<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Class="Hbpos.Client.Wpf.Views.CardRecoveryCenterView"
             Background="{DynamicResource PosScreenBackgroundBrush}"
             Loaded="CardRecoveryCenterView_OnLoaded"
             Unloaded="CardRecoveryCenterView_OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ===== 文字 ===== -->
        <Style x:Key="RecoveryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RecoveryCaps" TargetType="TextBlock" BasedOn="{StaticResource RecoveryLabel}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RecoveryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RecoveryMono" TargetType="TextBlock" BasedOn="{StaticResource RecoveryValue}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- ===== 带图标按钮：Content 仍是本地化文字，图标名放在 Tag ===== -->
        <DataTemplate x:Key="RecoveryIconContentTemplate">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"
                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="RecoveryPrimaryIconButton" TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource RecoveryIconContentTemplate}"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="RecoverySecondaryIconButton" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource RecoveryIconContentTemplate}"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <!-- 证据快捷标签：单行横排，窄屏时由所在 WrapPanel 自动换行。 -->
        <Style x:Key="RecoveryChipButton" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="14,2"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="RecoveryCopyButton" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 头部订单号旁的复制小按钮：比 RecoveryCopyButton 矮，给首屏省高度。 -->
        <Style x:Key="RecoveryCopyChip" TargetType="Button" BasedOn="{StaticResource RecoveryCopyButton}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <!-- 左列底部的「商品 / 交易详情 / 状态记录」入口：打开弹层，不占主屏。 -->
        <Style x:Key="RecoveryMoreButton" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- ===== 状态页签（药丸）与分段筛选（单选按钮） ===== -->
        <Style x:Key="RecoveryTab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="RecoveryCategory"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PosTextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="22" Padding="14,0,8,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PosPrimaryStrongBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecoveryCountBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}"/>
        </Style>
        <Style x:Key="RecoverySegment" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PosTextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="9" Margin="2">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 列表行（列表允许滚动，行高压到 76，首屏可见 5 行） ===== -->
        <Style x:Key="RecoveryListItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态色调：列表行绑定 Tone，详情绑定 SelectedTone；两套样式颜色一致。 -->
        <Style x:Key="RowPillBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Background" Value="{DynamicResource PosWarningSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosWarningBorderBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Danger"><Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosDangerBorderBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosSuccessBorderBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowToneText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowToneRail" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosBorderStrongBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter Property="Background" Value="{DynamicResource PosPrimaryBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Background" Value="{DynamicResource PosWarningBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Danger"><Setter Property="Background" Value="{DynamicResource PosDangerBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Background" Value="{DynamicResource PosSuccessBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowToneIconTile" TargetType="Border" BasedOn="{StaticResource RowPillBorder}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="DetailPillBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Info"><Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Warning"><Setter Property="Background" Value="{DynamicResource PosWarningSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosWarningBorderBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Danger"><Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosDangerBorderBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Success"><Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosSuccessBorderBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailToneText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Info"><Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailToneIconTile" TargetType="Border" BasedOn="{StaticResource DetailPillBorder}">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 左列「关键字段」一行：左标签、右值，细线分隔。 -->
        <Style x:Key="RecoveryFactRow" TargetType="Border">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,4"/>
        </Style>
        <Style x:Key="RecoveryFactValue" TargetType="TextBlock" BasedOn="{StaticResource RecoveryValue}">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 窄屏（< 1180）紧凑模式：由代码后置根据宽度设置 IsCompact，隐藏左列进度与字段，让操作区独占宽度。 -->
        <Style x:Key="RecoveryHideWhenCompact" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RecoveryShowOnlyWhenCompact" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 人工核对结果卡片：Content 是结果名称，Tag 是说明 ===== -->
        <Style x:Key="RecoveryOutcomeTile" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="14" Padding="14,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="16" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource PosTextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 第一个结果卡片：被 Square 拒绝的退款只有这一个结果，占满整行（Grid 共 5 列：3 卡片 + 2 间隔）。 -->
        <Style x:Key="RecoveryPrimaryOutcomeTile" TargetType="Button" BasedOn="{StaticResource RecoveryOutcomeTile}">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowAlternativeOutcomes}" Value="False">
                    <Setter Property="Grid.ColumnSpan" Value="5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 首屏布局：顶栏（返回 + 标题 + 状态页签 + 刷新）/ 主从区 / 底部状态。除列表外不滚动，所有操作按钮常驻首屏。 -->
        <Grid Margin="20,12,20,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding BackCommand}" Content="{loc:Loc cardRecovery.workspace.back}" Tag="ChevronLeft" Style="{StaticResource RecoverySecondaryIconButton}" MinHeight="48"/>
                <TextBlock Grid.Column="1" Text="{loc:Loc cardRecovery.center.title}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource RecoveryHideWhenCompact}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource RecoveryTab}" Command="{Binding FilterCommand}" CommandParameter="pending" IsChecked="{Binding IsPendingFilter, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource PosWarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc cardRecovery.workspace.pending}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource RecoveryCountBadge}" Background="{DynamicResource PosWarningStrongBrush}">
                                <TextBlock Text="{Binding PendingCount}" Foreground="White" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RecoveryTab}" Command="{Binding FilterCommand}" CommandParameter="review" IsChecked="{Binding IsReviewFilter, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource PosDangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc cardRecovery.workspace.review}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource RecoveryCountBadge}">
                                <TextBlock Text="{Binding ReviewCount}" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RecoveryTab}" Command="{Binding FilterCommand}" CommandParameter="failed" IsChecked="{Binding IsFailedFilter, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource PosBorderStrongBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc cardRecovery.workspace.failed}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource RecoveryCountBadge}">
                                <TextBlock Text="{Binding FailedCount}" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RecoveryTab}" Command="{Binding FilterCommand}" CommandParameter="resolved" IsChecked="{Binding IsResolvedFilter, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource PosSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc cardRecovery.workspace.resolved}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource RecoveryCountBadge}">
                                <TextBlock Text="{Binding ResolvedCount}" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <Button Grid.Column="4" Command="{Binding RefreshCommand}" Content="{loc:Loc cardRecovery.center.action.refresh}" Tag="Refresh" Style="{StaticResource RecoverySecondaryIconButton}" MinHeight="48"/>
            </Grid>

            <!-- 主从布局：列表 380 左右（窄屏不小于 320），其余给详情 -->
            <Grid Grid.Row="1" x:Name="RecoveryMasterDetailGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="320" MaxWidth="420"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2.4*" MinWidth="480"/>
                </Grid.ColumnDefinitions>

                <!-- 列表（唯一允许滚动的区域） -->
                <Border Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc cardRecovery.workspace.search}" AutomationProperties.Name="{loc:Loc cardRecovery.workspace.search}" MinHeight="48" Padding="42,0,12,0" VerticalContentAlignment="Center" FontSize="15" Style="{StaticResource PosSearchTextBoxStyle}"/>
                            <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{DynamicResource PosMutedForegroundBrush}"/>
                            <TextBlock Text="{loc:Loc cardRecovery.workspace.search}" Margin="44,0,12,0" VerticalAlignment="Center" FontSize="14.5" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PosSubtleForegroundBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource PosSurfaceMutedBrush}" CornerRadius="12" Padding="2">
                                <UniformGrid Rows="1">
                                    <RadioButton GroupName="RecoveryChannel" Style="{StaticResource RecoverySegment}" Content="{loc:Loc cardRecovery.v2.channelAll}" IsChecked="{Binding IsChannelAll}" AutomationProperties.Name="{loc:Loc cardRecovery.workspace.channel}"/>
                                    <RadioButton GroupName="RecoveryChannel" Style="{StaticResource RecoverySegment}" Content="{loc:Loc cardRecovery.center.channel.square}" IsChecked="{Binding IsChannelSquare}"/>
                                    <RadioButton GroupName="RecoveryChannel" Style="{StaticResource RecoverySegment}" Content="{loc:Loc cardRecovery.center.channel.linkly}" IsChecked="{Binding IsChannelLinkly}"/>
                                </UniformGrid>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource PosSurfaceMutedBrush}" CornerRadius="12" Padding="2">
                                <UniformGrid Rows="1">
                                    <RadioButton GroupName="RecoveryOperation" Style="{StaticResource RecoverySegment}" Content="{loc:Loc cardRecovery.v2.typeAll}" IsChecked="{Binding IsOperationAll}" AutomationProperties.Name="{loc:Loc cardRecovery.workspace.operations}"/>
                                    <RadioButton GroupName="RecoveryOperation" Style="{StaticResource RecoverySegment}" Content="{loc:Loc cardRecovery.v2.typeSale}" IsChecked="{Binding IsOperationSale}"/>
                                    <RadioButton GroupName="RecoveryOperation" Style="{StaticResource RecoverySegment}" Content="{loc:Loc cardRecovery.v2.typeRefund}" IsChecked="{Binding IsOperationRefund}"/>
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding ListCountText}" Style="{StaticResource RecoveryCaps}" Margin="4,10,0,6"/>
                        <Grid Grid.Row="3">
                            <ListBox x:Name="OpenAttemptsList" ItemsSource="{Binding OpenAttemptRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" ItemContainerStyle="{StaticResource RecoveryListItemStyle}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.PanningMode="VerticalOnly">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource RowToneRail}" CornerRadius="10,0,0,10" Margin="-1.5,-1.5,0,-1.5"/>
                                            <Border Grid.Column="1" Style="{StaticResource RowToneIconTile}" Margin="10,0,10,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="CreditCardOutline"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRefund}" Value="True"><Setter Property="Kind" Value="CashRefund"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Neutral"><Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Border>
                                            <!-- 标题与金额同一行；单号时间一行、状态一行，窄屏也不截断状态。 -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,8">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding OperationTypeText}" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding MetaText}" ToolTip="{Binding OrderText}" Style="{StaticResource RecoveryLabel}" FontSize="12.5" Margin="0,1,0,5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                <Border Style="{StaticResource RowPillBorder}">
                                                    <TextBlock Text="{Binding StatusPillText}" Style="{StaticResource RowToneText}" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{loc:Loc cardRecovery.workspace.empty}" Style="{StaticResource RecoveryLabel}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoOpenAttempts, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <!-- 收款安全提示已在右侧详情的警示条中显示，这里只保留历史范围说明。 -->
                        <TextBlock Grid.Row="4" Text="{loc:Loc cardRecovery.workspace.historyScope}" Style="{StaticResource RecoveryLabel}" FontSize="12" Margin="4,8,4,0"/>
                    </Grid>
                </Border>

                <!-- 详情：固定三块（头部 / 警示条 / 左信息右操作），不再整体滚动 -->
                <Border Grid.Column="2" x:Name="DetailCard" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="16" Padding="20,16">
                    <Grid>
                        <TextBlock Text="{loc:Loc cardRecovery.center.detail.empty}" Style="{StaticResource RecoveryLabel}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Grid Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 头部：图标 / 标题 + 单号 / (紧凑模式的三个入口) / 金额 + 状态 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DetailToneIconTile}" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <materialDesign:PackIcon Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="CreditCardOutline"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelectedRefund}" Value="True"><Setter Property="Kind" Value="CashRefund"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedTone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedTone}" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedTone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedHeadlineText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedTitleText}" Style="{StaticResource RecoveryCaps}" TextWrapping="NoWrap" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding SelectedOrderText}" ToolTip="{Binding SelectedOrderText}" Style="{StaticResource RecoveryMono}" FontWeight="Normal" Foreground="{DynamicResource PosTextSecondaryBrush}" VerticalAlignment="Center" MaxWidth="360"/>
                                        <Button Content="{loc:Loc cardRecovery.v2.copy}" Tag="{Binding SelectedOrderText}" Click="CopyButton_OnClick" Style="{StaticResource RecoveryCopyChip}"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- 紧凑模式：左列收起后，三个次要信息入口挪到头部（图标按钮，触屏 48×48）。 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,12,0" VerticalAlignment="Center" Style="{StaticResource RecoveryShowOnlyWhenCompact}">
                                    <Button Tag="products" Click="OpenDetailSheet_OnClick" ToolTip="{loc:Loc cardRecovery.v2.products}" AutomationProperties.Name="{loc:Loc cardRecovery.v2.products}" Style="{StaticResource PosSecondaryButtonStyle}" MinWidth="48" MinHeight="48" Padding="0" Margin="0,0,6,0">
                                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="22" Height="22"/>
                                    </Button>
                                    <Button Tag="details" Click="OpenDetailSheet_OnClick" ToolTip="{loc:Loc cardRecovery.v2.details}" AutomationProperties.Name="{loc:Loc cardRecovery.v2.details}" Style="{StaticResource PosSecondaryButtonStyle}" MinWidth="48" MinHeight="48" Padding="0" Margin="0,0,6,0">
                                        <materialDesign:PackIcon Kind="CardSearchOutline" Width="22" Height="22"/>
                                    </Button>
                                    <Button Tag="history" Click="OpenDetailSheet_OnClick" ToolTip="{loc:Loc cardRecovery.workspace.history}" AutomationProperties.Name="{loc:Loc cardRecovery.workspace.history}" Style="{StaticResource PosSecondaryButtonStyle}" MinWidth="48" MinHeight="48" Padding="0">
                                        <materialDesign:PackIcon Kind="ClockOutline" Width="22" Height="22"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedAmountText}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" HorizontalAlignment="Right"/>
                                    <Border Style="{StaticResource DetailPillBorder}" HorizontalAlignment="Right" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding SelectedStatusPillText}" Style="{StaticResource DetailToneText}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 安全提示：单行标题 + 说明，英文长文案自动换行，高度随内容增长。 -->
                            <Border Grid.Row="1" Margin="0,10,0,0" Padding="14,8" MinHeight="44" CornerRadius="12" BorderThickness="1.5" Visibility="{Binding ShowSafetyBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource PosWarningSoftBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PosWarningBorderBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettlementPendingSelection}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSettlementRejectedSelection}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBorderBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="AlertOutline"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PosWarningStrongBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSettlementPendingSelection}" Value="True">
                                                        <Setter Property="Kind" Value="InformationOutline"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSettlementRejectedSelection}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock Grid.Column="1" Text="{Binding SafetyBannerTitleText}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSettlementPendingSelection}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSettlementRejectedSelection}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding SafetyBannerBodyText}" FontSize="13.5" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource PosTextSecondaryBrush}"/>
                                </Grid>
                            </Border>

                            <!-- 主体：左信息列（进度 / 关键字段 / 次要信息入口）+ 右操作列 -->
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左信息列：紧凑模式整体收起 -->
                                <StackPanel x:Name="InfoColumn" Width="280" Margin="0,0,20,0" Style="{StaticResource RecoveryHideWhenCompact}">
                                    <!-- 进度：已提交 → 当前状态 → 完成（竖排） -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                        </Grid.RowDefinitions>
                                        <!-- 连接线：画在圆点下面，第一段恒为已完成，第二段随终态变色 -->
                                        <Border Grid.Row="0" Grid.RowSpan="2" Width="2" Margin="0,20" HorizontalAlignment="Center" Background="{DynamicResource PosSuccessBrush}"/>
                                        <Border Grid.Row="1" Grid.RowSpan="2" Width="2" Margin="0,20" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PosDividerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFinalStepDone}" Value="True"><Setter Property="Background" Value="{DynamicResource PosSuccessBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSettlementSelection}" Value="True"><Setter Property="Background" Value="{DynamicResource PosSuccessBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- 圆点 1：已提交 -->
                                        <Border Grid.Row="0" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource PosSuccessBrush}" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- 圆点 2：处理中（琥珀圆环）或已完成（绿色对勾） -->
                                        <Border Grid.Row="1" Width="28" Height="28" CornerRadius="14" BorderThickness="3" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PosSuccessBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PosSuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentStepActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PosWarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <TextBlock Text="2" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource PosWarningTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsCurrentStepActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrentStepActive}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Grid>
                                        </Border>
                                        <!-- 圆点 3：未到（灰圈）/ 完成（绿）/ 失败（红叉） -->
                                        <Border Grid.Row="2" Width="28" Height="28" CornerRadius="14" BorderThickness="3" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFinalStepDone}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PosSuccessBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PosSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFinalStepFailed}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PosDangerBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <TextBlock Text="3" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource PosMutedForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsFinalStepPending, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsFinalStepDone, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsFinalStepFailed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>

                                        <!-- 步骤文字：左标签、右时间 -->
                                        <DockPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StepSubmittedTimeText}" Style="{StaticResource RecoveryLabel}" FontSize="12.5" TextWrapping="NoWrap" Margin="8,0,0,0"/>
                                            <TextBlock Text="{loc:Loc cardRecovery.v2.step.submitted}" Style="{StaticResource RecoveryValue}" FontSize="14.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StepCurrentTimeText}" Style="{StaticResource RecoveryLabel}" FontSize="12.5" TextWrapping="NoWrap" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding StepCurrentLabelText}" ToolTip="{Binding StepCurrentLabelText}" Style="{StaticResource RecoveryValue}" FontSize="14.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StepFinalTimeText}" Style="{StaticResource RecoveryLabel}" FontSize="12.5" TextWrapping="NoWrap" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding StepFinalLabelText}" ToolTip="{Binding StepFinalLabelText}" Style="{StaticResource RecoveryValue}" FontSize="14.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Grid>

                                    <!-- 关键字段：五行，其余（会话、尝试标识、环境、响应内容）放进「交易详情」弹层 -->
                                    <StackPanel Margin="0,8,0,0">
                                        <Border Style="{StaticResource RecoveryFactRow}" BorderThickness="0,1,0,1">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{loc:Loc cardRecovery.center.field.channel}" Style="{StaticResource RecoveryLabel}" FontSize="13" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding SelectedChannelText}" Style="{StaticResource RecoveryFactValue}"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource RecoveryFactRow}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{loc:Loc cardRecovery.center.field.time}" Style="{StaticResource RecoveryLabel}" FontSize="13" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding SelectedTimeText}" ToolTip="{Binding SelectedTimeText}" Style="{StaticResource RecoveryFactValue}"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource RecoveryFactRow}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{loc:Loc cardRecovery.v2.field.cashier}" Style="{StaticResource RecoveryLabel}" FontSize="13" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding SelectedCashierNameText}" ToolTip="{Binding SelectedCashierNameText}" Style="{StaticResource RecoveryFactValue}"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource RecoveryFactRow}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{loc:Loc cardRecovery.center.field.txn}" Style="{StaticResource RecoveryLabel}" FontSize="13" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding SelectedTxnText}" ToolTip="{Binding SelectedTxnText}" Style="{StaticResource RecoveryFactValue}" FontFamily="Consolas"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource RecoveryFactRow}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{loc:Loc cardRecovery.center.field.responseCode}" Style="{StaticResource RecoveryLabel}" FontSize="13" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding SelectedResponseCodeText}" ToolTip="{Binding SelectedResponseCodeText}" Style="{StaticResource RecoveryFactValue}"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 次要信息入口：商品 / 交易详情 / 状态记录，点开是弹层（列表在弹层里滚动） -->
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button Tag="products" Click="OpenDetailSheet_OnClick" Style="{StaticResource RecoveryMoreButton}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{loc:Loc cardRecovery.v2.products}" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SelectedProductSummaryText}" FontSize="11.5" Foreground="{DynamicResource PosMutedForegroundBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Tag="details" Click="OpenDetailSheet_OnClick" Style="{StaticResource RecoveryMoreButton}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CardSearchOutline" Width="20" Height="20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{loc:Loc cardRecovery.v2.details}" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Tag="history" Click="OpenDetailSheet_OnClick" Style="{StaticResource RecoveryMoreButton}" Margin="0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{loc:Loc cardRecovery.workspace.history}" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- 右操作列：自动检查条 + 人工核实（常驻，不再是侧滑抽屉） -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 自动检查倒计时 + 立即检查 -->
                                    <Border Background="{DynamicResource PosPrimarySoftBrush}" BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14,4,4,4" Margin="0,0,0,10" Visibility="{Binding ShowActionBar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <materialDesign:PackIcon Kind="Autorenew" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource PosPrimaryTextBrush}" Visibility="{Binding IsAutoCheckActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding AutoCheckText}" Style="{StaticResource RecoveryLabel}" FontSize="14" Foreground="{DynamicResource PosTextSecondaryBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <Button Grid.Column="1" Command="{Binding RecoverCommand}" Content="{loc:Loc cardRecovery.v2.action.checkNow}" Tag="Refresh" Style="{StaticResource RecoveryPrimaryIconButton}" MinHeight="48" MinWidth="170"/>
                                        </Grid>
                                    </Border>

                                    <!-- 人工核实：标题 + 证据快捷 / 可滚动表单 / 固定的结果按钮 -->
                                    <Border Grid.Row="1" Background="{DynamicResource PosSurfaceAltBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="14" Padding="14,10" Visibility="{Binding CanShowSupervisorResolution, Converter={StaticResource BooleanToVisibilityConverter}}" GotKeyboardFocus="ManualResolution_OnGotKeyboardFocus">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- 标题先占位，证据快捷标签在剩余宽度里右对齐，放不下时自动换行（英文长文案）。 -->
                                            <DockPanel Margin="0,0,0,6">
                                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ResolutionSectionTitleText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                                    <Border Margin="10,0,0,0" CornerRadius="12" Padding="9,3" BorderThickness="1" Background="{DynamicResource PosWarningSoftBrush}" BorderBrush="{DynamicResource PosWarningBorderBrush}" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="LockOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource PosWarningTextBrush}"/>
                                                            <TextBlock Text="{loc:Loc cardRecovery.v2.sheet.supervisorRequired}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PosWarningTextBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding ShowEvidenceInputs, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Button Command="{Binding ApplyEvidencePresetCommand}" CommandParameter="squareDashboard" Content="{loc:Loc cardRecovery.v2.evidence.squareDashboard}" Style="{StaticResource RecoveryChipButton}"/>
                                                    <Button Command="{Binding ApplyEvidencePresetCommand}" CommandParameter="terminalReceipt" Content="{loc:Loc cardRecovery.v2.evidence.terminalReceipt}" Style="{StaticResource RecoveryChipButton}"/>
                                                    <Button Command="{Binding ApplyEvidencePresetCommand}" CommandParameter="bankStatement" Content="{loc:Loc cardRecovery.v2.evidence.bankStatement}" Style="{StaticResource RecoveryChipButton}"/>
                                                </WrapPanel>
                                            </DockPanel>

                                            <!-- 表单区：典型文案下不出现滚动条；英文长文案时在这里滚动，结果按钮始终固定在下方。 -->
                                            <ScrollViewer Grid.Row="1" x:Name="DetailScrollViewer" PanningMode="VerticalOnly" Style="{StaticResource PosVerticalTouchScrollViewerStyle}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding ResolutionInstructionsText}" Style="{StaticResource RecoveryLabel}" FontSize="13" Margin="0,0,0,8"/>
                                                    <!-- 三个输入同一行：付款参考号 / 证据 / 主管备注；被拒退款只剩备注，占满整行。 -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.9*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="1*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Visibility="{Binding ShowEvidenceInputs, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ResolutionReferenceLabelText}" Style="{StaticResource RecoveryLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                            <TextBox Text="{Binding ResolutionReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ResolutionReferenceLabelText}" MinHeight="48" FontSize="14.5" VerticalContentAlignment="Center" TextWrapping="Wrap" Style="{StaticResource PosSearchTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Visibility="{Binding ShowEvidenceInputs, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ResolutionEvidenceLabelText}" Style="{StaticResource RecoveryLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                            <TextBox Text="{Binding ResolutionEvidence, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ResolutionEvidenceLabelText}" MinHeight="48" FontSize="14.5" VerticalContentAlignment="Center" TextWrapping="Wrap" Style="{StaticResource PosSearchTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Grid.Column" Value="4"/>
                                                                    <Setter Property="Grid.ColumnSpan" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowEvidenceInputs}" Value="False">
                                                                            <Setter Property="Grid.Column" Value="0"/>
                                                                            <Setter Property="Grid.ColumnSpan" Value="5"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{Binding ResolutionReasonLabelText}" Style="{StaticResource RecoveryLabel}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                            <TextBox Text="{Binding ResolutionReason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ResolutionReasonLabelText}" MinHeight="48" FontSize="14.5" VerticalContentAlignment="Top" Padding="12,10" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource PosSearchTextBoxStyle}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>

                                            <!-- 结果按钮：固定在卡片底部，永远在首屏内。每个结果仍需主管扫码授权。 -->
                                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock DockPanel.Dock="Left" Text="{loc:Loc cardRecovery.v2.sheet.step.outcome}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{loc:Loc cardRecovery.v2.sheet.outcomeHint}" Style="{StaticResource RecoveryLabel}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                </DockPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 被 Square 拒绝的退款只有一个结果，占满整行 -->
                                                    <Button Command="{Binding ConfirmPaidCommand}" Content="{Binding ConfirmProcessedText}" Tag="{Binding ProcessedOutcomeHintText}" Style="{StaticResource RecoveryPrimaryOutcomeTile}" MinHeight="76" Background="{DynamicResource PosSuccessSoftBrush}" BorderBrush="{DynamicResource PosSuccessBorderBrush}" Foreground="{DynamicResource PosSuccessTextBrush}"/>
                                                    <Button Grid.Column="2" Command="{Binding ConfirmNotPaidCommand}" Content="{Binding ConfirmNotProcessedText}" Tag="{Binding NotProcessedOutcomeHintText}" Style="{StaticResource RecoveryOutcomeTile}" MinHeight="76" Visibility="{Binding ShowAlternativeOutcomes, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <Button Grid.Column="4" Command="{Binding ContinueWaitingCommand}" Content="{loc:Loc cardRecovery.center.action.continueWaiting}" Tag="{Binding WaitingOutcomeHintText}" Style="{StaticResource RecoveryOutcomeTile}" MinHeight="76" Visibility="{Binding ShowAlternativeOutcomes, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                                                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="16" Height="16" Margin="0,1,6,0" VerticalAlignment="Center" Foreground="{DynamicResource PosMutedForegroundBrush}"/>
                                                    <TextBlock Text="{loc:Loc cardRecovery.v2.sheet.audit}" Style="{StaticResource RecoveryLabel}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 不能手工结案：只给出说明，立即检查仍可用 -->
                                    <Border Grid.Row="1" VerticalAlignment="Top" Background="{DynamicResource PosWarningSoftBrush}" BorderBrush="{DynamicResource PosWarningBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12" Visibility="{Binding CanShowRecoveryOnlyGuidance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DockPanel>
                                            <materialDesign:PackIcon Kind="AlertOutline" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Top" Foreground="{DynamicResource PosWarningStrongBrush}"/>
                                            <TextBlock Text="{Binding RecoveryOnlyGuidanceMessage}" Style="{StaticResource RecoveryLabel}" FontSize="14" Foreground="{DynamicResource PosTextSecondaryBrush}"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- 已结交易：仅供查看 -->
                                    <Border Grid.Row="1" VerticalAlignment="Top" Background="{DynamicResource PosSurfaceAltBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="14" Padding="16,12" Visibility="{Binding IsHistorySelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DockPanel>
                                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource PosMutedForegroundBrush}"/>
                                            <TextBlock Text="{loc:Loc cardRecovery.workspace.readOnly}" Style="{StaticResource RecoveryLabel}" FontSize="14.5" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 底部状态 -->
            <Grid Grid.Row="2" Margin="2,8,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource RecoveryLabel}" FontSize="13"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="{loc:Loc cardRecovery.workspace.refreshed}" Style="{StaticResource RecoveryLabel}" FontSize="13"/>
                    <TextBlock Text="{Binding LastRefreshText}" Style="{StaticResource RecoveryLabel}" FontSize="13" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== 次要信息弹层：商品 / 交易详情 / 状态记录（列表，可滚动） ===== -->
        <Grid x:Name="DetailSheetOverlay" Visibility="Collapsed">
            <Border Background="{DynamicResource PosInverseSurfaceBrush}" Opacity="0.45" MouseLeftButtonUp="DetailSheetScrim_OnMouseLeftButtonUp"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="600" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" MaxHeight="520" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>
                <Grid Margin="16,14,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource PosSurfaceMutedBrush}" CornerRadius="12" Padding="2">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="SheetTabProducts" GroupName="RecoverySheetTab" IsChecked="True" Style="{StaticResource RecoverySegment}" MinHeight="44" Content="{loc:Loc cardRecovery.v2.products}"/>
                                <RadioButton x:Name="SheetTabDetails" GroupName="RecoverySheetTab" Style="{StaticResource RecoverySegment}" MinHeight="44" Content="{loc:Loc cardRecovery.v2.details}"/>
                                <RadioButton x:Name="SheetTabHistory" GroupName="RecoverySheetTab" Style="{StaticResource RecoverySegment}" MinHeight="44" Content="{loc:Loc cardRecovery.workspace.history}"/>
                            </UniformGrid>
                        </Border>
                        <Button Grid.Column="1" Click="DetailSheetClose_OnClick" Content="{loc:Loc cardRecovery.v2.action.close}" Tag="Close" Style="{StaticResource RecoverySecondaryIconButton}" MinHeight="48" Margin="10,0,0,0"/>
                    </Grid>

                    <!-- 商品 -->
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" PanningMode="VerticalOnly" Style="{StaticResource PosVerticalTouchScrollViewerStyle}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsChecked, ElementName=SheetTabProducts, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding SelectedProductLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Quantity, StringFormat='× {0}'}" DockPanel.Dock="Right" Style="{StaticResource RecoveryValue}" FontSize="15" Margin="12,0,0,0"/>
                                                <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource PosTextBrush}"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:Loc cardRecovery.v2.noProducts}" Style="{StaticResource RecoveryLabel}" Margin="0,10" Visibility="{Binding HasNoProductSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 交易详情：含左列放不下的会话、尝试标识、环境、响应内容，以及可复制的交易号 -->
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" PanningMode="VerticalOnly" Style="{StaticResource PosVerticalTouchScrollViewerStyle}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsChecked, ElementName=SheetTabDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:Loc cardRecovery.center.field.type}" Style="{StaticResource RecoveryCaps}" Margin="0,8"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedTypeText}" Style="{StaticResource RecoveryValue}" FontSize="15" Margin="0,8"/>
                            <TextBlock Grid.Row="1" Text="{loc:Loc cardRecovery.center.field.txn}" Style="{StaticResource RecoveryCaps}" Margin="0,8"/>
                            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="{loc:Loc cardRecovery.v2.copy}" Tag="{Binding SelectedTxnText}" Click="CopyButton_OnClick" Style="{StaticResource RecoveryCopyButton}"/>
                                <TextBlock Text="{Binding SelectedTxnText}" ToolTip="{Binding SelectedTxnText}" Style="{StaticResource RecoveryMono}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Grid.Row="2" Text="{loc:Loc cardRecovery.center.field.responseCode}" Style="{StaticResource RecoveryCaps}" Margin="0,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedResponseCodeText}" Style="{StaticResource RecoveryValue}" FontSize="15" Margin="0,8"/>
                            <TextBlock Grid.Row="3" Text="{loc:Loc cardRecovery.center.field.responseText}" Style="{StaticResource RecoveryCaps}" Margin="0,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedResponseText}" Style="{StaticResource RecoveryValue}" FontSize="15" Margin="0,8"/>
                            <TextBlock Grid.Row="4" Text="{loc:Loc cardRecovery.center.field.session}" Style="{StaticResource RecoveryCaps}" Margin="0,8"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSessionText}" Style="{StaticResource RecoveryMono}" Margin="0,8"/>
                            <TextBlock Grid.Row="5" Text="{loc:Loc cardRecovery.center.field.attempt}" Style="{StaticResource RecoveryCaps}" Margin="0,8"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedAttemptText}" Style="{StaticResource RecoveryMono}" Margin="0,8"/>
                            <TextBlock Grid.Row="6" Text="{loc:Loc cardRecovery.v2.field.cashierId}" Style="{StaticResource RecoveryCaps}" Margin="0,8"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedCashierText}" Style="{StaticResource RecoveryMono}" Margin="0,8"/>
                            <TextBlock Grid.Row="7" Text="{loc:Loc cardRecovery.center.field.environment}" Style="{StaticResource RecoveryCaps}" Margin="0,8"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedEnvironmentText}" Style="{StaticResource RecoveryValue}" FontSize="15" Margin="0,8"/>
                        </Grid>
                    </ScrollViewer>

                    <!-- 状态记录 -->
                    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" PanningMode="VerticalOnly" Style="{StaticResource PosVerticalTouchScrollViewerStyle}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsChecked, ElementName=SheetTabHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding SelectedHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource RecoveryLabel}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource RecoveryValue}" FontSize="14.5" FontWeight="Normal"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
