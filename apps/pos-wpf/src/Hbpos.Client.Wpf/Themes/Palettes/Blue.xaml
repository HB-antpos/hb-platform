<!-- 由色板总表生成，各套主题的键必须完全一致。蓝色：冷灰白底、深蓝灰字、明快蓝主色，新装收银机的默认配色。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="PosPaletteId">Blue</sys:String>
    <sys:Boolean x:Key="PosPaletteIsDark">False</sys:Boolean>
    <Color x:Key="PosPaletteMaterialPrimaryColor">#FF0B5ED7</Color>

    <!-- 整屏背景 -->
    <SolidColorBrush x:Key="PosScreenBackgroundBrush" Color="#FFF3F5F8" />
    <!-- 卡片/面板 -->
    <SolidColorBrush x:Key="PosSurfaceBrush" Color="#FFFFFFFF" />
    <!-- 次级面板/交替行 -->
    <SolidColorBrush x:Key="PosSurfaceAltBrush" Color="#FFF8FAFC" />
    <!-- 浅灰底（输入区、分组底） -->
    <SolidColorBrush x:Key="PosSurfaceMutedBrush" Color="#FFF1F4F8" />
    <!-- 较深灰底（按下、禁用块） -->
    <SolidColorBrush x:Key="PosSurfaceStrongBrush" Color="#FFE2E7EE" />
    <!-- 深色提示底（配白字） -->
    <SolidColorBrush x:Key="PosInverseSurfaceBrush" Color="#FF142033" />
    <!-- 分隔线/浅描边 -->
    <SolidColorBrush x:Key="PosDividerBrush" Color="#FFE1E6ED" />
    <!-- 描边 -->
    <SolidColorBrush x:Key="PosBorderBrush" Color="#FFCED6E0" />
    <!-- 深描边/滚动条 -->
    <SolidColorBrush x:Key="PosBorderStrongBrush" Color="#FF94A3B8" />
    <!-- 正文 -->
    <SolidColorBrush x:Key="PosTextBrush" Color="#FF142033" />
    <!-- 次级正文 -->
    <SolidColorBrush x:Key="PosTextSecondaryBrush" Color="#FF3D4A5C" />
    <!-- 次要文字 -->
    <SolidColorBrush x:Key="PosMutedForegroundBrush" Color="#FF5F6B7A" />
    <!-- 占位/弱提示文字 -->
    <SolidColorBrush x:Key="PosSubtleForegroundBrush" Color="#FF94A3B8" />
    <!-- 功能图标 -->
    <SolidColorBrush x:Key="PosIconBrush" Color="#FF2F4A6E" />
    <!-- 侧栏功能图标 -->
    <SolidColorBrush x:Key="PosSidebarIconBrush" Color="#FF0B5ED7" />
    <!-- 侧栏退款图标 -->
    <SolidColorBrush x:Key="PosSidebarRefundIconBrush" Color="#FF0B5ED7" />
    <!-- 侧栏挂单图标 -->
    <SolidColorBrush x:Key="PosSidebarHoldIconBrush" Color="#FF0B5ED7" />
    <!-- 主色填充/描边（配白字） -->
    <SolidColorBrush x:Key="PosPrimaryBrush" Color="#FF0B5ED7" />
    <!-- 主色按下 -->
    <SolidColorBrush x:Key="PosPrimaryStrongBrush" Color="#FF094FB5" />
    <!-- 主色文字/图标 -->
    <SolidColorBrush x:Key="PosPrimaryTextBrush" Color="#FF0B5ED7" />
    <!-- 选中/主色浅底 -->
    <SolidColorBrush x:Key="PosPrimarySoftBrush" Color="#FFEAF2FF" />
    <!-- 主色浅底（悬停/按下） -->
    <SolidColorBrush x:Key="PosPrimarySoftStrongBrush" Color="#FFD6E5FB" />
    <!-- 主色浅描边 -->
    <SolidColorBrush x:Key="PosPrimarySoftBorderBrush" Color="#FFC4D9FB" />
    <!-- 主色按钮禁用底（配白字） -->
    <SolidColorBrush x:Key="PosPrimaryDisabledBrush" Color="#FF8DB6EE" />
    <!-- 标题文字 -->
    <SolidColorBrush x:Key="PosPrimaryDarkBrush" Color="#FF142033" />
    <!-- 重点金额 -->
    <SolidColorBrush x:Key="PosAccentBrush" Color="#FFF59E0B" />
    <!-- 重点金额文字 -->
    <SolidColorBrush x:Key="PosAccentForegroundBrush" Color="#FFE07A00" />
    <!-- 应付合计底色（荧光笔） -->
    <SolidColorBrush x:Key="PosAmountSoftBrush" Color="#00FFFFFF" />
    <!-- 成功填充（配白字） -->
    <SolidColorBrush x:Key="PosSuccessBrush" Color="#FF15803D" />
    <!-- 成功文字 -->
    <SolidColorBrush x:Key="PosSuccessTextBrush" Color="#FF15803D" />
    <!-- 成功浅底 -->
    <SolidColorBrush x:Key="PosSuccessSoftBrush" Color="#FFE9F7EE" />
    <!-- 成功描边 -->
    <SolidColorBrush x:Key="PosSuccessBorderBrush" Color="#FFA8DCB8" />
    <!-- 警告填充 -->
    <SolidColorBrush x:Key="PosWarningBrush" Color="#FFF59E0B" />
    <!-- 警告文字 -->
    <SolidColorBrush x:Key="PosWarningTextBrush" Color="#FF92400E" />
    <!-- 警告强调填充（配白字） -->
    <SolidColorBrush x:Key="PosWarningStrongBrush" Color="#FFB45309" />
    <!-- 警告浅底 -->
    <SolidColorBrush x:Key="PosWarningSoftBrush" Color="#FFFFF6E5" />
    <!-- 警告描边 -->
    <SolidColorBrush x:Key="PosWarningBorderBrush" Color="#FFF6D38F" />
    <!-- 危险填充（配白字） -->
    <SolidColorBrush x:Key="PosDangerBrush" Color="#FFC62828" />
    <!-- 危险文字 -->
    <SolidColorBrush x:Key="PosDangerTextBrush" Color="#FFB91C1C" />
    <!-- 危险浅底 -->
    <SolidColorBrush x:Key="PosDangerSoftBrush" Color="#FFFDECEC" />
    <!-- 危险描边 -->
    <SolidColorBrush x:Key="PosDangerBorderBrush" Color="#FFF3B9B9" />
    <!-- 标题栏背景 -->
    <SolidColorBrush x:Key="PosHeaderBackgroundBrush" Color="#FFFFFFFF" />
    <!-- 标题栏文字 -->
    <SolidColorBrush x:Key="PosHeaderForegroundBrush" Color="#FF142033" />
    <!-- 标题栏次要文字 -->
    <SolidColorBrush x:Key="PosHeaderMutedForegroundBrush" Color="#FF5F6B7A" />
    <!-- 状态栏背景 -->
    <SolidColorBrush x:Key="PosFooterBackgroundBrush" Color="#FFFFFFFF" />

    <LinearGradientBrush x:Key="PosPrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2F80ED" Offset="0" />
        <GradientStop Color="#FF0B5ED7" Offset="0.55" />
        <GradientStop Color="#FF0A4AA8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PosPayButtonGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF1A73E8" Offset="0" />
        <GradientStop Color="#FF0B5ED7" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
