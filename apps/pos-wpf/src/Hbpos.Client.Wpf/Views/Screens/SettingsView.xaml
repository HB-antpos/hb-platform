                                                                            CommandParameter="{Binding ManagementItem}">
                                                                        <TextBlock Text="{loc:Loc settings.linkly.cloudBackend.changeBinding}" />
                                                                    </Button>
                                                                    <Button Style="{StaticResource PosSecondaryButtonStyle}" MinHeight="44" Padding="12,8" Margin="0,0,0,6"
                                                                            Command="{Binding DataContext.UnassignLinklyCloudTerminalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding ManagementItem}">
                                                                        <TextBlock Text="{loc:Loc settings.linkly.cloudBackend.unassign}" />
                                                                    </Button>
                                                                </WrapPanel>
                                                                <Border Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="4" Padding="14" Margin="0,10,0,0"
                                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{loc:Loc settings.linkly.lines.working}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"
                                                                                   Visibility="{Binding IsOperationBusy, Converter={StaticResource BoolToVis}}" />
