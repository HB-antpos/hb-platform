<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.CustomerDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d"
               d:DesignHeight="688"
               d:DesignWidth="1366"
               UseLayoutRounding="True"
               SnapsToDevicePixels="True"
               Background="{StaticResource PosCustomerDisplayBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="CustomerDisplayHeaderBaseStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PosCustomerDisplaySurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PosCustomerDisplayMutedTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource PosCustomerDisplayDividerBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CustomerDisplayHeaderLeftStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CustomerDisplayHeaderBaseStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="CustomerDisplayHeaderCenterStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CustomerDisplayHeaderBaseStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CustomerDisplayHeaderRightStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CustomerDisplayHeaderBaseStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <Style x:Key="CustomerDisplayCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PosCustomerDisplayTextBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource PosCustomerDisplayDividerBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform"
             StretchDirection="Both"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
        <!-- 画布高度固定 768，宽度在代码中随宿主宽高比调整（4:3 → 1024、16:10 → 1229、16:9 及更宽 1366），常见客显屏都能铺满。 -->
        <Grid x:Name="DesignCanvas"
              Width="1366"
              Height="768"
              Margin="0"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              Background="{StaticResource PosCustomerDisplayBackgroundBrush}">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="SummaryRow" Height="152" />
                </Grid.RowDefinitions>

        <Grid x:Name="ContentGrid" Grid.Row="0" SizeChanged="ContentGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PromotionBannerRow" Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CartColumn" Width="60*" MinWidth="0" />
                <ColumnDefinition x:Name="PromotionColumn" Width="40*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CartPanel"
                    Grid.Row="1"
                    Grid.Column="0"
                    Background="{StaticResource PosCustomerDisplayBackgroundBrush}"
                    BorderBrush="{StaticResource PosCustomerDisplayDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <DataGrid x:Name="LineDataGrid"
                          ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Background="{StaticResource PosCustomerDisplayBackgroundBrush}"
                          Foreground="{StaticResource PosCustomerDisplayTextBrush}"
                          RowBackground="{StaticResource PosCustomerDisplayBackgroundBrush}"
                          AlternatingRowBackground="{StaticResource PosCustomerDisplaySurfaceBrush}"
                          RowHeight="72"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          CellStyle="{StaticResource CustomerDisplayCellStyle}"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource PosCartDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Loc ItemDescription}" Width="*" HeaderStyle="{StaticResource CustomerDisplayHeaderLeftStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,6,8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="52"
                                                Height="52"
                                                Margin="0,0,12,0"
                                                Background="{StaticResource PosCustomerDisplayAccentSurfaceBrush}"
                                                BorderBrush="{StaticResource PosCustomerDisplayDividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True"
                                                UseLayoutRounding="True"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Rectangle RadiusX="5"
                                                           RadiusY="5"
                                                           Margin="2"
                                                           SnapsToDevicePixels="True"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Panel.ZIndex="1">
                                                    <Rectangle.Fill>
                                                        <ImageBrush converters:ProductThumbnailImageSourceConverter.AsyncSourceText="{Binding ProductImage}"
                                                                    converters:ProductThumbnailImageSourceConverter.AsyncDecodePixelWidth="72"
                                                                    Stretch="Uniform" />
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <materialDesign:PackIcon Kind="Shopping"
                                                                         Width="22"
                                                                         Height="22"
                                                                         Foreground="{StaticResource PosCustomerDisplayAccentBrush}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Panel.ZIndex="0" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource PosCustomerDisplayTextBrush}"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="210">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasItemNumber}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}"
                                                               FontSize="12"
                                                               MaxWidth="185"
                                                               ToolTip="{Binding ItemNumber}"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{loc:Loc ItemNumber}" />
                                                        <Run Text=" " />
                                                        <Run Text="{Binding ItemNumber}" />
                                                    </TextBlock>
                                                    <Border Width="1"
                                                            Height="12"
                                                            Margin="10,0"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource PosCustomerDisplayDividerBrush}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LookupCode}"
                                                           Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Loc Quantity}" Width="96" HeaderStyle="{StaticResource CustomerDisplayHeaderCenterStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Padding="10,4"
                                            Background="{StaticResource PosCustomerDisplayAccentSurfaceBrush}"
                                            BorderBrush="{StaticResource PosCustomerDisplayAccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <TextBlock Text="{Binding QuantityDisplay, Mode=OneWay}" Foreground="{StaticResource PosCustomerDisplayAccentBrush}" FontSize="16" FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Loc Price}" Width="116" HeaderStyle="{StaticResource CustomerDisplayHeaderRightStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:C2}}" Foreground="{StaticResource PosCustomerDisplayTextBrush}" Margin="0,0,12,0" FontSize="17" HorizontalAlignment="Stretch" TextAlignment="Right" />
                                        <TextBlock Text="{Binding DiscountRateText}" Foreground="{StaticResource PosCustomerDisplayAccentBrush}" Margin="0,2,12,0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Stretch" TextAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Loc Total}" Width="126" HeaderStyle="{StaticResource CustomerDisplayHeaderRightStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GrossAmount, StringFormat={}{0:C2}}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" Margin="0,0,12,1" FontSize="13" HorizontalAlignment="Stretch" TextAlignment="Right" TextDecorations="Strikethrough">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ActualAmount, StringFormat={}{0:C2}}" Margin="0,0,12,0" FontSize="19" HorizontalAlignment="Stretch" TextAlignment="Right" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource PosCustomerDisplayTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource PosCustomerDisplayAccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border x:Name="PromotionPanel"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="18,0,0,0"
                    Background="{StaticResource PosCustomerDisplaySurfaceBrush}"
                    BorderBrush="{StaticResource PosCustomerDisplayDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    ClipToBounds="True">
                <Grid>
                    <Rectangle Fill="{StaticResource PosCustomerDisplaySurfaceBrush}" />
                    <Rectangle x:Name="PromotionFallbackBackground" Fill="{StaticResource PosCustomerDisplayBackgroundBrush}" />
                    <Image x:Name="AdvertisementImage"
                           Stretch="Uniform"
                           Visibility="Collapsed"
                           ImageFailed="AdvertisementImage_ImageFailed" />
                    <MediaElement x:Name="AdvertisementVideo"
                                  Stretch="Uniform"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual"
                                  IsMuted="True"
                                  Volume="0"
                                  Visibility="Collapsed"
                                  MediaEnded="AdvertisementVideo_MediaEnded"
                                  MediaFailed="AdvertisementVideo_MediaFailed" />
                    <Rectangle Opacity="0.18" Fill="#FF000000" />
                    <StackPanel x:Name="PromotionTextPanel" Margin="48,44">
                        <Border Background="#CC09111F"
                                BorderBrush="{StaticResource PosCustomerDisplayAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,5"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{loc:Loc customer.promotionTitle}" Foreground="{StaticResource PosCustomerDisplayAccentBrush}" FontSize="12" FontWeight="Black" />
                        </Border>
                        <TextBlock x:Name="PromotionSubtitleText"
                                   Text="{Binding CurrentAdvertisementTitle}"
                                   Margin="0,18,0,8"
                                   Foreground="{StaticResource PosCustomerDisplayTextBrush}"
                                   FontSize="34"
                                   FontWeight="Black"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="PromotionBodyText"
                                   Text="{Binding CurrentAdvertisementDescription}"
                                   Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="PromotionFallbackSubtitleText"
                                   Text="{loc:Loc customer.promotionSubtitle}"
                                   Margin="0,18,0,8"
                                   Foreground="{StaticResource PosCustomerDisplayTextBrush}"
                                   FontSize="34"
                                   FontWeight="Black"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="PromotionFallbackBodyText"
                                   Text="{loc:Loc customer.promotionBody}"
                                   Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}"
                                   FontSize="16"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,28,28"
                            Background="#B309111F"
                            BorderBrush="{StaticResource PosCustomerDisplayDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Monitor" Width="22" Height="22" Foreground="{StaticResource PosCustomerDisplayTextBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding TerminalName}" Foreground="{StaticResource PosCustomerDisplayTextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="SummaryPanel"
                Grid.Row="1"
                Margin="0,20,0,0"
                Padding="24,16"
                Background="{StaticResource PosCustomerDisplaySurfaceBrush}"
                BorderBrush="{StaticResource PosCustomerDisplayDividerBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc customer.itemQuantity}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalItemQuantity, StringFormat={}{0:0.##}}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="15" Margin="8,0,0,0" />
                        <TextBlock Grid.Column="3" Text="{loc:Loc customer.skuCount}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{Binding SkuCount}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="15" Margin="8,0,0,0" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc Subtotal}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <Viewbox MaxHeight="38" StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Subtotal, StringFormat={}{0:C2}}" Foreground="{StaticResource PosCustomerDisplayTextBrush}" FontSize="28" FontWeight="Black" />
                            </Viewbox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc Tax}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <Viewbox MaxHeight="38" StretchDirection="DownOnly">
                                <TextBlock Text="{Binding TaxAmount, StringFormat={}{0:C2}}" Foreground="{StaticResource PosCustomerDisplayTextBrush}" FontSize="28" FontWeight="Black" />
                            </Viewbox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSavings}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{loc:Loc Savings}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <Viewbox MaxHeight="38" StretchDirection="DownOnly">
                                <TextBlock Text="{Binding SavingsAmount, StringFormat=-{0:C2}}" Foreground="{StaticResource PosCustomerDisplayTextBrush}" FontSize="28" FontWeight="Black" />
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc customer.totalToPay}" Foreground="{StaticResource PosCustomerDisplayTextBrush}" FontSize="16" FontWeight="Black" HorizontalAlignment="Right" />
                    <Viewbox MaxWidth="200" MaxHeight="68" HorizontalAlignment="Right" StretchDirection="DownOnly">
                        <TextBlock Text="{Binding TotalToPay, StringFormat={}{0:C2}}" Foreground="{StaticResource PosCustomerDisplayAmountBrush}" FontSize="62" FontWeight="Black" />
                    </Viewbox>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{StaticResource PosCustomerDisplayAccentSurfaceBrush}"
                        BorderBrush="{StaticResource PosCustomerDisplayAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc customer.readyForPayment}" Foreground="{StaticResource PosCustomerDisplayAccentBrush}" FontSize="18" FontWeight="Black" />
                        <TextBlock Text="{loc:Loc customer.insertOrTap}" Foreground="{StaticResource PosCustomerDisplayTextBrush}" FontSize="15" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            </Border>
        </Grid>
        </Grid>
    </Viewbox>
</UserControl>
