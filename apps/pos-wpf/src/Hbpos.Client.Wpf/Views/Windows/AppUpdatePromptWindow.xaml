<Window x:Class="Hbpos.Client.Wpf.Views.Windows.AppUpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
        xmlns:services="clr-namespace:Hbpos.Client.Wpf.Services"
        Title="{loc:Loc appUpdate.prompt.title}"
        Width="1200"
        Height="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource PosFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="AppUpdatePromptWindow_Loaded"
        AutomationProperties.Name="{loc:Loc appUpdate.prompt.title}">
    <Window.Resources>
        <DataTemplate x:Key="AppUpdateReleaseNoteTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="CheckCircle"
                                         Width="18"
                                         Height="18"
                                         Margin="0,1,10,0"
                                         Foreground="{DynamicResource PosPrimaryTextBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding}"
                           FontSize="14"
                           Foreground="{DynamicResource PosTextBrush}"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- 与主窗口同尺寸，缩放规则也与主窗口一致，小屏上弹窗卡片与收银界面等比缩小。 -->
    <Grid x:Name="ModalOverlay"
          services:AdaptiveUiScale.IsEnabled="True"
          Background="#6B0F172A">
        <Border x:Name="AppUpdateDialogCard"
                MaxWidth="900"
                MaxHeight="640"
                Margin="32,24"
                Padding="28"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Background="{DynamicResource PosSurfaceBrush}"
                BorderBrush="{DynamicResource PosBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                KeyboardNavigation.TabNavigation="Cycle"
                AutomationProperties.AutomationId="AppUpdatePromptCard">
            <Border.Effect>
                <DropShadowEffect Color="#FF1E3A5F"
                                  BlurRadius="28"
                                  ShadowDepth="4"
                                  Opacity="0.24" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="52"
                            Height="52"
                            Margin="0,0,16,0"
                            Background="{DynamicResource PosPrimarySoftBrush}"
                            CornerRadius="10">
                        <materialDesign:PackIcon Kind="Update"
                                                 Width="30"
                                                 Height="30"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PosPrimaryTextBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc appUpdate.prompt.title}"
                                   FontSize="24"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosTextBrush}" />
                        <TextBlock Text="{loc:Loc appUpdate.optional.prompt.description}"
                                   Margin="0,4,0,0"
                                   FontSize="15"
                                   Foreground="{DynamicResource PosMutedForegroundBrush}" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Padding="12,6"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PosSuccessSoftBrush}"
                            BorderBrush="{DynamicResource PosSuccessBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBlock Text="{loc:Loc appUpdate.optional.prompt.readyStatus}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PosSuccessTextBrush}" />
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,22,0,0"
                        Padding="20,14"
                        Background="{DynamicResource PosSurfaceAltBrush}"
                        BorderBrush="{DynamicResource PosBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{loc:Loc appUpdate.optional.prompt.currentVersion}"
                                       FontSize="13"
                                       Foreground="{DynamicResource PosMutedForegroundBrush}" />
                            <TextBlock Text="{Binding CurrentVersion}"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="26"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosTextBrush}" />
                        </StackPanel>

                        <materialDesign:PackIcon Grid.Column="1"
                                                 Kind="ArrowRight"
                                                 Width="30"
                                                 Height="30"
                                                 Margin="30,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PosMutedForegroundBrush}" />

                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{loc:Loc appUpdate.optional.prompt.newVersion}"
                                       FontSize="13"
                                       Foreground="{DynamicResource PosPrimaryTextBrush}" />
                            <TextBlock Text="{Binding TargetVersion}"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="26"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosPrimaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2"
                            Margin="0,12,0,0"
                            Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircleOutline"
                                             Width="18"
                                             Height="18"
                                             Margin="0,0,8,0"
                                             Foreground="{DynamicResource PosSuccessTextBrush}" />
                    <TextBlock Text="{loc:Loc appUpdate.optional.prompt.packageDownloaded}"
                               FontSize="13"
                               Foreground="{DynamicResource PosMutedForegroundBrush}" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Margin="0,18,0,10"
                           Text="{loc:Loc appUpdate.optional.prompt.whatsNew}"
                           FontSize="16"
                           FontWeight="Black"
                           Foreground="{DynamicResource PosTextBrush}" />

                <Grid Grid.Row="4"
                      MinHeight="72">
                    <ScrollViewer MaxHeight="150"
                                  Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ReleaseNotes}"
                                      ItemTemplate="{StaticResource AppUpdateReleaseNoteTemplate}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasReleaseNotes}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{loc:Loc appUpdate.optional.prompt.noReleaseNotes}"
                               FontSize="14"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasReleaseNotes}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Border Grid.Row="5"
                        Margin="0,14,0,0"
                        Padding="14,12"
                        Background="{DynamicResource PosPrimarySoftBrush}"
                        BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="InformationOutline"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 Foreground="{DynamicResource PosPrimaryTextBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc appUpdate.optional.prompt.safety}"
                                   FontSize="13"
                                   Foreground="{DynamicResource PosPrimaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Grid.Row="6"
                        Margin="0,16,0,0"
                        Padding="0,18,0,0"
                        BorderBrush="{DynamicResource PosDividerBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 中文注释：窄窗口下提示列会被按钮挤到接近 0 宽并逐字换行；限高后按钮行不会被撑出卡片。 -->
                        <TextBlock MaxWidth="360"
                                   MaxHeight="48"
                                   VerticalAlignment="Center"
                                   Text="{loc:Loc appUpdate.optional.prompt.settingsHint}"
                                   FontSize="12"
                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button x:Name="InstallLaterButton"
                                    MinWidth="132"
                                    Height="48"
                                    IsDefault="True"
                                    IsCancel="True"
                                    Click="InstallLaterButton_Click"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    AutomationProperties.Name="{loc:Loc appUpdate.optional.prompt.installLater}">
                                <TextBlock Text="{loc:Loc appUpdate.optional.prompt.installLater}"
                                           FontWeight="Bold" />
                            </Button>

                            <Button x:Name="RestartAndInstallButton"
                                    MinWidth="196"
                                    Height="48"
                                    Margin="12,0,0,0"
                                    Click="RestartAndInstallButton_Click"
                                    Style="{StaticResource PosPrimaryButtonStyle}"
                                    AutomationProperties.Name="{loc:Loc appUpdate.optional.prompt.restartAndInstall}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Update"
                                                             Width="18"
                                                             Height="18"
                                                             Margin="0,0,8,0"
                                                             Foreground="White" />
                                    <TextBlock Text="{loc:Loc appUpdate.optional.prompt.restartAndInstall}"
                                               FontWeight="Bold"
                                               Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
