<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
                    xmlns:services="clr-namespace:Hbpos.Client.Wpf.Services"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 收银主界面的颜色都在 Themes/Palettes/*.xaml 色板中，按主题整体替换；本文件只能用 DynamicResource 引用它们。 -->

    <!-- 客显使用独立深色调色板，不随收银主界面的配色主题切换。 -->
    <Color x:Key="PosCustomerDisplayColorBackground">#FF09111F</Color>
    <Color x:Key="PosCustomerDisplayColorSurface">#FF101B2D</Color>
    <Color x:Key="PosCustomerDisplayColorText">#FFFFFFFF</Color>
    <Color x:Key="PosCustomerDisplayColorMutedText">#A3FFFFFF</Color>
    <Color x:Key="PosCustomerDisplayColorAccent">#FF69E3C2</Color>
    <Color x:Key="PosCustomerDisplayColorAmount">#FFFFC73D</Color>
    <Color x:Key="PosCustomerDisplayColorDivider">#1FFFFFFF</Color>
    <Color x:Key="PosCustomerDisplayColorAccentSurface">#1F69E3C2</Color>

    <SolidColorBrush x:Key="PosCustomerDisplayBackgroundBrush" Color="{StaticResource PosCustomerDisplayColorBackground}" />
    <SolidColorBrush x:Key="PosCustomerDisplaySurfaceBrush" Color="{StaticResource PosCustomerDisplayColorSurface}" />
    <SolidColorBrush x:Key="PosCustomerDisplayTextBrush" Color="{StaticResource PosCustomerDisplayColorText}" />
    <SolidColorBrush x:Key="PosCustomerDisplayMutedTextBrush" Color="{StaticResource PosCustomerDisplayColorMutedText}" />
    <SolidColorBrush x:Key="PosCustomerDisplayAccentBrush" Color="{StaticResource PosCustomerDisplayColorAccent}" />
    <SolidColorBrush x:Key="PosCustomerDisplayAmountBrush" Color="{StaticResource PosCustomerDisplayColorAmount}" />
    <SolidColorBrush x:Key="PosCustomerDisplayDividerBrush" Color="{StaticResource PosCustomerDisplayColorDivider}" />
    <SolidColorBrush x:Key="PosCustomerDisplayAccentSurfaceBrush" Color="{StaticResource PosCustomerDisplayColorAccentSurface}" />

    <FontFamily x:Key="PosFontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="PosFontSizeBody">14</sys:Double>
    <sys:Double x:Key="PosFontSizeButton">16</sys:Double>
    <sys:Double x:Key="PosFontSizeSmall">12</sys:Double>
    <sys:Double x:Key="PosFontSizeTitle">22</sys:Double>
    <sys:Double x:Key="PosFontSizeAmount">32</sys:Double>

    <converters:ReceiptQrCodeImageSourceConverter x:Key="ReceiptQrCodeImageSourceConverter" />

    <!-- 页面与弹窗的显式滚动区域统一使用像素级触屏惯性；纵向区域复用边界回弹反馈。 -->
    <Style x:Key="PosVerticalTouchScrollViewerStyle"
           TargetType="ScrollViewer"
           BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="PanningMode" Value="VerticalOnly" />
        <Setter Property="PanningDeceleration" Value="0.0008" />
        <Setter Property="PanningRatio" Value="1.0" />
        <Setter Property="CanContentScroll" Value="False" />
        <Setter Property="services:TouchScrollFeedback.IsEnabled" Value="True" />
    </Style>

    <!-- 横向结果条只接管横向手势，避免纵向回弹干扰所在页面的手势方向。 -->
    <Style x:Key="PosHorizontalTouchScrollViewerStyle"
           TargetType="ScrollViewer"
           BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="PanningMode" Value="HorizontalOnly" />
        <Setter Property="PanningDeceleration" Value="0.0008" />
        <Setter Property="PanningRatio" Value="1.0" />
        <Setter Property="CanContentScroll" Value="False" />
    </Style>

    <DataTemplate x:Key="ReceiptPreviewRowTemplate">
        <StackPanel>
            <Image Width="260"
                   Height="260"
                   Margin="0,0,0,3"
                   HorizontalAlignment="Center"
                   Source="{Binding QrCodeValue, Converter={StaticResource ReceiptQrCodeImageSourceConverter}}"
                   Stretch="None"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   IsHitTestVisible="False">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQrCode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="Source" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            <TextBlock Text="{Binding Text}"
                       Margin="0,0,0,3"
                       FontFamily="Consolas"
                       FontSize="11"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Left" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCentered}" Value="True">
                                <Setter Property="TextAlignment" Value="Center" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRightAligned}" Value="True">
                                <Setter Property="TextAlignment" Value="Right" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEmphasized}" Value="True">
                                <Setter Property="FontWeight" Value="Black" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMachineCode}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource PosFontSizeBody}" />
    </Style>

    <!-- 日期框沿用原样式，只把文字改为主题正文色；系统默认黑字在深色主题下看不见。 -->
    <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
        <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
    </Style>

    <!-- 上面的全局 TextBlock 样式会把按钮里的文字也固定成 14，按钮样式里的 FontSize 传不到文字。
         按钮样式在 Style.Resources（显式 TextBlock 子元素）和模板 ContentPresenter.Resources（字符串内容）里
         基于本样式声明隐式 TextBlock 样式，让按钮文字跟随所在按钮的字号；按钮外的正文仍是 14。 -->
    <Style x:Key="PosButtonContentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize"
                Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ButtonBase}, FallbackValue={StaticResource PosFontSizeBody}}" />
    </Style>

    <Style x:Key="PosTitleTextBlock" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource PosFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PosCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="PosPillBaseStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PosStatusPillStyle" TargetType="Border" BasedOn="{StaticResource PosPillBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}" />
    </Style>

    <Style x:Key="PosWarningPillStyle" TargetType="Border" BasedOn="{StaticResource PosPillBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PosWarningSoftBrush}" />
    </Style>

    <Style x:Key="PosPriceSourceBadgeStyle" TargetType="Border" BasedOn="{StaticResource PosPillBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style x:Key="PosButtonBaseStyle" TargetType="Button">
        <Style.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource PosButtonContentTextStyle}" />
        </Style.Resources>
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PosFontSizeButton}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <!-- 纯文字按钮会生成 TextBlock 并套用全局正文色；这里跟随按钮字号，文字色改为跟随按钮前景色（主按钮白字）。 -->
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PosButtonContentTextStyle}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.04" />
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.04" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PosPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PosButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PosPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="PosBlueGradientButtonStyle" TargetType="Button" BasedOn="{StaticResource PosButtonBaseStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource PosPrimaryGradientBrush}" />
    </Style>

    <Style x:Key="PosSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PosButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PosPrimaryDarkBrush}" />
    </Style>

    <Style x:Key="PosSearchSegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource PosButtonBaseStyle}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="PosDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource PosDangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBrush}" />
    </Style>

    <Style x:Key="PosNumberButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.04" />
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.04" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PosActionTileButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
        <Setter Property="Margin" Value="6" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PosPaymentMethodButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- 本样式不继承 MaterialDesign，系统默认模板会把文字和光标设成黑色；深色主题下必须显式跟随色板。 -->
    <Style x:Key="PosSearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PosTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PosAmountTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PosSearchTextBoxStyle}">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PosSearchResultListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PosCartDataGridStyle" TargetType="DataGrid">
        <!-- 所有 POS 表格统一支持纵向触屏拖动；嵌套表格可在局部关闭并把手势交给外层滚动容器。 -->
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
        <Setter Property="ScrollViewer.PanningDeceleration" Value="0.0008" />
        <Setter Property="ScrollViewer.PanningRatio" Value="1.0" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="services:TouchScrollFeedback.IsEnabled" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
        <Setter Property="RowHeight" Value="44" />
        <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PosFontSizeBody}" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                    <Setter Property="FontSize" Value="{StaticResource PosFontSizeSmall}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceStrongBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PosShellNavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PosIconTileButtonStyle" TargetType="Button" BasedOn="{StaticResource PosButtonBaseStyle}">
        <Setter Property="MinHeight" Value="78" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.14" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PosQuickAmountButtonStyle" TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource PosAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PosAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Black" />
    </Style>

    <Style x:Key="PosSyncBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PosScreenBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
