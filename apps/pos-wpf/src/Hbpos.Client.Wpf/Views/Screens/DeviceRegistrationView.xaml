<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.DeviceRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Hbpos.Client.Wpf.Views.Controls"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource PosScreenBackgroundBrush}">
        <ScrollViewer x:Name="RegistrationScrollViewer"
                      Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="{Binding ElementName=RegistrationScrollViewer, Path=ViewportHeight}">
                <Border Width="620"
                        Margin="24"
                        Background="{DynamicResource PosSurfaceBrush}"
                        BorderBrush="{DynamicResource PosDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12" />
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <Image Width="42"
                            Height="42"
                            Margin="0,0,12,0"
                            Source="pack://application:,,,/Resources/AppBrandIcon.png"
                            Stretch="Uniform"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"
                            IsHitTestVisible="False"
                            AutomationProperties.Name="{loc:Loc AppName}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding TitleText}"
                                   FontSize="22"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosTextBrush}" />
                        <TextBlock Text="{loc:Loc AppName}"
                                   FontSize="12"
                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <controls:ApiServerSettingsPanel DataContext="{Binding ApiServerSettings}"
                                                 IsEnabled="{Binding CanEditServerSettings}"
                                                 Margin="0,0,0,18" />

                <StackPanel Visibility="{Binding IsActivationCodeMode, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource PosPrimarySoftBrush}"
                            BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12,10"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="BarcodeScan"
                                                     Width="18"
                                                     Height="18"
                                                     Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                     VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1"
                                       Text="{loc:Loc deviceActivation.description}"
                                       FontSize="12"
                                       Foreground="{DynamicResource PosTextBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{loc:Loc deviceActivation.code}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding ActivationCode, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="DeviceActivationCodeInput"
                             IsReadOnly="{Binding IsActivationRecoveryPending}"
                             CharacterCasing="Upper"
                             MaxLength="128"
                             Height="46"
                             FontSize="16"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,14">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding PreviewActivationCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Border Visibility="{Binding HasActivationPreview, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource PosSuccessSoftBrush}"
                            BorderBrush="{DynamicResource PosSuccessBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14,12"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="StoreCheck"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="{DynamicResource PosSuccessTextBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Loc deviceActivation.targetStore}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PosSuccessTextBrush}" />
                                <TextBlock Text="{Binding StoreTransitionDisplay}"
                                           FontSize="17"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           Margin="0,3,0,0" />
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           Margin="0,4,0,0">
                                    <Run Text="{loc:Loc deviceActivation.platform}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding PreviewDeviceSystem}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{loc:Loc deviceActivation.expiresAt}" />
                                    <Run Text=": " />
                                    <Run Text="{Binding PreviewExpiryText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border MinHeight="42"
                            Background="{DynamicResource PosWarningSoftBrush}"
                            BorderBrush="{DynamicResource PosWarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource PosWarningTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding PreviewActivationCommand}"
                                Height="46"
                                Style="{StaticResource PosSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="MagnifyScan" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ActivationPreviewButtonText}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding ConfirmActivationCommand}"
                                Height="46"
                                Style="{StaticResource PosPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Foreground="White" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ActivationConfirmButtonText}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                Height="46"
                                Style="{StaticResource PosSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Loc shell.backToPos}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="{Binding IsLegacyPendingRegistration, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc deviceRegistration.store}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding Stores}"
                              SelectedItem="{Binding SelectedStore, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Height="42"
                              FontSize="15"
                              Margin="0,0,0,16" />
                    <TextBlock Text="{loc:Loc deviceRegistration.deviceCode}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding DeviceCode}"
                             IsReadOnly="True"
                             Height="42"
                             FontSize="14"
                             Margin="0,0,0,12" />
                    <Border MinHeight="42"
                            Background="{DynamicResource PosWarningSoftBrush}"
                            BorderBrush="{DynamicResource PosWarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource PosWarningTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <Button Command="{Binding VerifyCommand}"
                            Height="46"
                            Style="{StaticResource PosPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Sync" Width="18" Height="18" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Loc deviceRegistration.verify}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
