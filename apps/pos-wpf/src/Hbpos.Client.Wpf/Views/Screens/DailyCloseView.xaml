<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.DailyCloseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:Hbpos.Client.Wpf.Services"
             mc:Ignorable="d"
             d:DesignHeight="688"
             d:DesignWidth="1366"
             Background="{DynamicResource PosSurfaceAltBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:CashDenominationAccentBrushConverter x:Key="CashDenominationAccentBrush" />
        <converters:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringHasValueToVis" />
        <converters:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringIsEmptyToVis" Invert="True" />

        <Style x:Key="SettlementCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="1"
                                      Opacity="0.08"
                                      Color="#FF101828" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettlementLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="SettlementTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="SettlementValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="DenominationBadgeStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CashDenominationButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeypadButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimarySoftStrongBrush}" />
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CashDenominationItemTemplate">
            <Button Command="{Binding DataContext.OpenCashCountDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Label}"
                    Style="{StaticResource CashDenominationButtonStyle}">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource DenominationBadgeStyle}"
                            Background="{Binding Value, Converter={StaticResource CashDenominationAccentBrush}, ConverterParameter=Background}"
                            BorderBrush="{Binding Value, Converter={StaticResource CashDenominationAccentBrush}, ConverterParameter=BorderBrush}">
                        <TextBlock Text="{Binding Label}"
                                   Foreground="{Binding Value, Converter={StaticResource CashDenominationAccentBrush}, ConverterParameter=Foreground}"
                                   FontSize="14"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc dailyClose.quantityShort}"
                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Count}"
                                   Margin="5,0,0,0"
                                   Foreground="{DynamicResource PosTextBrush}"
                                   FontSize="14"
                                   FontWeight="Black" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Subtotal, StringFormat={}{0:C2}}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource PosTextBrush}"
                               FontSize="14"
                               FontWeight="Black" />
                    <materialDesign:PackIcon Grid.Column="3"
                                             Kind="ChevronRight"
                                             Width="18"
                                             Height="18"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Right"
                                             Foreground="{DynamicResource PosMutedForegroundBrush}" />
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="DailyCloseTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Root"
                                Margin="2,0"
                                Background="{DynamicResource PosSurfaceAltBrush}"
                                BorderBrush="{DynamicResource PosBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimaryBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DailyCloseTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DailyCloseTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border x:Name="DailyCloseToolbar"
                                    Grid.Row="0"
                                    Background="{DynamicResource PosSurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource PosDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10">
                                <Grid x:Name="DailyCloseToolbarLayout">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            FontSize="14"
                                            Command="{Binding ReturnToPosCommand}"
                                            Height="36"
                                            VerticalAlignment="Center"
                                            Padding="11,0"
                                            Margin="0,0,12,0"
                                            Style="{StaticResource PosSecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0" />
                                            <TextBlock Text="{loc:Loc shell.backToPos}" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,16,0">
                                        <TextBlock Text="{loc:Loc dailyClose.businessDate}" Style="{StaticResource SettlementLabelStyle}" />
                                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    IsEnabled="{Binding CanChangeBusinessDate}"
                                                    Height="34"
                                                    MinWidth="160"
                                                    FontSize="14" />
                                    </StackPanel>

                                    <Grid Grid.Column="2"
                                          VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border x:Name="DailyCloseNavigationTabsBorder"
                                                Grid.Column="0"
                                                MinWidth="308"
                                                Background="{DynamicResource PosSurfaceBrush}"
                                                BorderBrush="{DynamicResource PosBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="2">
                                            <TabPanel IsItemsHost="True"
                                                      KeyboardNavigation.TabIndex="1"
                                                      Background="Transparent" />
                                        </Border>

                                        <!-- 工具栏与标签页同处一行，1080 宽时放不下全局 16 号按钮字，这一行的按钮（含左侧返回收银）保持 14。 -->
                                        <Button x:Name="DailyCloseRefreshHistoryButton"
                                                FontSize="14"
                                                Grid.Column="2"
                                                Command="{Binding LoadHistoryCommand}"
                                                Height="36"
                                                MinWidth="118"
                                                Margin="12,0,10,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHistoryTabSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Sync" Width="16" Height="16" Margin="0,0,6,0" Foreground="White" />
                                                <TextBlock Text="{loc:Loc dailyClose.refreshHistory}" Foreground="White" FontWeight="Bold" />
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="DailyCloseCreateDraftButton"
                                                FontSize="14"
                                                Grid.Column="3"
                                                Command="{Binding CreateOrResumeDailyCloseCommand}"
                                                Height="36"
                                                MinWidth="170">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsHistoryTabSelected}" Value="True" />
                                                                <Condition Binding="{Binding HasDailyCloseDraft}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="PlusCircleOutline" Width="16" Height="16" Margin="0,0,6,0" Foreground="White" />
                                                <TextBlock Text="{loc:Loc dailyClose.createNew}" Foreground="White" FontWeight="Bold" />
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="DailyCloseContinueDraftButton"
                                                FontSize="14"
                                                Grid.Column="3"
                                                Command="{Binding CreateOrResumeDailyCloseCommand}"
                                                Height="36"
                                                MinWidth="170"
                                                Padding="8,8">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsHistoryTabSelected}" Value="True" />
                                                                <Condition Binding="{Binding HasDailyCloseDraft}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" Margin="0,0,6,0" Foreground="White" />
                                                <TextBlock Text="{loc:Loc dailyClose.continueDraft}" Foreground="White" FontWeight="Bold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              Margin="0,10,0,0"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettlementDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource PosCartDataGridStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeight" Value="44" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <TabControl x:Name="DailyCloseTabControl"
                    Margin="20"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Style="{StaticResource DailyCloseTabControlStyle}">
            <TabItem Header="{loc:Loc dailyClose.tab.history}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettlementCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc dailyClose.history.title}" Style="{StaticResource SettlementTitleStyle}" />
                                    <TextBlock Text="{Binding BusinessDateText}"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding LoadHistoryCommand}"
                                        Height="42"
                                        MinWidth="132"
                                        Style="{StaticResource PosPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Sync" Width="17" Height="17" Margin="0,0,7,0" Foreground="White" />
                                        <TextBlock Text="{loc:Loc dailyClose.history.load}" Foreground="White" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding Archives}"
                                      SelectedItem="{Binding SelectedArchive, Mode=TwoWay}"
                                      Style="{StaticResource SettlementDataGridStyle}"
                                      RowHeight="52">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Time}" Binding="{Binding ClosedAtDisplay}" Width="150" />
                                    <DataGridTextColumn Header="{loc:Loc Cashier}" Binding="{Binding OperatorName}" Width="*" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.cashCounted}" Binding="{Binding CountedCashAmount, StringFormat={}{0:C2}}" Width="120" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.cashDifference}" Binding="{Binding CashDifference, StringFormat={}{0:C2}}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.05*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="0.95*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SettlementCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Loc dailyClose.receiptPreview}" Style="{StaticResource SettlementTitleStyle}" />
                                <ScrollViewer Grid.Row="1"
                                              Margin="0,12,0,0"
                                              Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ArchivePreviewRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           Margin="0,0,0,3"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Left" />
                                                            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCentered}" Value="True">
                                                                    <Setter Property="TextAlignment" Value="Center" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRightAligned}" Value="True">
                                                                    <Setter Property="TextAlignment" Value="Right" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsEmphasized}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Black" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource SettlementCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Loc dailyClose.cashDetail}" Style="{StaticResource SettlementTitleStyle}" />
                                <ScrollViewer Grid.Row="1"
                                              Margin="0,12,0,0"
                                              Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="False"
                                              PanningMode="VerticalOnly"
                                              PanningDeceleration="0.0008"
                                              PanningRatio="1.0"
                                              services:TouchScrollFeedback.IsEnabled="True">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc dailyClose.notes}" Style="{StaticResource SettlementLabelStyle}" />
                                        <DataGrid ItemsSource="{Binding SelectedArchiveNoteCounts}"
                                                  Margin="0,6,0,0"
                                                  Style="{StaticResource SettlementDataGridStyle}"
                                                  ScrollViewer.PanningMode="None"
                                                  services:TouchScrollFeedback.IsEnabled="False"
                                                  RowHeight="36">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Loc dailyClose.denomination}" Binding="{Binding Label}" Width="*" />
                                                <DataGridTextColumn Header="{loc:Loc dailyClose.quantity}" Binding="{Binding Quantity}" Width="70" />
                                                <DataGridTextColumn Header="{loc:Loc dailyClose.subtotal}" Binding="{Binding Amount, StringFormat={}{0:C2}}" Width="96" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Text="{loc:Loc dailyClose.coins}" Margin="0,14,0,6" Style="{StaticResource SettlementLabelStyle}" />
                                        <DataGrid ItemsSource="{Binding SelectedArchiveCoinCounts}"
                                                  Style="{StaticResource SettlementDataGridStyle}"
                                                  ScrollViewer.PanningMode="None"
                                                  services:TouchScrollFeedback.IsEnabled="False"
                                                  RowHeight="36">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Loc dailyClose.denomination}" Binding="{Binding Label}" Width="*" />
                                                <DataGridTextColumn Header="{loc:Loc dailyClose.quantity}" Binding="{Binding Quantity}" Width="70" />
                                                <DataGridTextColumn Header="{loc:Loc dailyClose.subtotal}" Binding="{Binding Amount, StringFormat={}{0:C2}}" Width="96" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Button Grid.Row="3"
                                Command="{Binding ReprintSelectedArchiveCommand}"
                                Height="50"
                                Margin="0,14,0,0"
                                Style="{StaticResource PosPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                <TextBlock Text="{loc:Loc dailyClose.reprint}" Foreground="White" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{loc:Loc dailyClose.linklySettlement.tab}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.12*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="0.88*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettlementCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc dailyClose.linklySettlement.title}" Style="{StaticResource SettlementTitleStyle}" />
                                    <TextBlock Text="{loc:Loc dailyClose.linklySettlement.hint}"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding LoadSettlementHistoryCommand}"
                                        Height="42"
                                        MinWidth="104"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource PosSecondaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Sync" Width="17" Height="17" Margin="0,0,7,0" />
                                        <TextBlock Text="{loc:Loc dailyClose.linklySettlement.refresh}" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding SettleAndPrintCommand}"
                                        Height="42"
                                        MinWidth="142"
                                        Style="{StaticResource PosPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Printer" Width="17" Height="17" Margin="0,0,7,0" Foreground="White" />
                                        <TextBlock Text="{loc:Loc dailyClose.linklySettlement.settleAndPrint}" Foreground="White" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding Settlements}"
                                      SelectedItem="{Binding SelectedSettlement, Mode=TwoWay}"
                                      Style="{StaticResource SettlementDataGridStyle}"
                                      RowHeight="52">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.time}" Binding="{Binding RequestedAtDisplay}" Width="145" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.mode}" Binding="{Binding ConnectionMode}" Width="120" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.result}" Binding="{Binding Status}" Width="88" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.submission}" Binding="{Binding ProviderSubmissionState}" Width="104" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.receipt}" Binding="{Binding ReceiptTexts.Count}" Width="58" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.printCount}" Binding="{Binding PrintCount}" Width="78" />
                                    <DataGridTextColumn Header="{loc:Loc dailyClose.linklySettlement.response}" Binding="{Binding ResponseText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource SettlementCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Loc dailyClose.linklySettlement.preview}" Style="{StaticResource SettlementTitleStyle}" />
                                <ScrollViewer Grid.Row="1"
                                              Margin="0,12,0,0"
                                              Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SettlementReceiptPreviewLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Margin="0,0,0,3"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PosTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,14,0,0"
                                Padding="12"
                                Background="{DynamicResource PosWarningSoftBrush}"
                                BorderBrush="{DynamicResource PosWarningBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding IsSettlementManualResolutionVisible, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="{loc:Loc dailyClose.linklySettlement.manual.automationName}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.title}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PosWarningTextBrush}" />
                                <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.hint}"
                                           Margin="0,3,0,8"
                                           FontSize="11"
                                           Foreground="{DynamicResource PosTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Command="{Binding PrepareSettlementManualResolutionCommand}"
                                            CommandParameter="{x:Static services:LocalLinklySettlementManualResolution.ConfirmedSucceeded}"
                                            MinHeight="32"
                                            Margin="0,0,6,6"
                                            Padding="10,4"
                                            IsTabStop="True"
                                            ToolTip="{loc:Loc dailyClose.linklySettlement.manual.keyboardHint}"
                                            AutomationProperties.Name="{loc:Loc dailyClose.linklySettlement.manual.succeeded}"
                                            Style="{StaticResource PosSecondaryButtonStyle}">
                                        <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.succeeded}" />
                                    </Button>
                                    <Button Command="{Binding PrepareSettlementManualResolutionCommand}"
                                            CommandParameter="{x:Static services:LocalLinklySettlementManualResolution.ConfirmedFailed}"
                                            MinHeight="32"
                                            Margin="0,0,6,6"
                                            Padding="10,4"
                                            IsTabStop="True"
                                            ToolTip="{loc:Loc dailyClose.linklySettlement.manual.keyboardHint}"
                                            AutomationProperties.Name="{loc:Loc dailyClose.linklySettlement.manual.failed}"
                                            Style="{StaticResource PosSecondaryButtonStyle}">
                                        <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.failed}" />
                                    </Button>
                                    <Button Command="{Binding PrepareSettlementManualResolutionCommand}"
                                            CommandParameter="{x:Static services:LocalLinklySettlementManualResolution.ConfirmedNotSubmitted}"
                                            MinHeight="32"
                                            Margin="0,0,6,6"
                                            Padding="10,4"
                                            IsTabStop="True"
                                            ToolTip="{loc:Loc dailyClose.linklySettlement.manual.keyboardHint}"
                                            AutomationProperties.Name="{loc:Loc dailyClose.linklySettlement.manual.notSubmitted}"
                                            Style="{StaticResource PosSecondaryButtonStyle}">
                                        <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.notSubmitted}" />
                                    </Button>
                                </WrapPanel>
                                <Border Margin="0,4,0,0"
                                        Padding="9"
                                        Background="{DynamicResource PosWarningSoftBrush}"
                                        BorderBrush="{DynamicResource PosWarningBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Visibility="{Binding IsSettlementManualResolutionConfirmationVisible, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SettlementManualResolutionPrompt}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Command="{Binding ConfirmSettlementManualResolutionCommand}"
                                                    MinHeight="32"
                                                    Padding="10,4"
                                                    IsTabStop="True"
                                                    ToolTip="{loc:Loc dailyClose.linklySettlement.manual.keyboardHint}"
                                                    AutomationProperties.Name="{loc:Loc dailyClose.linklySettlement.manual.confirm}"
                                                    Style="{StaticResource PosPrimaryButtonStyle}">
                                                <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.confirm}" Foreground="White" />
                                            </Button>
                                            <Button Command="{Binding CancelSettlementManualResolutionCommand}"
                                                    MinHeight="32"
                                                    Margin="8,0,0,0"
                                                    Padding="10,4"
                                                    IsTabStop="True"
                                                    ToolTip="{loc:Loc dailyClose.linklySettlement.manual.keyboardHint}"
                                                    AutomationProperties.Name="{loc:Loc dailyClose.linklySettlement.manual.cancel}"
                                                    Style="{StaticResource PosSecondaryButtonStyle}">
                                                <TextBlock Text="{loc:Loc dailyClose.linklySettlement.manual.cancel}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="2"
                                Command="{Binding ReprintSelectedSettlementCommand}"
                                Height="50"
                                Margin="0,14,0,0"
                                Style="{StaticResource PosPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                <TextBlock Text="{loc:Loc dailyClose.linklySettlement.reprintSelected}" Foreground="White" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid x:Name="DailyCloseCashWorkspaceOverlay"
              Panel.ZIndex="100"
              Background="#660F172A"
              Visibility="{Binding IsCashCountWorkspaceOpen, Converter={StaticResource BoolToVis}}"
              IsVisibleChanged="DailyCloseCashWorkspaceOverlayIsVisibleChanged"
              PreviewKeyDown="DailyCloseCashWorkspaceOverlayPreviewKeyDown"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="None"
              AutomationProperties.AutomationId="DailyCloseCashWorkspace"
              AutomationProperties.Name="{loc:Loc dailyClose.cashWorkspace.automationName}">
            <Border Margin="16"
                    MaxWidth="1600"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32"
                                      ShadowDepth="6"
                                      Opacity="0.24"
                                      Color="#FF101828" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc dailyClose.cashWorkspace.title}"
                                       FontSize="21"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosTextBrush}" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource PosMutedForegroundBrush}">
                                <Run Text="{loc:Loc dailyClose.businessDate}" />
                                <Run Text=": " />
                                <Run Text="{Binding BusinessDateText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CloseCashCountWorkspaceCommand}"
                                Width="42"
                                Height="42"
                                MinWidth="42"
                                MinHeight="42"
                                Padding="0"
                                ToolTip="{loc:Loc dailyClose.cashWorkspace.returnHistory}"
                                AutomationProperties.Name="{loc:Loc dailyClose.cashWorkspace.returnHistory}"
                                Style="{StaticResource PosSecondaryButtonStyle}">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource PosSurfaceStrongBrush}" />

                <Grid x:Name="DailyCloseCashWorkspaceBody"
                      Grid.Row="2"
                      Margin="18,14,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.65*" MinWidth="620" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="0.85*" MinWidth="280" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="0.58*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CashCountPanel"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Style="{StaticResource SettlementCardStyle}"
                                    Padding="18,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc dailyClose.cashCounter}" Style="{StaticResource SettlementTitleStyle}" />
                                        <TextBlock Text="{loc:Loc dailyClose.cashCountHint}"
                                                   Margin="0,3,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="0,12,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{loc:Loc dailyClose.notes}"
                                                       Style="{StaticResource SettlementLabelStyle}"
                                                       FontSize="12" />
                                            <ScrollViewer Grid.Row="1"
                                                          Margin="0,7,0,0"
                                                          Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="NoteDenominationList"
                                                              ItemsSource="{Binding NoteDenominations}"
                                                              ItemTemplate="{StaticResource CashDenominationItemTemplate}" />
                                            </ScrollViewer>
                                        </Grid>

                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{loc:Loc dailyClose.coins}"
                                                       Style="{StaticResource SettlementLabelStyle}"
                                                       FontSize="12" />
                                            <ScrollViewer Grid.Row="1"
                                                          Margin="0,7,0,0"
                                                          Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="CoinDenominationList"
                                                              ItemsSource="{Binding CoinDenominations}"
                                                              ItemTemplate="{StaticResource CashDenominationItemTemplate}" />
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="{DynamicResource PosScreenBackgroundBrush}"
                                                CornerRadius="8"
                                                Padding="12,8">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc dailyClose.noteTotal}" Style="{StaticResource SettlementLabelStyle}" />
                                                <TextBlock Text="{Binding NoteSubtotal, StringFormat={}{0:C2}}" Style="{StaticResource SettlementValueStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource PosScreenBackgroundBrush}"
                                                CornerRadius="8"
                                                Padding="12,8">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc dailyClose.coinTotal}" Style="{StaticResource SettlementLabelStyle}" />
                                                <TextBlock Text="{Binding CoinSubtotal, StringFormat={}{0:C2}}" Style="{StaticResource SettlementValueStyle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4"
                                                Background="{DynamicResource PosPrimarySoftBrush}"
                                                BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,8">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc dailyClose.cashCounted}" Style="{StaticResource SettlementLabelStyle}" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                                <TextBlock Text="{Binding CountedCashAmount, StringFormat={}{0:C2}}" Style="{StaticResource SettlementValueStyle}" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="DailyCloseZReportPanel"
                                Grid.Row="0"
                                Style="{StaticResource SettlementCardStyle}"
                                Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        BorderBrush="{DynamicResource PosBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="18"
                                        Background="{DynamicResource PosSurfaceBrush}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{loc:Loc dailyClose.reportTitle}"
                                                   FontSize="20"
                                                   FontWeight="Black"
                                                   Foreground="{DynamicResource PosTextBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding BusinessDateText}"
                                                   Margin="0,4,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="16,12,16,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="132" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{loc:Loc dailyClose.systemTotals}"
                                               Style="{StaticResource SettlementTitleStyle}"
                                               FontSize="15" />

                                    <DataGrid Grid.Row="2"
                                              ItemsSource="{Binding PaymentSummaries}"
                                              Style="{StaticResource SettlementDataGridStyle}"
                                              RowHeight="28"
                                              FontSize="11"
                                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{loc:Loc dailyClose.method}" Binding="{Binding Label}" Width="*" />
                                            <DataGridTextColumn Header="{loc:Loc dailyClose.sales}" Binding="{Binding SalesAmount, StringFormat={}{0:C2}}" Width="74" />
                                            <DataGridTextColumn Header="{loc:Loc dailyClose.refund}" Binding="{Binding RefundAmount, StringFormat={}{0:C2}}" Width="74" />
                                            <DataGridTextColumn Header="{loc:Loc dailyClose.net}" Binding="{Binding NetAmount, StringFormat={}{0:C2}}" Width="74" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Separator Grid.Row="4" Margin="0,0,0,10" />

                                    <Grid Grid.Row="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="{loc:Loc dailyClose.totalNetSales}" Foreground="{DynamicResource PosTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding NetAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <TextBlock Text="{loc:Loc dailyClose.expectedCash}" Foreground="{DynamicResource PosTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding ExpectedCashAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                        <Grid Grid.Row="2" Margin="0,0,0,8">
                                            <TextBlock Text="{loc:Loc dailyClose.cashCounted}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding CountedCashAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" FontWeight="Black" />
                                        </Grid>
                                        <Grid Grid.Row="3" Margin="0,2,0,10">
                                            <TextBlock Text="{loc:Loc dailyClose.overShort}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding CashDifference, StringFormat={}{0:C2}}" HorizontalAlignment="Right" FontWeight="Black" Foreground="{DynamicResource PosDangerTextBrush}" />
                                        </Grid>
                                        <Grid Grid.Row="4" Margin="0,0,0,8">
                                            <TextBlock Text="{loc:Loc dailyClose.refundAmount}" Foreground="{DynamicResource PosTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding RefundAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Grid.Row="5" Margin="0,0,0,8">
                                            <TextBlock Text="{loc:Loc dailyClose.returnQty}" Foreground="{DynamicResource PosTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding ReturnQuantity}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Grid.Row="6">
                                            <TextBlock Text="{loc:Loc dailyClose.orders}" Foreground="{DynamicResource PosTextSecondaryBrush}" />
                                            <TextBlock Text="{Binding TransactionCount}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>

                    <Border Grid.Row="3" Background="{DynamicResource PosSurfaceStrongBrush}" />

                    <Grid Grid.Row="4" Margin="18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DailyCloseDiscardDraftButton"
                                Grid.Column="0"
                                Command="{Binding RequestDiscardDailyCloseDraftCommand}"
                                Height="44"
                                MinWidth="138"
                                Padding="14,0"
                                AutomationProperties.Name="{loc:Loc dailyClose.cashWorkspace.discard}"
                                Style="{StaticResource PosSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="17" Height="17" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Loc dailyClose.cashWorkspace.discard}" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DailyCloseCashWorkspaceReturnButton"
                                Grid.Column="2"
                                Command="{Binding CloseCashCountWorkspaceCommand}"
                                Height="44"
                                MinWidth="138"
                                Padding="14,0"
                                AutomationProperties.Name="{loc:Loc dailyClose.cashWorkspace.returnHistory}"
                                Style="{StaticResource PosSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowLeft" Width="17" Height="17" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Loc dailyClose.cashWorkspace.returnHistory}" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DailyCloseSaveAndFinalizeButton"
                                Grid.Column="4"
                                Command="{Binding SaveAndPrintCommand}"
                                Height="44"
                                MinWidth="160"
                                Padding="16,0"
                                AutomationProperties.Name="{loc:Loc dailyClose.saveFinalize}"
                                Style="{StaticResource PosPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveCheck" Width="17" Height="17" Margin="0,0,7,0" Foreground="White" />
                                <TextBlock Text="{loc:Loc dailyClose.saveFinalize}" Foreground="White" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>


