<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.SpecialProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:Hbpos.Client.Wpf.Services"
             mc:Ignorable="d"
             d:DesignHeight="672"
             d:DesignWidth="1366"
             Background="{DynamicResource PosScreenBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringHasValueToVis" />

        <!-- 与收银主页保持相同的扁平触控反馈，不引入新的业务状态或动效。 -->
        <Style x:Key="SpecialFlatButtonBaseStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.90" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpecialSidebarActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SpecialFlatButtonBaseStyle}">
            <Setter Property="MinHeight" Value="84" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SpecialSidebarPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SpecialSidebarActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PosPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="SpecialSidebarActionLabelStyle" TargetType="TextBlock">
            <Setter Property="MaxWidth" Value="92" />
            <Setter Property="MaxHeight" Value="30" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <Style x:Key="SpecialTouchIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SpecialFlatButtonBaseStyle}">
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SpecialDangerIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SpecialTouchIconButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
        </Style>

        <Style x:Key="SpecialPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SpecialProductCardStyle" TargetType="Border" BasedOn="{StaticResource SpecialPanelStyle}">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="SpecialProductsWorkspace" Background="{DynamicResource PosSurfaceAltBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84*" MinWidth="760" />
            <ColumnDefinition Width="16*" MinWidth="180" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="ShelfContextPanel"
                    Grid.Row="0"
                    Height="58"
                    Margin="12,10,8,6"
                    Padding="12,7"
                    Style="{StaticResource SpecialPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="5">
                        <materialDesign:PackIcon Kind="StorefrontOutline"
                                                 Width="21"
                                                 Height="21"
                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SubtitleText}"
                               Margin="10,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PosTextBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2"
                            Padding="10,4"
                            Background="{DynamicResource PosSuccessSoftBrush}"
                            BorderBrush="{DynamicResource PosSuccessBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding OnlineStateText}"
                                   FontSize="10"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosSuccessTextBrush}" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="SpecialDownloadProgressPanel"
                    Grid.Row="1"
                    Margin="12,0,8,6"
                    Padding="10,8"
                    Style="{StaticResource SpecialPanelStyle}"
                    Visibility="{Binding IsDownloadProgressVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DownloadProgressText}"
                               Margin="0,0,12,0"
                               FontSize="11"
                               FontWeight="Black"
                               Foreground="{DynamicResource PosTextBrush}"
                               VerticalAlignment="Center" />
                    <ProgressBar Grid.Column="1"
                                 Height="7"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding DownloadProgressValue}"
                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                 Background="{DynamicResource PosPrimarySoftBrush}"
                                 BorderThickness="0"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding DownloadProgressDetailText}"
                               Margin="12,0,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <Border x:Name="SpecialEditSearchPanel"
                    Grid.Row="2"
                    Margin="12,0,8,6"
                    Padding="8"
                    Style="{StaticResource SpecialPanelStyle}"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PosSearchTextBoxStyle}"
                                 Height="44"
                                 FontSize="14"
                                 materialDesign:HintAssist.Hint="{Binding SearchPlaceholderText}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Command="{Binding ClearSearchCommand}"
                                Style="{StaticResource SpecialFlatButtonBaseStyle}"
                                MinHeight="44"
                                MinWidth="76"
                                Margin="7,0,0,0">
                            <TextBlock Text="{Binding ClearSearchText}" FontWeight="Black" />
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource SpecialFlatButtonBaseStyle}"
                                MinHeight="44"
                                MinWidth="104"
                                Margin="7,0,0,0"
                                Background="{DynamicResource PosPrimaryBrush}"
                                BorderBrush="{DynamicResource PosPrimaryBrush}"
                                Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Magnify"
                                                         Width="18"
                                                         Height="18"
                                                         Margin="0,0,6,0"
                                                         Foreground="White"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SearchButtonText}"
                                           Foreground="White"
                                           FontWeight="Black"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Margin="0,7,0,0"
                                Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SearchResultsText}"
                                   Margin="2,0,0,5"
                                   FontSize="10"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      Style="{StaticResource PosHorizontalTouchScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Disabled"
                                      MaxHeight="78">
                            <ListBox ItemsSource="{Binding SearchResults}"
                                     SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.PanningMode="None"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="SearchResultCard"
                                                Width="220"
                                                Height="70"
                                                Margin="0,0,7,0"
                                                Padding="6"
                                                Background="{DynamicResource PosSurfaceBrush}"
                                                BorderBrush="{DynamicResource PosBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="5" ClipToBounds="True">
                                                    <Grid>
                                                        <materialDesign:PackIcon Kind="Image"
                                                                                 Width="20"
                                                                                 Height="20"
                                                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center" />
                                                        <Image converters:ProductThumbnailImageSourceConverter.AsyncIsEnabled="{Binding DataContext.AreThumbnailsEnabled, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                               converters:ProductThumbnailImageSourceConverter.AsyncSourceText="{Binding ProductImage}"
                                                               converters:ProductThumbnailImageSourceConverter.AsyncDecodePixelWidth="72"
                                                               Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="LowQuality" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="7,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="11"
                                                               FontWeight="Black"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="30" />
                                                    <TextBlock Text="{Binding LookupCode}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Command="{Binding DataContext.AddSpecialProductCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SpecialFlatButtonBaseStyle}"
                                                        MinWidth="44"
                                                        MinHeight="44"
                                                        Padding="0"
                                                        Background="{DynamicResource PosPrimaryBrush}"
                                                        BorderBrush="{DynamicResource PosPrimaryBrush}"
                                                        Foreground="White"
                                                        ToolTip="{Binding DataContext.AddText, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" Foreground="White" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter TargetName="SearchResultCard" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                                <Setter TargetName="SearchResultCard" Property="BorderThickness" Value="3,1,1,1" />
                                                <Setter TargetName="SearchResultCard" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="9,0,5,6">
                <Border Visibility="{Binding IsSpecialListEmpty, Converter={StaticResource BoolToVis}}"
                        Margin="3"
                        Padding="24"
                        Style="{StaticResource SpecialPanelStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="StarOutline"
                                                 Width="48"
                                                 Height="48"
                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyText}"
                                   FontSize="16"
                                   FontWeight="Black"
                                   TextAlignment="Center"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="SpecialProductGrid"
                         ItemsSource="{Binding PagedSpecialItems}"
                         SelectedItem="{Binding SelectedSpecialItem, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="4" Columns="5" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="SpecialProductCard" Style="{StaticResource SpecialProductCardStyle}">
                                <Button Command="{Binding DataContext.SpecialItemCardCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource PosSearchSegmentButtonStyle}"
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch">
                                    <Grid Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="64"
                                                Height="64"
                                                Background="{DynamicResource PosPrimarySoftBrush}"
                                                CornerRadius="5"
                                                ClipToBounds="True"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <materialDesign:PackIcon Kind="Image"
                                                                         Width="25"
                                                                         Height="25"
                                                                         Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                                <Image converters:ProductThumbnailImageSourceConverter.AsyncIsEnabled="{Binding DataContext.AreThumbnailsEnabled, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                       converters:ProductThumbnailImageSourceConverter.AsyncSourceText="{Binding ProductImage}"
                                                       converters:ProductThumbnailImageSourceConverter.AsyncDecodePixelWidth="72"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="LowQuality" />
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Column="1" Margin="8,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="Black"
                                                       Foreground="{DynamicResource PosTextBrush}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="38" />
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding ItemNumber}"
                                                           MaxWidth="84"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding LookupCode}"
                                                           Margin="7,0,0,0"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource PosIconBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding RetailPrice, StringFormat={}{0:C2}}"
                                                       Margin="0,4,0,0"
                                                       FontSize="17"
                                                       FontWeight="Black"
                                                       Foreground="{DynamicResource PosAccentBrush}" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="SpecialProductCard" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                    <Setter TargetName="SpecialProductCard" Property="BorderThickness" Value="4,1,1,1" />
                                    <Setter TargetName="SpecialProductCard" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border x:Name="SpecialProductsFooter"
                    Grid.Row="4"
                    Height="58"
                    Margin="12,0,8,10"
                    Padding="10,6"
                    Style="{StaticResource SpecialPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="2,0,12,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding PreviousPageCommand}"
                                Style="{StaticResource SpecialFlatButtonBaseStyle}"
                                MinWidth="112"
                                MinHeight="44"
                                Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding PreviousPageText}" FontWeight="Black" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding PageStatusText}"
                                   MinWidth="128"
                                   Margin="8,0"
                                   FontSize="12"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosTextBrush}"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Button Command="{Binding NextPageCommand}"
                                Style="{StaticResource SpecialFlatButtonBaseStyle}"
                                MinWidth="112"
                                MinHeight="44"
                                Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NextPageText}" FontWeight="Black" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Background="{DynamicResource PosSurfaceAltBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <UniformGrid x:Name="SpecialActionsPanel" Rows="2" Columns="2" Margin="5,7,5,6">
                <Button Command="{Binding BackCommand}" Style="{StaticResource SpecialSidebarActionButtonStyle}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ArrowLeft"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding BackText}" Style="{StaticResource SpecialSidebarActionLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DownloadCommand}"
                        services:ButtonFeedback.Cue="Download"
                        Style="{StaticResource SpecialSidebarPrimaryButtonStyle}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Download"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DownloadText}" Style="{StaticResource SpecialSidebarActionLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ToggleEditModeCommand}" Style="{StaticResource SpecialSidebarActionButtonStyle}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Pencil"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EditModeText}" Style="{StaticResource SpecialSidebarActionLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource SpecialSidebarActionButtonStyle}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Refresh"
                                                 Width="24"
                                                 Height="24"
                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding RefreshText}" Style="{StaticResource SpecialSidebarActionLabelStyle}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Border x:Name="SpecialShelfSummaryPanel"
                    Grid.Row="1"
                    Margin="8,0,8,6"
                    Padding="9,8"
                    Style="{StaticResource SpecialPanelStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="StarOutline"
                                                 Width="18"
                                                 Height="18"
                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                 VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Padding="6,2"
                                Background="{DynamicResource PosSuccessSoftBrush}"
                                BorderBrush="{DynamicResource PosSuccessBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <TextBlock Text="{Binding OnlineStateText}"
                                       FontSize="9"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosSuccessTextBrush}" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding PageStatusText}"
                               Margin="0,7,0,0"
                               FontSize="11"
                               FontWeight="Black"
                               Foreground="{DynamicResource PosTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SubtitleText}"
                               Margin="0,4,0,0"
                               FontSize="9"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="28" />
                </StackPanel>
            </Border>

            <Border x:Name="SpecialEditActionsPanel"
                    Grid.Row="2"
                    Margin="8,0,8,6"
                    Padding="8"
                    Style="{StaticResource SpecialPanelStyle}"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedSpecialItemText}"
                               Margin="2,0,2,5"
                               FontSize="10"
                               FontWeight="Black"
                               Foreground="{DynamicResource PosTextBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="30" />
                    <UniformGrid Rows="1" Columns="3">
                        <Button Command="{Binding MoveUpCommand}"
                                CommandParameter="{Binding SelectedSpecialItem}"
                                Style="{StaticResource SpecialTouchIconButtonStyle}"
                                ToolTip="{Binding MoveUpText}">
                            <materialDesign:PackIcon Kind="ArrowUp" Width="20" Height="20" />
                        </Button>
                        <Button Command="{Binding MoveDownCommand}"
                                CommandParameter="{Binding SelectedSpecialItem}"
                                Style="{StaticResource SpecialTouchIconButtonStyle}"
                                ToolTip="{Binding MoveDownText}">
                            <materialDesign:PackIcon Kind="ArrowDown" Width="20" Height="20" />
                        </Button>
                        <Button Command="{Binding RemoveSpecialProductCommand}"
                                CommandParameter="{Binding SelectedSpecialItem}"
                                services:ButtonFeedback.Cue="Delete"
                                Style="{StaticResource SpecialDangerIconButtonStyle}"
                                ToolTip="{Binding RemoveText}">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" />
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="4"
                    Margin="8,0,8,10"
                    Padding="9,8"
                    Style="{StaticResource SpecialPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="InformationOutline"
                                             Width="18"
                                             Height="18"
                                             Foreground="{DynamicResource PosPrimaryTextBrush}"
                                             VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               Margin="7,0,0,0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="42" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="0"
                Panel.ZIndex="5"
                BorderBrush="{DynamicResource PosDividerBrush}"
                BorderThickness="0,0,1,0"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>
