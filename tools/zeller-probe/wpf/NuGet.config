<?xml version="1.0" encoding="utf-8"?>
<!--
  中文注释：Zeller.* 走 Zeller 私有源，其余包仍走 nuget.org。
  凭据不进仓库：用户名和令牌从环境变量 ZELLER_NUGET_USERNAME / ZELLER_NUGET_TOKEN 读取，
  取值见 Zeller 开发者文档「Payments SDK - .NET」快速入门第 6 步（需登录 developer.myzeller.com）。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="zeller" value="https://zeller.jfrog.io/artifactory/api/nuget/v3/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="zeller">
      <package pattern="Zeller.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <zeller>
      <add key="Username" value="%ZELLER_NUGET_USERNAME%" />
      <add key="ClearTextPassword" value="%ZELLER_NUGET_TOKEN%" />
    </zeller>
  </packageSourceCredentials>
</configuration>
