<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.PosTerminalView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:Hbpos.Client.Wpf.Services"
             xmlns:vm="clr-namespace:Hbpos.Client.Wpf.ViewModels"
             mc:Ignorable="d"
             AutomationProperties.AutomationId="PosTerminalScreen"
             Focusable="True"
             KeyDown="AttendanceQrView_KeyDown"
             d:DesignHeight="672"
             d:DesignWidth="1366"
             Background="{DynamicResource PosScreenBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:AlternationIndexToRowNumberConverter x:Key="RowNumberConverter" />
        <converters:ProductThumbnailImageSourceConverter x:Key="ProductThumbnailImageSourceConverter" DecodePixelWidth="72" />
        <converters:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringHasValueToVis" />
        <converters:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringIsEmptyToVis" Invert="True" />

        <Style x:Key="CartColumnHeaderCenterStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="FontSize" Value="{StaticResource PosFontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CartColumnHeaderRightStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CartColumnHeaderCenterStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <Style x:Key="CartColumnHeaderLeftStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CartColumnHeaderCenterStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="CartDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridRow}">
                        <Grid ClipToBounds="True">
                            <Button x:Name="PART_SwipeDeleteAction"
                                    Width="88"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Background="{DynamicResource PosDangerBrush}"
                                    Foreground="White"
                                    AutomationProperties.Name="{loc:Loc Remove}"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    services:ButtonFeedback.Cue="Delete"
                                    Style="{DynamicResource CartSwipeDeleteButtonStyle}"
                                    ToolTip="{loc:Loc Remove}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="DeleteOutline"
                                                             Width="21"
                                                             Height="21"
                                                             HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{loc:Loc Remove}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="PART_SwipeContent"
                                    Panel.ZIndex="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    ClipToBounds="True"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <Border.RenderTransform>
                                    <TranslateTransform />
                                </Border.RenderTransform>
                                <DataGridCellsPresenter HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="4,0,0,1" />
                </Trigger>
                <DataTrigger Binding="{Binding HasZeroUnitPrice}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReturnLine}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CartDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CartZeroPriceAmountTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasZeroUnitPrice}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReturnLine}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CartSwipeDeleteButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CartSearchClearButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CartQuantityStepButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CartQuantityIncreaseButtonStyle" TargetType="Button" BasedOn="{StaticResource CartQuantityStepButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosSuccessBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" />
        </Style>

        <Style x:Key="CartQuantityDecreaseButtonStyle" TargetType="Button" BasedOn="{StaticResource CartQuantityStepButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
        </Style>

        <Style x:Key="CartTouchScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="22" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <!-- 无需滚动时隐藏轨道，但保留 22px 布局占位，避免购物车列宽跳动。 -->
                <Trigger Property="Maximum" Value="0">
                    <Setter Property="Opacity" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CashierFlatButtonBaseStyle" TargetType="Button">
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource PosButtonContentTextStyle}" />
            </Style.Resources>
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource PosFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosButtonContentTextStyle}" />
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CashierNumberKeyStyle" TargetType="Button" BasedOn="{StaticResource CashierFlatButtonBaseStyle}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CashierClearKeyStyle" TargetType="Button" BasedOn="{StaticResource CashierNumberKeyStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBorderBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="CashierQuickKeyStyle" TargetType="Button" BasedOn="{StaticResource CashierNumberKeyStyle}">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CashierWholeOrderToggleStyle" TargetType="ToggleButton">
            <Style.Resources>
                <!-- 英文 “Whole Order” 在 1080 宽时单行放不下，放大后允许换成两行。 -->
                <Style TargetType="TextBlock" BasedOn="{StaticResource PosButtonContentTextStyle}">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="TextAlignment" Value="Center" />
                </Style>
            </Style.Resources>
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosButtonContentTextStyle}">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="TextAlignment" Value="Center" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CashierFunctionButtonStyle" TargetType="Button" BasedOn="{StaticResource CashierFlatButtonBaseStyle}">
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CashierNoBarcodeButtonStyle" TargetType="Button" BasedOn="{StaticResource CashierFlatButtonBaseStyle}">
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource PosButtonContentTextStyle}" />
            </Style.Resources>
            <Setter Property="Height" Value="50" />
            <Setter Property="Background" Value="{DynamicResource PosPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PosButtonContentTextStyle}" />
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimaryStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimaryDisabledBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimaryDisabledBrush}" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CashierPayButtonStyle" TargetType="Button" BasedOn="{StaticResource CashierFlatButtonBaseStyle}">
            <Setter Property="Height" Value="64" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PosPayButtonGradientBrush}" />
        </Style>

        <Style x:Key="CashierDiscountButtonStyle" TargetType="Button" BasedOn="{StaticResource CashierFlatButtonBaseStyle}">
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 右侧操作区保持五行两列与真实触控边界，视觉改为规范图中的扁平卡片。 -->
        <Style x:Key="PosSidebarActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CashierFlatButtonBaseStyle}">
            <Setter Property="MinHeight" Value="62" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PosSidebarExitButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PosSidebarActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
        </Style>

        <Style x:Key="PosSidebarActionIconHostStyle" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PosSidebarActionLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PosStitchTileLabelStyle}">
            <Setter Property="MaxWidth" Value="88" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PosStatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <ControlTemplate x:Key="PosStatusCardTemplate" TargetType="{x:Type ContentControl}">
            <Border x:Name="StatusCardRoot"
                    Padding="{TemplateBinding Padding}"
                    Style="{StaticResource PosStatusCardStyle}">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding ContentStringFormat}" />
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58*" MinWidth="600" />
            <ColumnDefinition Width="26*" MinWidth="280" />
            <ColumnDefinition Width="16*" MinWidth="180" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{DynamicResource PosSurfaceAltBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="17,16,12,8" Background="{DynamicResource PosSurfaceAltBrush}">
                <Grid Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="SearchBoxHost"
                            Grid.Column="0"
                            Background="{DynamicResource PosSurfaceBrush}"
                            BorderBrush="{DynamicResource PosBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify"
                                                     Width="21"
                                                     Height="21"
                                                     Foreground="{DynamicResource PosIconBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="14,0,0,0" />
                            <TextBox Grid.Column="1"
                                     AutomationProperties.AutomationId="ProductBarcodeInput"
                                     Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="{Binding SearchPlaceholderText}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     VerticalContentAlignment="Center"
                                     Padding="10,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ScanCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2"
                                    Command="{Binding ClearSearchCommand}"
                                    Style="{StaticResource CartSearchClearButtonStyle}"
                                    Visibility="{Binding ScanText, Converter={StaticResource StringHasValueToVis}}"
                                    ToolTip="{loc:Loc Clear}">
                                <materialDesign:PackIcon Kind="CloseCircle" Width="19" Height="19" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource PosPrimaryBrush}" CornerRadius="6" ClipToBounds="True">
                        <Button Command="{Binding ScanCommand}"
                                Style="{StaticResource PosSearchSegmentButtonStyle}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BarcodeScan" Width="17" Height="17" Foreground="White" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding SearchButtonText}" Foreground="White" FontSize="16" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border Grid.Column="4"
                            Background="{DynamicResource PosSurfaceBrush}"
                            BorderBrush="{DynamicResource PosBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Button Command="{Binding ToggleTouchKeyboardCommand}"
                                Style="{StaticResource PosSearchSegmentButtonStyle}"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip="{loc:Loc shell.numpad}">
                            <materialDesign:PackIcon Kind="KeyboardOutline"
                                                     Width="22"
                                                     Height="22"
                                                     Foreground="{DynamicResource PosIconBrush}" />
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <Popup x:Name="MatchesPopup"
                   Grid.Row="0"
                   DataContext="{Binding DataContext, ElementName=SearchBoxHost}"
                   IsOpen="{Binding IsMatchesPopupOpen, Mode=TwoWay}"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=SearchBoxHost}"
                   StaysOpen="False"
                   VerticalOffset="6">
                <Border Width="{Binding PlacementTarget.ActualWidth, ElementName=MatchesPopup}"
                        MaxHeight="260"
                        Background="{DynamicResource PosSurfaceBrush}"
                        BorderBrush="{DynamicResource PosDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" />
                    </Border.Effect>
                    <!-- 使用 WPF 基础触屏惯性属性，兼容 Win7/10/11，避免引入系统版本专属特效。 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  PanningMode="VerticalOnly"
                                  PanningDeceleration="0.0008"
                                  PanningRatio="1.0">
                        <ItemsControl ItemsSource="{Binding Matches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 码冲突时多个候选的码相同，靠商品图与货号区分；图片走与购物车行相同的异步缩略图缓存，不阻塞扫码。 -->
                                    <Button x:Name="MatchCandidateCard"
                                            Width="264"
                                            Height="80"
                                            Margin="0,0,10,10"
                                            Padding="0"
                                            Background="Transparent"
                                             BorderThickness="0"
                                             Style="{StaticResource PosSearchSegmentButtonStyle}"
                                             Command="{Binding DataContext.SelectMatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}">
                                        <Border Background="{DynamicResource PosSurfaceBrush}"
                                                BorderBrush="{DynamicResource PosDividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="56"
                                                        Height="56"
                                                        Background="{DynamicResource PosPrimarySoftBrush}"
                                                        CornerRadius="6"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        SnapsToDevicePixels="True"
                                                        UseLayoutRounding="True"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <Rectangle RadiusX="5"
                                                                   RadiusY="5"
                                                                   Margin="2"
                                                                   SnapsToDevicePixels="True"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Panel.ZIndex="1">
                                                            <Rectangle.Fill>
                                                                <ImageBrush converters:ProductThumbnailImageSourceConverter.AsyncSourceText="{Binding ProductImage}"
                                                                            converters:ProductThumbnailImageSourceConverter.AsyncDecodePixelWidth="80"
                                                                            Stretch="Uniform" />
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                        <materialDesign:PackIcon Kind="Shopping"
                                                                                 Width="22"
                                                                                 Height="22"
                                                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Panel.ZIndex="0" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Black" TextTrimming="CharacterEllipsis" />
                                                    <DockPanel Margin="0,3,0,0" LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Left" Text="{loc:Loc ItemNumber}" FontSize="10" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                                        <TextBlock DockPanel.Dock="Left" Text=":" FontSize="10" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                                        <Grid Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding ItemNumber}"
                                                                       Visibility="{Binding ItemNumber, Converter={StaticResource StringHasValueToVis}}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="-"
                                                                       Visibility="{Binding ItemNumber, Converter={StaticResource StringIsEmptyToVis}}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                                        </Grid>
                                                    </DockPanel>
                                                    <DockPanel Margin="0,3,0,0" LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding RetailPrice, StringFormat={}{0:C2}}"
                                                                   FontSize="15"
                                                                   FontWeight="Black"
                                                                   Foreground="{DynamicResource PosAccentBrush}"
                                                                   VerticalAlignment="Bottom"
                                                                   Margin="8,0,0,0" />
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Text="{Binding LookupCode}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding PriceSourceLabel}"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="6,0,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Popup>

            <Popup x:Name="TouchKeyboardPopup"
                   Grid.Row="0"
                   DataContext="{Binding DataContext, ElementName=SearchBoxHost}"
                   IsOpen="{Binding IsTouchKeyboardOpen, Mode=TwoWay}"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=SearchBoxHost}"
                   StaysOpen="False"
                   VerticalOffset="6">
                <Grid Width="620" Background="Transparent">
                    <Border Background="{DynamicResource PosSurfaceBrush}"
                            BorderBrush="{DynamicResource PosDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            ClipToBounds="True"
                            Padding="10">
                        <StackPanel>
                        <UniformGrid Columns="11">
                            <Button Content="1" Command="{Binding NumberInputCommand}" CommandParameter="1" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="2" Command="{Binding NumberInputCommand}" CommandParameter="2" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="3" Command="{Binding NumberInputCommand}" CommandParameter="3" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="4" Command="{Binding NumberInputCommand}" CommandParameter="4" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="5" Command="{Binding NumberInputCommand}" CommandParameter="5" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="6" Command="{Binding NumberInputCommand}" CommandParameter="6" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="7" Command="{Binding NumberInputCommand}" CommandParameter="7" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="8" Command="{Binding NumberInputCommand}" CommandParameter="8" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="9" Command="{Binding NumberInputCommand}" CommandParameter="9" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="0" Command="{Binding NumberInputCommand}" CommandParameter="0" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="{loc:Loc Backspace}" Command="{Binding NumberInputCommand}" CommandParameter="Back" Style="{StaticResource PosStitchClearNumberButtonStyle}" />
                        </UniformGrid>
                        <UniformGrid Columns="10">
                            <Button Content="Q" Command="{Binding NumberInputCommand}" CommandParameter="Q" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="W" Command="{Binding NumberInputCommand}" CommandParameter="W" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="E" Command="{Binding NumberInputCommand}" CommandParameter="E" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="R" Command="{Binding NumberInputCommand}" CommandParameter="R" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="T" Command="{Binding NumberInputCommand}" CommandParameter="T" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="Y" Command="{Binding NumberInputCommand}" CommandParameter="Y" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="U" Command="{Binding NumberInputCommand}" CommandParameter="U" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="I" Command="{Binding NumberInputCommand}" CommandParameter="I" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="O" Command="{Binding NumberInputCommand}" CommandParameter="O" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="P" Command="{Binding NumberInputCommand}" CommandParameter="P" Style="{StaticResource PosStitchNumberButtonStyle}" />
                        </UniformGrid>
                        <UniformGrid Columns="9" Margin="18,0">
                            <Button Content="A" Command="{Binding NumberInputCommand}" CommandParameter="A" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="S" Command="{Binding NumberInputCommand}" CommandParameter="S" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="D" Command="{Binding NumberInputCommand}" CommandParameter="D" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="F" Command="{Binding NumberInputCommand}" CommandParameter="F" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="G" Command="{Binding NumberInputCommand}" CommandParameter="G" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="H" Command="{Binding NumberInputCommand}" CommandParameter="H" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="J" Command="{Binding NumberInputCommand}" CommandParameter="J" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="K" Command="{Binding NumberInputCommand}" CommandParameter="K" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="L" Command="{Binding NumberInputCommand}" CommandParameter="L" Style="{StaticResource PosStitchNumberButtonStyle}" />
                        </UniformGrid>
                        <UniformGrid Columns="7" Margin="48,0">
                            <Button Content="Z" Command="{Binding NumberInputCommand}" CommandParameter="Z" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="X" Command="{Binding NumberInputCommand}" CommandParameter="X" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="C" Command="{Binding NumberInputCommand}" CommandParameter="C" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="V" Command="{Binding NumberInputCommand}" CommandParameter="V" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="B" Command="{Binding NumberInputCommand}" CommandParameter="B" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="N" Command="{Binding NumberInputCommand}" CommandParameter="N" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Content="M" Command="{Binding NumberInputCommand}" CommandParameter="M" Style="{StaticResource PosStitchNumberButtonStyle}" />
                        </UniformGrid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{loc:Loc Clear}" Command="{Binding NumberInputCommand}" CommandParameter="Clear" Style="{StaticResource PosStitchClearNumberButtonStyle}" />
                            <Button Grid.Column="1" Content="{loc:Loc common.space}" Command="{Binding NumberInputCommand}" CommandParameter="Space" Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Grid.Column="2" Content="." Command="{Binding NumberInputCommand}" CommandParameter="." Style="{StaticResource PosStitchNumberButtonStyle}" />
                            <Button Grid.Column="3" Content="{Binding SearchButtonText}" Command="{Binding NumberInputCommand}" CommandParameter="Enter" Style="{StaticResource PosStitchQuickButtonStyle}" />
                        </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Popup>

            <Border Grid.Row="1"
                    Margin="17,0,10,10"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <!-- 购物车列表使用像素级触屏滚动，保持 Win7/10/11 可用的 WPF 基础属性。 -->
                <DataGrid ItemsSource="{Binding CartLines}"
                          AutomationProperties.AutomationId="CartItemsGrid"
                          SelectedItem="{Binding SelectedCartLine, Mode=TwoWay}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="CartDataGrid_SelectionChanged"
                          IsReadOnly="True"
                          AlternationCount="1000000"
                          AlternatingRowBackground="{DynamicResource PosSurfaceAltBrush}"
                          RowBackground="{DynamicResource PosSurfaceBrush}"
                          MinRowHeight="67"
                          ColumnHeaderHeight="36"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.PanningMode="VerticalFirst"
                          ScrollViewer.PanningDeceleration="0.0008"
                          ScrollViewer.PanningRatio="1.0"
                          services:CartSwipeRevealBehavior.IsEnabled="True"
                          GridLinesVisibility="None"
                          Background="{DynamicResource PosSurfaceBrush}"
                          BorderThickness="0"
                          RowStyle="{StaticResource CartDataGridRowStyle}"
                          CellStyle="{StaticResource CartDataGridCellStyle}"
                          Style="{StaticResource PosCartDataGridStyle}">
                    <DataGrid.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CartTouchScrollBarStyle}" />
                        <Style TargetType="{x:Type Thumb}">
                            <Setter Property="MinHeight" Value="52" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border Background="{DynamicResource PosBorderStrongBrush}"
                                                BorderBrush="{DynamicResource PosBorderStrongBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Margin="4" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="#" Width="44" HeaderStyle="{StaticResource CartColumnHeaderCenterStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource RowNumberConverter}}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc Item}" Width="2.6*" HeaderStyle="{StaticResource CartColumnHeaderLeftStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="52"
                                                Height="52"
                                                Background="{DynamicResource PosPrimarySoftBrush}"
                                                CornerRadius="6"
                                                Margin="0,0,12,0"
                                                SnapsToDevicePixels="True"
                                                UseLayoutRounding="True"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Rectangle RadiusX="5"
                                                           RadiusY="5"
                                                           Margin="2"
                                                           SnapsToDevicePixels="True"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Panel.ZIndex="1">
                                                    <Rectangle.Fill>
                                                        <ImageBrush converters:ProductThumbnailImageSourceConverter.AsyncSourceText="{Binding ProductImage}"
                                                                    converters:ProductThumbnailImageSourceConverter.AsyncDecodePixelWidth="72"
                                                                    Stretch="Uniform" />
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <materialDesign:PackIcon Kind="Shopping"
                                                                         Width="22"
                                                                         Height="22"
                                                                         Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Panel.ZIndex="0" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Black" TextTrimming="CharacterEllipsis" />
                                            <StackPanel x:Name="CartItemMetadataLine" Margin="0,2,0,0" Orientation="Horizontal">
                                                <TextBlock Text="{loc:Loc ItemNumber}" FontSize="11" Foreground="{DynamicResource PosIconBrush}" />
                                                <TextBlock Text=":" FontSize="11" Foreground="{DynamicResource PosIconBrush}" />
                                                <Grid Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding ItemNumber}"
                                                               ToolTip="{Binding ItemNumber}"
                                                               Visibility="{Binding ItemNumber, Converter={StaticResource StringHasValueToVis}}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource PosIconBrush}"
                                                               TextWrapping="NoWrap" />
                                                    <TextBlock Text="-"
                                                               Visibility="{Binding ItemNumber, Converter={StaticResource StringIsEmptyToVis}}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource PosIconBrush}" />
                                                </Grid>
                                                <Grid Margin="14,0,0,0">
                                                    <TextBlock Text="{Binding LookupCode}"
                                                               ToolTip="{Binding LookupCode}"
                                                               Visibility="{Binding LookupCode, Converter={StaticResource StringHasValueToVis}}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource PosIconBrush}"
                                                               TextWrapping="NoWrap" />
                                                    <TextBlock Text="-"
                                                               Visibility="{Binding LookupCode, Converter={StaticResource StringIsEmptyToVis}}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource PosIconBrush}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc UnitPrice}" Width="0.8*" HeaderStyle="{StaticResource CartColumnHeaderRightStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,6,10,6">
                                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:C2}}" Style="{StaticResource CartZeroPriceAmountTextStyle}" FontSize="13" FontWeight="Black" TextAlignment="Right" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="{Binding DiscountRateText}"
                                                   Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}"
                                                   FontSize="10"
                                                   FontWeight="Black"
                                                   Foreground="{DynamicResource PosAccentBrush}"
                                                   TextAlignment="Right"
                                                   HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc Quantity}" Width="1.35*" MinWidth="122" HeaderStyle="{StaticResource CartColumnHeaderCenterStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Command="{Binding DataContext.DecreaseLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CartQuantityDecreaseButtonStyle}"
                                                ToolTip="{loc:Loc pos.terminal.actions.qtyMinus}">
                                            <materialDesign:PackIcon Kind="Minus" Width="18" Height="18" />
                                        </Button>
                                        <Border Grid.Column="1"
                                                Width="50"
                                                Height="32"
                                                Background="{DynamicResource PosSurfaceBrush}"
                                                BorderBrush="{DynamicResource PosBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <TextBlock AutomationProperties.AutomationId="CartLineQuantity"
                                                       Text="{Binding SignedQuantity, StringFormat={}{0:0.##}}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Button Grid.Column="2"
                                                AutomationProperties.AutomationId="CartLineIncreaseButton"
                                                Command="{Binding DataContext.IncreaseLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CartQuantityIncreaseButtonStyle}"
                                                ToolTip="{loc:Loc pos.terminal.actions.qtyPlus}">
                                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc Total}" Width="0.9*" HeaderStyle="{StaticResource CartColumnHeaderRightStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,6,10,6">
                                        <TextBlock Text="{Binding GrossAmount, StringFormat={}{0:C2}}" Style="{StaticResource CartZeroPriceAmountTextStyle}" FontSize="13" FontWeight="Black" TextAlignment="Right" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="{Binding ActualAmount, StringFormat={}{0:C2}}"
                                                   Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}"
                                                   FontSize="10"
                                                   FontWeight="Black"
                                                   Foreground="{DynamicResource PosAccentBrush}"
                                                   TextAlignment="Right"
                                                   HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 结账完成后在购物车区域显示上一单结果；扫码或加入商品后由 VM 收起。与购物车同行叠放，不包裹购物车 DataGrid。 -->
            <Border x:Name="PaymentSuccessCard"
                    Grid.Row="1"
                    Panel.ZIndex="3"
                    MaxWidth="540"
                    Margin="37,44,30,30"
                    Padding="20,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosSuccessBrush}"
                    BorderThickness="2"
                    CornerRadius="12"
                    AutomationProperties.AutomationId="PaymentSuccessCard"
                    Visibility="{Binding IsLastSaleVisible, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.16" />
                </Border.Effect>
                <Grid DataContext="{Binding LastSale}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="{DynamicResource PosSuccessSoftBrush}"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Check"
                                                     Width="24"
                                                     Height="24"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource PosSuccessTextBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc PaymentSuccessful}"
                                       FontSize="20"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosSuccessTextBrush}" />
                            <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                <TextBlock Text="{Binding TransactionIdDisplay}"
                                           AutomationProperties.AutomationId="CompletedTransactionId"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                <TextBlock Text="  ·  " FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                <TextBlock Text="{Binding SoldAtDisplay}" FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Width="40"
                                Height="40"
                                VerticalAlignment="Top"
                                Command="{Binding DataContext.DismissLastSaleCommand, ElementName=PaymentSuccessCard}"
                                Style="{StaticResource PosSearchSegmentButtonStyle}"
                                AutomationProperties.AutomationId="PaymentSuccessCardCloseButton"
                                AutomationProperties.Name="{loc:Loc success.card.close}"
                                ToolTip="{loc:Loc success.card.close}">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        </Button>
                    </Grid>

                    <!-- 现金单并排显示实付、实收与找零；非现金单只显示实付。UniformGrid 不为折叠的子项留位。 -->
                    <UniformGrid Grid.Row="1" Margin="0,14,0,0" Rows="1">
                        <Border Margin="0,0,8,0" Padding="12,8" Background="{DynamicResource PosSurfaceAltBrush}" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc success.totalPaid}" FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                <TextBlock Text="{Binding TotalAmountPaidDisplay}"
                                           AutomationProperties.AutomationId="CompletedSaleTotalPaid"
                                           Margin="0,2,0,0"
                                           FontSize="22"
                                           FontWeight="Black" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0"
                                Padding="12,8"
                                Background="{DynamicResource PosSurfaceAltBrush}"
                                CornerRadius="8"
                                Visibility="{Binding IsCashChangeVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc payment.cash.amountTendered}" FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                <TextBlock Text="{Binding TenderedAmountDisplay}" Margin="0,2,0,0" FontSize="22" FontWeight="Black" />
                            </StackPanel>
                        </Border>
                        <Border Padding="12,8"
                                Background="{DynamicResource PosWarningSoftBrush}"
                                CornerRadius="8"
                                Visibility="{Binding IsCashChangeVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc payment.cash.changeDue}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PosAccentBrush}" />
                                <TextBlock Text="{Binding ChangeAmountDisplay}"
                                           AutomationProperties.AutomationId="CompletedSaleChangeDue"
                                           FontSize="30"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource PosAccentBrush}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Grid.Row="2"
                               Margin="0,10,0,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource PosTextBrush}"
                               Visibility="{Binding IsCardPaymentSummaryVisible, Converter={StaticResource BoolToVis}}">
                        <Run Text="{loc:Loc success.cardDetails}" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        <Run Text=" " />
                        <Run Text="{Binding CardPaymentSummary, Mode=OneWay}" />
                    </TextBlock>

                    <Border Grid.Row="3"
                            Margin="0,10,0,0"
                            Padding="10,8"
                            Background="{DynamicResource PosDangerSoftBrush}"
                            CornerRadius="8"
                            AutomationProperties.AutomationId="PaymentCompletedWarning"
                            Visibility="{Binding HasPostCommitWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Loc payment.status.completedWarning}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource PosDangerTextBrush}" />
                    </Border>

                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="BarcodeScan" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                            <TextBlock Text="{loc:Loc success.card.scanToContinue}"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                MinHeight="40"
                                Padding="14,4"
                                Command="{Binding PrintReceiptCommand}"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                AutomationProperties.AutomationId="PaymentSuccessCardPrintButton">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PrinterOutline" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc success.printReceipt}" VerticalAlignment="Center" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="17,0,12,18" Background="{DynamicResource PosSurfaceAltBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="92" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>
                    <Border x:Name="CartSummaryPanel"
                            Grid.Row="0"
                            Background="{DynamicResource PosSurfaceBrush}"
                            BorderBrush="{DynamicResource PosBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="58" />
                            </Grid.RowDefinitions>

                            <Border x:Name="CartCountSummaryRow"
                                    Grid.Row="0"
                                    Padding="14,0"
                                    BorderBrush="{DynamicResource PosDividerBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc pos.terminal.cart.itemQuantity}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding CartItemQuantity, StringFormat={}{0:0.##}}" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{loc:Loc pos.terminal.cart.skuCount}" Margin="28,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding CartSkuCount}" Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border x:Name="CartTotalsSummaryRow" Grid.Row="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="14,0" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="0,0,1,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Loc Subtotal}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat={}{0:C2}}" FontSize="14" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" Padding="14,0" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="0,0,1,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Loc Discount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PosAccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DiscountAmount, StringFormat={}{0:C2}}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PosAccentBrush}" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Column="2" Margin="14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TotalsLabelText}" FontSize="15" FontWeight="Black" Foreground="{DynamicResource PosTextBrush}" VerticalAlignment="Center" />
                                        <!-- 应付合计高亮底（青瓷为荧光笔底）；默认主题透明，负外边距抵消内边距，位置不变。 -->
                                        <Border Grid.Column="1"
                                                Margin="2,0,-8,0"
                                                Padding="8,0"
                                                VerticalAlignment="Center"
                                                CornerRadius="6"
                                                Background="{DynamicResource PosAmountSoftBrush}">
                                            <TextBlock Text="{Binding ActualAmount, StringFormat={}{0:C2}}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource PosAccentBrush}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Button Grid.Row="2"
                             AutomationProperties.AutomationId="OpenPaymentButton"
                             Command="{Binding OpenPaymentCommand}"
                             services:ButtonFeedback.Cue="Checkout"
                             Style="{StaticResource CashierPayButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cash" Width="26" Height="26" Foreground="White" Margin="0,0,16,0" />
                            <TextBlock Text="{Binding PayNowText}" Foreground="White" FontSize="22" FontWeight="Black" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Background="{DynamicResource PosSurfaceAltBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="InputBufferHost"
                    Grid.Row="0"
                    Height="78"
                    Margin="13,10,13,8"
                    Padding="12,6"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <!-- 输入缓冲区和退格按钮共享同一外框，保持总宽度不超过下方键盘。 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="2"
                               Text="{loc:Loc pos.terminal.inputBuffer}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PosMutedForegroundBrush}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="{Binding KeypadBuffer, TargetNullValue=0}"
                               FontFamily="Consolas"
                               FontSize="34"
                               FontWeight="Black"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button Grid.Row="1"
                            Grid.Column="1"
                            Width="44"
                            Height="44"
                            Margin="8,0,0,0"
                            Background="{DynamicResource PosSurfaceBrush}"
                            BorderBrush="{DynamicResource PosDividerBrush}"
                            Command="{Binding KeypadInputCommand}"
                            CommandParameter="Back"
                            ToolTip="{loc:Loc Backspace}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="RootBorder"
                                        Padding="4"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Border.RenderTransform>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                                        <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource PosDangerBorderBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="RootBorder" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <!-- 红色退格图标用于提示这是逐位删除，不是清空整个缓冲区。 -->
                        <materialDesign:PackIcon Kind="BackspaceOutline" Width="22" Height="22" Foreground="{DynamicResource PosDangerTextBrush}" />
                    </Button>
                </Grid>
            </Border>

            <UniformGrid x:Name="CashierKeypad" Grid.Row="1" Columns="3" Rows="5" Margin="11,0,11,6" VerticalAlignment="Stretch">
                <Button Content="1" Command="{Binding KeypadInputCommand}" CommandParameter="1" Style="{StaticResource CashierNumberKeyStyle}" />
                <Button Content="2" Command="{Binding KeypadInputCommand}" CommandParameter="2" Style="{StaticResource CashierNumberKeyStyle}" />
                <Button Content="3" Command="{Binding KeypadInputCommand}" CommandParameter="3" Style="{StaticResource CashierNumberKeyStyle}" />
                <Button Content="4" Command="{Binding KeypadInputCommand}" CommandParameter="4" Style="{StaticResource CashierNumberKeyStyle}" />
                <Button Content="5" Command="{Binding KeypadInputCommand}" CommandParameter="5" Style="{StaticResource CashierNumberKeyStyle}" />
                <Button Content="6" Command="{Binding KeypadInputCommand}" CommandParameter="6" Style="{StaticResource CashierNumberKeyStyle}" />
                <Button Content="7" Command="{Binding KeypadInputCommand}" CommandParameter="7" Style="{StaticResource CashierNumberKeyStyle}" />
                <Button Content="8" Command="{Binding KeypadInputCommand}" CommandParameter="8" Style="{StaticResource CashierNumberKeyStyle}" />
                <Button Content="9" Command="{Binding KeypadInputCommand}" CommandParameter="9" Style="{StaticResource CashierNumberKeyStyle}" />
                <Button Content="{loc:Loc Clear}" Command="{Binding KeypadInputCommand}" CommandParameter="Clear" Style="{StaticResource CashierClearKeyStyle}" />
                <Button Content="0" Command="{Binding KeypadInputCommand}" CommandParameter="0" Style="{StaticResource CashierNumberKeyStyle}" />
                <Button Content="." Command="{Binding KeypadInputCommand}" CommandParameter="." Style="{StaticResource CashierNumberKeyStyle}" />
                <Button Content="{loc:Loc pos.terminal.quickHalf}" Command="{Binding KeypadInputCommand}" CommandParameter="QuickHalf" Style="{StaticResource CashierQuickKeyStyle}" />
                <Button Content="{loc:Loc pos.terminal.quickNinetyNine}" Command="{Binding KeypadInputCommand}" CommandParameter="QuickNinetyNine" Style="{StaticResource CashierQuickKeyStyle}" />
                <ToggleButton Content="{loc:Loc pos.terminal.actions.wholeOrderToggle}"
                              IsChecked="{Binding IsWholeOrderOperation, Mode=TwoWay}"
                              Style="{StaticResource CashierWholeOrderToggleStyle}" />
            </UniformGrid>

            <Button Grid.Row="2"
                    Command="{Binding AddOpenItemCommand}"
                    Margin="13,0,13,8"
                    Style="{StaticResource CashierNoBarcodeButtonStyle}">
                <TextBlock Text="{loc:Loc pos.terminal.actions.noBarcode}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Button>

            <Grid Grid.Row="3" Margin="9,0,9,0" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="2">
                    <Button Command="{Binding ModifySelectedLineQuantityCommand}"
                            Style="{StaticResource CashierFunctionButtonStyle}">
                        <TextBlock Text="{loc:Loc pos.terminal.actions.modifyQty}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </Button>
                    <Button Command="{Binding ModifySelectedLinePriceCommand}"
                            Style="{StaticResource CashierFunctionButtonStyle}">
                        <TextBlock Text="{loc:Loc Price}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </Button>
                    <Button Command="{Binding ApplySelectedLineDiscountAmountCommand}"
                            Style="{StaticResource CashierFunctionButtonStyle}">
                        <TextBlock Text="{loc:Loc pos.terminal.actions.discountAmount}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </Button>
                    <Button Command="{Binding ApplySelectedLineDiscountPercentCommand}"
                            Style="{StaticResource CashierFunctionButtonStyle}">
                        <TextBlock Text="{loc:Loc pos.terminal.actions.discountPercent}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </Button>
                </UniformGrid>

                <Border x:Name="QuickDiscountSegment"
                        Grid.Row="1"
                        Margin="3,4,3,0"
                        Background="{DynamicResource PosSurfaceBrush}"
                        BorderBrush="{DynamicResource PosBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Border.OpacityMask>
                        <VisualBrush Stretch="Fill">
                            <VisualBrush.Visual>
                                <Border Width="{Binding ActualWidth, ElementName=QuickDiscountSegment}"
                                        Height="{Binding ActualHeight, ElementName=QuickDiscountSegment}"
                                        Background="Black"
                                        CornerRadius="5" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>
                    <UniformGrid Columns="5">
                        <Button Content="10%" Command="{Binding ApplyQuickDiscountPercentCommand}" CommandParameter="10" Style="{StaticResource CashierDiscountButtonStyle}" />
                        <Button Content="20%" Command="{Binding ApplyQuickDiscountPercentCommand}" CommandParameter="20" Style="{StaticResource CashierDiscountButtonStyle}" />
                        <Button Content="30%" Command="{Binding ApplyQuickDiscountPercentCommand}" CommandParameter="30" Style="{StaticResource CashierDiscountButtonStyle}" />
                        <Button Content="40%" Command="{Binding ApplyQuickDiscountPercentCommand}" CommandParameter="40" Style="{StaticResource CashierDiscountButtonStyle}" />
                        <Button Content="50%" Command="{Binding ApplyQuickDiscountPercentCommand}" CommandParameter="50" BorderThickness="0" Style="{StaticResource CashierDiscountButtonStyle}" />
                    </UniformGrid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="AttendanceQrSidebar" Grid.Column="2" Background="{DynamicResource PosSurfaceAltBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 关键逻辑：右侧操作区固定五行两列，避免不同语言下按钮顺序和状态卡位置漂移。 -->
            <UniformGrid Grid.Row="0" Columns="2" Rows="5" Margin="8,13,8,6">
                <Button Command="{Binding OpenSpecialProductsCommand}" Style="{StaticResource PosSidebarActionButtonStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource PosSidebarActionIconHostStyle}">
                            <materialDesign:PackIcon Kind="StarOutline" Width="24" Height="24" Foreground="{DynamicResource PosSidebarIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{loc:Loc pos.terminal.actions.specialItems}" Style="{StaticResource PosSidebarActionLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenReturnsCommand}" Style="{StaticResource PosSidebarActionButtonStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource PosSidebarActionIconHostStyle}">
                            <materialDesign:PackIcon Kind="CashRefund" Width="24" Height="24" Foreground="{DynamicResource PosSidebarRefundIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{loc:Loc Refund}" Style="{StaticResource PosSidebarActionLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding HoldOrderCommand}" Style="{StaticResource PosSidebarActionButtonStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource PosSidebarActionIconHostStyle}">
                            <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="24" Height="24" Foreground="{DynamicResource PosSidebarHoldIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding HoldOrderText}" Style="{StaticResource PosSidebarActionLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RecallOrderCommand}" Style="{StaticResource PosSidebarActionButtonStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource PosSidebarActionIconHostStyle}">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="24" Height="24" Foreground="{DynamicResource PosSidebarIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding RecallOrderText}" Style="{StaticResource PosSidebarActionLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenCashDrawerCommand}" services:ButtonFeedback.Cue="CashDrawer" Style="{StaticResource PosSidebarActionButtonStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource PosSidebarActionIconHostStyle}">
                            <materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24" Foreground="{DynamicResource PosSidebarIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding OpenCashDrawerText}" Style="{StaticResource PosSidebarActionLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding PrintLastReceiptCommand}" Style="{StaticResource PosSidebarActionButtonStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource PosSidebarActionIconHostStyle}">
                            <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="24" Height="24" Foreground="{DynamicResource PosSidebarIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding PrintLastReceiptText}" Style="{StaticResource PosSidebarActionLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding LockCashierCommand}" Style="{StaticResource PosSidebarActionButtonStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource PosSidebarActionIconHostStyle}">
                            <materialDesign:PackIcon Kind="LogoutVariant" Width="24" Height="24" Foreground="{DynamicResource PosSidebarIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding LockCashierText}" Style="{StaticResource PosSidebarActionLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenDailyCloseCommand}" Style="{StaticResource PosSidebarActionButtonStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource PosSidebarActionIconHostStyle}">
                            <materialDesign:PackIcon Kind="CalendarCheckOutline" Width="24" Height="24" Foreground="{DynamicResource PosSidebarIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding DailyCloseText}" Style="{StaticResource PosSidebarActionLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource PosSidebarActionButtonStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource PosSidebarActionIconHostStyle}">
                            <materialDesign:PackIcon Kind="CogOutline" Width="24" Height="24" Foreground="{DynamicResource PosSidebarIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding SettingsText}" Style="{StaticResource PosSidebarActionLabelStyle}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExitApplicationCommand}" Style="{StaticResource PosSidebarExitButtonStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource PosSidebarActionIconHostStyle}">
                            <materialDesign:PackIcon Kind="Power" Width="24" Height="24" Foreground="{DynamicResource PosDangerTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding ExitApplicationText}" Style="{StaticResource PosSidebarActionLabelStyle}" Foreground="{DynamicResource PosDangerTextBrush}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <ContentControl Grid.Row="1"
                            x:Name="PosTerminalStatusCard"
                            Margin="8,0,8,8"
                            Height="154"
                            MaxHeight="154"
                            Padding="9,7"
                            Template="{StaticResource PosStatusCardTemplate}"
                            Tag="{Binding StatusPulseToken, NotifyOnTargetUpdated=True}">
                <Grid x:Name="PosTerminalStatusCardLayout" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc common.status}" FontSize="11" FontWeight="Black" Foreground="{DynamicResource PosTextBrush}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Padding="6,2" Background="{DynamicResource PosSuccessSoftBrush}" BorderBrush="{DynamicResource PosSuccessBorderBrush}" BorderThickness="1" CornerRadius="3">
                            <TextBlock Text="{Binding PendingSyncText}" Foreground="{DynamicResource PosSuccessTextBrush}" FontSize="9" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="PosTerminalStatusMessage"
                               Grid.Row="1"
                               Margin="0,5,0,0"
                               Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold"
                               FontSize="10"
                               VerticalAlignment="Top" />
                    <!-- 入口固定保留；仅在存在待处理卡交易时切换警告样式与数量徽标。 -->
                    <Button x:Name="CardRecoveryCenterEntryButton"
                            Grid.Row="2"
                            Margin="0,10,0,0"
                            MinHeight="44"
                            Padding="10,6"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Command="{Binding OpenCardRecoveryCenterCommand}"
                            AutomationProperties.AutomationId="CardRecoveryCenterEntryButton"
                            AutomationProperties.Name="{Binding CardRecoveryCenterAutomationName}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="Root"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="5"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  RecognizesAccessKey="True"
                                                                  TextBlock.Foreground="{TemplateBinding Foreground}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                                    <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Root" Property="Opacity" Value="0.48" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOpenCardRecoveryAttempts}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PosWarningSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PosWarningBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon x:Name="CardRecoveryCenterStateIcon"
                                                     Width="18"
                                                     Height="18"
                                                     VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="{x:Type materialDesign:PackIcon}">
                                        <Setter Property="Kind" Value="CreditCardSearchOutline" />
                                        <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOpenCardRecoveryAttempts}" Value="True">
                                                <Setter Property="Kind" Value="AlertCircleOutline" />
                                                <Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock x:Name="CardRecoveryCenterTitle"
                                       Grid.Column="1"
                                       Margin="8,0"
                                       Text="{Binding CardRecoveryCenterText}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       VerticalAlignment="Center" />
                            <Border x:Name="CardRecoveryOpenCountBadge"
                                    Grid.Column="2"
                                    MinWidth="22"
                                    Margin="4,0,8,0"
                                    Padding="6,2"
                                    CornerRadius="9"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOpenCardRecoveryAttempts}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Background" Value="{DynamicResource PosWarningStrongBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CardRecoveryOpenCount}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Black"
                                           TextAlignment="Center" />
                            </Border>
                            <materialDesign:PackIcon Grid.Column="3"
                                                     Kind="ChevronRight"
                                                     Width="18"
                                                     Height="18"
                                                     VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="{x:Type materialDesign:PackIcon}">
                                        <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOpenCardRecoveryAttempts}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Grid>
                    </Button>
                </Grid>
            </ContentControl>

            <Button x:Name="AttendanceQrLauncher"
                    Grid.Row="2"
                    Height="62"
                    Margin="8,0,8,16"
                    Padding="8,6"
                    HorizontalContentAlignment="Stretch"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosBorderBrush}"
                    BorderThickness="1"
                    Click="AttendanceQrLauncher_Click"
                    AutomationProperties.Name="{loc:Loc attendance.qr.open}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Qrcode" Width="22" Height="22" Foreground="{DynamicResource PosPrimaryTextBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc attendance.qr.title}" FontSize="11" FontWeight="Black" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="9" Foreground="{DynamicResource PosMutedForegroundBrush}" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding AttendanceQrPanel.VerificationStatusText, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{Binding AttendanceQrPanel.MessageText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding AttendanceQrPanel.SecondsRemaining}" FontSize="14" FontWeight="Black" Foreground="{DynamicResource PosPrimaryTextBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </Grid>

        <Border Grid.Column="0"
                Panel.ZIndex="5"
                BorderBrush="{DynamicResource PosDividerBrush}"
                BorderThickness="0,0,1,0"
                IsHitTestVisible="False" />
        <Border Grid.Column="1"
                Panel.ZIndex="5"
                BorderBrush="{DynamicResource PosDividerBrush}"
                BorderThickness="0,0,1,0"
                IsHitTestVisible="False" />

        <!-- 关键逻辑：弹窗属于纯视图状态，覆盖收银区三列，不扩展业务 ViewModel。 -->
        <Grid x:Name="AttendanceQrOverlay"
              Grid.Column="0"
              Grid.ColumnSpan="3"
              Panel.ZIndex="100"
              Background="#99000000"
              Visibility="Collapsed"
              AutomationProperties.Name="{loc:Loc attendance.qr.title}"
              AutomationProperties.HelpText="{loc:Loc attendance.qr.scanHint}"
              MouseLeftButtonDown="AttendanceQrOverlay_Click">
            <Border x:Name="AttendanceQrDialog"
                    Width="360"
                    Height="430"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    KeyboardNavigation.TabNavigation="Cycle"
                    MouseLeftButtonDown="AttendanceQrDialog_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="260" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc attendance.qr.title}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource PosPrimaryDarkBrush}" />
                            <TextBlock Text="{loc:Loc attendance.qr.scanHint}" FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        </StackPanel>
                        <Button x:Name="AttendanceQrCloseButton" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Click="AttendanceQrCloseButton_Click" AutomationProperties.Name="{loc:Loc attendance.qr.close}" AutomationProperties.HelpText="{loc:Loc attendance.qr.closeHelp}">
                            <materialDesign:PackIcon Kind="Close" Width="24" Height="24" />
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Width="260" Height="260" HorizontalAlignment="Center" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Image Width="260" Height="260" Source="{Binding AttendanceQrPanel.QrImage}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" AutomationProperties.Name="{loc:Loc attendance.qr.title}" />
                            <TextBlock Text="{Binding AttendanceQrPanel.MessageText}" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource PosMutedForegroundBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AttendanceQrPanel.QrImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding AttendanceQrPanel.StoreText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}">
                                <Run Text="{loc:Loc attendance.qr.device}" />
                                <Run Text=": " />
                                <Run Text="{Binding AttendanceQrPanel.DeviceText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding AttendanceQrPanel.VerificationStatusText}" Margin="0,3,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSuccessTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding AttendanceQrPanel.SecondsRemaining}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource PosPrimaryTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc attendance.qr.seconds}" FontSize="10" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
