<Window x:Class="Hbpos.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Hbpos.Client.Wpf.Views.Controls"
        xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:Hbpos.Client.Wpf.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Hbpos.Client.Wpf.Views.Screens"
        xmlns:rootViews="clr-namespace:Hbpos.Client.Wpf.Views"
        xmlns:vm="clr-namespace:Hbpos.Client.Wpf.ViewModels"
        mc:Ignorable="d"
        AutomationProperties.AutomationId="PosMainWindow"
        Title="HB POS"
        Width="1366"
        Height="768"
        MinWidth="960"
        MinHeight="540"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource PosFontFamily}"
        Foreground="{DynamicResource PosTextBrush}"
        Background="{DynamicResource PosScreenBackgroundBrush}">
    <!-- 窗口前景色跟随色板：未单独着色的图标继承它，否则深色主题下会落回系统黑色。 -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:LocalizationKeyConverter x:Key="LocalizationKeyConverter" />
        <converters:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringHasValueToVis" />

        <!-- 标题栏配色按钮：打开时不参与命中测试，再点一次即视为点击外部，由 Popup 自行关闭。 -->
        <Style x:Key="ColorThemeToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorThemeOptionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomerDisplayModeIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <DataTrigger Binding="{Binding CustomerDisplayWindowMode}" Value="{x:Static services:CustomerDisplayWindowMode.Closed}">
                                <Setter TargetName="Root" Property="Background" Value="Transparent" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource PosTextSecondaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CustomerDisplayWindowMode}" Value="{x:Static services:CustomerDisplayWindowMode.Normal}">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CustomerDisplayWindowMode}" Value="{x:Static services:CustomerDisplayWindowMode.Fullscreen}">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSuccessSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosSuccessBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderUtilityButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderMetadataTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="HeaderDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceStrongBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FooterDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceStrongBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FooterTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate DataType="{x:Type vm:PosTerminalViewModel}">
            <views:PosTerminalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SpecialProductsViewModel}">
            <views:SpecialProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReceiptReturnsViewModel}">
            <views:ReceiptReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PaymentViewModel}">
            <views:PaymentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CardRecoveryCenterViewModel}">
            <rootViews:CardRecoveryCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallmentCenterViewModel}">
            <views:InstallmentCenterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallmentCreateViewModel}">
            <views:InstallmentCreateView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransactionHistoryViewModel}">
            <views:TransactionHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DailyCloseViewModel}">
            <views:DailyCloseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerDisplayViewModel}">
            <views:CustomerDisplayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceRegistrationViewModel}">
            <views:DeviceRegistrationView />
        </DataTemplate>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ConfirmationDialog.CancelCommand}" />
    </Window.InputBindings>

    <!-- 窗口小于 1280×720（如 1024×768 屏）时整体等比缩小，页面仍按设计基准排版；窗口最小尺寸 = 基准 × 0.75。 -->
    <Grid services:AdaptiveUiScale.IsEnabled="True"
          Background="{DynamicResource PosScreenBackgroundBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="IsEnabled" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsApiServerSwitching}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Opacity" Value="0.72" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PosSurfaceBrush}"
                BorderBrush="{DynamicResource PosDividerBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <controls:TitleBarLayoutPanel Margin="16,0,8,0">
                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center" Panel.ZIndex="2">
                    <Image Width="32"
                           Height="32"
                           Margin="0,0,10,0"
                           Source="pack://application:,,,/Resources/AppBrandIcon.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           IsHitTestVisible="False"
                           AutomationProperties.AutomationId="HeaderBrandMark"
                           AutomationProperties.Name="{loc:Loc AppName}" />
                    <TextBlock Text="{loc:Loc AppName}"
                               FontWeight="Black"
                               FontSize="17"
                               Foreground="{DynamicResource PosTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding ActivePageTitleText}"
                           FontSize="21"
                           FontWeight="Black"
                           Foreground="{DynamicResource PosTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Panel.ZIndex="1" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center" Panel.ZIndex="2">
                    <Button Command="{Binding ToggleCustomerDisplayWindowCommand}"
                            Style="{StaticResource CustomerDisplayModeIconButtonStyle}"
                            ToolTip="{loc:Loc shell.customerDisplayWindow}">
                        <materialDesign:PackIcon Width="17" Height="17">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="MonitorOff" />
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CustomerDisplayWindowMode}" Value="{x:Static services:CustomerDisplayWindowMode.Normal}">
                                            <Setter Property="Kind" Value="Monitor" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CustomerDisplayWindowMode}" Value="{x:Static services:CustomerDisplayWindowMode.Fullscreen}">
                                            <Setter Property="Kind" Value="Fullscreen" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </Button>
                    <!-- 配色切换：DataContext 在 MainWindow 构造时设为 ColorThemeSwitcherViewModel。 -->
                    <Grid x:Name="ColorThemeSwitcher" Margin="2,0,0,0" VerticalAlignment="Center">
                        <ToggleButton x:Name="ColorThemeToggle"
                                      IsChecked="{Binding IsMenuOpen, Mode=TwoWay}"
                                      Style="{StaticResource ColorThemeToggleButtonStyle}"
                                      ToolTip="{loc:Loc shell.colorTheme}"
                                      AutomationProperties.AutomationId="ColorThemeToggle"
                                      AutomationProperties.Name="{loc:Loc shell.colorTheme}">
                            <materialDesign:PackIcon Kind="PaletteOutline"
                                                     Width="18"
                                                     Height="18"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsMenuOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=ColorThemeToggle}"
                               Placement="Bottom"
                               VerticalOffset="6"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Width="252"
                                    Margin="0,0,14,14"
                                    Padding="8"
                                    Background="{DynamicResource PosSurfaceBrush}"
                                    BorderBrush="{DynamicResource PosBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    AutomationProperties.AutomationId="ColorThemeMenu">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF101828" Opacity="0.18" BlurRadius="18" ShadowDepth="4" Direction="270" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{Binding MenuTitle}"
                                               Margin="10,4,10,8"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                    <ItemsControl ItemsSource="{Binding Options}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Theme}"
                                                        Style="{StaticResource ColorThemeOptionButtonStyle}"
                                                        AutomationProperties.Name="{Binding Name}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ItemsControl ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Ellipse Width="16"
                                                                             Height="16"
                                                                             Margin="0,0,-4,0"
                                                                             Fill="{Binding}"
                                                                             Stroke="{DynamicResource PosSurfaceBrush}"
                                                                             StrokeThickness="2" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PosTextBrush}" />
                                                            <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                                        </StackPanel>
                                                        <materialDesign:PackIcon Grid.Column="2"
                                                                                 Kind="Check"
                                                                                 Width="18"
                                                                                 Height="18"
                                                                                 VerticalAlignment="Center"
                                                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                                 Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Border Style="{StaticResource HeaderDividerStyle}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="StorefrontOutline" Width="17" Height="17" Foreground="{DynamicResource PosPrimaryTextBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StoreInfo}"
                                   AutomationProperties.AutomationId="CurrentStoreInfo"
                                   Style="{StaticResource HeaderMetadataTextStyle}"
                                   MaxWidth="132" />
                    </StackPanel>
                    <Border Style="{StaticResource HeaderDividerStyle}" />
                    <TextBlock Text="{Binding CashierInfo}"
                               AutomationProperties.AutomationId="CurrentCashierInfo"
                               Style="{StaticResource HeaderMetadataTextStyle}"
                               MaxWidth="132" />
                    <Border Style="{StaticResource HeaderDividerStyle}" />
                    <Button Content="{loc:Loc shell.languageToggle}"
                            Command="{Binding ToggleCultureCommand}"
                            Width="64"
                            Style="{StaticResource HeaderUtilityButtonStyle}"
                            ToolTip="{loc:Loc Language}" />
                    <Border Style="{StaticResource HeaderDividerStyle}" Margin="5,0" />
                    <Button Command="{Binding ResetScannerBindingCommand}"
                            Width="84"
                            Style="{StaticResource HeaderUtilityButtonStyle}"
                            ToolTip="{loc:Loc shell.scannerBinding.resetTooltip}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="BarcodeScan" Width="17" Height="17" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Loc shell.scannerBinding}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="MinimizeButton_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="{loc:Loc shell.window.minimize}">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" />
                    </Button>
                    <Button Click="MaximizeButton_Click"
                            Style="{StaticResource TitleBarButtonStyle}"
                            ToolTip="{loc:Loc shell.window.maximize}"
                            Margin="0">
                        <materialDesign:PackIcon Kind="WindowMaximize" Width="16" Height="16" />
                    </Button>
                    <Button Command="{Binding ExitApplicationCommand}"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            ToolTip="{loc:Loc shell.window.close}"
                            Margin="0">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                    </Button>
                </StackPanel>
            </controls:TitleBarLayoutPanel>
        </Border>

        <Grid Grid.Row="1">
            <ContentControl Content="{Binding CachedPosTerminalScreen}">
                <ContentControl.Style>
                    <Style TargetType="{x:Type ContentControl}">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPosTerminalScreenActive}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <ContentControl Content="{Binding CachedSpecialProductsScreen}">
                <ContentControl.Style>
                    <Style TargetType="{x:Type ContentControl}">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSpecialProductsScreenActive}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <ContentControl Content="{Binding CachedCashPaymentScreen}">
                <ContentControl.Style>
                    <Style TargetType="{x:Type ContentControl}">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCashPaymentScreenActive}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <!-- 设置与历史 VM 本身已缓存；固定宿主确保辅助技术持续连接时也只创建一个页面实例。 -->
            <ContentControl Content="{Binding CachedTransactionHistoryScreen}">
                <ContentControl.Style>
                    <Style TargetType="{x:Type ContentControl}">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTransactionHistoryScreenActive}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <ContentControl Content="{Binding CachedSettingsScreen}">
                <ContentControl.Style>
                    <Style TargetType="{x:Type ContentControl}">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsScreenActive}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <ContentControl>
                <ContentControl.Style>
                    <Style TargetType="{x:Type ContentControl}">
                        <Setter Property="Content" Value="{x:Null}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFallbackScreenActive}" Value="True">
                                <Setter Property="Content" Value="{Binding CurrentScreen}" />
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <Border Visibility="{Binding IsSyncCenterExpanded, Converter={StaticResource BoolToVis}}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Margin="16"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Panel.ZIndex="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource PosSurfaceAltBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding ToggleSyncCenterCommand}"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    ToolTip="{loc:Loc shell.sync.close}">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc shell.sync.title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" />
                                <TextBlock Text="{Binding SyncCenterDetailTitle}" FontSize="10" Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TabControl Grid.Row="1" Margin="16,12" Background="Transparent" BorderThickness="0">
                        <TabItem Header="{loc:Loc shell.sync.ordersTab}">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource PosWarningSoftBrush}"
                                        BorderBrush="{DynamicResource PosWarningBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="{Binding LastOrderSyncErrorText}"
                                               Foreground="{DynamicResource PosWarningTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </Border>
                                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right"
                                            Content="{loc:Loc shell.sync.retryAll}"
                                            Command="{Binding RetryAllSyncOrdersCommand}"
                                            Style="{StaticResource PosPrimaryButtonStyle}"
                                            Padding="10,4"
                                            Margin="8,0,0,0" />
                                    <Button DockPanel.Dock="Right"
                                            Content="{loc:Loc shell.sync.retrySelected}"
                                            Command="{Binding RetrySelectedSyncOrdersCommand}"
                                            Style="{StaticResource PosPrimaryButtonStyle}"
                                            Padding="10,4" />
                                    <Button DockPanel.Dock="Left"
                                            Content="{loc:Loc shell.sync.selectAll}"
                                            Command="{Binding SelectAllSyncOrdersCommand}"
                                            Style="{StaticResource TitleBarButtonStyle}"
                                            Padding="10,4" />
                                </DockPanel>
                                <ScrollViewer Grid.Row="2"
                                              Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SyncCenterOrders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8"
                                                        Padding="10"
                                                        Background="{DynamicResource PosSurfaceBrush}"
                                                        BorderBrush="{DynamicResource PosDividerBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Selection.IsSelected}"
                                                                  IsEnabled="{Binding CanRetry}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,10,0" />
                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                                           Margin="0,0,6,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding EntityType}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding EntityType}" Value="Order">
                                                                                    <Setter Property="Text" Value="{loc:Loc shell.sync.entity.order}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding EntityType}" Value="LinklySettlement">
                                                                                    <Setter Property="Text" Value="{loc:Loc shell.sync.entity.linklySettlement}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding ShortEntityId}" FontWeight="Bold" />
                                                                <TextBlock Text="{Binding Status, StringFormat='  [{0}]'}"
                                                                           Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                           Margin="6,0,0,0" />
                                                            </StackPanel>
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource PosMutedForegroundBrush}">
                                                                <Run Text="{loc:Loc shell.sync.created}" />
                                                                <Run Text=" " />
                                                                <Run Text="{Binding CreatedAtDisplay, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource PosMutedForegroundBrush}">
                                                                <Run Text="{loc:Loc shell.sync.lastAttempt}" />
                                                                <Run Text=" " />
                                                                <Run Text="{Binding LastTriedAtDisplay, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding ErrorMessage}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource PosDangerTextBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                                            <TextBlock Text="{Binding AmountDisplay}"
                                                                       FontWeight="Black"
                                                                       Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                                            <Button Content="{loc:Loc shell.sync.retry}"
                                                                    Command="{Binding DataContext.RetrySyncOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource PosPrimaryButtonStyle}"
                                                                    Padding="10,4"
                                                                    Margin="0,6,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{loc:Loc shell.sync.auditTab}">
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right"
                                            Content="{loc:Loc shell.sync.retrySelected}"
                                            Command="{Binding RetrySelectedAuditLogsCommand}"
                                            Style="{StaticResource PosPrimaryButtonStyle}"
                                            Padding="10,4" />
                                    <Button DockPanel.Dock="Left"
                                            Content="{loc:Loc shell.sync.selectAll}"
                                            Command="{Binding SelectAllAuditLogsCommand}"
                                            Style="{StaticResource TitleBarButtonStyle}"
                                            Padding="10,4" />
                                </DockPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding LastAuditSyncErrorText}"
                                           Visibility="{Binding LastAuditSyncErrorText, Converter={StaticResource StringHasValueToVis}}"
                                           Foreground="{DynamicResource PosDangerTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <ScrollViewer Grid.Row="2"
                                              Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SyncCenterAuditLogs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8"
                                                        Padding="10"
                                                        Background="{DynamicResource PosSurfaceBrush}"
                                                        BorderBrush="{DynamicResource PosDividerBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Selection.IsSelected}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,10,0" />
                                                        <StackPanel Grid.Column="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding ShortEventId}" FontWeight="Bold" />
                                                                <TextBlock Text="{Binding Status, StringFormat='  [{0}]'}"
                                                                           Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                           Margin="6,0,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding OccurredAtDisplay}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                                            <TextBlock Text="{Binding ErrorMessage}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource PosDangerTextBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="2" Padding="16,12" Background="{DynamicResource PosSurfaceAltBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,14,14">
                        <DockPanel>
                            <TextBlock Text="{loc:Loc shell.sync.caption}" FontSize="10" Foreground="{DynamicResource PosMutedForegroundBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding CurrentTime}" Style="{StaticResource FooterTextStyle}" FontFamily="Consolas" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource FooterDividerStyle}" />
                    <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14" Foreground="{DynamicResource PosSuccessTextBrush}" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding StatusMessage}" MaxWidth="190">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FooterTextStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCatalogDownloadProgressVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource FooterDividerStyle}" />
                    <Border Width="8" Height="8" Background="{DynamicResource PosSuccessBrush}" CornerRadius="4" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding OnlineStateText}" Style="{StaticResource FooterTextStyle}" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource FooterDividerStyle}" />
                    <TextBlock Text="{Binding PendingSyncText}" Style="{StaticResource FooterTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource FooterDividerStyle}" />
                    <TextBlock Text="{Binding TerminalInfo}" Style="{StaticResource FooterTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource FooterDividerStyle}" />
                    <TextBlock Style="{StaticResource FooterTextStyle}">
                        <Run Text="{loc:Loc shell.footer.currentVersion}" />
                        <Run Text=": " />
                        <Run Text="{Binding AppUpdate.CurrentVersion, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PosPrimaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding AppUpdate.HasDifferentTargetVersion}" Value="True" />
                                            <Condition Binding="{Binding AppUpdate.IsRollbackTarget}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{loc:Loc shell.footer.latestVersion}" />
                        <Run Text=": " />
                        <Run Text="{Binding AppUpdate.TargetVersion, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PosDangerTextBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppUpdate.IsRollbackTarget}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{loc:Loc shell.footer.targetVersion}" />
                        <Run Text=": " />
                        <Run Text="{Binding AppUpdate.TargetVersion, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <Border Grid.Column="1"
                        Grid.ColumnSpan="5"
                        Visibility="{Binding IsCatalogDownloadProgressVisible, Converter={StaticResource BoolToVis}}"
                        Margin="14,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PosSurfaceBrush}"
                        Panel.ZIndex="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CatalogDownloadProgressText}"
                                   FontSize="10"
                                   FontWeight="Black"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCatalogDownloadProgressFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Grid.Column="1"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding CatalogDownloadProgressValue}"
                                     Foreground="{DynamicResource PosSuccessTextBrush}"
                                     Background="{DynamicResource PosSuccessSoftBrush}"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CatalogDownloadProgressDetailText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <Button Grid.Column="6"
                        Command="{Binding ToggleSyncCenterCommand}"
                        Height="32"
                        Padding="10,0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        Cursor="Hand"
                        Style="{StaticResource HeaderUtilityButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc shell.sync.title}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" Margin="0,0,12,0" />
                        <TextBlock FontSize="10" Foreground="{DynamicResource PosPrimaryTextBrush}" Margin="0,0,10,0">
                            <Run Text="{loc:Loc shell.sync.pending}" />
                            <Run Text=" " />
                            <Run Text="{Binding PendingUploadCount, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="10" Foreground="{DynamicResource PosDangerTextBrush}" Margin="0,0,10,0">
                            <Run Text="{loc:Loc shell.sync.failed}" />
                            <Run Text=" " />
                            <Run Text="{Binding FailedUploadCount, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="10" Foreground="{DynamicResource PosSuccessTextBrush}">
                            <Run Text="{loc:Loc shell.sync.syncing}" />
                            <Run Text=" " />
                            <Run Text="{Binding SyncingOrderCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsDeviceReregistrationDialogOpen, Converter={StaticResource BoolToVis}}"
              Background="#99000000"
              Panel.ZIndex="100">
            <Border Width="560"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DataContext="{Binding DeviceRegistration}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Width="42" Height="42" Background="{DynamicResource PosPrimaryBrush}" CornerRadius="8" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="AccountSwitch"
                                                     Width="22"
                                                     Height="22"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding TitleText}"
                                       FontSize="21"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosTextBrush}" />
                            <TextBlock Text="{loc:Loc deviceRegistration.reregister.subtitle}"
                                       FontSize="12"
                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource PosPrimarySoftBrush}"
                            BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12,10"
                            Margin="0,0,0,16">
                        <TextBlock Text="{loc:Loc deviceActivation.rebindDescription}"
                                   FontSize="12"
                                   Foreground="{DynamicResource PosTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="{loc:Loc deviceActivation.code}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding ActivationCode, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="DeviceRebindActivationCodeInput"
                             IsReadOnly="{Binding IsActivationRecoveryPending}"
                             CharacterCasing="Upper"
                             MaxLength="128"
                             Height="46"
                             FontSize="16"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,14">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding PreviewActivationCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Border Visibility="{Binding HasActivationPreview, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource PosSuccessSoftBrush}"
                            BorderBrush="{DynamicResource PosSuccessBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14,12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc deviceActivation.targetStore}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PosSuccessTextBrush}" />
                            <TextBlock Text="{Binding StoreTransitionDisplay}"
                                       FontSize="17"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosTextBrush}"
                                       Margin="0,3,0,0" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                       Margin="0,4,0,0">
                                <Run Text="{loc:Loc deviceActivation.platform}" />
                                <Run Text=": " />
                                <Run Text="{Binding PreviewDeviceSystem}" />
                                <Run Text="  ·  " />
                                <Run Text="{loc:Loc deviceActivation.expiresAt}" />
                                <Run Text=": " />
                                <Run Text="{Binding PreviewExpiryText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border MinHeight="42"
                            Background="{DynamicResource PosWarningSoftBrush}"
                            BorderBrush="{DynamicResource PosWarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,20">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource PosWarningTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding PreviewActivationCommand}"
                                Height="44"
                                Style="{StaticResource PosSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="MagnifyScan" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ActivationPreviewButtonText}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding ConfirmActivationCommand}"
                                Height="44"
                                Style="{StaticResource PosPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Foreground="White" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ActivationConfirmButtonText}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                Height="44"
                                Style="{StaticResource PosSecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Loc common.cancel}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 收银员登录全局遮盖：未登录时盖住主窗口，扫码内容仍走现有登录命令。 -->
        <Grid Grid.RowSpan="3"
              AutomationProperties.AutomationId="CashierLoginOverlay"
              Visibility="{Binding IsCashierLoginOverlayOpen, Converter={StaticResource BoolToVis}}"
              Background="#99000000"
              Panel.ZIndex="97"
              IsVisibleChanged="CashierLoginOverlayIsVisibleChanged"
              IsEnabledChanged="CashierLoginOverlayIsEnabledChanged">
            <Border Width="520"
                    MaxHeight="680"
                    Padding="26"
                    Background="{DynamicResource PosSurfaceBrush}"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" />
                </Border.Effect>
                <ScrollViewer Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.Resources>
                        <Style x:Key="CashierBarcodeKeyboardButtonStyle" TargetType="Button">
                            <Setter Property="Height" Value="44" />
                            <Setter Property="Margin" Value="3" />
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                            <Setter Property="FontSize" Value="22" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="RootBorder"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Border.RenderTransform>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="4" Opacity="0.1" ShadowDepth="1" />
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="RootBorder" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource PosPrimarySoftStrongBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,18">
                        <Border Width="46"
                                Height="46"
                                Background="{DynamicResource PosPrimarySoftBrush}"
                                CornerRadius="12"
                                Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="BadgeAccountHorizontalOutline"
                                                     Width="28"
                                                     Height="28"
                                                     Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc shell.cashierLogin.overlayTitle}"
                                       FontSize="20"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosTextBrush}" />
                            <TextBlock Text="{loc:Loc shell.cashierLogin.overlayMessage}"
                                       FontSize="13"
                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <PasswordBox x:Name="CashierLoginOverlayPasswordBox"
                                 AutomationProperties.AutomationId="CashierLoginInput"
                                 Grid.Row="1"
                                 Height="46"
                                 Padding="12,0"
                                 FontSize="16"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="{loc:Loc shell.cashierLogin.inputHint}"
                                 ToolTip="{loc:Loc shell.cashierLogin.tooltip}"
                                 PasswordChanged="CashierLoginOverlayPasswordBoxPasswordChanged"
                                 KeyDown="CashierLoginOverlayPasswordBoxKeyDown" />

                    <!-- 关键逻辑：屏幕数字键盘只写入收银员登录弹窗，不复用商品/金额键盘命令。 -->
                    <UniformGrid Grid.Row="2"
                                 Columns="3"
                                 Rows="4"
                                 Margin="0,14,0,0">
                        <Button Content="1"
                                Tag="1"
                                Style="{StaticResource CashierBarcodeKeyboardButtonStyle}"
                                Click="CashierLoginOverlayKeyboardButtonClick" />
                        <Button Content="2"
                                Tag="2"
                                Style="{StaticResource CashierBarcodeKeyboardButtonStyle}"
                                Click="CashierLoginOverlayKeyboardButtonClick" />
                        <Button Content="3"
                                Tag="3"
                                Style="{StaticResource CashierBarcodeKeyboardButtonStyle}"
                                Click="CashierLoginOverlayKeyboardButtonClick" />
                        <Button Content="4"
                                Tag="4"
                                Style="{StaticResource CashierBarcodeKeyboardButtonStyle}"
                                Click="CashierLoginOverlayKeyboardButtonClick" />
                        <Button Content="5"
                                Tag="5"
                                Style="{StaticResource CashierBarcodeKeyboardButtonStyle}"
                                Click="CashierLoginOverlayKeyboardButtonClick" />
                        <Button Content="6"
                                Tag="6"
                                Style="{StaticResource CashierBarcodeKeyboardButtonStyle}"
                                Click="CashierLoginOverlayKeyboardButtonClick" />
                        <Button Content="7"
                                Tag="7"
                                Style="{StaticResource CashierBarcodeKeyboardButtonStyle}"
                                Click="CashierLoginOverlayKeyboardButtonClick" />
                        <Button Content="8"
                                Tag="8"
                                Style="{StaticResource CashierBarcodeKeyboardButtonStyle}"
                                Click="CashierLoginOverlayKeyboardButtonClick" />
                        <Button Content="9"
                                Tag="9"
                                Style="{StaticResource CashierBarcodeKeyboardButtonStyle}"
                                Click="CashierLoginOverlayKeyboardButtonClick" />
                        <Button Content="{loc:Loc Clear}"
                                Tag="Clear"
                                FontSize="15"
                                Foreground="{DynamicResource PosDangerTextBrush}"
                                Style="{StaticResource CashierBarcodeKeyboardButtonStyle}"
                                Click="CashierLoginOverlayKeyboardButtonClick" />
                        <Button Content="0"
                                Tag="0"
                                Style="{StaticResource CashierBarcodeKeyboardButtonStyle}"
                                Click="CashierLoginOverlayKeyboardButtonClick" />
                        <Button Tag="Back"
                                Foreground="{DynamicResource PosDangerTextBrush}"
                                ToolTip="{loc:Loc Backspace}"
                                Style="{StaticResource CashierBarcodeKeyboardButtonStyle}"
                                Click="CashierLoginOverlayKeyboardButtonClick">
                            <materialDesign:PackIcon Kind="BackspaceOutline"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="{DynamicResource PosDangerTextBrush}" />
                        </Button>
                    </UniformGrid>

                    <Button Grid.Row="3"
                            AutomationProperties.AutomationId="CashierLoginButton"
                            Command="{Binding LoginCashierCommand}"
                            Height="46"
                            Margin="0,14,0,0"
                            Style="{StaticResource PosPrimaryButtonStyle}"
                            Click="CashierLoginOverlayButtonClick">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Login"
                                                     Width="18"
                                                     Height="18"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc shell.cashierLogin.overlayAction}"
                                       Foreground="White"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Row="4"
                               Text="{Binding StatusMessage}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,14,0,0" />

                    <TextBlock Grid.Row="5"
                               Text="{Binding StoreInfo}"
                               FontSize="11"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,12,0,0" />

                    <!-- 关键逻辑：未登录时原地复用服务器设置面板，不绕过现有校验与连接测试。 -->
                    <Expander Grid.Row="6"
                              Header="{loc:Loc shell.cashierLogin.changeServerAddress}"
                              IsExpanded="False"
                              Margin="0,14,0,0">
                        <controls:ApiServerSettingsPanel DataContext="{Binding ApiServerSettings}"
                                                         Margin="0,10,0,0" />
                    </Expander>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 单次操作授权遮罩：只接收授权扫码，不显示或保存条码内容。 -->
        <Grid Grid.RowSpan="3"
              AutomationProperties.AutomationId="OperationAuthorizationOverlay"
              AutomationProperties.Name="{loc:Loc shell.operationAuthorization.title}"
              Visibility="{Binding OperationAuthorization.IsPromptOpen, Converter={StaticResource BoolToVis}}"
              Background="#99000000"
              Panel.ZIndex="98"
              KeyboardNavigation.TabNavigation="Cycle"
              IsVisibleChanged="OperationAuthorizationOverlayIsVisibleChanged">
            <Border Width="560"
                    Padding="26"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Width="54"
                                Height="54"
                                Background="{DynamicResource PosPrimarySoftBrush}"
                                CornerRadius="12"
                                Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="ShieldAccountOutline"
                                                     Width="32"
                                                     Height="32"
                                                     Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc shell.operationAuthorization.title}"
                                       FontSize="22"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosTextBrush}" />
                            <TextBlock Text="{loc:Loc shell.operationAuthorization.message}"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Padding="16"
                            Background="{DynamicResource PosSurfaceAltBrush}"
                            BorderBrush="{DynamicResource PosDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="ClipboardTextOutline"
                                                     Width="24"
                                                     Height="24"
                                                     Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                     VerticalAlignment="Top" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Loc shell.operationAuthorization.operationLabel}"
                                           FontSize="11"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                <TextBlock Text="{Binding OperationAuthorization.Action}"
                                           Margin="0,3,0,0"
                                           FontSize="17"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap">
                                    <Run Text="{loc:Loc shell.operationAuthorization.screenLabel}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding OperationAuthorization.Screen, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Padding="14"
                            Background="{DynamicResource PosWarningSoftBrush}"
                            BorderBrush="{DynamicResource PosWarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock FontSize="11"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosWarningTextBrush}">
                                <Run Text="{loc:Loc shell.operationAuthorization.permissionLabel}" />
                                <Run Text=" " />
                                <Run Text="{Binding OperationAuthorization.PermissionCode, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3"
                            Padding="14"
                            Background="{DynamicResource PosPrimarySoftBrush}"
                            BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BarcodeScan"
                                                         Width="22"
                                                         Height="22"
                                                         Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                         Margin="0,0,10,0" />
                                <TextBlock Text="{loc:Loc shell.operationAuthorization.scanHint}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ProgressBar Height="4"
                                         Margin="0,12,0,0"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource PosPrimaryTextBrush}"
                                         Visibility="{Binding OperationAuthorization.IsBusy, Converter={StaticResource BoolToVis}}" />
                            <TextBlock AutomationProperties.AutomationId="OperationAuthorizationStatus"
                                       AutomationProperties.LiveSetting="Assertive"
                                       Text="{Binding OperationAuthorization.StatusMessage}"
                                       Margin="0,10,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="OperationAuthorizationCancelButton"
                            Grid.Row="4"
                            AutomationProperties.AutomationId="OperationAuthorizationCancelButton"
                            Command="{Binding OperationAuthorization.CancelCommand}"
                            MinWidth="128"
                            Height="44"
                            HorizontalAlignment="Right"
                            IsTabStop="True"
                            KeyboardNavigation.TabIndex="0"
                            Style="{StaticResource PosSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloseCircleOutline"
                                                     Width="18"
                                                     Height="18"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="{loc:Loc common.cancel}" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsCardRecoveryResultDialogOpen, Converter={StaticResource BoolToVis}}"
              Background="#99000000"
              Panel.ZIndex="90">
            <Border Width="760"
                    MaxHeight="680"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DataContext="{Binding CardRecoveryResultDialog}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="22,18"
                            BorderBrush="{DynamicResource PosDividerBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PosWarningSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding DataContext.CloseCardRecoveryResultDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    ToolTip="{loc:Loc shell.window.close}">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="22"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource PosTextBrush}" />
                                <TextBlock Text="{Binding Message}"
                                           Margin="0,6,24,0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Margin="22,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Loc cardRecovery.dialog.section.certFields}"
                                           FontSize="13"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           Margin="0,0,0,10" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,12" Visibility="{Binding HasOrderGuid, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:Loc cardRecovery.dialog.field.order}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                        <TextBlock Text="{Binding OrderGuidDisplay}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource PosTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12" Visibility="{Binding HasAmount, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:Loc cardRecovery.dialog.field.amount}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                        <TextBlock Text="{Binding AmountDisplay}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12" Visibility="{Binding HasTxnRef, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:Loc cardRecovery.dialog.field.txnRef}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                        <TextBlock Text="{Binding TxnRef}" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource PosTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12" Visibility="{Binding HasSessionId, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:Loc cardRecovery.dialog.field.sessionId}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                        <TextBlock Text="{Binding SessionId}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource PosTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12" Visibility="{Binding HasResponseCode, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:Loc cardRecovery.dialog.field.responseCode}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                        <TextBlock Text="{Binding ResponseCode}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource PosAccentBrush}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,12" Visibility="{Binding HasResponseText, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{loc:Loc cardRecovery.dialog.field.responseText}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                        <TextBlock Text="{Binding ResponseText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource PosTextBrush}" />
                                    </StackPanel>
                                </UniformGrid>

                                <Border Padding="12"
                                        Margin="0,4,0,0"
                                        Background="{DynamicResource PosSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource PosDividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc cardRecovery.dialog.field.timestamp}" FontSize="10" FontWeight="Black" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                        <TextBlock Text="{Binding TimestampDisplay}" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource PosTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Padding="14"
                                    Background="{DynamicResource PosSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PosDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding HasReceiptPreview, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="Receipt" Width="18" Height="18" Foreground="{DynamicResource PosPrimaryTextBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc cardRecovery.dialog.section.receiptPreview}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource PosTextBrush}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding ReceiptPreviewRows}"
                                                  ItemTemplate="{StaticResource ReceiptPreviewRowTemplate}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Margin="0,16,0,0"
                                    Padding="14"
                                    Background="{DynamicResource PosWarningSoftBrush}"
                                    BorderBrush="{DynamicResource PosWarningBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding CanResolveFinancialResult, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc cardRecovery.refund.section.title}"
                                               FontSize="14"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource PosTextBrush}"
                                               Visibility="{Binding CanResolveRefund, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{loc:Loc cardRecovery.refund.section.instructions}"
                                               Margin="0,4,0,12"
                                               FontSize="12"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding CanResolveRefund, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{loc:Loc cardRecovery.payment.section.title}"
                                               FontSize="14"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource PosTextBrush}"
                                               Visibility="{Binding CanResolvePayment, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{loc:Loc cardRecovery.payment.section.instructions}"
                                               Margin="0,4,0,12"
                                               FontSize="12"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding CanResolvePayment, Converter={StaticResource BoolToVis}}" />

                                    <Grid Margin="0,0,0,12"
                                          Visibility="{Binding CanResolveRefund, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc cardRecovery.refund.field.processor}"
                                                       FontSize="10"
                                                       FontWeight="Black"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                            <TextBlock Text="{Binding RefundProcessorDisplay}"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PosTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc cardRecovery.refund.field.originalReference}"
                                                       FontSize="10"
                                                       FontWeight="Black"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                            <TextBlock Text="{Binding OriginalReferenceDisplay}"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       FontFamily="Consolas"
                                                       Foreground="{DynamicResource PosTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{loc:Loc cardRecovery.refund.field.refundReference}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               Margin="0,0,0,5"
                                               Visibility="{Binding CanResolveRefund, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{loc:Loc cardRecovery.payment.field.paymentReference}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               Margin="0,0,0,5"
                                               Visibility="{Binding CanResolvePayment, Converter={StaticResource BoolToVis}}" />
                                    <TextBox Text="{Binding RefundReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="38"
                                             Padding="8,6"
                                             MaxLength="200" />

                                    <TextBlock Text="{loc:Loc cardRecovery.refund.field.evidence}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               Margin="0,10,0,5"
                                               Visibility="{Binding CanResolveRefund, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{loc:Loc cardRecovery.payment.field.evidence}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               Margin="0,10,0,5"
                                               Visibility="{Binding CanResolvePayment, Converter={StaticResource BoolToVis}}" />
                                    <TextBox Text="{Binding RefundEvidence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="54"
                                             MaxHeight="96"
                                             Padding="8,6"
                                             MaxLength="1000"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" />

                                    <TextBlock Text="{loc:Loc cardRecovery.refund.field.note}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               Margin="0,10,0,5"
                                               Visibility="{Binding CanResolveRefund, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{loc:Loc cardRecovery.payment.field.note}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               Margin="0,10,0,5"
                                               Visibility="{Binding CanResolvePayment, Converter={StaticResource BoolToVis}}" />
                                    <TextBox Text="{Binding RefundSupervisorNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="54"
                                             MaxHeight="96"
                                             Padding="8,6"
                                             MaxLength="500"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" />

                                    <Border Margin="0,10,0,0"
                                            Padding="10,8"
                                            Background="{DynamicResource PosDangerSoftBrush}"
                                            BorderBrush="{DynamicResource PosDangerBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Visibility="{Binding HasRefundResolutionMessage, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding RefundResolutionMessage}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PosDangerTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Padding="18"
                            Background="{DynamicResource PosSurfaceAltBrush}"
                            BorderBrush="{DynamicResource PosDividerBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,8,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding DataContext.ResolveCardRefundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static services:CardRefundSupervisorDecision.ConfirmRefunded}"
                                    MinWidth="142"
                                    Height="44"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource PosPrimaryButtonStyle}"
                                    Visibility="{Binding CanResolveRefund, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc cardRecovery.refund.action.confirmRefunded}"
                                           Foreground="White"
                                           FontWeight="Bold" />
                            </Button>
                            <Button Command="{Binding DataContext.ResolveCardRefundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
