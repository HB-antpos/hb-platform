                                                                                        <DataTrigger Binding="{Binding HasConnectionFailure}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" /></DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <StackPanel Margin="0,0,0,10" MinWidth="125">
