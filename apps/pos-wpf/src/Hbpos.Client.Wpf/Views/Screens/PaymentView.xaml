<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Hbpos.Client.Wpf.Views.Controls"
             xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:orders="clr-namespace:Hbpos.Contracts.Orders;assembly=Hbpos.Contracts"
             xmlns:services="clr-namespace:Hbpos.Client.Wpf.Services"
             xmlns:vm="clr-namespace:Hbpos.Client.Wpf.ViewModels"
             mc:Ignorable="d"
             AutomationProperties.AutomationId="PaymentScreen"
             d:DesignHeight="688"
             d:DesignWidth="1366"
             Background="{DynamicResource PosSurfaceAltBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:LocalizationKeyConverter x:Key="LocalizationKeyConverter" />
        <!-- 付款页三列宽度：显示订单列表时 28/42/30，隐藏时左列收窄为 22/44/34（省下的宽度给金额键盘与支付方式）。 -->
        <converters:BoolToGridLengthConverter x:Key="OrderListLeftColumnWidthConverter" TrueValue="28*" FalseValue="22*" />
        <converters:BoolToGridLengthConverter x:Key="OrderListMiddleColumnWidthConverter" TrueValue="42*" FalseValue="44*" />
        <converters:BoolToGridLengthConverter x:Key="OrderListRightColumnWidthConverter" TrueValue="30*" FalseValue="34*" />
        <Style x:Key="PaymentCartTouchScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="22" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosKeyBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <!-- 无需滚动时隐藏轨道，但保留触屏滚动条的布局宽度。 -->
                <Trigger Property="Maximum" Value="0">
                    <Setter Property="Opacity" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ZeroPricePaymentCartRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <!-- 斑马纹：是否交替由 DataGrid 的 AlternationCount 决定（旧主题为 0=不交替，长者主题为 2）；
                     放在异常行触发器之前，零价/退货行的红底仍然优先。 -->
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource PosCartAltRowBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding HasZeroUnitPrice}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReturnLine}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 订单表格表头：底色/描边走语义键，字号与最小高度走尺寸字典；数量/合计列再各加一个表头最小宽度。 -->
        <Style x:Key="PaymentCartHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PosCartHeaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource PosPayCartHeaderFontSize}" />
            <Setter Property="MinHeight" Value="{DynamicResource PosPayCartHeaderMinHeight}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,10" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosCardBorderBrush}" />
        </Style>
        <Style x:Key="PaymentCartQtyHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource PaymentCartHeaderStyle}">
            <Setter Property="MinWidth" Value="{DynamicResource PosPayCartQtyColumnMinWidth}" />
        </Style>
        <Style x:Key="PaymentCartTotalHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource PaymentCartHeaderStyle}">
            <Setter Property="MinWidth" Value="{DynamicResource PosPayCartTotalColumnMinWidth}" />
        </Style>

        <Style x:Key="ZeroPricePaymentAmountTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasZeroUnitPrice}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                    <Setter Property="FontWeight" Value="Black" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReturnLine}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                    <Setter Property="FontWeight" Value="Black" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaymentKeypadNumberTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource PosPayKeypadNumberFontSize}" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="PaymentKeypadFunctionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PaymentKeypadNumberTextStyle}">
            <Setter Property="FontSize" Value="{DynamicResource PosPayKeypadClearFontSize}" />
        </Style>

        <!-- 数字键：沿用共用数字键样式，仅把描边改成语义键（旧主题＝原 PosBorderBrush，长者主题＝无描边）。 -->
        <Style x:Key="PaymentKeypadButtonStyle" TargetType="Button" BasedOn="{StaticResource PosNumberButtonStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource PosKeyBorderBrush}" />
        </Style>

        <!-- ═══ 支付方式方块（现金/刷卡/代金券/手动刷卡）：全主题按方式分色 ═══
             未选＝Soft 浅底 + Ink 字 + Fill 实心圆盘（On 图标）；选中＝Fill 实心 + On 字 + On 圆盘（Fill 图标）+ 右上 ✓ 角标。
             模板自带满宽 ContentPresenter，这样内容 Grid 才能撑满方块，✓ 角标才能贴在方块右上角。 -->
        <Style x:Key="PaymentMethodTileStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="100" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosKeyBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 悬停 / 按下的缩放动画与 PosButtonBaseStyle 一致：悬停 1.02，按下 0.96，松开回到 1.02。 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.04" />
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.04" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CashMethodButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentMethodTileStyle}">
            <Setter Property="Background" Value="{DynamicResource PosMethodCashSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosMethodCashSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosMethodCashInkBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosMethodCashFillBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosMethodCashFillBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosMethodCashOnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardMethodButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentMethodTileStyle}">
            <Setter Property="Background" Value="{DynamicResource PosMethodCardSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosMethodCardSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosMethodCardInkBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCardSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosMethodCardFillBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosMethodCardFillBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosMethodCardOnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VoucherMethodButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentMethodTileStyle}">
            <Setter Property="Background" Value="{DynamicResource PosMethodVoucherSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosMethodVoucherSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosMethodVoucherInkBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVoucherSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosMethodVoucherFillBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosMethodVoucherFillBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosMethodVoucherOnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 手动刷卡入口是「打开确认弹窗」的动作按钮，不会成为已选方式，所以固定显示刷卡色的未选外观。 -->
        <Style x:Key="ManualCardMethodButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentMethodTileStyle}">
            <Setter Property="Background" Value="{DynamicResource PosMethodCardSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosMethodCardSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosMethodCardInkBrush}" />
        </Style>
        <!-- 圆盘与图标：未选＝Fill 圆盘 + On 图标；选中＝On 圆盘 + Fill 图标（与方块底色互换）。 -->
        <Style x:Key="PaymentMethodDiscStyle" TargetType="Border">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PaymentMethodIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CashMethodDiscStyle" TargetType="Border" BasedOn="{StaticResource PaymentMethodDiscStyle}">
            <Setter Property="Background" Value="{DynamicResource PosMethodCashFillBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosMethodCashOnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CashMethodIconStyle" TargetType="materialDesign:PackIcon" BasedOn="{StaticResource PaymentMethodIconStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PosMethodCashOnBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PosMethodCashFillBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardMethodDiscStyle" TargetType="Border" BasedOn="{StaticResource PaymentMethodDiscStyle}">
            <Setter Property="Background" Value="{DynamicResource PosMethodCardFillBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCardSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosMethodCardOnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardMethodIconStyle" TargetType="materialDesign:PackIcon" BasedOn="{StaticResource PaymentMethodIconStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PosMethodCardOnBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCardSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PosMethodCardFillBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VoucherMethodDiscStyle" TargetType="Border" BasedOn="{StaticResource PaymentMethodDiscStyle}">
            <Setter Property="Background" Value="{DynamicResource PosMethodVoucherFillBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVoucherSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosMethodVoucherOnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VoucherMethodIconStyle" TargetType="materialDesign:PackIcon" BasedOn="{StaticResource PaymentMethodIconStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PosMethodVoucherOnBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVoucherSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PosMethodVoucherFillBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PaymentMethodTileTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource PosPayMethodLabelFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <!-- 文字色跟随所在按钮的 Foreground（未选＝Ink，选中＝On）；分期开关是 ToggleButton，所以取共同基类 ButtonBase。 -->
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ButtonBase}}}" />
        </Style>

        <!-- ═══ 快捷现金（方案 B）：色块 + 内缩线框 + 两个角上的半透明圆 + 底部 3px 厚度；全主题生效 ═══
             只用颜色与自绘抽象几何，不含任何头像/水印/安全特征/真实纸币图案。
             面额色由 Label 做 DataTrigger 取 PosNote{N}FillBrush/TextBrush（主题随色板微调）。 -->
        <Style x:Key="PaymentQuickAmountButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="Height" Value="{DynamicResource PosPayQuickCashButtonHeight}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosKeyBorderBrush}" />
            <Setter Property="FontWeight" Value="Black" />
            <!-- 键盘/外设焦点：3px 外框；只在键盘导航时显示，触屏点击后不会残留。 -->
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border Margin="-3"
                                            BorderBrush="{DynamicResource PosTextBrush}"
                                            BorderThickness="3"
                                            CornerRadius="11"
                                            IsHitTestVisible="False" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid SnapsToDevicePixels="True">
                            <!-- 底部 3px 深色「厚度」：半透明深色圆角块下移 3px（不用 DropShadowEffect，低配收银机更稳）。 -->
                            <Border x:Name="ThicknessLayer"
                                    Margin="0,3,0,-3"
                                    CornerRadius="9"
                                    Background="{DynamicResource PosInverseSurfaceBrush}"
                                    Opacity="0.3"
                                    IsHitTestVisible="False" />
                            <Border x:Name="Face"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    ClipToBounds="True">
                                <Grid>
                                    <!-- 左上与右下角两个半透明圆（数字色 15% 不透明）。 -->
                                    <Ellipse x:Name="CornerDotTopLeft"
                                             Width="52"
                                             Height="52"
                                             Margin="-16,-16,0,0"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Fill="{TemplateBinding Foreground}"
                                             Opacity="0.15"
                                             IsHitTestVisible="False" />
                                    <Ellipse x:Name="CornerDotBottomRight"
                                             Width="60"
                                             Height="60"
                                             Margin="0,0,-18,-18"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Bottom"
                                             Fill="{TemplateBinding Foreground}"
                                             Opacity="0.15"
                                             IsHitTestVisible="False" />
                                    <!-- 内缩圆角线框（数字色 45% 不透明）。 -->
                                    <Border x:Name="Frame"
                                            Margin="5"
                                            CornerRadius="6"
                                            BorderThickness="2"
                                            BorderBrush="{TemplateBinding Foreground}"
                                            Opacity="0.45"
                                            IsHitTestVisible="False" />
                                    <!-- 禁用态：灰底上的虚线框，装饰全部隐藏。 -->
                                    <Rectangle x:Name="DisabledFrame"
                                               Margin="3"
                                               RadiusX="6"
                                               RadiusY="6"
                                               Stroke="{DynamicResource PosBorderStrongBrush}"
                                               StrokeThickness="2"
                                               StrokeDashArray="4 3"
                                               Visibility="Collapsed"
                                               IsHitTestVisible="False" />
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                    <!-- 按下变深：叠一层半透明深色。 -->
                                    <Border x:Name="PressShade"
                                            CornerRadius="9"
                                            Background="{DynamicResource PosInverseSurfaceBrush}"
                                            Opacity="0"
                                            IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 按下：面板下沉 2px（厚度只剩 1px）并变深。 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Margin" Value="0,2,0,-2" />
                                <Setter TargetName="PressShade" Property="Opacity" Value="0.14" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ThicknessLayer" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CornerDotTopLeft" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CornerDotBottomRight" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Frame" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="DisabledFrame" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Label}" Value="$100">
                    <Setter Property="Background" Value="{DynamicResource PosNote100FillBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosNote100TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Label}" Value="$50">
                    <Setter Property="Background" Value="{DynamicResource PosNote50FillBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosNote50TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Label}" Value="$20">
                    <Setter Property="Background" Value="{DynamicResource PosNote20FillBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosNote20TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Label}" Value="$10">
                    <Setter Property="Background" Value="{DynamicResource PosNote10FillBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosNote10TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Label}" Value="$5">
                    <Setter Property="Background" Value="{DynamicResource PosNote5FillBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosNote5TextBrush}" />
                </DataTrigger>
                <!-- 禁用（现金不可加）：灰底 + 灰字，数字仍可读；放在面额触发器之后，优先级最高。 -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ 确认支付：深绿实心（长者主题）+ 底部厚阴影；旧主题阴影色透明，外观与原主色按钮一致 ═══ -->
        <Style x:Key="PaymentConfirmButtonStyle" TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PosConfirmPaymentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosConfirmPaymentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <!-- 底部厚阴影：同尺寸圆角块下移 4px；颜色取色板 PosConfirmPaymentShadowBrush（旧主题透明＝无视觉变化）。 -->
                            <Border x:Name="Shadow"
                                    Margin="0,4,0,-4"
                                    CornerRadius="5"
                                    Background="{DynamicResource PosConfirmPaymentShadowBrush}"
                                    IsHitTestVisible="False" />
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    RenderTransformOrigin="0.5,0.5"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <!-- 与共用按钮模板一致：内容整体居中（不跟随 HorizontalContentAlignment），保持旧主题外观。 -->
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 悬停 / 按下的缩放动画与 PosButtonBaseStyle 一致：悬停 1.02，按下 0.96，松开回到 1.02。 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.04" />
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.04" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <!-- 禁用时同时收起厚阴影，避免只剩一条深色条。 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lay-by 分期开关：逻辑与绑定不变，仅配色走主题已有键。
             未开/锁定＝浅灰块 + 虚线框（表示「当前不是一种已选付款方式」）；开启＝主色浅底 + 主色实线边。 -->
        <Style x:Key="InstallmentMethodToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <!-- 未开时的虚线框；开启后由 IsChecked 触发器收起。 -->
                            <Rectangle x:Name="DashedFrame"
                                       Margin="1"
                                       RadiusX="7"
                                       RadiusY="7"
                                       Stroke="{DynamicResource PosBorderStrongBrush}"
                                       StrokeThickness="1.5"
                                       StrokeDashArray="4 3"
                                       IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                <Setter TargetName="DashedFrame" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InstallmentCustomerDialogTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PosSearchTextBoxStyle}">
            <Setter Property="Height" Value="56" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="VoucherEntryKeyButtonStyle" TargetType="Button" BasedOn="{StaticResource PosNumberButtonStyle}">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Black" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PaymentLayoutRoot">
        <!-- ColumnDefinition 不继承 DataContext，所以用 ElementName 指到根 Grid，再经由它的 DataContext 取 IsOrderListVisible。
             显示订单列表时 28/42/30；隐藏时左列收窄为 22/44/34。 -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding DataContext.IsOrderListVisible, ElementName=PaymentLayoutRoot, Converter={StaticResource OrderListLeftColumnWidthConverter}}" MinWidth="0" />
            <ColumnDefinition Width="{Binding DataContext.IsOrderListVisible, ElementName=PaymentLayoutRoot, Converter={StaticResource OrderListMiddleColumnWidthConverter}}" MinWidth="0" />
            <ColumnDefinition Width="{Binding DataContext.IsOrderListVisible, ElementName=PaymentLayoutRoot, Converter={StaticResource OrderListRightColumnWidthConverter}}" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <!-- 三列区域底色：左＝订单区、中＝金额与键盘区、右＝支付方式区。
             旧主题三个键都等于整页背景色（视觉不变），长者主题分别为灰/浅蓝/蓝灰；衬板铺满整列，内部卡片仍保留 12px 边距。 -->
        <Border Grid.Column="0" Background="{DynamicResource PosZoneCartBrush}" IsHitTestVisible="False" />
        <Border Grid.Column="1" Background="{DynamicResource PosZoneKeypadBrush}" IsHitTestVisible="False" />
        <Border Grid.Column="2" Background="{DynamicResource PosZoneFuncBrush}" IsHitTestVisible="False" />

        <Border Grid.Column="0" Margin="12,12,6,12" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosCardBorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid IsEnabled="{Binding IsManualCardBackgroundEnabled}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12" Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 返回按钮的浅蓝底衬板：旧主题 Opacity=0 不可见（按钮底色与卡片同为 PosSurfaceBrush，设为透明后外观不变），
                         长者主题 Opacity=1，让无描边的按钮依然有清晰的底色轮廓。 -->
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Background="{DynamicResource PosPrimarySoftBrush}"
                            CornerRadius="5"
                            Opacity="{DynamicResource PosPayBackPlateOpacity}"
                            IsHitTestVisible="False" />
                    <Button Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Command="{Binding BackToPosCommand}"
                            Style="{StaticResource PosSecondaryButtonStyle}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource PosKeyBorderBrush}"
                            HorizontalAlignment="Stretch"
                            MinHeight="{DynamicResource PosPayBackButtonMinHeight}"
                            Padding="6,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="{DynamicResource PosPayBackIconSize}" Height="{DynamicResource PosPayBackIconSize}" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Loc shell.backToPos}" FontWeight="Bold" FontSize="{DynamicResource PosPayBackButtonFontSize}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                        <Border Padding="8,3" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="4">
                            <TextBlock FontSize="{DynamicResource PosPayItemsLabelFontSize}" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryTextBrush}">
                                <Run Text="{Binding CartLines.Count, Mode=OneWay}" />
                                <Run Text=" " />
                                <Run Text="{loc:Loc Items}" />
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding OrderSummaryText}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource PosPayItemsLabelFontSize}" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="12,0,12,10" Padding="12" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosKeyBorderBrush}" BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInstallmentCustomerSectionVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="10" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountEdit"
                                                 Width="23"
                                                 Height="23"
                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc payment.installment.customerInfo}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource PosTextBrush}" />
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding InstallmentCustomerNameDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                            <TextBlock Text="  |  " FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                            <TextBlock Text="{Binding InstallmentCustomerPhoneDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding InstallmentOrderInfoText}"
                                   Margin="0,4,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PosMutedForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanEditInstallmentCustomer}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Command="{Binding OpenInstallmentCustomerDialogCommand}"
                            MinWidth="76"
                            MinHeight="36"
                            Padding="10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanEditInstallmentCustomer}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15" Margin="0,0,5,0" />
                            <TextBlock Text="{loc:Loc payment.installment.editCustomer}" FontWeight="Black" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 订单列表：设置里关闭「付款页显示订单列表」时整块隐藏，中央改显大号应付金额（见下方 Row 2 的另一块）。 -->
            <DataGrid Grid.Row="2"
                      Margin="8,0"
                      FontSize="{DynamicResource PosPayCartFontSize}"
                      Visibility="{Binding IsOrderListVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ItemsSource="{Binding CartLines}"
                      AutomationProperties.AutomationId="PaymentCartItemsGrid"
                      IsReadOnly="True"
                      RowBackground="{DynamicResource PosSurfaceBrush}"
                      AlternatingRowBackground="{DynamicResource PosCartAltRowBrush}"
                      AlternationCount="{DynamicResource PosPayCartAlternationCount}"
                      RowHeight="{DynamicResource PosPayCartRowHeight}"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.PanningMode="VerticalOnly"
                      ScrollViewer.PanningDeceleration="0.0008"
                      ScrollViewer.PanningRatio="1.0"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      RowStyle="{StaticResource ZeroPricePaymentCartRowStyle}"
                      ColumnHeaderStyle="{StaticResource PaymentCartHeaderStyle}"
                      Style="{StaticResource PosCartDataGridStyle}">
                <DataGrid.Resources>
                    <!-- 与主购物车一致：支持手指纵向拖动，并提供易触达的滚动条拖块。 -->
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PaymentCartTouchScrollBarStyle}" />
                    <Style TargetType="{x:Type Thumb}">
                        <Setter Property="MinHeight" Value="52" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border Background="{DynamicResource PosBorderStrongBrush}"
                                            BorderBrush="{DynamicResource PosBorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Margin="4" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Item}" Binding="{Binding DisplayName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- 数量/合计列：DataGridColumn 不是 FrameworkElement，Width 不能用 DynamicResource，
                         所以改为 Auto 宽度 + 表头最小宽度（标准 58/82，长者 64/96，与原固定宽度一致）。 -->
                    <DataGridTextColumn Header="{loc:Loc Quantity}" Binding="{Binding SignedQuantity, StringFormat={}{0:0.##}}" Width="Auto" HeaderStyle="{StaticResource PaymentCartQtyHeaderStyle}" />
                    <DataGridTextColumn Header="{loc:Loc Total}" Binding="{Binding ActualAmount, StringFormat={}{0:C2}}" Width="Auto" HeaderStyle="{StaticResource PaymentCartTotalHeaderStyle}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ZeroPricePaymentAmountTextStyle}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 订单列表关闭时：表格位置改显大号应付金额（标签 + 金额），仍保留下方的小计/折扣。 -->
            <StackPanel Grid.Row="2" Margin="12,0" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOrderListVisible}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{loc:Loc AmountDue}"
                           HorizontalAlignment="Center"
                           FontSize="{DynamicResource PosPayDueBigLabelFontSize}"
                           FontWeight="Black"
                           Foreground="{DynamicResource PosAmountEmphasisBrush}" />
                <!-- 金额很大时整体等比缩小，避免在收窄后的左列里被截断。 -->
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock Text="{Binding ActualAmount, StringFormat={}{0:C2}}"
                               FontSize="{DynamicResource PosPayDueBigAmountFontSize}"
                               FontWeight="Black"
                               Foreground="{DynamicResource PosAmountEmphasisBrush}" />
                </Viewbox>
            </StackPanel>

            <!-- 汇总区底色衬板：旧主题 Opacity=0 不可见（卡片原样），长者主题 Opacity=1 显示灰底。 -->
            <Border Grid.Row="3"
                    Background="{DynamicResource PosZoneCartBrush}"
                    CornerRadius="0,0,7,7"
                    Opacity="{DynamicResource PosPaySummaryPlateOpacity}"
                    IsHitTestVisible="False" />
            <Border Grid.Row="3" Padding="12,14" Background="Transparent" BorderBrush="{DynamicResource PosCardBorderBrush}" BorderThickness="0,1,0,0">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PaymentSummaryAmountColumn" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Subtotal}" FontSize="{DynamicResource PosPaySummaryLabelFontSize}" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" TextAlignment="Right" FontSize="{DynamicResource PosPaySummaryValueFontSize}" FontWeight="SemiBold" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PaymentSummaryAmountColumn" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Discount}" FontSize="{DynamicResource PosPaySummaryLabelFontSize}" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding DiscountAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" TextAlignment="Right" FontSize="{DynamicResource PosPaySummaryValueFontSize}" FontWeight="SemiBold" />
                    </Grid>

                    <Border Grid.Row="2" Height="1" Background="{DynamicResource PosKeyBorderBrush}" Margin="0,0,0,8"
                            Visibility="{Binding IsOrderListVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Grid Grid.Row="3" Visibility="{Binding IsOrderListVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PaymentSummaryAmountColumn" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc AmountDue}" VerticalAlignment="Center" FontSize="{DynamicResource PosPayDueLabelFontSize}" FontWeight="Black" Foreground="{DynamicResource PosAmountEmphasisBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding ActualAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" TextAlignment="Right" FontSize="{DynamicResource PosPayDueAmountFontSize}" FontWeight="Black" Foreground="{DynamicResource PosAmountEmphasisBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </Border>

        <Grid Grid.Column="1" Background="Transparent" Margin="6,12" IsEnabled="{Binding IsManualCardBackgroundEnabled}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,14" Margin="0,0,0,14" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosCardBorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding RemainingAmountText}" FontSize="{DynamicResource PosPayAmountLabelFontSize}" FontWeight="Bold" Foreground="{DynamicResource PosAmountEmphasisBrush}" TextWrapping="Wrap" />
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="72" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:C2}}" AutomationProperties.AutomationId="RemainingAmount" FontSize="60" FontWeight="Black" Foreground="{DynamicResource PosAmountEmphasisBrush}" />
                        </Viewbox>
                    </StackPanel>
                    <!-- 有找零时整块换底色（旧主题成功绿浅底、长者主题浅蓝灰底），提醒收银员需要找钱；
                         无找零时底色衬板的透明度取 PosPayChangeIdlePlateOpacity：旧主题 0=透明弱化，长者主题 1=保持浅蓝灰底。 -->
                    <Border Grid.Column="1" Background="{DynamicResource PosChangeDueBackgroundBrush}" CornerRadius="{DynamicResource PosPayChangePlateCornerRadius}" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChangeDue}" Value="0">
                                        <Setter Property="Opacity" Value="{DynamicResource PosPayChangeIdlePlateOpacity}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="{DynamicResource PosCardBorderBrush}" BorderThickness="1,0,0,0" Padding="14,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding ChangeDueText}" FontSize="{DynamicResource PosPayAmountLabelFontSize}" FontWeight="SemiBold" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource PosChangeDueForegroundBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChangeDue}" Value="0">
                                                <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="72" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ChangeDue, StringFormat={}{0:C2}}" FontSize="{DynamicResource PosPayChangeAmountFontSize}" FontWeight="Black">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource PosChangeDueForegroundBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChangeDue}" Value="0">
                                                    <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Viewbox>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="3,0,3,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="{Binding CurrentTenderTextLabel}" FontSize="{DynamicResource PosPayTenderLabelFontSize}" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border Grid.Row="1" MinHeight="{DynamicResource PosPayTenderInputMinHeight}"
                        Padding="14,8"
                        Background="{DynamicResource PosSurfaceBrush}"
                        BorderBrush="{DynamicResource PosPrimaryBrush}"
                        BorderThickness="{DynamicResource PosPayTenderInputBorderThickness}"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TenderAmountText}"
                                   FontSize="{DynamicResource PosPayTenderInputFontSize}"
                                   FontWeight="Black"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Button Grid.Row="1" Grid.Column="1"
                        Command="{Binding NumberInputCommand}"
                        CommandParameter="Back"
                        Style="{StaticResource PaymentKeypadButtonStyle}"
                        Width="{DynamicResource PosPayBackspaceWidth}"
                        MinHeight="{DynamicResource PosPayBackspaceMinHeight}"
                        Margin="8,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center">
                    <Grid Width="{DynamicResource PosPayBackspaceWidth}" Height="{DynamicResource PosPayBackspaceMinHeight}">
                        <!-- 退格键浅红底衬板：旧主题 Opacity=0 不可见（保持白键），长者主题 Opacity=1。
                             内容 Grid 取与按钮相同的宽高，衬板才能铺满整个键而不是只有图标那么大。 -->
                        <Border Background="{DynamicResource PosDangerSoftBrush}"
                                CornerRadius="4"
                                Opacity="{DynamicResource PosPayBackspacePlateOpacity}"
                                IsHitTestVisible="False" />
                        <materialDesign:PackIcon Kind="BackspaceOutline"
                                                 Width="{DynamicResource PosPayBackspaceIconSize}"
                                                 Height="{DynamicResource PosPayBackspaceIconSize}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Grid>
                </Button>
            </Grid>

            <!-- 快捷现金 + 数字键盘：首行固定高度（快捷现金，按钮高 + 6 间隔，长者更高），键盘 4 行吃剩余高度并等分。
                 不显示快捷现金时，首行（Auto）收缩为 0，键盘铺满整块区域，底部不留空。 -->
            <Grid Grid.Row="2" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="192" />
                </Grid.RowDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTenderEntryVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- 五个面额从左到右 $100/$50/$20/$10/$5，宽度按 1 : .956 : .911 : .867 : .82 分配；点击行为仍是 QuickCashCommand（立即加一条现金付款；已有现金行时累加进这一条，直到收够为止）。 -->
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding QuickCashAmounts}"
                              AutomationProperties.AutomationId="PaymentQuickCashAmounts"
                              Height="{DynamicResource PosPayQuickCashRowHeight}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCashSelected}" Value="True" />
                                        <Condition Binding="{Binding IsQuickCashVisible}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:WeightedRowPanel Weights="1 0.956 0.911 0.867 0.82" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.QuickCashCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Label}"
                                    Style="{StaticResource PaymentQuickAmountButtonStyle}">
                                <!-- 「$」缩小成上标，数字是按钮主体；文字色跟随面额色（Foreground）。 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="$"
                                               FontSize="{DynamicResource PosPayQuickCashDollarFontSize}"
                                               FontWeight="Black"
                                               VerticalAlignment="Top"
                                               Margin="0,4,2,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="{Binding Amount, StringFormat={}{0:0.##}, Mode=OneWay}"
                                               FontSize="{DynamicResource PosPayQuickCashFontSize}"
                                               FontWeight="Black"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <UniformGrid Grid.Row="1" Columns="3" Rows="4" Margin="0" AutomationProperties.AutomationId="PaymentNumberKeypad">
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="1" Style="{StaticResource PaymentKeypadButtonStyle}">
                        <TextBlock Text="1" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="2" Style="{StaticResource PaymentKeypadButtonStyle}">
                        <TextBlock Text="2" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="3" Style="{StaticResource PaymentKeypadButtonStyle}">
                        <TextBlock Text="3" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="4" Style="{StaticResource PaymentKeypadButtonStyle}">
                        <TextBlock Text="4" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="5" Style="{StaticResource PaymentKeypadButtonStyle}">
                        <TextBlock Text="5" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="6" Style="{StaticResource PaymentKeypadButtonStyle}">
                        <TextBlock Text="6" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="7" Style="{StaticResource PaymentKeypadButtonStyle}">
                        <TextBlock Text="7" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="8" Style="{StaticResource PaymentKeypadButtonStyle}">
                        <TextBlock Text="8" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="9" Style="{StaticResource PaymentKeypadButtonStyle}">
                        <TextBlock Text="9" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="." Style="{StaticResource PaymentKeypadButtonStyle}">
                        <TextBlock Text="." Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="0" Style="{StaticResource PaymentKeypadButtonStyle}">
                        <TextBlock Text="0" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}"
                            CommandParameter="Clear"
                            Style="{StaticResource PaymentKeypadButtonStyle}"
                            Background="{DynamicResource PosDangerSoftBrush}"
                            BorderBrush="{DynamicResource PosDangerBorderBrush}"
                            BorderThickness="{DynamicResource PosPayClearKeyBorderThickness}"
                            Foreground="{DynamicResource PosDangerTextBrush}">
                        <TextBlock Text="{loc:Loc Clear}" Style="{StaticResource PaymentKeypadFunctionTextStyle}" />
                    </Button>
                </UniformGrid>
            </Grid>

        </Grid>

        <Border Grid.Column="2" Margin="6,12,12,12" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosCardBorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid IsEnabled="{Binding IsManualCardBackgroundEnabled}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding PaymentMethodText}" Margin="14,14,14,12" FontSize="{DynamicResource PosPayMethodTitleFontSize}" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaymentMethodSelectionVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Row="1" Margin="14,0,14,8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaymentMethodSelectionVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Background="{DynamicResource PosSurfaceAltBrush}"
                        BorderBrush="{DynamicResource PosKeyBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsLinklyCloudTerminalSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc payment.linklyTerminal.title}"
                                       FontSize="10"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Click="RefreshLinklyCloudTerminals_Click"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    AutomationProperties.Name="Refresh Linkly terminals">
                                <materialDesign:PackIcon Kind="Refresh" Width="17" Height="17" />
                            </Button>
                        </Grid>
                        <ComboBox ItemsSource="{Binding LinklyCloudTerminals}"
                                  SelectedItem="{Binding SelectedLinklyCloudTerminal, Mode=TwoWay}"
                                  IsEnabled="{Binding CanSwitchLinklyCloudTerminal}"
                                  SelectionChanged="LinklyCloudTerminal_SelectionChanged"
                                  MinHeight="40"
                                  Padding="8,5"
                                  AutomationProperties.AutomationId="PaymentLinklyCloudTerminalSelector">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding LaneNo, StringFormat=Lane {0}}" FontSize="10" FontWeight="Black" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="Bold" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding LinklyCloudTerminalStatusText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="2,5,2,0" />
                    </StackPanel>
                </Border>
                <!-- 信用卡和手动刷卡共用一个位置；关闭代金券时自动收起整行。 -->
                <Grid AutomationProperties.AutomationId="PaymentMethodTiles">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Button Command="{Binding SelectCashCommand}" AutomationProperties.AutomationId="AddCashTenderButton" Style="{StaticResource CashMethodButtonStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource CashMethodDiscStyle}">
                                <materialDesign:PackIcon Kind="Cash" Style="{StaticResource CashMethodIconStyle}" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding CashMethodText}" Style="{StaticResource PaymentMethodTileTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding SelectCardCommand}" AutomationProperties.AutomationId="AddCardTenderButton" Style="{StaticResource CardMethodButtonStyle}" Visibility="{Binding IsIntegratedCardPaymentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource CardMethodDiscStyle}">
                                <materialDesign:PackIcon Kind="CreditCard" Style="{StaticResource CardMethodIconStyle}" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding CardMethodText}" Style="{StaticResource PaymentMethodTileTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <!-- 手动刷卡入口：只是打开确认弹窗的动作按钮，固定刷卡色未选外观，不显示 ✓。 -->
                    <Button Grid.Column="2" Command="{Binding OpenManualCardCommand}" AutomationProperties.AutomationId="ManualCardPaymentButton" Style="{StaticResource ManualCardMethodButtonStyle}" Visibility="{Binding IsManualCardPaymentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource PaymentMethodDiscStyle}" Background="{DynamicResource PosMethodCardFillBrush}">
                                <materialDesign:PackIcon Kind="CreditCard" Style="{StaticResource PaymentMethodIconStyle}" Foreground="{DynamicResource PosMethodCardOnBrush}" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="{loc:Loc payment.manualCard.title}" Style="{StaticResource PaymentMethodTileTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Row="1" Command="{Binding OpenVoucherEntryCommand}"
                            AutomationProperties.AutomationId="AddVoucherTenderButton" Style="{StaticResource VoucherMethodButtonStyle}" Margin="0,8,0,0"
                            Visibility="{Binding IsVoucherPaymentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource VoucherMethodDiscStyle}">
                                <materialDesign:PackIcon Kind="TicketPercent" Style="{StaticResource VoucherMethodIconStyle}" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding VoucherMethodText}" Style="{StaticResource PaymentMethodTileTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <!-- 分期开关并入支付方式区，仍沿用原绑定与可见性（仅付款模式显示）。 -->
                    <ToggleButton Grid.Row="1"
                                  Grid.Column="2"
                                  AutomationProperties.AutomationId="InstallmentPaymentToggle"
                                  AutomationProperties.Name="{Binding InstallmentMethodText}"
                                  ToolTip="{loc:Loc payment.installment.switchHelp}"
                                  ToolTipService.ShowOnDisabled="True"
                                  IsChecked="{Binding IsInstallmentPaymentEnabled, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  MinHeight="100"
                                  Margin="0,8,0,0">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource InstallmentMethodToggleStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstallmentEntryVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInstallmentSwitchLocked}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>
                            <Border Width="46"
                                    Height="26"
                                    CornerRadius="13"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource PosSurfaceStrongBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstallmentPaymentEnabled}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PosPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Ellipse Width="20" Height="20" Fill="{DynamicResource PosSurfaceBrush}" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Margin" Value="3,0,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstallmentPaymentEnabled}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="Margin" Value="0,0,3,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding InstallmentMethodText}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource PaymentMethodTileTextStyle}" />
                        </Grid>
</ToggleButton>
                </Grid>
                <TextBox Text="{Binding VoucherCodeText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{loc:Loc payment.voucher.code}"
                         Height="40"
                         Margin="0,8,0,0">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource PosSearchTextBoxStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVoucherCodeEntryVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>

            <Border Grid.Row="2" Margin="14,8,14,8" Padding="0,12,0,0" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosCardBorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding AppliedTendersText}" FontSize="{DynamicResource PosPayTendersTitleFontSize}" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" Margin="0,0,0,10" />
                    <Grid Grid.Row="1">
                        <TextBlock Text="{Binding NoTendersText}" TextWrapping="Wrap" TextAlignment="Center" Margin="8" Foreground="{DynamicResource PosMutedForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PaymentTenders.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PaymentTenders}" AutomationProperties.AutomationId="AppliedTendersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 已付款项行按付款方式取色：Soft 行底 + Fill 图标块（On 图标）+ Ink 文字/金额，与方式按钮同一套色。 -->
                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                BorderBrush="{DynamicResource PosCardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PosMethodCashSoftBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Card}">
                                                            <Setter Property="Background" Value="{DynamicResource PosMethodCardSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Voucher}">
                                                            <Setter Property="Background" Value="{DynamicResource PosMethodVoucherSoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.RemoveTenderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="{DynamicResource PosPayTenderIconBlockSize}" Height="{DynamicResource PosPayTenderIconBlockSize}" CornerRadius="9" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource PosMethodCashFillBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Card}">
                                                                    <Setter Property="Background" Value="{DynamicResource PosMethodCardFillBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Voucher}">
                                                                    <Setter Property="Background" Value="{DynamicResource PosMethodVoucherFillBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <materialDesign:PackIcon Width="{DynamicResource PosPayTenderIconSize}" Height="{DynamicResource PosPayTenderIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="Cash" />
                                                                <Setter Property="Foreground" Value="{DynamicResource PosMethodCashOnBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Card}">
                                                                        <Setter Property="Kind" Value="CreditCard" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource PosMethodCardOnBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Voucher}">
                                                                        <Setter Property="Kind" Value="TicketPercent" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource PosMethodVoucherOnBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="{DynamicResource PosPayTenderNameFontSize}" FontWeight="Black">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{loc:Loc payment.method.cash}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource PosMethodCashInkBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Card}">
                                                                        <Setter Property="Text" Value="{loc:Loc payment.method.card}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource PosMethodCardInkBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Voucher}">
                                                                        <Setter Property="Text" Value="{loc:Loc payment.method.voucher}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource PosMethodVoucherInkBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding DisplayReference}" TextWrapping="Wrap" FontSize="{DynamicResource PosPayTenderNoteFontSize}" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:C2}}" VerticalAlignment="Center" FontSize="{DynamicResource PosPayTenderAmountFontSize}" FontWeight="Black">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource PosMethodCashInkBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Card}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PosMethodCardInkBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Voucher}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PosMethodVoucherInkBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="3" Command="{Binding DataContext.RemoveTenderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" services:ButtonFeedback.Cue="Delete" Width="36" Height="44" Margin="4,0,0,0" Style="{StaticResource TitleBarButtonStyle}">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" VerticalAlignment="Top">
            <!-- 刷卡进行中面板：沿用一键扣款流程，只展示终端、金额与等待状态，取消仍用底部取消按钮。 -->
            <Border AutomationProperties.AutomationId="CardPaymentProgressPanel"
                    Margin="14,0,14,8" Padding="12"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosPrimaryBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCardPaymentInProgress}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource PosPrimarySoftBrush}" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CreditCard" Width="20" Height="20" Foreground="{DynamicResource PosPrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CardMethodText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" />
                            <TextBlock Text="{Binding SelectedLinklyCloudTerminalText}" FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLinklyCloudTerminalSelectorVisible}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding CardPaymentAmount, StringFormat={}{0:C2}}"
                               AutomationProperties.AutomationId="CardPaymentProgressAmount"
                               Margin="0,10,0,0" FontSize="30" FontWeight="Black"
                               Foreground="{DynamicResource PosPrimaryTextBrush}" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,8" Foreground="{DynamicResource PosPrimaryBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                </StackPanel>
            </Border>
            <Border Margin="14,0,14,8" Padding="10" Background="{DynamicResource PosPrimarySoftBrush}" BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCardPaymentInProgress}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" Margin="0,0,8,0" Background="{DynamicResource PosPrimaryBrush}" CornerRadius="12" VerticalAlignment="Top">
                        <materialDesign:PackIcon Kind="Information" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PosIconBrush}" VerticalAlignment="Center" />
                        <Button Command="{Binding CardPaymentErrorPrimaryActionCommand}"
                                AutomationProperties.AutomationId="RecoverPreviousCardTransactionButton"
                                MinWidth="148"
                                Height="40"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPaymentInteractionLocked}" Value="True" />
                                                <Condition Binding="{Binding CardPaymentErrorOverlay.HasPrimaryAction}" Value="True" />
                                                <Condition Binding="{Binding CardPaymentErrorOverlay.PrimaryActionKind}"
                                                           Value="{x:Static vm:CardPaymentErrorOverlayPrimaryActionKind.RecoverPrevious}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding CardPaymentErrorOverlay.PrimaryButtonTextKey, Converter={StaticResource LocalizationKeyConverter}}"
                                       Foreground="White"
                                       FontWeight="Bold" />
                        </Button>
                        <Button Command="{Binding OpenCardRecoveryCenterCommand}"
                                AutomationProperties.AutomationId="OpenCardRecoveryCenterFromCardErrorButton"
                                MinWidth="148"
                                Height="40"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPaymentInteractionLocked}" Value="True" />
                                                <Condition Binding="{Binding IsCardPaymentRecoveryRequired}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{loc:Loc payment.card.error.overlay.activeSession.openCenter}"
                                       FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            </StackPanel>

            <Grid Grid.Row="4" Margin="14,0,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.8*" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding CancelCommand}" Height="{DynamicResource PosPayCancelButtonHeight}" Margin="0,0,8,0" Padding="6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                            <Setter Property="Background" Value="{DynamicResource PosCancelButtonBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PosKeyBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PosCancelButtonForegroundBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCancelPaymentVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding CancelText}" FontWeight="Bold" FontSize="{DynamicResource PosPayCancelFontSize}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button Command="{Binding ConfirmPaymentCommand}"
                        AutomationProperties.AutomationId="ConfirmPaymentButton"
                        Height="{DynamicResource PosPayConfirmButtonHeight}" HorizontalContentAlignment="Stretch" Padding="10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PaymentConfirmButtonStyle}">
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                            <Setter Property="Margin" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCancelPaymentVisible}" Value="True">
                                    <Setter Property="Grid.Column" Value="1" />
                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                    <Setter Property="Margin" Value="8,0,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource PosPayConfirmIconColumnWidth}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="CheckCircle" Width="{DynamicResource PosPayConfirmIconSize}" Height="{DynamicResource PosPayConfirmIconSize}" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ConfirmPaymentText}" Foreground="White" FontSize="{DynamicResource PosPayConfirmFontSize}" FontWeight="Black" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>
        </Border>

        <Grid Grid.ColumnSpan="3" Panel.ZIndex="25" Background="#99000000"
              AutomationProperties.AutomationId="ManualCardConfirmationDialog"
              KeyboardNavigation.TabNavigation="Cycle"
              Visibility="{Binding IsManualCardDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="580" Padding="28" Background="{DynamicResource PosSurfaceBrush}" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{loc:Loc payment.manualCard.title}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" />
                    <TextBlock Text="{loc:Loc payment.manualCard.instructions}" FontSize="17" TextWrapping="Wrap" Margin="0,16,0,20" />
                    <TextBlock Text="{loc:Loc payment.manualCard.amount}" FontSize="16" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                    <TextBlock Text="{Binding ManualCardAmount, StringFormat={}{0:C2}}" FontSize="44" FontWeight="Bold"
                               AutomationProperties.AutomationId="ManualCardConfirmationAmount" Margin="0,4,0,18" />
                    <CheckBox x:Name="ManualCardSuccessCheckBox" IsChecked="{Binding IsManualCardSuccessChecked}" MinHeight="52"
                              AutomationProperties.AutomationId="ManualCardSuccessCheckBox">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaymentInteractionLocked}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                        <TextBlock Text="{loc:Loc payment.manualCard.checked}" FontSize="16" TextWrapping="Wrap" MaxWidth="460" />
                    </CheckBox>
                    <TextBlock Text="{loc:Loc payment.manualCard.uncertain}" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,12,0,12" />
                    <TextBlock Text="{Binding ManualCardDialogStatusMessage}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Command="{Binding CancelManualCardCommand}" Style="{StaticResource PosSecondaryButtonStyle}" MinHeight="58"
                                AutomationProperties.AutomationId="ManualCardCancelButton">
                            <TextBlock Text="{loc:Loc payment.manualCard.cancel}" FontSize="16" FontWeight="Bold" />
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ConfirmManualCardCommand}" Style="{StaticResource PosPrimaryButtonStyle}" MinHeight="58"
                                AutomationProperties.AutomationId="ManualCardConfirmButton">
                            <TextBlock Text="{loc:Loc payment.manualCard.confirm}" FontSize="16" FontWeight="Bold" Foreground="White" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="3" Panel.ZIndex="26" Background="#99000000"
              Visibility="{Binding IsManualCardSavePending, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="580" Padding="28" Background="{DynamicResource PosSurfaceBrush}" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{loc:Loc payment.manualCard.savingTitle}" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="{loc:Loc payment.manualCard.saveHint}" FontSize="17" TextWrapping="Wrap" Margin="0,18,0,18" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,18" />
                    <Button Command="{Binding RetryManualCardSaveCommand}" MinHeight="58" Style="{StaticResource PosPrimaryButtonStyle}"
                            AutomationProperties.AutomationId="RetryManualCardSaveButton">
                        <TextBlock Text="{loc:Loc payment.manualCard.retrySave}" FontSize="17" FontWeight="Bold" Foreground="White" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="3"
              Panel.ZIndex="20"
              Background="#99000000"
              Visibility="{Binding IsVoucherEntryDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="620"
                    MaxWidth="620"
                    Padding="22"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="{DynamicResource PosSuccessSoftBrush}" CornerRadius="10">
                            <materialDesign:PackIcon Kind="TicketPercent"
                                                     Width="26"
                                                     Height="26"
                                                     Foreground="{DynamicResource PosSuccessTextBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc payment.voucher.dialogTitle}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosPrimaryTextBrush}" />
                        <Button Grid.Column="2"
                                Command="{Binding CancelVoucherEntryCommand}"
                                Width="34"
                                Height="34"
                                Padding="0"
                                Style="{StaticResource TitleBarButtonStyle}">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{loc:Loc payment.voucher.scanOrEnter}"
                               Margin="0,14,0,10"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PosMutedForegroundBrush}" />

                    <!-- 代金券码是扫码专用输入，关闭中文输入法，避免字母条码进入组合输入后丢失。 -->
                    <TextBox x:Name="VoucherEntryTextBox"
                             Grid.Row="2"
                             Text="{Binding VoucherEntryText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{loc:Loc payment.voucher.code}"
                             InputMethod.IsInputMethodEnabled="False"
                             InputMethod.PreferredImeState="Off"
                             Height="56"
                             FontSize="24"
                             FontWeight="Black"
                             CharacterCasing="Upper"
                             Style="{StaticResource PosSearchTextBoxStyle}" />

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="6">
                            <Button Content="1" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="1" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="2" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="2" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="3" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="3" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="4" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="4" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="5" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="5" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="6" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="6" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="7" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="7" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="8" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="8" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="9" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="9" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="0" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="0" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="-" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="-" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Command="{Binding VoucherEntryKeyCommand}" CommandParameter="Back" Style="{StaticResource VoucherEntryKeyButtonStyle}">
                                <materialDesign:PackIcon Kind="BackspaceOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Content="A" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="A" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="B" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="B" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="C" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="C" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="D" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="D" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="E" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="E" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="F" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="F" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="G" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="G" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="H" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="H" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="I" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="I" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="J" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="J" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="K" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="K" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="L" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="L" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="M" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="M" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="N" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="N" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="O" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="O" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="P" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="P" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="Q" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="Q" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="R" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="R" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="S" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="S" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="T" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="T" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="U" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="U" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="V" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="V" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="W" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="W" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="X" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="X" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="Y" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="Y" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Content="Z" Command="{Binding VoucherEntryKeyCommand}" CommandParameter="Z" Style="{StaticResource VoucherEntryKeyButtonStyle}" />
                            <Button Command="{Binding VoucherEntryKeyCommand}" CommandParameter="Clear" Style="{StaticResource VoucherEntryKeyButtonStyle}">
                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </UniformGrid>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{Binding CancelVoucherEntryCommand}"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    MinHeight="48">
                                <TextBlock Text="{Binding CancelText}" FontWeight="Black" />
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding ConfirmVoucherEntryCommand}"
                                    Style="{StaticResource PosPrimaryButtonStyle}"
                                    MinHeight="48">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:Loc payment.voucher.confirm}" FontWeight="Black" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Lay-by 订单总额不足起订金额的提示：只有一个「知道了」，盖在分期客户信息弹窗之上（ZIndex 22），不影响其它状态。 -->
        <Grid Grid.ColumnSpan="3"
              Panel.ZIndex="22"
              Background="#99000000"
              AutomationProperties.AutomationId="InstallmentMinimumNotice"
              Visibility="{Binding IsInstallmentMinimumNoticeOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="520"
                    MaxWidth="520"
                    Padding="22"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="10">
                            <materialDesign:PackIcon Kind="InformationOutline"
                                                     Width="26"
                                                     Height="26"
                                                     Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc payment.installment.minimumNotice.title}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="22"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosPrimaryTextBrush}" />
