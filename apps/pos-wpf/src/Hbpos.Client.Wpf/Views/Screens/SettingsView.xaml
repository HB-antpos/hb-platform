<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
             xmlns:controls="clr-namespace:Hbpos.Client.Wpf.Views.Controls"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:Hbpos.Client.Wpf.Services"
             mc:Ignorable="d"
             d:DesignHeight="632"
             d:DesignWidth="1366"
             FontFamily="Segoe UI"
             Background="{DynamicResource PosScreenBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:LocalizationKeyConverter x:Key="LocalizationKeyConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <converters:ReceiptQrCodeImageSourceConverter x:Key="QrCodeImage" />

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- 单行输入框不接管触摸平移，让所在页面容器（SettingsPageHost）内的 ScrollViewer 处理纵向拖动。 -->
        <Style x:Key="SettingsFieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PosSearchTextBoxStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="ScrollViewer.PanningMode" Value="None" />
            <!-- 只读（例如总部下发的小票资料）用浅一级底色提示不可编辑，文字仍可选中复制。 -->
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsFieldPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.PanningMode" Value="None" />
        </Style>

        <!-- 系统默认下拉框模板的底色写死为浅灰渐变，深色主题下会变成浅字压浅底；
             改为继承 MaterialDesign 下拉框（与历史、卡交易异常中心一致），底色与弹出层随主题切换。 -->
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 左侧导航项：固定 48 高、间距 6，字号 15 SemiBold（选中 Bold）；英文长标签在项内换行，不截断。 -->
        <Style x:Key="SettingsCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="4,1,1,1" />
                    <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <!-- 选中态左边线 4px（平时 1px），左内边距相应少 3px，文字不位移。 -->
                    <Setter Property="Padding" Value="9,0,12,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsActionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
        </Style>

        <Style x:Key="SettingsPageDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- 服务商选择做成大卡片：整卡可点，选中时蓝框+浅蓝底，适合触屏。 -->
        <Style x:Key="SettingsProviderTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,14,16" />
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="MinWidth" Value="280" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="ProviderTabBorder"
                                Background="{DynamicResource PosSurfaceBrush}"
                                BorderBrush="{DynamicResource PosBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="12"
                                Padding="18,12">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ProviderTabBorder" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                <Setter TargetName="ProviderTabBorder" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ProviderTabBorder" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsModeChoiceBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                             Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 分段控件：一组 RadioButton 放在浅灰底槽里，选中段为白底凸起，整段 52px 高便于触屏。 -->
        <Style x:Key="SettingsSegmentHostStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style x:Key="SettingsSegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 触屏选择列表：每项是一张 64px 高的卡片，左侧单选圆点；不带内部滚动，交给页面容器（SettingsPageHost）的兜底滚动。 -->
        <Style x:Key="SettingsTouchListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.PanningMode" Value="None" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="MinHeight" Value="64" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{DynamicResource PosSurfaceBrush}"
                                            BorderBrush="{DynamicResource PosBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="12"
                                            Padding="16,10">
                                        <DockPanel>
                                            <Border x:Name="RadioOuter"
                                                    DockPanel.Dock="Left"
                                                    Width="26"
                                                    Height="26"
                                                    CornerRadius="13"
                                                    BorderThickness="2"
                                                    BorderBrush="{DynamicResource PosBorderStrongBrush}"
                                                    Background="{DynamicResource PosSurfaceBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,14,0">
                                                <Ellipse x:Name="RadioDot"
                                                         Width="12"
                                                         Height="12"
                                                         Fill="{DynamicResource PosPrimaryBrush}"
                                                         Visibility="Collapsed" />
                                            </Border>
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                            <Setter TargetName="RadioOuter" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                            <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置分区卡片标题与步骤序号。 -->
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
        </Style>

        <Style x:Key="SettingsStepBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource PosPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsStepBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsTouchButtonHeight" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="18,0" />
        </Style>
        <!-- 页头保存状态：已保存（绿）/ 正在保存（灰）/ 未保存（红）。 -->
        <Style x:Key="SettingsSaveChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PageSaveStatus}" Value="Saved">
                    <Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PageSaveStatus}" Value="Unsaved">
                    <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSaveChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PageSaveStatus}" Value="Saved">
                    <Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PageSaveStatus}" Value="Unsaved">
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 分区保存状态小字（放在卡片标题右侧）：Tag 绑定该分区的 SaveState；已保存时文字为空、整行折叠。 -->
        <Style x:Key="SettingsSectionStateTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Draft">
                    <Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 分页标签上的红点：该分页有保存失败或未生效的修改。 -->
        <Style x:Key="SettingsUnsavedDotStyle" TargetType="Border">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="4.5" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PosDangerBrush}" />
        </Style>

        <!-- 左侧导航的未保存数量角标。 -->
        <Style x:Key="SettingsNavBadgeStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PosDangerBrush}" />
        </Style>

        <!-- 页内分页（支付终端、小票打印机）：沿用分段控件外观，每段至少 150px 宽、48px 高。 -->
        <Style x:Key="SettingsSubTabRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource SettingsSegmentRadioStyle}">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 顶栏（52）：返回收银 | 面包屑「设置 / 页面名」| 页面说明（单行省略）| 保存状态芯片 + 小票页「测试打印」。
             取代旧的顶部条、固定页头和右上角上下文徽标（徽标只是重复标题，不是功能）。 -->
        <Border Grid.Row="0"
                Background="{DynamicResource PosSurfaceBrush}"
                BorderBrush="{DynamicResource PosDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Height="40"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc shell.backToPos}" />
                    </StackPanel>
                </Button>
                <!-- 面包屑：设置 / 当前页面名（二级页签名不放这里）。 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <TextBlock Text="{Binding ScreenTitleText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PosMutedForegroundBrush}" />
                    <TextBlock Text="/"
                               Margin="8,0"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PosSubtleForegroundBrush}" />
                    <TextBlock Text="{Binding PageTitleText}"
                               FontSize="18"
                               FontWeight="Black"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PosTextBrush}" />
                </StackPanel>
                <!-- 页面说明：面包屑右侧单行，放不下时省略。 -->
                <TextBlock Grid.Column="2"
                           Text="{Binding PageDescriptionText}"
                           Margin="16,0"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SettingsSaveChipStyle}"
                            Visibility="{Binding IsPageSaveStatusVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PageSaveStatusText}"
                                       Style="{StaticResource SettingsSaveChipTextStyle}" />
                            <Button Command="{Binding RetryFailedSavesCommand}"
                                    Visibility="{Binding CanRetryPageSaves, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    MinHeight="32"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="10,0,0,0">
                                <TextBlock Text="{loc:Loc settings.autosave.page.retry}" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- 测试打印放在顶栏：小票页三个分页都能直接点；小票设置已自动保存，测试只打印。 -->
                    <Button Command="{Binding TestReceiptPrinterCommand}"
                            Visibility="{Binding IsReceiptPrinterSelected, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource PosPrimaryButtonStyle}"
                            Height="44"
                            MinWidth="150"
                            Padding="18,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" Margin="0,0,8,0" Foreground="White" />
                            <TextBlock Text="{loc:Loc settings.receiptPrinter.test}" Foreground="White" FontSize="16" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区外框：边距 12；导航列 200 宽、与内容间距 12。 -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 导航先于内容声明，使键盘 Tab 顺序与左到右的视觉顺序一致。
                 六项（48 高、间距 6、内边距 10）合计 6×48 + 5×6 + 20 ≈ 340，在 632 高度内完整可见。 -->
            <Border Grid.Column="0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10">
                <StackPanel>
                <Button Command="{Binding SelectDataMaintenanceCommand}"
                        Tag="{Binding IsDataMaintenanceSelected}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <!-- 内容宽度固定 152 = 导航项宽 178 - 左右边线/内边距（选中与未选中都是 152）：Button 模板把内容居中，固定宽度才能让图标、文字左对齐、角标靠右。 -->
                    <Grid Width="152">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="DatabaseSyncOutline"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <!-- 英文长标签允许换行（行高 1.15，按钮固定 48 高可容纳两行）。 -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DataMaintenanceTitleText}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <Border Grid.Column="2"
                                Style="{StaticResource SettingsNavBadgeStyle}"
                                Visibility="{Binding HasDataMaintenanceUnsaved, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding DataMaintenanceUnsavedCount}" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <Button Command="{Binding SelectPaymentTerminalCommand}"
                        Tag="{Binding IsPaymentTerminalSelected}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <!-- 内容宽度固定 152 = 导航项宽 178 - 左右边线/内边距（选中与未选中都是 152）：Button 模板把内容居中，固定宽度才能让图标、文字左对齐、角标靠右。 -->
                    <Grid Width="152">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="ContactlessPayment"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <!-- 英文长标签允许换行（行高 1.15，按钮固定 48 高可容纳两行）。 -->
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc settings.category.paymentTerminal}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <Border Grid.Column="2"
                                Style="{StaticResource SettingsNavBadgeStyle}"
                                Visibility="{Binding HasPaymentTerminalUnsaved, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding PaymentTerminalUnsavedCount}" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <Button Command="{Binding SelectReceiptPrinterCommand}"
                        Tag="{Binding IsReceiptPrinterSelected}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <!-- 内容宽度固定 152 = 导航项宽 178 - 左右边线/内边距（选中与未选中都是 152）：Button 模板把内容居中，固定宽度才能让图标、文字左对齐、角标靠右。 -->
                    <Grid Width="152">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="Printer"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <!-- 英文长标签允许换行（行高 1.15，按钮固定 48 高可容纳两行）。 -->
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc settings.category.receiptPrinter}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <Border Grid.Column="2"
                                Style="{StaticResource SettingsNavBadgeStyle}"
                                Visibility="{Binding HasReceiptPrinterUnsaved, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ReceiptPrinterUnsavedCount}" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <Button Command="{Binding SelectDeviceRegistrationCommand}"
                        Tag="{Binding IsDeviceRegistrationSelected}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <!-- 内容宽度固定 152 = 导航项宽 178 - 左右边线/内边距（选中与未选中都是 152）：Button 模板把内容居中，固定宽度才能让图标、文字左对齐、角标靠右。 -->
                    <Grid Width="152">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="CashRegister"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <!-- 英文长标签允许换行（行高 1.15，按钮固定 48 高可容纳两行）。 -->
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc settings.category.deviceRegistrationNav}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <Border Grid.Column="2"
                                Style="{StaticResource SettingsNavBadgeStyle}"
                                Visibility="{Binding HasDeviceRegistrationUnsaved, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding DeviceRegistrationUnsavedCount}" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <Button Command="{Binding SelectRemoteMaintenanceCommand}"
                        Tag="{Binding IsRemoteMaintenanceSelected}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <!-- 内容宽度固定 152 = 导航项宽 178 - 左右边线/内边距（选中与未选中都是 152）：Button 模板把内容居中，固定宽度才能让图标、文字左对齐、角标靠右。 -->
                    <Grid Width="152">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="RemoteDesktop"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <!-- 英文长标签允许换行（行高 1.15，按钮固定 48 高可容纳两行）。 -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding RemoteMaintenanceTitleText}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Grid>
                </Button>

                <Button Command="{Binding SelectMobileAppDownloadCommand}"
                        Tag="{Binding IsMobileAppDownloadSelected}"
                        Style="{StaticResource SettingsCategoryButtonStyle}"
                        Margin="0">
                    <!-- 内容宽度固定 152 = 导航项宽 178 - 左右边线/内边距（选中与未选中都是 152）：Button 模板把内容居中，固定宽度才能让图标、文字左对齐、角标靠右。 -->
                    <Grid Width="152">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="CellphoneArrowDown"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <!-- 英文长标签允许换行（行高 1.15，按钮固定 48 高可容纳两行）。 -->
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc settings.category.mobileAppDownload}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Grid>
                </Button>
                </StackPanel>
            </Border>

            <!-- 六个分类页面并列放在同一个单元格里，靠各自的 Visibility 绑定互斥显示；
                 不再有外层 ScrollViewer，每页由 SettingsPageHost 自带兜底滚动与固定底栏。 -->
            <Grid Grid.Column="2">
                <!-- ===== PAGE: DataMaintenance BEGIN ===== -->
                <controls:SettingsPageHost Style="{StaticResource SettingsPageHostStyle}"
                                           Visibility="{Binding IsDataMaintenanceSelected, Converter={StaticResource BoolToVis}}">
                    <!-- SettingsPageHost 槽位：SubTabs（二级页签条）/ Footer（固定底部操作条）；阶段 A 暂不使用，阶段 B 逐页迁移。 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource SettingsActionCardStyle}"
                                MinHeight="208">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0"
                                                             Kind="CloudDownloadOutline"
                                                             Width="48"
                                                             Height="48"
                                                             Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Loc settings.section.dataDownload.title}"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   Foreground="{DynamicResource PosTextBrush}" />
                                        <TextBlock Text="{loc:Loc settings.section.dataDownload.description}"
                                                   Style="{StaticResource SettingsPageDescriptionStyle}" />
                                    </StackPanel>
                                </Grid>
                                <!-- 同步时间与同步状态合并展示；页面级操作提示仍由底部状态栏显示。 -->
                                <Border x:Name="CatalogSyncStatusPanel"
                                        Grid.Row="1"
                                        Background="{DynamicResource PosSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource PosDividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="72,14,0,0">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ClockOutline"
                                                                         Width="14"
                                                                         Height="14"
                                                                         Margin="0,0,6,0"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                                <TextBlock Text="{Binding CatalogSyncTimeLabelText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                            </StackPanel>
                                            <Grid DockPanel.Dock="Right">
                                                <Border Background="{DynamicResource PosSuccessSoftBrush}"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        Visibility="{Binding IsCatalogSyncSucceeded, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource PosSuccessTextBrush}" />
                                                        <TextBlock Text="{loc:Loc settings.section.dataDownload.state.synced}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosSuccessTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{DynamicResource PosPrimarySoftBrush}"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        Visibility="{Binding IsCatalogSyncing, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Sync" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                                        <TextBlock Text="{loc:Loc settings.section.dataDownload.state.syncing}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{DynamicResource PosDangerSoftBrush}"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        Visibility="{Binding IsCatalogSyncFailed, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="AlertCircleOutline" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource PosDangerTextBrush}" />
                                                        <TextBlock Text="{loc:Loc settings.section.dataDownload.state.failed}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PosDangerTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DockPanel>
                                        <TextBlock Text="{Binding CatalogSyncTimeText}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource PosTextBrush}" />
                                        <ProgressBar Height="4"
                                                     Margin="0,8,0,0"
                                                     IsIndeterminate="True"
                                                     Visibility="{Binding IsCatalogSyncing, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding CatalogSyncFailureText}"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PosDangerTextBrush}"
                                                   Visibility="{Binding IsCatalogSyncFailed, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                                <Button Grid.Row="2"
                                        Command="{Binding DownloadCatalogCommand}"
                                        services:ButtonFeedback.Cue="Download"
                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                        Height="42"
                                        MinWidth="138"
                                        HorizontalAlignment="Left"
                                        Margin="72,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                        <TextBlock Text="{loc:Loc settings.section.dataDownload.action}" Foreground="White" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource SettingsActionCardStyle}"
                                MinHeight="208">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0"
                                                             Kind="DatabaseRefreshOutline"
                                                             Width="48"
                                                             Height="48"
                                                             Foreground="{DynamicResource PosAccentBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Loc settings.section.dataReset.title}"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   Foreground="{DynamicResource PosTextBrush}" />
                                        <TextBlock Text="{loc:Loc settings.section.dataReset.description}"
                                                   Style="{StaticResource SettingsPageDescriptionStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Button Grid.Row="2"
                                        Command="{Binding ResetCatalogCommand}"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Height="42"
                                        MinWidth="154"
                                        HorizontalAlignment="Center"
                                        Margin="0,18,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DatabaseRefreshOutline" Width="18" Height="18" Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:Loc settings.section.dataReset.action}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource SettingsActionCardStyle}"
                                Margin="0,16,0,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="52"
                                        Height="52"
                                        Background="{DynamicResource PosSuccessSoftBrush}"
                                        CornerRadius="10"
                                        Margin="0,0,16,0">
                                    <materialDesign:PackIcon Kind="Update"
                                                             Width="28"
                                                             Height="28"
                                                             Foreground="{DynamicResource PosSuccessTextBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding CheckForAppUpdateCommand}"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Height="42"
                                        MinWidth="154"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Update" Width="18" Height="18" Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:Loc settings.section.appUpdate.action}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc settings.section.appUpdate.title}"
                                               FontSize="18"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource PosTextBrush}" />
                                    <TextBlock Text="{loc:Loc settings.section.appUpdate.description}"
                                               Style="{StaticResource SettingsPageDescriptionStyle}" />
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               Margin="0,5,0,0">
                                        <Run Text="{loc:Loc settings.section.appUpdate.channel}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding AppUpdateChannelText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="3"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource SettingsActionCardStyle}"
                                Background="{DynamicResource PosDangerSoftBrush}"
                                BorderBrush="{DynamicResource PosDangerBorderBrush}"
                                Margin="0,16,0,0"
                                Visibility="{Binding IsDebugTestSalesDataResetVisible, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="52"
                                        Height="52"
                                        Background="{DynamicResource PosDangerSoftBrush}"
                                        CornerRadius="10"
                                        Margin="0,0,16,0">
                                    <materialDesign:PackIcon Kind="DeleteOutline"
                                                             Width="28"
                                                             Height="28"
                                                             Foreground="{DynamicResource PosDangerTextBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding ResetTestSalesDataCommand}"
                                        services:ButtonFeedback.Cue="Delete"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        Height="42"
                                        MinWidth="168"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,8,0" Foreground="{DynamicResource PosDangerTextBrush}" />
                                        <TextBlock Text="{loc:Loc settings.section.testSalesDataReset.action}" Foreground="{DynamicResource PosDangerTextBrush}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc settings.section.testSalesDataReset.title}"
                                               FontSize="18"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource PosDangerTextBrush}" />
                                    <TextBlock Text="{loc:Loc settings.section.testSalesDataReset.description}"
                                               Style="{StaticResource SettingsPageDescriptionStyle}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 日结后提醒重启：设备级开关，立即保存，默认开启。 -->
                        <Border Grid.Row="4"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource SettingsActionCardStyle}"
                                Margin="0,16,0,0"
                                Visibility="{Binding IsRestartPromptSettingVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                            <Grid MinHeight="72">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="12"
                                        Background="{DynamicResource PosSurfaceAltBrush}"
                                        Margin="0,0,14,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Restart" Width="22" Height="22"
                                                             Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc settings.restartPrompt.toggle}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc settings.restartPrompt.description}"
                                               TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,4,0,0" />
                                    <TextBlock Text="{loc:Loc settings.restartPrompt.toggle.help}"
                                               TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RestartPromptSaveStateText}"
                                               Tag="{Binding RestartPromptSaveState}"
                                               Style="{StaticResource SettingsSectionStateTextStyle}"
                                               Margin="0,0,12,0" />
                                    <ToggleButton x:Name="RestartPromptSettingToggle"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding IsRestartPromptEnabled, Mode=TwoWay}"
                                                  AutomationProperties.Name="{loc:Loc settings.restartPrompt.toggle}"
                                                  MinHeight="48" MinWidth="56" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource PosDividerBrush}" Margin="0,6"
                                    Visibility="{Binding IsRestartComputerTestVisible, Converter={StaticResource BoolToVis}}" />
                            <Grid MinHeight="72"
                                  Visibility="{Binding IsRestartComputerTestVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="12"
                                        Background="{DynamicResource PosSurfaceAltBrush}"
                                        Margin="0,0,14,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="PowerCycle" Width="22" Height="22"
                                                             Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc settings.restartTest.title}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc settings.restartTest.help}"
                                               TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="RestartComputerTestButton"
                                        Command="{Binding RestartComputerCommand}"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        MinHeight="48" MinWidth="168" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Restart" Width="18" Height="18" Margin="0,0,8,0"
                                                                 Foreground="{DynamicResource PosDangerTextBrush}" />
                                        <TextBlock Text="{loc:Loc settings.restartTest.button}" Foreground="{DynamicResource PosDangerTextBrush}" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </controls:SettingsPageHost>
                <!-- ===== PAGE: DataMaintenance END ===== -->

                <!-- ===== PAGE: PaymentTerminal BEGIN ===== -->
                <controls:SettingsPageHost Style="{StaticResource SettingsPageHostStyle}"
                                           Visibility="{Binding IsPaymentTerminalSelected, Converter={StaticResource BoolToVis}}">
                    <!-- SettingsPageHost 槽位：SubTabs（二级页签条）/ Footer（固定底部操作条）；阶段 A 暂不使用，阶段 B 逐页迁移。 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ===== PAGE: PaymentTerminal / PaymentSubTabs BEGIN ===== -->
                        <!-- 分页：付款方式 / Square / ANZ Linkly；有未保存修改的分页带红点。 -->
                        <Border Grid.Row="0" Grid.ColumnSpan="3"
                                Style="{StaticResource SettingsSegmentHostStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="PaymentSubTabs"
                                             Style="{StaticResource SettingsSubTabRadioStyle}"
                                             IsChecked="{Binding IsPaymentMethodsSubTabSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="TuneVariant" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc settings.subtab.paymentMethods}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource SettingsUnsavedDotStyle}" Visibility="{Binding HasPaymentMethodsUnsaved, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="PaymentSubTabs"
                                             Style="{StaticResource SettingsSubTabRadioStyle}"
                                             IsChecked="{Binding IsSquareSubTabSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SquareRoundedOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SquareTitleText}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource SettingsUnsavedDotStyle}" Visibility="{Binding HasSquareUnsaved, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="PaymentSubTabs"
                                             Style="{StaticResource SettingsSubTabRadioStyle}"
                                             IsChecked="{Binding IsLinklySubTabSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CreditCardWirelessOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LinklyTitleText}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource SettingsUnsavedDotStyle}" Visibility="{Binding HasLinklyUnsaved, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <!-- ===== PAGE: PaymentTerminal / PaymentSubTabs END ===== -->

                        <!-- ===== PAGE: PaymentTerminal / PaymentMethods BEGIN ===== -->
                        <!-- 付款方式：三个大开关（手动刷卡 / 代金券 / 付款页订单列表），共用一个保存按钮（不触发终端配置写入）。 -->
                        <Border Grid.Row="1" Grid.Column="0"
                                Style="{StaticResource SettingsActionCardStyle}"
                                Visibility="{Binding IsPaymentMethodsSubTabSelected, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding PaymentMethodsSaveStateText}"
                                               Tag="{Binding PaymentMethodsSaveState}"
                                               Style="{StaticResource SettingsSectionStateTextStyle}" />
                                    <TextBlock Text="{loc:Loc settings.payment.methods.title}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                </DockPanel>
                                <TextBlock Text="{loc:Loc settings.payment.methods.description}"
                                           Style="{StaticResource SettingsPageDescriptionStyle}" Margin="0,4,0,10" />
                                <Grid MinHeight="72">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="12"
                                            Background="{DynamicResource PosSurfaceAltBrush}"
                                            Margin="0,0,14,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CreditCardOutline" Width="22" Height="22"
                                                                 Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc settings.payment.methods.manualCard}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc settings.payment.methods.manualCard.help}"
                                                   TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" x:Name="ManualCardSettingToggle"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding UseManualCard, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanChangeEnvironment}"
                                                  AutomationProperties.Name="{loc:Loc settings.payment.methods.manualCard}"
                                                  MinHeight="48" MinWidth="56" VerticalAlignment="Center">
                                    </ToggleButton>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource PosDividerBrush}" Margin="0,6" />
                                <Grid MinHeight="72">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="12"
                                            Background="{DynamicResource PosSurfaceAltBrush}"
                                            Margin="0,0,14,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="TicketPercentOutline" Width="22" Height="22"
                                                                 Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc settings.payment.methods.voucher}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc settings.payment.methods.voucher.help}"
                                                   TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" x:Name="VoucherSettingToggle"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding VoucherEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanChangeEnvironment}"
                                                  AutomationProperties.Name="{loc:Loc settings.payment.methods.voucher}"
                                                  MinHeight="48" MinWidth="56" VerticalAlignment="Center">
                                    </ToggleButton>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource PosDividerBrush}" Margin="0,6" />
                                <!-- 付款页显示订单列表：默认开启，按本机保存，与上面两项共用同一个保存按钮。
                                     它只是付款页的布局偏好，不涉及支付环境，所以不绑定 CanChangeEnvironment，始终可切换。 -->
                                <Grid MinHeight="72">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="12"
                                            Background="{DynamicResource PosSurfaceAltBrush}"
                                            Margin="0,0,14,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="22" Height="22"
                                                                 Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc settings.payment.methods.orderList}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc settings.payment.methods.orderList.help}"
                                                   TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" x:Name="OrderListSettingToggle"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding ShowOrderList, Mode=TwoWay}"
                                                  AutomationProperties.Name="{loc:Loc settings.payment.methods.orderList}"
                                                  MinHeight="48" MinWidth="56" VerticalAlignment="Center">
                                    </ToggleButton>
                                </Grid>
                                <Button Command="{Binding SavePaymentMethodsCommand}"
                                        Visibility="{Binding IsExplicitSaveVisible, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                        HorizontalAlignment="Right" MinHeight="52" MinWidth="168" Margin="0,10,0,0">
                                    <TextBlock Text="{loc:Loc settings.payment.methods.save}" Foreground="White" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 当前生效的服务商摘要。 -->
                        <Border Grid.Row="1" Grid.Column="2"
                                Style="{StaticResource SettingsActionCardStyle}"
                                Visibility="{Binding IsPaymentMethodsSubTabSelected, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left"
                                            Width="52" Height="52"
                                            Background="{DynamicResource PosPrimarySoftBrush}"
                                            CornerRadius="12"
                                            Margin="0,0,14,0">
                                        <materialDesign:PackIcon Kind="ContactlessPayment" Width="28" Height="28"
                                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc settings.payment.activeProvider.title}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                        <TextBlock Text="{Binding ActivePaymentProviderText}"
                                                   FontSize="20" FontWeight="Black"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding ActivePaymentProviderDetailText}"
                                           FontSize="13"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="20"
                                           Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- ===== PAGE: PaymentTerminal / PaymentMethods END ===== -->

                        <TabControl Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    AutomationProperties.AutomationId="PaymentProviderTabs"
                                    SelectedIndex="{Binding SelectedProviderTabIndex, Mode=TwoWay}"
                                    Visibility="{Binding IsProviderSubTabSelected, Converter={StaticResource BoolToVis}}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">
                            <TabControl.Resources>
                                <!-- 标签头由上方分页条代替；TabControl 只负责按 SelectedProviderTabIndex 显示 Square / Linkly 内容。 -->
                                <Style TargetType="TabItem" BasedOn="{StaticResource SettingsProviderTabStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                            </TabControl.Resources>
                            <!-- ===== PAGE: PaymentTerminal / Square BEGIN ===== -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource PosPrimarySoftBrush}" Margin="0,0,14,0">
                                            <materialDesign:PackIcon Kind="TabletCellphone" Width="24" Height="24" Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SquareTitleText}" FontSize="17" />
                                            <TextBlock Text="{loc:Loc settings.payment.provider.square.subtitle}"
                                                       FontSize="12" FontWeight="Normal"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem.Header>
                                <Border Style="{StaticResource SettingsActionCardStyle}">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="{Binding SquareTitleText}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                            <TextBlock Text="{loc:Loc settings.square.description}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{loc:Loc settings.square.switchHelp}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>

                                        <!-- 令牌由后台统一管理，收银机只显示状态。 -->
                                        <Border Background="{DynamicResource PosSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource PosDividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14,10"
                                                Margin="0,0,0,18">
                                            <DockPanel>
                                                <materialDesign:PackIcon DockPanel.Dock="Left" Kind="ShieldKeyOutline" Width="22" Height="22"
                                                                         Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                         VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Loc settings.square.tokenSource}" FontSize="13" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding SquareTokenStatusText}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <TextBlock Text="{loc:Loc settings.square.tokenHelp}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- 直连 Square（默认关闭）：本地开关 + 服务端门店开关 + 令牌剩余有效期。 -->
                                        <Border Background="{DynamicResource PosSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource PosDividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14,10"
                                                Margin="0,0,0,18">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc settings.square.direct.title}" FontSize="13" FontWeight="Bold" />
                                                <TextBlock Text="{loc:Loc settings.square.direct.description}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                           TextWrapping="Wrap" Margin="0,2,0,6" />
                                                <TextBlock Text="{Binding SquareDirectStatusText}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Command="{Binding ToggleSquareDirectCommand}"
                                                            Content="{Binding SquareDirectToggleText}"
                                                            Style="{StaticResource PosPrimaryButtonStyle}"
                                                            Height="44"
                                                            MinWidth="160"
                                                            Margin="0,0,10,0" />
                                                    <Button Command="{Binding RefreshSquareDirectCommand}"
                                                            Content="{loc:Loc settings.square.direct.refresh}"
                                                            Height="44"
                                                            MinWidth="120" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- ① 环境 + 等待超时 -->
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Border Style="{StaticResource SettingsStepBadgeStyle}">
                                                        <TextBlock Text="1" Style="{StaticResource SettingsStepBadgeTextStyle}" />
                                                    </Border>
                                                    <TextBlock Text="{loc:Loc settings.payment.environment}" Style="{StaticResource SettingsSectionTitleStyle}" FontSize="16" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Border Style="{StaticResource SettingsSegmentHostStyle}" IsEnabled="{Binding CanChangeEnvironment}">
                                                    <UniformGrid Rows="1">
                                                        <RadioButton GroupName="SquareEnvironmentSegment"
                                                                     Style="{StaticResource SettingsSegmentRadioStyle}"
                                                                     IsChecked="{Binding IsSquareSandbox, Mode=TwoWay, Converter={StaticResource InverseBool}}"
                                                                     Content="{loc:Loc settings.payment.environment.production}" />
                                                        <RadioButton GroupName="SquareEnvironmentSegment"
                                                                     Style="{StaticResource SettingsSegmentRadioStyle}"
                                                                     IsChecked="{Binding IsSquareSandbox, Mode=TwoWay}"
                                                                     Content="{loc:Loc settings.payment.environment.sandbox}" />
                                                    </UniformGrid>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Border Style="{StaticResource SettingsStepBadgeStyle}">
                                                        <TextBlock Text="2" Style="{StaticResource SettingsStepBadgeTextStyle}" />
                                                    </Border>
                                                    <TextBlock Text="{loc:Loc settings.square.timeoutSeconds}" Style="{StaticResource SettingsSectionTitleStyle}" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBox Text="{Binding TimeoutSecondsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                         Height="58" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource PosDividerBrush}" Margin="0,0,0,16" />

                                        <!-- ③ 门店位置 -->
                                        <DockPanel Margin="0,0,0,12">
                                            <Button DockPanel.Dock="Right"
                                                    Command="{Binding LoadLocationsCommand}"
                                                    services:ButtonFeedback.Cue="Download"
                                                    Style="{StaticResource SettingsTouchButtonHeight}"
                                                    ToolTip="{loc:Loc settings.square.loadLocations.tooltip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="20" Height="20" Margin="0,0,8,0" />
                                                    <TextBlock Text="{loc:Loc settings.square.loadLocations}" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource SettingsStepBadgeStyle}">
                                                    <TextBlock Text="3" Style="{StaticResource SettingsStepBadgeTextStyle}" />
                                                </Border>
                                                <TextBlock Text="{loc:Loc settings.square.location}" Style="{StaticResource SettingsSectionTitleStyle}" FontSize="16" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                        <ListBox x:Name="SquareLocationList"
                                                 ItemsSource="{Binding SquareLocations}"
                                                 SelectedItem="{Binding SelectedSquareLocation, Mode=TwoWay}"
                                                 Style="{StaticResource SettingsTouchListBoxStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding Id}" FontSize="12" FontFamily="Consolas"
                                                                   Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="{loc:Loc settings.square.location.empty}" Margin="0,0,0,10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=SquareLocationList}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Height="1" Background="{DynamicResource PosDividerBrush}" Margin="0,6,0,16" />

                                        <!-- ④ 刷卡设备 -->
                                        <DockPanel Margin="0,0,0,12">
                                            <Button DockPanel.Dock="Right"
                                                    Command="{Binding LoadDevicesCommand}"
                                                    Style="{StaticResource SettingsTouchButtonHeight}"
                                                    ToolTip="{loc:Loc settings.square.loadDevices.tooltip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Margin="0,0,8,0" />
                                                    <TextBlock Text="{loc:Loc settings.square.loadDevices}" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Style="{StaticResource SettingsStepBadgeStyle}">
                                                    <TextBlock Text="4" Style="{StaticResource SettingsStepBadgeTextStyle}" />
                                                </Border>
                                                <TextBlock Text="{loc:Loc settings.square.device}" Style="{StaticResource SettingsSectionTitleStyle}" FontSize="16" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                        <ListBox x:Name="SquareDeviceList"
                                                 ItemsSource="{Binding SquareDevices}"
                                                 SelectedItem="{Binding SelectedSquareDevice, Mode=TwoWay}"
                                                 Style="{StaticResource SettingsTouchListBoxStyle}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right"
                                                                Background="{DynamicResource PosSurfaceAltBrush}"
                                                                BorderBrush="{DynamicResource PosBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="14"
                                                                Padding="12,4"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusDisplayName}" FontSize="12.5" FontWeight="Bold"
                                                                       Foreground="{DynamicResource PosTextSecondaryBrush}" />
                                                        </Border>
                                                        <StackPanel Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding Id}" FontSize="12" FontFamily="Consolas"
                                                                       Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Text="{loc:Loc settings.square.device.empty}" Margin="0,0,0,10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=SquareDeviceList}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- ⑤ 配对新终端（设备码） -->
                                        <Border Background="{DynamicResource PosSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource PosDividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="16"
                                                Margin="0,8,0,18">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <Border Style="{StaticResource SettingsStepBadgeStyle}">
                                                        <TextBlock Text="5" Style="{StaticResource SettingsStepBadgeTextStyle}" />
                                                    </Border>
                                                    <TextBlock Text="{loc:Loc settings.square.deviceCodes}" Style="{StaticResource SettingsSectionTitleStyle}" FontSize="16" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <Border Background="{DynamicResource PosWarningSoftBrush}"
                                                        BorderBrush="{DynamicResource PosWarningBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12,8"
                                                        Margin="0,0,0,12"
                                                        Visibility="{Binding IsSquareDeviceCodesUnsupported, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding SquareDeviceCodesUnavailableText}"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource PosWarningTextBrush}"
                                                               TextWrapping="Wrap" />
                                                </Border>

                                                <StackPanel IsEnabled="{Binding IsSquareDeviceCodesSupported}">
                                                    <TextBlock Text="{loc:Loc settings.square.deviceCodeName}" Style="{StaticResource SettingsLabelStyle}" />
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding SquareDeviceCodeNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                                        <Button Grid.Column="1"
                                                                Command="{Binding CreateDeviceCodeCommand}"
                                                                Style="{StaticResource PosPrimaryButtonStyle}"
                                                                Height="52"
                                                                Padding="18,0"
                                                                Margin="12,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="PlusCircleOutline" Width="20" Height="20" Margin="0,0,8,0" Foreground="White" />
                                                                <TextBlock Text="{loc:Loc settings.square.createDeviceCode}" Foreground="White" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <TextBlock Text="{loc:Loc settings.square.deviceCodeList}" Style="{StaticResource SettingsLabelStyle}" />
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox ItemsSource="{Binding SquareDeviceCodes}"
                                                                  SelectedItem="{Binding SelectedSquareDeviceCode, Mode=TwoWay}"
                                                                  Style="{StaticResource SettingsComboBoxStyle}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                                        <TextBlock FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}">
                                                                            <Run Text="{Binding Code}" />
                                                                            <Run Text="  " />
                                                                            <Run Text="{Binding Status}" />
                                                                            <Run Text="  " />
                                                                            <Run Text="{Binding DeviceId}" />
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding LoadDeviceCodesCommand}"
                                                                Style="{StaticResource SettingsTouchButtonHeight}"
                                                                Margin="12,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="ViewListOutline" Width="20" Height="20" Margin="0,0,8,0" />
                                                                <TextBlock Text="{loc:Loc settings.square.loadDeviceCodes}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="2"
                                                                Command="{Binding RefreshDeviceCodeStatusCommand}"
                                                                Style="{StaticResource SettingsTouchButtonHeight}"
                                                                Margin="12,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Margin="0,0,8,0" />
                                                                <TextBlock Text="{loc:Loc settings.square.refreshDeviceCode}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <!-- 选中设备码时放大显示，方便在终端上照着输入。 -->
                                                    <Border Background="{DynamicResource PosSurfaceBrush}"
                                                            BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}"
