<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- FakeTimeProvider：让测试直接推进虚拟时间触发生产代码超时，而不是靠墙钟硬等。 -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <!-- xunit 2.8+ 才有 conservative 并行算法（见 xunit.runner.json），与 Hbpos.Api.Tests 版本保持一致。 -->
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- 共享 WaitUntilAsync：见 AsyncTestWaitSupport.cs，各测试文件不要再复制私有副本。 -->
    <Using Include="Hbpos.Client.Tests.AsyncTestWaitSupport" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hbpos.Contracts\Hbpos.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Hbpos.Client.Wpf\Hbpos.Client.Wpf.csproj" />
    <ProjectReference Include="..\..\src\Hbpos.Updater\Hbpos.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CI 使用固定的并行度，避免 hosted Windows runner 因过度并发而抖动。 -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 跨端 frozen wire fixture：与 iPad shared-sale-cart-v1-fixture.test.ts 共用同一批 JSON。 -->
    <None Include="..\..\..\..\test-fixtures\shared-held-orders\**\*.json"
          Link="test-fixtures\shared-held-orders\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
