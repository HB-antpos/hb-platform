<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:orders="clr-namespace:Hbpos.Contracts.Orders;assembly=Hbpos.Contracts"
             xmlns:services="clr-namespace:Hbpos.Client.Wpf.Services"
             xmlns:vm="clr-namespace:Hbpos.Client.Wpf.ViewModels"
             mc:Ignorable="d"
             AutomationProperties.AutomationId="PaymentScreen"
             d:DesignHeight="688"
             d:DesignWidth="1366"
             Background="{DynamicResource PosSurfaceAltBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:LocalizationKeyConverter x:Key="LocalizationKeyConverter" />
        <Style x:Key="PaymentCartTouchScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="22" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <!-- 无需滚动时隐藏轨道，但保留触屏滚动条的布局宽度。 -->
                <Trigger Property="Maximum" Value="0">
                    <Setter Property="Opacity" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ZeroPricePaymentCartRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasZeroUnitPrice}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReturnLine}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ZeroPricePaymentAmountTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasZeroUnitPrice}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                    <Setter Property="FontWeight" Value="Black" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReturnLine}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                    <Setter Property="FontWeight" Value="Black" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaymentKeypadNumberTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="PaymentKeypadFunctionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PaymentKeypadNumberTextStyle}">
            <Setter Property="FontSize" Value="24" />
        </Style>

        <Style x:Key="PaymentMethodTileStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="124" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CashMethodButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentMethodTileStyle}">
            <Setter Property="MinHeight" Value="124" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCashSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardMethodButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentMethodTileStyle}">
            <Setter Property="MinHeight" Value="124" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCardSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VoucherMethodButtonStyle" TargetType="Button" BasedOn="{StaticResource PaymentMethodTileStyle}">
            <Setter Property="MinHeight" Value="62" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVoucherSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PaymentMethodTileTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
        </Style>
        <Style x:Key="PaymentQuickAmountButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="InstallmentMethodToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosBorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InstallmentCustomerDialogTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PosSearchTextBoxStyle}">
            <Setter Property="Height" Value="56" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style x:Key="VoucherEntryKeyButtonStyle" TargetType="Button" BasedOn="{StaticResource PosNumberButtonStyle}">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Black" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28*" MinWidth="0" />
            <ColumnDefinition Width="42*" MinWidth="0" />
            <ColumnDefinition Width="30*" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="12,12,6,12" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="8">
        <Grid IsEnabled="{Binding IsManualCardBackgroundEnabled}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12" Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0"
                            Grid.Column="0"
                            Command="{Binding BackToPosCommand}"
                            Style="{StaticResource PosSecondaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            MinHeight="44"
                            Padding="6,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Loc shell.backToPos}" FontWeight="Bold" FontSize="15" />
                        </StackPanel>
                    </Button>
                    <ToggleButton Grid.Row="0"
                                  Grid.Column="1"
                                  AutomationProperties.AutomationId="InstallmentPaymentToggle"
                                  AutomationProperties.Name="{Binding InstallmentMethodText}"
                                  ToolTip="{loc:Loc payment.installment.switchHelp}"
                                  ToolTipService.ShowOnDisabled="True"
                                  IsChecked="{Binding IsInstallmentPaymentEnabled, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  MinHeight="44"
                                  Margin="6,0,0,0">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource InstallmentMethodToggleStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstallmentEntryVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsInstallmentSwitchLocked}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding InstallmentMethodText}"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PosTextBrush}" />
                            <Border Grid.Column="2"
                                    Width="36"
                                    Height="24"
                                    CornerRadius="12"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource PosSurfaceStrongBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstallmentPaymentEnabled}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PosPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Ellipse Width="18" Height="18" Fill="{DynamicResource PosSurfaceBrush}" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Margin" Value="3,0,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstallmentPaymentEnabled}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="Margin" Value="0,0,3,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Border>
                        </Grid>
                    </ToggleButton>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                        <Border Padding="8,3" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="4">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryTextBrush}">
                                <Run Text="{Binding CartLines.Count, Mode=OneWay}" />
                                <Run Text=" " />
                                <Run Text="{loc:Loc Items}" />
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding OrderSummaryText}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="12,0,12,10" Padding="12" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosBorderBrush}" BorderThickness="1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInstallmentCustomerSectionVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="10" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountEdit"
                                                 Width="23"
                                                 Height="23"
                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc payment.installment.customerInfo}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource PosTextBrush}" />
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding InstallmentCustomerNameDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                            <TextBlock Text="  |  " FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                            <TextBlock Text="{Binding InstallmentCustomerPhoneDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding InstallmentOrderInfoText}"
                                   Margin="0,4,0,0"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PosMutedForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanEditInstallmentCustomer}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Command="{Binding OpenInstallmentCustomerDialogCommand}"
                            MinWidth="76"
                            MinHeight="36"
                            Padding="10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanEditInstallmentCustomer}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15" Margin="0,0,5,0" />
                            <TextBlock Text="{loc:Loc payment.installment.editCustomer}" FontWeight="Black" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <DataGrid Grid.Row="2"
                      Margin="8,0"
                      FontSize="14"
                      ItemsSource="{Binding CartLines}"
                      AutomationProperties.AutomationId="PaymentCartItemsGrid"
                      IsReadOnly="True"
                      RowBackground="{DynamicResource PosSurfaceBrush}"
                      AlternatingRowBackground="{DynamicResource PosSurfaceAltBrush}"
                      RowHeight="54"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.PanningMode="VerticalOnly"
                      ScrollViewer.PanningDeceleration="0.0008"
                      ScrollViewer.PanningRatio="1.0"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      RowStyle="{StaticResource ZeroPricePaymentCartRowStyle}"
                      Style="{StaticResource PosCartDataGridStyle}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="6,10" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Resources>
                    <!-- 与主购物车一致：支持手指纵向拖动，并提供易触达的滚动条拖块。 -->
                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PaymentCartTouchScrollBarStyle}" />
                    <Style TargetType="{x:Type Thumb}">
                        <Setter Property="MinHeight" Value="52" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Thumb}">
                                    <Border Background="{DynamicResource PosBorderStrongBrush}"
                                            BorderBrush="{DynamicResource PosBorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Margin="4" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Item}" Binding="{Binding DisplayName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{loc:Loc Quantity}" Binding="{Binding SignedQuantity, StringFormat={}{0:0.##}}" Width="58" />
                    <DataGridTextColumn Header="{loc:Loc Total}" Binding="{Binding ActualAmount, StringFormat={}{0:C2}}" Width="82">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ZeroPricePaymentAmountTextStyle}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" Padding="12,14" Background="Transparent" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="0,1,0,0">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PaymentSummaryAmountColumn" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Subtotal}" FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" TextAlignment="Right" FontSize="14" FontWeight="SemiBold" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PaymentSummaryAmountColumn" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Discount}" FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding DiscountAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" TextAlignment="Right" FontSize="14" FontWeight="SemiBold" />
                    </Grid>

                    <Border Grid.Row="2" Height="1" Background="{DynamicResource PosBorderBrush}" Margin="0,0,0,8" />

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="PaymentSummaryAmountColumn" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc AmountDue}" VerticalAlignment="Center" FontSize="14" FontWeight="Black" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding ActualAmount, StringFormat={}{0:C2}}" HorizontalAlignment="Right" TextAlignment="Right" FontSize="28" FontWeight="Black" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </Border>

        <Grid Grid.Column="1" Background="Transparent" Margin="6,12" IsEnabled="{Binding IsManualCardBackgroundEnabled}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,14" Margin="0,0,0,14" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding RemainingAmountText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryTextBrush}" TextWrapping="Wrap" />
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="62" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:C2}}" AutomationProperties.AutomationId="RemainingAmount" FontSize="52" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                        </Viewbox>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1,0,0,0" Padding="14,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding ChangeDueText}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PosMutedForegroundBrush}" TextWrapping="Wrap" />
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Height="62" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding ChangeDue, StringFormat={}{0:C2}}" FontSize="36" FontWeight="Bold" />
                            </Viewbox>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="3,0,3,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="{Binding CurrentTenderTextLabel}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border Grid.Row="1" MinHeight="62"
                        Padding="14,8"
                        Background="{DynamicResource PosSurfaceBrush}"
                        BorderBrush="{DynamicResource PosPrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TenderAmountText}"
                                   FontSize="36"
                                   FontWeight="Black"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Button Grid.Row="1" Grid.Column="1"
                        Command="{Binding NumberInputCommand}"
                        CommandParameter="Back"
                        Style="{StaticResource PosNumberButtonStyle}"
                        Width="64"
                        MinHeight="62"
                        Margin="8,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="BackspaceOutline"
                                             Width="30"
                                             Height="30"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <DockPanel Grid.Row="2" Margin="0" LastChildFill="True">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTenderEntryVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>

                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding QuickCashAmounts}" AutomationProperties.AutomationId="PaymentQuickCashAmounts" Height="50" Margin="0,0,0,8">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCashSelected}" Value="True" />
                                        <Condition Binding="{Binding IsQuickCashVisible}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.QuickCashCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource PaymentQuickAmountButtonStyle}">
                                <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="Bold" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <UniformGrid Columns="3" Rows="4" Margin="0" AutomationProperties.AutomationId="PaymentNumberKeypad">
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="1" Style="{StaticResource PosNumberButtonStyle}">
                        <TextBlock Text="1" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="2" Style="{StaticResource PosNumberButtonStyle}">
                        <TextBlock Text="2" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="3" Style="{StaticResource PosNumberButtonStyle}">
                        <TextBlock Text="3" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="4" Style="{StaticResource PosNumberButtonStyle}">
                        <TextBlock Text="4" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="5" Style="{StaticResource PosNumberButtonStyle}">
                        <TextBlock Text="5" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="6" Style="{StaticResource PosNumberButtonStyle}">
                        <TextBlock Text="6" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="7" Style="{StaticResource PosNumberButtonStyle}">
                        <TextBlock Text="7" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="8" Style="{StaticResource PosNumberButtonStyle}">
                        <TextBlock Text="8" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="9" Style="{StaticResource PosNumberButtonStyle}">
                        <TextBlock Text="9" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="." Style="{StaticResource PosNumberButtonStyle}">
                        <TextBlock Text="." Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}" CommandParameter="0" Style="{StaticResource PosNumberButtonStyle}">
                        <TextBlock Text="0" Style="{StaticResource PaymentKeypadNumberTextStyle}" />
                    </Button>
                    <Button Command="{Binding NumberInputCommand}"
                            CommandParameter="Clear"
                            Style="{StaticResource PosNumberButtonStyle}"
                            Background="{DynamicResource PosDangerSoftBrush}"
                            BorderBrush="{DynamicResource PosDangerBorderBrush}"
                            Foreground="{DynamicResource PosDangerTextBrush}">
                        <TextBlock Text="{loc:Loc Clear}" Style="{StaticResource PaymentKeypadFunctionTextStyle}" />
                    </Button>
                </UniformGrid>
            </DockPanel>

        </Grid>

        <Border Grid.Column="2" Margin="6,12,12,12" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="8">
        <Grid IsEnabled="{Binding IsManualCardBackgroundEnabled}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding PaymentMethodText}" Margin="14,14,14,12" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaymentMethodSelectionVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Row="1" Margin="14,0,14,8">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaymentMethodSelectionVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Background="{DynamicResource PosSurfaceAltBrush}"
                        BorderBrush="{DynamicResource PosBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsLinklyCloudTerminalSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc payment.linklyTerminal.title}"
                                       FontSize="10"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Click="RefreshLinklyCloudTerminals_Click"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    AutomationProperties.Name="Refresh Linkly terminals">
                                <materialDesign:PackIcon Kind="Refresh" Width="17" Height="17" />
                            </Button>
                        </Grid>
                        <ComboBox ItemsSource="{Binding LinklyCloudTerminals}"
                                  SelectedItem="{Binding SelectedLinklyCloudTerminal, Mode=TwoWay}"
                                  IsEnabled="{Binding CanSwitchLinklyCloudTerminal}"
                                  SelectionChanged="LinklyCloudTerminal_SelectionChanged"
                                  MinHeight="40"
                                  Padding="8,5"
                                  AutomationProperties.AutomationId="PaymentLinklyCloudTerminalSelector">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding LaneNo, StringFormat=Lane {0}}" FontSize="10" FontWeight="Black" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="Bold" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding LinklyCloudTerminalStatusText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Margin="2,5,2,0" />
                    </StackPanel>
                </Border>
                <!-- 信用卡和手动刷卡共用一个位置；关闭代金券时自动收起整行。 -->
                <Grid AutomationProperties.AutomationId="PaymentMethodTiles">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Button  Command="{Binding SelectCashCommand}" AutomationProperties.AutomationId="AddCashTenderButton" Style="{StaticResource CashMethodButtonStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                            <Border Width="48" Height="48" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="24" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Cash" Width="28" Height="28" Foreground="{DynamicResource PosPrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding CashMethodText}" Style="{StaticResource PaymentMethodTileTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding SelectCardCommand}" AutomationProperties.AutomationId="AddCardTenderButton" Style="{StaticResource CardMethodButtonStyle}" Visibility="{Binding IsIntegratedCardPaymentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                            <Border Width="48" Height="48" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="24" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CreditCard" Width="28" Height="28" Foreground="{DynamicResource PosPrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding CardMethodText}" Style="{StaticResource PaymentMethodTileTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding OpenManualCardCommand}" AutomationProperties.AutomationId="ManualCardPaymentButton" Style="{StaticResource PaymentMethodTileStyle}" Visibility="{Binding IsManualCardPaymentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                            <Border Width="48" Height="48" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="24" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CreditCard" Width="28" Height="28" Foreground="{DynamicResource PosPrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="{loc:Loc payment.manualCard.title}" Style="{StaticResource PaymentMethodTileTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Row="1" Grid.ColumnSpan="3" Command="{Binding OpenVoucherEntryCommand}"
                            AutomationProperties.AutomationId="AddVoucherTenderButton" Style="{StaticResource VoucherMethodButtonStyle}" Margin="0,8,0,0"
                            Visibility="{Binding IsVoucherPaymentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="38" Height="38" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="19" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="TicketPercent" Width="24" Height="24" Foreground="{DynamicResource PosPrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding VoucherMethodText}" Style="{StaticResource PaymentMethodTileTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBox Text="{Binding VoucherCodeText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="{loc:Loc payment.voucher.code}"
                         Height="40"
                         Margin="0,8,0,0">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource PosSearchTextBoxStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVoucherCodeEntryVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>

            <Border Grid.Row="2" Margin="14,8,14,8" Padding="0,12,0,0" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding AppliedTendersText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" Margin="0,0,0,10" />
                    <Grid Grid.Row="1">
                        <TextBlock Text="{Binding NoTendersText}" TextWrapping="Wrap" TextAlignment="Center" Margin="8" Foreground="{DynamicResource PosMutedForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PaymentTenders.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PaymentTenders}" AutomationProperties.AutomationId="AppliedTendersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                Background="{DynamicResource PosSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource PosDividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.RemoveTenderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="9" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource PosWarningSoftBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Card}">
                                                                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Voucher}">
                                                                    <Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <materialDesign:PackIcon Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="Cash" />
                                                                <Setter Property="Foreground" Value="{DynamicResource PosAccentBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Card}">
                                                                        <Setter Property="Kind" Value="CreditCard" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Voucher}">
                                                                        <Setter Property="Kind" Value="TicketPercent" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock FontSize="15" FontWeight="Black">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{loc:Loc payment.method.cash}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource PosAccentBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Card}">
                                                                        <Setter Property="Text" Value="{loc:Loc payment.method.card}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Voucher}">
                                                                        <Setter Property="Text" Value="{loc:Loc payment.method.voucher}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding DisplayReference}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:C2}}" VerticalAlignment="Center" FontSize="16" FontWeight="Black">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource PosAccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Card}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Method}" Value="{x:Static orders:PaymentMethodKind.Voucher}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="3" Command="{Binding DataContext.RemoveTenderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" services:ButtonFeedback.Cue="Delete" Width="36" Height="44" Margin="4,0,0,0" Style="{StaticResource TitleBarButtonStyle}">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" Margin="14,0,14,8" Padding="10" Background="{DynamicResource PosPrimarySoftBrush}" BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="24" Height="24" Margin="0,0,8,0" Background="{DynamicResource PosPrimaryBrush}" CornerRadius="12" VerticalAlignment="Top">
                        <materialDesign:PackIcon Kind="Information" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PosIconBrush}" VerticalAlignment="Center" />
                        <Button Command="{Binding CardPaymentErrorPrimaryActionCommand}"
                                AutomationProperties.AutomationId="RecoverPreviousCardTransactionButton"
                                MinWidth="148"
                                Height="40"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPaymentInteractionLocked}" Value="True" />
                                                <Condition Binding="{Binding CardPaymentErrorOverlay.HasPrimaryAction}" Value="True" />
                                                <Condition Binding="{Binding CardPaymentErrorOverlay.PrimaryActionKind}"
                                                           Value="{x:Static vm:CardPaymentErrorOverlayPrimaryActionKind.RecoverPrevious}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding CardPaymentErrorOverlay.PrimaryButtonTextKey, Converter={StaticResource LocalizationKeyConverter}}"
                                       Foreground="White"
                                       FontWeight="Bold" />
                        </Button>
                        <Button Command="{Binding OpenCardRecoveryCenterCommand}"
                                AutomationProperties.AutomationId="OpenCardRecoveryCenterFromCardErrorButton"
                                MinWidth="148"
                                Height="40"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPaymentInteractionLocked}" Value="True" />
                                                <Condition Binding="{Binding IsCardPaymentRecoveryRequired}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{loc:Loc payment.card.error.overlay.activeSession.openCenter}"
                                       FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="14,0,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.8*" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding CancelCommand}" Height="54" Margin="0,0,8,0" Padding="6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCancelPaymentVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding CancelText}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                </Button>
                <Button Command="{Binding ConfirmPaymentCommand}"
                        AutomationProperties.AutomationId="ConfirmPaymentButton"
                        Height="54" HorizontalContentAlignment="Stretch" Padding="10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                            <Setter Property="Margin" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCancelPaymentVisible}" Value="True">
                                    <Setter Property="Grid.Column" Value="1" />
                                    <Setter Property="Grid.ColumnSpan" Value="1" />
                                    <Setter Property="Margin" Value="8,0,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="CheckCircle" Width="20" Height="20" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ConfirmPaymentText}" Foreground="White" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>
        </Border>

        <Grid Grid.ColumnSpan="3" Panel.ZIndex="25" Background="#99000000"
              AutomationProperties.AutomationId="ManualCardConfirmationDialog"
              KeyboardNavigation.TabNavigation="Cycle"
              Visibility="{Binding IsManualCardDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="580" Padding="28" Background="{DynamicResource PosSurfaceBrush}" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{loc:Loc payment.manualCard.title}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" />
                    <TextBlock Text="{loc:Loc payment.manualCard.instructions}" FontSize="17" TextWrapping="Wrap" Margin="0,16,0,20" />
                    <TextBlock Text="{loc:Loc payment.manualCard.amount}" FontSize="16" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                    <TextBlock Text="{Binding ManualCardAmount, StringFormat={}{0:C2}}" FontSize="44" FontWeight="Bold"
                               AutomationProperties.AutomationId="ManualCardConfirmationAmount" Margin="0,4,0,18" />
                    <CheckBox x:Name="ManualCardSuccessCheckBox" IsChecked="{Binding IsManualCardSuccessChecked}" MinHeight="52"
                              AutomationProperties.AutomationId="ManualCardSuccessCheckBox">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaymentInteractionLocked}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                        <TextBlock Text="{loc:Loc payment.manualCard.checked}" FontSize="16" TextWrapping="Wrap" MaxWidth="460" />
                    </CheckBox>
                    <TextBlock Text="{loc:Loc payment.manualCard.uncertain}" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,12,0,12" />
                    <TextBlock Text="{Binding ManualCardDialogStatusMessage}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Command="{Binding CancelManualCardCommand}" Style="{StaticResource PosSecondaryButtonStyle}" MinHeight="58"
                                AutomationProperties.AutomationId="ManualCardCancelButton">
                            <TextBlock Text="{loc:Loc payment.manualCard.cancel}" FontSize="16" FontWeight="Bold" />
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ConfirmManualCardCommand}" Style="{StaticResource PosPrimaryButtonStyle}" MinHeight="58"
                                AutomationProperties.AutomationId="ManualCardConfirmButton">
                            <TextBlock Text="{loc:Loc payment.manualCard.confirm}" FontSize="16" FontWeight="Bold" Foreground="White" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

