{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "FaceIngest": {
    "CaptureEnabled": false,
    "StorageRootPath": "/app/App_Data/FaceIngest",
    "ConfigDirectory": "/app/config",
    "MaxRequestBodyBytes": 16777216,
    "MaxTotalBytes": 5368709120,
    "MaxFileCount": 100000,
    "MinFreeDiskBytes": 10737418240,
    "RetentionDays": 7,
    "CleanupIntervalMinutes": 10,
    "Cameras": [],
    "ProcessingEnabled": true,
    "ProcessingIntervalSeconds": 5,
    "ProcessingBatchSize": 50,
    "ProcessingMaxAttempts": 10,
    "Database": {
      "ConnectionString": "",
      "CameraRefreshSeconds": 30
    },
    "Cos": {
      "Enabled": false,
      "Bucket": "",
      "Region": "",
      "SecretId": "",
      "SecretKey": "",
      "KeyPrefix": "face-ingest",
      "UploadRawBody": false
    }
  }
}
