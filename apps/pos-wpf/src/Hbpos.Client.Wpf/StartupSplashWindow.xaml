<Window x:Class="Hbpos.Client.Wpf.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hbpos.Client.Wpf"
        Title="{Binding TitleText}"
        Width="540"
        Height="296"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="StartupSplashWindow">
    <!--
        启动页运行在独立的 UI 线程上，只能使用这里内联的资源：
        不能引用 App.xaml 的 StaticResource，也不能依赖主线程正在加载的主题字典；
        文案全部绑定启动页自己的视图模型，不使用 loc:Loc（它绑定主线程的本地化单例）。
        所有文字都固定行高，保证中英文字体回退时卡片高度不变、与窗口高度严格对齐。
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="InkBrush" Color="#FF1E293B" />
        <SolidColorBrush x:Key="BodyBrush" Color="#FF475569" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF64748B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEFF6FF" />
        <SolidColorBrush x:Key="TrackBrush" Color="#FFE2E8F0" />
        <SolidColorBrush x:Key="DividerBrush" Color="#FFEEF1F5" />
        <SolidColorBrush x:Key="PendingRingBrush" Color="#FFCBD5E1" />
        <SolidColorBrush x:Key="WarnBrush" Color="#FFB45309" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#FFDCFCE7" />
        <SolidColorBrush x:Key="SuccessDeepBrush" Color="#FF166534" />

        <Style x:Key="StartupProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{StaticResource TrackBrush}" CornerRadius="4" />
                            <!-- 高光是指示条自身背景里的一段渐变，随圆角一起裁剪；由代码按系统动画设置决定是否播放。 -->
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="120,0">
                                        <LinearGradientBrush.Transform>
                                            <TranslateTransform x:Name="SheenTransform" X="-120" />
                                        </LinearGradientBrush.Transform>
                                        <GradientStop Offset="0" Color="#FF2563EB" />
                                        <GradientStop Offset="0.35" Color="#FF2563EB" />
                                        <GradientStop Offset="0.5" Color="#FF60A5FA" />
                                        <GradientStop Offset="0.65" Color="#FF2563EB" />
                                        <GradientStop Offset="1" Color="#FF2563EB" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="StepDotTemplate" DataType="{x:Type local:StartupStepItem}">
            <Ellipse x:Name="Dot"
                     Width="8"
                     Height="8"
                     Margin="0,0,6,0"
                     Fill="White"
                     Stroke="{StaticResource PendingRingBrush}"
                     StrokeThickness="1.5" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:StartupStepState.Active}">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentSoftBrush}" />
                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:StartupStepState.Done}">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 外层留 10px 透明边距，避免裁掉卡片圆角；与更新进度窗口同一套卡片样式。 -->
    <Grid Margin="10" Background="Transparent">
        <Border x:Name="Card"
                Background="White"
                BorderBrush="#FFE3E7EF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="32,28,32,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Width="48"
                           Height="48"
                           Source="pack://application:,,,/Resources/AppBrandIcon.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           IsHitTestVisible="False"
                           AutomationProperties.AutomationId="StartupBrandMark"
                           AutomationProperties.Name="{Binding TitleText}" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TitleText}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   LineHeight="26"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource InkBrush}"
                                   AutomationProperties.AutomationId="StartupTitle" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding SubtitleText}"
                                   FontSize="13"
                                   LineHeight="18"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="380"
                                   AutomationProperties.AutomationId="StartupSubtitle" />
                    </StackPanel>
                </StackPanel>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding StageTitle}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   LineHeight="24"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource InkBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="StartupStageTitle"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding StageDetail}"
                                   FontSize="13"
                                   LineHeight="18"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="StartupStageDetail">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <!-- 网络阶段等待过久时换成琥珀色说明，提示"在等服务器"而不是卡死。 -->
                                        <DataTrigger Binding="{Binding IsStageSlow}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Margin="16,0,0,0"
                               VerticalAlignment="Bottom"
                               LineHeight="46"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{StaticResource AccentBrush}"
                               Typography.NumeralAlignment="Tabular"
                               AutomationProperties.AutomationId="StartupPercent">
                        <Run Text="{Binding PercentText, Mode=OneWay}" FontSize="40" FontWeight="Bold" /><Run Text="%" FontSize="20" FontWeight="SemiBold" />
                    </TextBlock>
                </Grid>

                <ProgressBar x:Name="StartupProgressBar"
                             Margin="0,14,0,0"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Style="{StaticResource StartupProgressBarStyle}"
                             AutomationProperties.AutomationId="StartupProgressBar"
                             AutomationProperties.Name="{Binding StageTitle}" />

                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Steps}"
                                      ItemTemplate="{StaticResource StepDotTemplate}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Margin="2,0,0,0"
                                   Text="{Binding StepText}"
                                   FontSize="12"
                                   LineHeight="16"
                                   LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource MutedBrush}"
                                   Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="StartupStepText" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding ElapsedText}"
                               FontSize="12"
                               LineHeight="16"
                               LineStackingStrategy="BlockLineHeight"
                               Foreground="{StaticResource MutedBrush}"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="StartupElapsed" />
                </DockPanel>

                <Border Margin="0,20,0,0"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,14,0,0"
                        AutomationProperties.AutomationId="StartupVersionFooter">
                    <DockPanel Height="24" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionLabel}"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding VersionText}"
                                       Margin="6,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BodyBrush}"
                                       Typography.NumeralAlignment="Tabular"
                                       AutomationProperties.AutomationId="StartupVersionText" />
                        </StackPanel>
                        <!-- 更新后首次启动在右下角显示"已更新到"标签；平时不占位。 -->
                        <Border DockPanel.Dock="Right"
                                Height="24"
                                Padding="8,0,10,0"
                                VerticalAlignment="Center"
                                CornerRadius="12"
                                Background="{StaticResource SuccessSoftBrush}"
                                Visibility="{Binding HasUpdateNotice, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="StartupUpdateNotice">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Data="M5,12.5 L9.5,17 L19,7.5"
                                      Stroke="{StaticResource SuccessDeepBrush}"
                                      StrokeThickness="2.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <TextBlock Text="{Binding UpdateNoticeText}"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessDeepBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
