                                    Height="44"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Visibility="{Binding CanResolveRefund, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc cardRecovery.refund.action.confirmNotRefunded}"
                                           FontWeight="Bold" />
                            </Button>
                            <Button Command="{Binding DataContext.ResolveCardRefundCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static services:CardRefundSupervisorDecision.ContinueWaiting}"
                                    MinWidth="136"
                                    Height="44"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Visibility="{Binding CanResolveRefund, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc cardRecovery.refund.action.continueWaiting}"
                                           FontWeight="Bold" />
                            </Button>
                            <Button Command="{Binding DataContext.ResolveCardPaymentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static services:CardPaymentSupervisorDecision.ConfirmPaid}"
                                    MinWidth="142"
                                    Height="44"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource PosPrimaryButtonStyle}"
                                    Visibility="{Binding CanResolvePayment, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc cardRecovery.payment.action.confirmPaid}"
                                           Foreground="White"
                                           FontWeight="Bold" />
                            </Button>
                            <Button Command="{Binding DataContext.ResolveCardPaymentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static services:CardPaymentSupervisorDecision.ConfirmNotPaid}"
                                    MinWidth="168"
                                    Height="44"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Visibility="{Binding CanResolvePayment, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc cardRecovery.payment.action.confirmNotPaid}"
                                           FontWeight="Bold" />
                            </Button>
                            <Button Command="{Binding DataContext.ResolveCardPaymentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static services:CardPaymentSupervisorDecision.ContinueWaiting}"
                                    MinWidth="136"
                                    Height="44"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Visibility="{Binding CanResolvePayment, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc cardRecovery.refund.action.continueWaiting}"
                                           FontWeight="Bold" />
                            </Button>
                            <Button Command="{Binding DataContext.PrintRecoveredReceiptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    MinWidth="128"
                                    Height="44"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource PosPrimaryButtonStyle}"
                                    Visibility="{Binding CanPrintReceipt, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Foreground="White" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding PrintButtonText}" Foreground="White" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DataContext.RetryActiveSessionRecoveryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    MinWidth="128"
                                    Height="44"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource PosPrimaryButtonStyle}"
                                    Visibility="{Binding CanRetryRecovery, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding RetryButtonText}" Foreground="White" FontWeight="Bold" />
                            </Button>
                            <Button Command="{Binding DataContext.CloseCardRecoveryResultDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    MinWidth="112"
                                    Height="44"
                                    Style="{StaticResource PosSecondaryButtonStyle}">
                                <TextBlock Text="{loc:Loc cardRecovery.dialog.action.close}" FontWeight="Bold" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.RowSpan="3"
                Panel.ZIndex="80"
                Background="#66000000"
                Visibility="{Binding LinklyTerminalDialog.IsOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="520"
                    Padding="24"
                    Background="{DynamicResource PosSurfaceBrush}"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DataContext="{Binding LinklyTerminalDialog}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseCommand}"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Visibility="{Binding IsCloseButtonVisible, Converter={StaticResource BoolToVis}}"
                                ToolTip="{loc:Loc shell.window.close}">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{Binding TitleText}"
                                       FontSize="20"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosTextBrush}" />
                            <TextBlock Text="{Binding SessionId}"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Padding="12"
                            Margin="0,0,0,12"
                            Background="{DynamicResource PosSurfaceAltBrush}"
                            BorderBrush="{DynamicResource PosDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatusLabelText}"
                                       FontSize="11"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosMutedForegroundBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       FontSize="15"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosPrimaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="{Binding DisplayLabelText}"
                                   FontSize="11"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        <Border Margin="0,6,0,0"
                                Padding="14"
                                MinHeight="70"
                                Background="{DynamicResource PosInverseSurfaceBrush}"
                                CornerRadius="10">
                            <TextBlock Text="{Binding DisplayText}"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Black"
                                       TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="{Binding MessageText}"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource PosWarningTextBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding MessageText, Converter={StaticResource StringHasValueToVis}}" />
                        <TextBlock Text="{Binding ResponseText}"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource PosAccentBrush}"
                                   FontWeight="Black"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ResponseText, Converter={StaticResource StringHasValueToVis}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Margin="0,0,0,16"
                                Visibility="{Binding ReceiptText, Converter={StaticResource StringHasValueToVis}}">
                        <TextBlock Text="{Binding ReceiptLabelText}"
                                   FontSize="11"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosMutedForegroundBrush}" />
                        <TextBox Text="{Binding ReceiptText, Mode=OneWay}"
                                 Margin="0,6,0,0"
                                 MinHeight="96"
                                 MaxHeight="150"
                                 Padding="10"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Command="{Binding CancelPaymentCommand}"
                                MinWidth="112"
                                Height="44"
                                Margin="8,0,0,0"
                                Visibility="{Binding IsCancelPaymentVisible, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
                                    <Setter Property="Background" Value="{DynamicResource PosDangerBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBrush}" />
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding CancelPaymentText}" Foreground="White" FontWeight="Bold" />
                        </Button>
                        <ItemsControl ItemsSource="{Binding DisplayButtons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type services:LinklyTerminalDialogButtonViewModel}">
                                    <Button Command="{Binding DataContext.LinklyTerminalDialog.SubmitActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            MinWidth="112"
                                            Height="44"
                                            Margin="8,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PosDangerBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding Text}" Foreground="White" FontWeight="Bold" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- 刷卡错误全局弹窗：和 Linkly 终端弹窗同级，避免只在右侧支付区域内显示。 -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="90">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsCashPaymentScreenActive}" Value="True" />
                                <Condition Binding="{Binding CachedCashPaymentScreen.CardPaymentErrorOverlay.IsOpen}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#66000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding CachedCashPaymentScreen.CloseCardPaymentErrorOverlayCommand}" />
                </Border.InputBindings>
            </Border>

            <Border Width="520"
                    Padding="24"
                    Background="{DynamicResource PosSurfaceBrush}"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DataContext="{Binding CachedCashPaymentScreen}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,18">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CloseCardPaymentErrorOverlayCommand}"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="{loc:Loc shell.window.close}">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                        </Button>
                        <TextBlock Text="{Binding CardPaymentErrorOverlay.TitleKey, Converter={StaticResource LocalizationKeyConverter}}"
                                   FontSize="20"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosTextBrush}"
                                   TextWrapping="Wrap" />
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="54"
                                Height="54"
                                Background="{DynamicResource PosDangerSoftBrush}"
                                CornerRadius="12"
                                VerticalAlignment="Top">
                            <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                     Width="34"
                                                     Height="34"
                                                     Foreground="{DynamicResource PosDangerTextBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CardPaymentErrorOverlay.DisplayMessage}"
                                   Margin="16,0,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 有恢复或确认操作时保留主按钮，普通错误只显示关闭按钮。 -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Command="{Binding CardPaymentErrorPrimaryActionCommand}"
                                MinWidth="148"
                                Height="44"
                                Margin="0,0,8,0"
                                Visibility="{Binding CardPaymentErrorOverlay.HasPrimaryAction, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                Style="{StaticResource PosPrimaryButtonStyle}">
                            <TextBlock Text="{Binding CardPaymentErrorOverlay.PrimaryButtonTextKey, Converter={StaticResource LocalizationKeyConverter}}"
                                       Foreground="White"
                                       FontWeight="Bold" />
                        </Button>
                        <Button Command="{Binding CloseCardPaymentErrorOverlayCommand}"
                                MinWidth="112"
                                Height="44"
                                Style="{StaticResource PosPrimaryButtonStyle}">
                            <TextBlock Text="{Binding CardPaymentErrorOverlay.ButtonTextKey, Converter={StaticResource LocalizationKeyConverter}}"
                                       Foreground="White"
                                       FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Panel.ZIndex="95"
                Width="540"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Padding="16"
                Background="{DynamicResource PosSurfaceBrush}"
                BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding AppUpdate.IsOptionalUpdateReady, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="Update"
                                         Width="24"
                                         Height="24"
                                         Foreground="{DynamicResource PosPrimaryTextBrush}"
                                         Margin="0,0,12,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Loc appUpdate.optional.title}"
                               FontSize="14"
                               FontWeight="Black"
                               Foreground="{DynamicResource PosTextBrush}" />
                    <TextBlock Text="{Binding AppUpdate.StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding AppUpdate.InstallUpdateCommand}"
                        services:ButtonFeedback.Cue="VersionNotice"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        MinWidth="112"
                        Height="36"
                        Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Update" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc appUpdate.force.action}" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Command="{Binding AppUpdate.DismissOptionalUpdateCommand}"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="{loc:Loc shell.window.close}"
                        Margin="12,0,0,0">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Panel.ZIndex="96"
                Width="560"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Padding="18"
                Background="{DynamicResource PosSurfaceBrush}"
                BorderBrush="{DynamicResource PosWarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding AppUpdate.IsForceUpdatePendingInstall, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36"
                        Height="36"
                        Background="{DynamicResource PosWarningSoftBrush}"
                        CornerRadius="10"
                        Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="AlertCircleOutline"
                                             Width="20"
                                             Height="20"
                                             Foreground="{DynamicResource PosWarningTextBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Loc appUpdate.force.title}"
                               FontSize="14"
                               FontWeight="Black"
                               Foreground="{DynamicResource PosTextBrush}" />
                    <TextBlock Text="{Binding AppUpdate.StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding AppUpdate.InstallUpdateCommand}"
                        services:ButtonFeedback.Cue="VersionNotice"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        MinWidth="118"
                        Height="36"
                        Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Update" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc appUpdate.force.action}" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Command="{Binding AppUpdate.DismissForceUpdateForDebugCommand}"
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="{loc:Loc appUpdate.force.dismissDebug}"
                        Margin="10,0,0,0"
                        Visibility="{Binding AppUpdate.CanDismissForceUpdateForDebug, Converter={StaticResource BoolToVis}}">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                </Button>
            </Grid>
        </Border>

        <!-- 全局确认遮罩：统一承接退出、测试数据与分期确认，背景点击不关闭。 -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="99"
              Background="#66000000"
              Visibility="{Binding ConfirmationDialog.IsOpen, Converter={StaticResource BoolToVis}}"
              IsVisibleChanged="ConfirmationDialogIsVisibleChanged"
              FocusManager.IsFocusScope="True"
              FocusManager.FocusedElement="{Binding ElementName=ConfirmationCancelButton}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
            <Border Width="520"
                    Padding="24"
                    Background="{DynamicResource PosSurfaceBrush}"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DataContext="{Binding ConfirmationDialog}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="54"
                                Height="54"
                                CornerRadius="12"
                                Margin="0,0,14,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <materialDesign:PackIcon Width="34"
                                                     Height="34"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="InformationOutline" />
                                        <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                                <Setter Property="Kind" Value="AlertCircleOutline" />
                                                <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Border>
                        <TextBlock Text="{Binding TitleText}"
                                   FontSize="22"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosTextBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding MessageText}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,22" />

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                KeyboardNavigation.TabNavigation="Cycle">
                        <Button x:Name="ConfirmationCancelButton"
                                Command="{Binding CancelCommand}"
                                MinWidth="112"
                                Height="44"
                                Margin="0,0,10,0"
                                IsTabStop="True"
                                KeyboardNavigation.TabIndex="0"
                                Style="{StaticResource PosSecondaryButtonStyle}">
                            <TextBlock Text="{Binding CancelButtonText}" FontWeight="Bold" />
                        </Button>
                        <Button Command="{Binding ConfirmCommand}"
                                MinWidth="112"
                                Height="44"
                                IsTabStop="True"
                                KeyboardNavigation.TabIndex="1">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PosDangerBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding ConfirmButtonText}"
                                       Foreground="White"
                                       FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 强制更新全局遮罩：Release 只允许继续更新；Debug 提供显式跳过入口。 -->
        <Border Grid.RowSpan="3"
                Panel.ZIndex="100"
                Background="#99000000"
                Visibility="{Binding AppUpdate.IsForceUpdateBlocking, Converter={StaticResource BoolToVis}}">
            <Border Width="560"
                    Padding="26"
                    Background="{DynamicResource PosSurfaceBrush}"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.22" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="54"
                                Height="54"
                                Background="{DynamicResource PosWarningSoftBrush}"
                                CornerRadius="12"
                                Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                     Width="34"
                                                     Height="34"
                                                     Foreground="{DynamicResource PosWarningTextBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc appUpdate.force.title}"
                                       FontSize="22"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosTextBrush}" />
                            <TextBlock Text="{Binding AppUpdate.TargetVersion, StringFormat={}{0}}"
                                       FontSize="12"
                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding AppUpdate.StatusMessage}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <TextBlock Grid.Row="2"
                               Text="{Binding AppUpdate.ReleaseNotes}"
                               FontSize="12"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               TextWrapping="Wrap"
                               MaxHeight="110"
                               Margin="0,0,0,18" />

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding AppUpdate.DismissForceUpdateForDebugCommand}"
                                MinWidth="148"
                                Height="44"
                                Margin="0,0,10,0"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                Visibility="{Binding AppUpdate.CanDismissForceUpdateForDebug, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Loc appUpdate.force.dismissDebug}" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AppUpdate.RetryForceUpdateCommand}"
                                services:ButtonFeedback.Cue="Download"
                                MinWidth="104"
                                Height="44"
                                Margin="0,0,10,0"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                Visibility="{Binding AppUpdate.IsForceUpdateError, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Loc appUpdate.force.retry}" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AppUpdate.ExitApplicationCommand}"
                                MinWidth="104"
                                Height="44"
                                Margin="0,0,10,0"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                Visibility="{Binding AppUpdate.IsForceUpdateError, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ExitToApp" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Loc appUpdate.force.exit}" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AppUpdate.InstallUpdateCommand}"
                                services:ButtonFeedback.Cue="VersionNotice"
                                MinWidth="148"
                                Height="44"
                                Style="{StaticResource PosPrimaryButtonStyle}"
                                Visibility="{Binding AppUpdate.IsInstallerReady, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Update" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                <TextBlock Text="{loc:Loc appUpdate.force.action}" Foreground="White" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
