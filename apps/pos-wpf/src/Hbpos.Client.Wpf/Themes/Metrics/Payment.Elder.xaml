<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 长者模式下支付页的放大尺寸（真机 1366×768 带任务栏、窗口约 728 高上实测偏大，2026-10-15 收到比标准大约 1~3 号；订单行合计列曾被 22 号字挤切）；仅在选中长者主题时追加到应用资源末尾，覆盖标准值。
         只写与标准值不同的键（必须是 Payment.Standard.xaml 键的子集）。 -->
    <sys:String x:Key="PosMetricsElderId">Payment</sys:String>

    <!-- 左列：返回按钮、件数小标签、订单表格（字号/行高/表头） -->
    <sys:Double x:Key="PosPayBackButtonMinHeight">48</sys:Double>
    <sys:Double x:Key="PosPayBackButtonFontSize">17</sys:Double>
    <sys:Double x:Key="PosPayBackIconSize">18</sys:Double>
    <sys:Double x:Key="PosPayItemsLabelFontSize">14</sys:Double>
    <sys:Double x:Key="PosPayCartFontSize">18</sys:Double>
    <sys:Double x:Key="PosPayCartRowHeight">60</sys:Double>
    <sys:Double x:Key="PosPayCartHeaderFontSize">14</sys:Double>
    <sys:Double x:Key="PosPayCartHeaderMinHeight">36</sys:Double>
    <sys:Double x:Key="PosPayCartQtyColumnMinWidth">64</sys:Double>
    <sys:Double x:Key="PosPayCartTotalColumnMinWidth">104</sys:Double>
    <sys:Int32 x:Key="PosPayCartAlternationCount">2</sys:Int32>
    <!-- 汇总：标签/值/应付金额；灰色衬板与返回按钮浅蓝衬板打开 -->
    <sys:Double x:Key="PosPaySummaryLabelFontSize">15</sys:Double>
    <sys:Double x:Key="PosPaySummaryValueFontSize">20</sys:Double>
    <sys:Double x:Key="PosPayDueLabelFontSize">17</sys:Double>
    <sys:Double x:Key="PosPayDueAmountFontSize">34</sys:Double>
    <sys:Double x:Key="PosPaySummaryPlateOpacity">1</sys:Double>
    <sys:Double x:Key="PosPayBackPlateOpacity">1</sys:Double>
    <sys:Double x:Key="PosPayDueBigLabelFontSize">19</sys:Double>
    <sys:Double x:Key="PosPayDueBigAmountFontSize">46</sys:Double>

    <!-- 中列：待付/找零、当前支付金额输入框、退格、数字键 -->
    <sys:Double x:Key="PosPayAmountLabelFontSize">17</sys:Double>
    <sys:Double x:Key="PosPayChangeAmountFontSize">42</sys:Double>
    <sys:Double x:Key="PosPayChangeIdlePlateOpacity">1</sys:Double>
    <sys:Double x:Key="PosPayTenderLabelFontSize">16</sys:Double>
    <sys:Double x:Key="PosPayTenderInputFontSize">40</sys:Double>
    <sys:Double x:Key="PosPayTenderInputMinHeight">64</sys:Double>
    <!-- 长者：内容区零描边 -->
    <Thickness x:Key="PosPayTenderInputBorderThickness">0</Thickness>
    <sys:Double x:Key="PosPayBackspaceWidth">68</sys:Double>
    <sys:Double x:Key="PosPayBackspaceMinHeight">64</sys:Double>
    <sys:Double x:Key="PosPayBackspaceIconSize">32</sys:Double>
    <sys:Double x:Key="PosPayBackspacePlateOpacity">1</sys:Double>
    <sys:Double x:Key="PosPayKeypadNumberFontSize">36</sys:Double>
    <sys:Double x:Key="PosPayKeypadClearFontSize">24</sys:Double>
    <Thickness x:Key="PosPayClearKeyBorderThickness">0</Thickness>
    <!-- 快捷现金：字号/按钮高/整行高（「$」上标随字号） -->
    <sys:Double x:Key="PosPayQuickCashFontSize">34</sys:Double>
    <sys:Double x:Key="PosPayQuickCashDollarFontSize">19</sys:Double>
    <sys:Double x:Key="PosPayQuickCashButtonHeight">80</sys:Double>
    <sys:Double x:Key="PosPayQuickCashRowHeight">86</sys:Double>

    <!-- 右列：支付方式、已付款项、取消与确认按钮 -->
    <sys:Double x:Key="PosPayMethodTitleFontSize">21</sys:Double>
    <sys:Double x:Key="PosPayMethodLabelFontSize">16</sys:Double>
    <sys:Double x:Key="PosPayTendersTitleFontSize">17</sys:Double>
    <sys:Double x:Key="PosPayTenderNameFontSize">17</sys:Double>
    <sys:Double x:Key="PosPayTenderAmountFontSize">19</sys:Double>
    <sys:Double x:Key="PosPayTenderNoteFontSize">12</sys:Double>
    <sys:Double x:Key="PosPayTenderIconBlockSize">40</sys:Double>
    <sys:Double x:Key="PosPayTenderIconSize">23</sys:Double>
    <sys:Double x:Key="PosPayCancelButtonHeight">58</sys:Double>
    <sys:Double x:Key="PosPayCancelFontSize">16</sys:Double>
    <sys:Double x:Key="PosPayConfirmButtonHeight">66</sys:Double>
    <sys:Double x:Key="PosPayConfirmFontSize">21</sys:Double>
    <sys:Double x:Key="PosPayConfirmIconSize">22</sys:Double>
    <GridLength x:Key="PosPayConfirmIconColumnWidth">28</GridLength>
    <CornerRadius x:Key="PosPayChangePlateCornerRadius">0,7,7,0</CornerRadius>
</ResourceDictionary>
