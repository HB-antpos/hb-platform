<Window x:Class="Hbpos.Client.Wpf.StartupSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
        Width="460"
        Height="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource PosFontFamily}"
        UseLayoutRounding="True">
    <!-- 保持窗口外层透明，避免遮住内部 Border 的圆角。 -->
    <Grid Background="Transparent" Margin="10">
        <Border Background="White"
                BorderBrush="#FFE3E7EF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="28,28,28,18">
            <Grid>
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        MaxWidth="364">
                <Image Width="82"
                       Height="82"
                       Source="pack://application:,,,/Resources/AppBrandIcon.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True"
                       IsHitTestVisible="False"
                       AutomationProperties.AutomationId="StartupBrandMark"
                       AutomationProperties.Name="{loc:Loc AppName}" />
                <TextBlock Text="{loc:Loc startup.title}"
                           Margin="0,16,0,0"
                           FontSize="28"
                           FontWeight="Black"
                           Foreground="#FF1E293B"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <!-- 更新后首次启动时用"已更新到"标签替换这句通用提示，保持启动页高度不变。 -->
                <Border Margin="0,6,0,0"
                        Height="26"
                        Padding="8,0,12,0"
                        HorizontalAlignment="Center"
                        CornerRadius="13"
                        Background="#FFDCFCE7"
                        Visibility="{Binding HasUpdateNotice, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.AutomationId="StartupUpdateNotice">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="16"
                              Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Data="M5,12.5 L9.5,17 L19,7.5"
                              Stroke="#FF166534"
                              StrokeThickness="2.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <TextBlock Text="{Binding UpdateNoticeText}"
                                   Margin="6,0,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FF166534"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{loc:Loc startup.loading}"
                           Margin="0,4,0,0"
                           FontSize="13"
                           Foreground="#FF64748B"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Center"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUpdateNotice}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusText}"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="#FF475569"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Border Margin="0,14,0,0"
                        MinWidth="144"
                        MinHeight="52"
                        Padding="16,6"
                        HorizontalAlignment="Center"
                        Background="#0D2563EB"
                        CornerRadius="12">
                    <TextBlock Text="{Binding ProgressText}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#FF2563EB"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="NoWrap" />
                </Border>
            </StackPanel>

            <Border Grid.Row="2"
                    Height="6"
                    Margin="48,16,48,0"
                    Background="#FFE2E8F0"
                    CornerRadius="3"
                    ClipToBounds="True">
                <Border Width="132"
                        HorizontalAlignment="Left"
                        Background="#FF2563EB"
                        CornerRadius="3">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgressIndicatorTransform" X="-132" />
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="ProgressIndicatorTransform"
                                                     Storyboard.TargetProperty="X"
                                                     From="-132"
                                                     To="360"
                                                     Duration="0:0:1.15" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </Border>

            <Border Grid.Row="4"
                    BorderBrush="#FFEEF1F5"
                    BorderThickness="0,1,0,0"
                    Padding="0,14,0,0"
                    AutomationProperties.AutomationId="StartupVersionFooter">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Loc startup.versionLabel}"
                               FontSize="12"
                               Foreground="#FF64748B" />
                    <TextBlock Text="{Binding VersionText}"
                               Margin="6,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FF475569"
                               Typography.NumeralAlignment="Tabular"
                               AutomationProperties.AutomationId="StartupVersionText" />
                </StackPanel>
            </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
