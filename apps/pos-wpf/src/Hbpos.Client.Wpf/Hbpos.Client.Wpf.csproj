<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Hbpos.Contracts\Hbpos.Contracts.csproj" />
    <ProjectReference Include="..\Hbpos.RemoteMaintenance.Setup\Hbpos.RemoteMaintenance.Setup.csproj" />
    <ProjectReference Include="..\..\..\..\services\backend\BlazorApp.Shared\BlazorApp.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="PCEFTPOS.EFTClient.IPInterface" Version="1.7.3" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <HbposWpfAppVersion Condition="'$(HbposWpfAppVersion)' == '' and '$(HBPOS_WPF_APP_VERSION)' != ''">$(HBPOS_WPF_APP_VERSION)</HbposWpfAppVersion>
    <HbposWpfAppVersion Condition="'$(HbposWpfAppVersion)' == ''">0.0.0-local</HbposWpfAppVersion>
    <Version>$(HbposWpfAppVersion)</Version>
    <InformationalVersion>$(HbposWpfAppVersion)</InformationalVersion>
  </PropertyGroup>

  <!--
    中心日志（hbpos_win）写入 Key 只在安装包构建时由 CI 以环境变量 HbposCenterLogApiKey 注入（仓库 Secret），
    MSBuild 把同名环境变量当属性读入，再写进程序集元数据作为客户端默认配置；本地与 PR 构建没有这个变量，客户端不上传中心日志。
    与 Web 前端、手持/iPad 的写入 Key 一样只能写日志，可在服务端单独吊销。
  -->
  <PropertyGroup>
    <HbposCenterLogIngestUrl Condition="'$(HbposCenterLogIngestUrl)' == ''">https://hotbargain.vip/api/system/logs/ingest</HbposCenterLogIngestUrl>
  </PropertyGroup>
  <ItemGroup Condition="'$(HbposCenterLogApiKey)' != ''">
    <AssemblyMetadata Include="HbposCenterLogApiKey" Value="$(HbposCenterLogApiKey)" />
    <AssemblyMetadata Include="HbposCenterLogIngestUrl" Value="$(HbposCenterLogIngestUrl)" />
  </ItemGroup>

  <!--
    发布时预编译为本机代码（ReadyToRun），减少收银机每天开机后首次启动时的 JIT 开销。
    只在带运行时标识的发布中生效（安装包构建使用 -r win-x64），调试构建与测试不受影响。
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!--
    以下程序集由 BlazorApp.Shared 的 SqlSugar / Blazor 依赖间接带入，收银端运行时不会加载：
    照常随包发布，但不做预编译，避免发布目录白白增大约 22MB。
  -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Oracle.ManagedDataAccess.dll;SqlSugar.dll;Npgsql.dll;Kdbndp.dll;DmProvider.dll;MySqlConnector.dll;Oscar.Data.SqlClient.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Data.SqlClient.dll;Microsoft.Identity.Client.dll;System.IdentityModel.Tokens.Jwt.dll;Newtonsoft.Json.dll" />
    <PublishReadyToRunExclude Include="Microsoft.IdentityModel.JsonWebTokens.dll;Microsoft.IdentityModel.Logging.dll;Microsoft.IdentityModel.Protocols.dll;Microsoft.IdentityModel.Protocols.OpenIdConnect.dll;Microsoft.IdentityModel.Tokens.dll" />
    <PublishReadyToRunExclude Include="Microsoft.AspNetCore.Authorization.dll;Microsoft.AspNetCore.Components.dll;Microsoft.AspNetCore.Components.Forms.dll;Microsoft.AspNetCore.Components.Web.dll;Microsoft.AspNetCore.Components.WebAssembly.dll;Microsoft.AspNetCore.Metadata.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\AppIcon.ico" />
    <None Remove="Resources\AppBrandIcon.png" />
    <Resource Include="Resources\AppIcon.ico" />
    <Resource Include="Resources\AppBrandIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Native\printer.sdk.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="printer.sdk.dll" />
    <Content Include="WAV\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

