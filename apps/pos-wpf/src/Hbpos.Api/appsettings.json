{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileLogging": {
    "Enabled": true,
    "Path": "logs/hbpos-api.log",
    "MinimumLevel": "Information",
    "MaxFileSizeMb": 50,
    "RetainedFiles": 5
  },
  "LinklyCloudBackendAsync": {
    "PublicNotificationBaseUrl": ""
  },
  "LinklyCloudBackend": {},
  "AppUpdate": {
    "CenterBaseUrl": "",
    "Channel": "production",
    "CheckApiKey": "",
    "CenterApiKey": ""
  },
  "CashierAuthorization": {
    "Mode": "Audit"
  },
  "DeviceActivation": {
    "LegacyRegistrationEnabled": {
      "Windows": true,
      "iPadOS": true,
      "Android": true,
      "iOS": true
    }
  },
  "PosIpadAppReview": {
    "Enabled": false,
    "StoreCode": "",
    "ExpiresAtUtc": null,
    "MaxActiveDevices": 1,
    "GrantId": "",
    "RegistrationCodeSha256": ""
  },
  "InstallmentRepaymentClaims": {
    "Required": true,
    "CrossDeviceEnabled": true
  },
  "InstallmentCancelClaims": {
    "Required": true
  },
  "InstallmentCrossDeviceLifecycle": {
    "CancelRefundEnabled": true,
    "VoidEnabled": true,
    "PickupEnabled": true
  },
  "DataProtection": {
    "ApplicationName": "Hbpos.Api",
    "KeysPath": "App_Data/DataProtectionKeys"
  },
  "AllowedHosts": "*"
}
