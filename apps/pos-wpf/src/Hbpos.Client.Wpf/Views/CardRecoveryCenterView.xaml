<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization" x:Class="Hbpos.Client.Wpf.Views.CardRecoveryCenterView" Background="{DynamicResource PosSurfaceAltBrush}" Loaded="CardRecoveryCenterView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="RecoveryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RecoveryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RecoveryTab" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="RecoveryListItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="108"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Loc cardRecovery.center.title}" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Loc cardRecovery.workspace.subtitle}" Margin="0,5,0,0" Style="{StaticResource RecoveryLabel}"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="{loc:Loc cardRecovery.center.action.refresh}" Style="{StaticResource PosSecondaryButtonStyle}" MinHeight="48" MinWidth="100" Margin="12,0"/>
            <Button Grid.Column="2" Command="{Binding BackCommand}" Content="{loc:Loc cardRecovery.workspace.back}" Style="{StaticResource PosPrimaryButtonStyle}" MinHeight="48" MinWidth="220"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Command="{Binding FilterCommand}" CommandParameter="pending" Content="{Binding PendingCountText}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RecoveryTab}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPendingFilter}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Command="{Binding FilterCommand}" CommandParameter="failed" Content="{Binding FailedCountText}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RecoveryTab}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFailedFilter}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Command="{Binding FilterCommand}" CommandParameter="resolved" Content="{Binding ResolvedCountText}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RecoveryTab}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsResolvedFilter}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Command="{Binding FilterCommand}" CommandParameter="review" Content="{Binding ReviewCountText}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RecoveryTab}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReviewFilter}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <Grid Grid.Row="2" x:Name="RecoveryMasterDetailGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" MinWidth="300"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.5*" MinWidth="480"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PosCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:Loc cardRecovery.workspace.list}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{loc:Loc cardRecovery.workspace.search}" Style="{StaticResource RecoveryLabel}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc cardRecovery.workspace.search}" AutomationProperties.Name="{loc:Loc cardRecovery.workspace.search}" MinHeight="44" Style="{StaticResource PosSearchTextBoxStyle}"/>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="0,10,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ComboBox SelectedIndex="{Binding ChannelIndex}" MinHeight="44" AutomationProperties.Name="{loc:Loc cardRecovery.workspace.channel}">
                            <ComboBoxItem Content="{loc:Loc cardRecovery.workspace.channel}"/>
                            <ComboBoxItem Content="Linkly"/>
                            <ComboBoxItem Content="Square"/>
                        </ComboBox>
                        <ComboBox Grid.Column="2" SelectedIndex="{Binding OperationIndex}" MinHeight="44" AutomationProperties.Name="{loc:Loc cardRecovery.workspace.operations}">
                            <ComboBoxItem Content="{loc:Loc cardRecovery.workspace.operations}"/>
                            <ComboBoxItem Content="{loc:Loc cardRecovery.center.type.sale}"/>
                            <ComboBoxItem Content="{loc:Loc cardRecovery.center.type.refund}"/>
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="3">
                        <ListBox x:Name="OpenAttemptsList" ItemsSource="{Binding OpenAttemptRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" ItemContainerStyle="{StaticResource RecoveryListItemStyle}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.PanningMode="VerticalOnly">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding OrderText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OrderText}" Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding OperationTypeText}" Style="{StaticResource RecoveryValue}"/>
                                            <TextBlock Text="{Binding ChannelText}" Style="{StaticResource RecoveryLabel}" Margin="0,5,0,0"/>
                                            <TextBlock Text="{Binding UpdatedAtText}" Style="{StaticResource RecoveryLabel}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding AmountText}" FontSize="21" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource RecoveryLabel}" Margin="0,8,0,0" MaxWidth="190"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{loc:Loc cardRecovery.workspace.empty}" Style="{StaticResource RecoveryLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoOpenAttempts, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                    <Border Grid.Row="4" Background="{DynamicResource PosSurfaceMutedBrush}" Padding="12" Margin="0,10,0,0" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc cardRecovery.workspace.historyScope}" Style="{StaticResource RecoveryLabel}" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc cardRecovery.workspace.terminalHint}" Style="{StaticResource RecoveryLabel}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PosCardStyle}" Padding="18">
                <Grid>
                    <TextBlock Text="{loc:Loc cardRecovery.center.detail.empty}" Style="{StaticResource RecoveryLabel}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ScrollViewer x:Name="DetailScrollViewer" PanningMode="VerticalOnly" Style="{StaticResource PosVerticalTouchScrollViewerStyle}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{loc:Loc cardRecovery.workspace.order}" Style="{StaticResource RecoveryLabel}"/>
                            <TextBlock Text="{Binding SelectedOrderText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,12"/>
                            <Border Background="{DynamicResource PosWarningSoftBrush}" Padding="12" CornerRadius="5" Visibility="{Binding SelectedAttempt.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{loc:Loc cardRecovery.workspace.warning}" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc cardRecovery.center.field.amount}" Style="{StaticResource RecoveryLabel}"/>
                                    <TextBlock Text="{Binding SelectedAmountText}" FontSize="28" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Loc cardRecovery.center.field.status}" Style="{StaticResource RecoveryLabel}"/>
                                    <TextBlock Text="{Binding SelectedStatusText}" Style="{StaticResource RecoveryValue}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc cardRecovery.center.field.channel}" Style="{StaticResource RecoveryLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedChannelText}" Style="{StaticResource RecoveryValue}"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc cardRecovery.center.field.time}" Style="{StaticResource RecoveryLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTimeText}" Style="{StaticResource RecoveryValue}"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc cardRecovery.center.field.txn}" Style="{StaticResource RecoveryLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTxnText}" Style="{StaticResource RecoveryValue}"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc cardRecovery.center.field.responseText}" Style="{StaticResource RecoveryLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedResponseText}" Style="{StaticResource RecoveryValue}"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc cardRecovery.center.field.type}" Style="{StaticResource RecoveryLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTypeText}" Style="{StaticResource RecoveryValue}"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc cardRecovery.center.field.cashier}" Style="{StaticResource RecoveryLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedCashierText}" Style="{StaticResource RecoveryValue}"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc cardRecovery.center.field.responseCode}" Style="{StaticResource RecoveryLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedResponseCodeText}" Style="{StaticResource RecoveryValue}"/>
                            </Grid>
                            <Expander Header="{loc:Loc cardRecovery.workspace.more}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedAttemptText}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedSessionText}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedEnvironmentText}"/>
                                    <ItemsControl ItemsSource="{Binding SelectedProductLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,5">
                                                    <TextBlock Text="{Binding Quantity}" DockPanel.Dock="Right"/>
                                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                            <TextBlock Text="{loc:Loc cardRecovery.workspace.history}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,10"/>
                            <ItemsControl ItemsSource="{Binding SelectedHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource RecoveryLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource RecoveryLabel}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:Loc cardRecovery.workspace.readOnly}" Style="{StaticResource RecoveryLabel}" Margin="0,12" Visibility="{Binding IsHistorySelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding RecoveryOnlyGuidanceMessage}" Style="{StaticResource RecoveryLabel}" Margin="0,10" Visibility="{Binding CanShowRecoveryOnlyGuidance, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding SquareRefundProcessingMessage}" Style="{StaticResource RecoveryLabel}" Margin="0,10" Visibility="{Binding IsSquareRefundProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource PosPrimarySoftBrush}" BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc cardRecovery.workspace.auto}" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Loc cardRecovery.workspace.autoHint}" Style="{StaticResource RecoveryLabel}" Margin="0,6,0,12"/>
                                        <Button Command="{Binding RecoverCommand}" Content="{loc:Loc cardRecovery.center.action.recover}" Style="{StaticResource PosPrimaryButtonStyle}" MinHeight="48"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource PosBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc cardRecovery.workspace.manual}" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Loc cardRecovery.workspace.manualHint}" Style="{StaticResource RecoveryLabel}" Margin="0,6,0,12"/>
                                        <Button Command="{Binding ToggleManualCommand}" IsEnabled="{Binding CanShowSupervisorResolution}" Content="{loc:Loc cardRecovery.workspace.manual}" Style="{StaticResource PosSecondaryButtonStyle}" MinHeight="48"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Margin="0,14,0,0" Padding="14" Background="{DynamicResource PosWarningSoftBrush}" CornerRadius="5" Visibility="{Binding IsManualExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ResolutionSectionTitleText}" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ResolutionInstructionsText}" Style="{StaticResource RecoveryLabel}" Margin="0,8"/>
                                    <TextBlock Text="{Binding ResolutionReasonLabelText}" Style="{StaticResource RecoveryLabel}" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding ResolutionReason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ResolutionReasonLabelText}" MinHeight="44" TextWrapping="Wrap" Style="{StaticResource PosSearchTextBoxStyle}"/>
                                    <TextBlock Text="{Binding ResolutionEvidenceLabelText}" Style="{StaticResource RecoveryLabel}" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding ResolutionEvidence, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ResolutionEvidenceLabelText}" MinHeight="44" TextWrapping="Wrap" Style="{StaticResource PosSearchTextBoxStyle}"/>
                                    <TextBlock Text="{Binding ResolutionReferenceLabelText}" Style="{StaticResource RecoveryLabel}" Margin="0,8,0,4"/>
                                    <TextBox Text="{Binding ResolutionReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ResolutionReferenceLabelText}" MinHeight="44" TextWrapping="Wrap" Style="{StaticResource PosSearchTextBoxStyle}"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Command="{Binding ConfirmPaidCommand}" Content="{Binding ConfirmProcessedText}" Style="{StaticResource PosPrimaryButtonStyle}" MinHeight="48" Margin="0,0,8,8"/>
                                        <Button Command="{Binding ConfirmNotPaidCommand}" Content="{Binding ConfirmNotProcessedText}" Style="{StaticResource PosSecondaryButtonStyle}" MinHeight="48" Margin="0,0,8,8"/>
                                        <Button Command="{Binding ContinueWaitingCommand}" Content="{loc:Loc cardRecovery.center.action.continueWaiting}" Style="{StaticResource PosSecondaryButtonStyle}" MinHeight="48" Margin="0,0,0,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource RecoveryLabel}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                <TextBlock Text="{loc:Loc cardRecovery.workspace.refreshed}" Style="{StaticResource RecoveryLabel}"/>
                <TextBlock Text="{Binding LastRefreshText}" Style="{StaticResource RecoveryLabel}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
