                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLinklyRecommendedAddress}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
