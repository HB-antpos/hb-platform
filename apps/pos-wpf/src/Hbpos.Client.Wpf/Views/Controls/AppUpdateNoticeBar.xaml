<UserControl x:Class="Hbpos.Client.Wpf.Views.Controls.AppUpdateNoticeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:Hbpos.Client.Wpf.Services"
             AutomationProperties.AutomationId="AppUpdateNoticeBar">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="NoticeBarTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 状态栏只有 42 像素高，按钮压到 30 像素，仍保留足够的触控宽度。 -->
        <Style x:Key="NoticeBarButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- 底部状态栏里的更新提示条：DataContext 为 AppUpdateState；背景盖住下面的状态栏信息，不占用页面内容区。 -->
    <Border Background="{DynamicResource PosSurfaceBrush}" Padding="0,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <materialDesign:PackIcon Kind="AlertCircleOutline"
                                     Width="16"
                                     Height="16"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource PosWarningTextBrush}"
                                     Visibility="{Binding IsForceUpdatePendingInstall, Converter={StaticResource BoolToVis}}" />
            <materialDesign:PackIcon Kind="Update"
                                     Width="16"
                                     Height="16"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource PosPrimaryTextBrush}"
                                     Visibility="{Binding IsOptionalUpdateReady, Converter={StaticResource BoolToVis}}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc appUpdate.notice.forceTitle}"
                           Style="{StaticResource NoticeBarTextStyle}"
                           FontWeight="Black"
                           Foreground="{DynamicResource PosWarningTextBrush}"
                           Visibility="{Binding IsForceUpdatePendingInstall, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{loc:Loc appUpdate.notice.optionalTitle}"
                           Style="{StaticResource NoticeBarTextStyle}"
                           FontWeight="Black"
                           Foreground="{DynamicResource PosPrimaryTextBrush}"
                           Visibility="{Binding IsOptionalUpdateReady, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding TargetVersion}"
                           Style="{StaticResource NoticeBarTextStyle}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PosTextBrush}"
                           Margin="6,0,0,0" />
            </StackPanel>

            <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ReadyText"
                           Text="{loc:Loc appUpdate.notice.ready}"
                           Style="{StaticResource NoticeBarTextStyle}"
                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                           Visibility="{Binding CanInstallFromNotice, Converter={StaticResource BoolToVis}}" />
                <!-- 交易中安装一定会被拒绝，只提示交易完成后再装，不给会“点了没反应”的安装按钮。 -->
                <TextBlock x:Name="WaitingForTransactionText"
                           Text="{loc:Loc appUpdate.notice.waitingForTransaction}"
                           Style="{StaticResource NoticeBarTextStyle}"
                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                           Visibility="{Binding IsTransactionInProgress, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <Button x:Name="InstallButton"
                    Grid.Column="3"
                    Command="{Binding InstallUpdateCommand}"
                    services:ButtonFeedback.Cue="VersionNotice"
                    AutomationProperties.AutomationId="AppUpdateNoticeInstallButton"
                    Style="{StaticResource NoticeBarButtonStyle}"
                    Visibility="{Binding CanInstallFromNotice, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Update" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Loc appUpdate.force.action}" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button x:Name="PostponeButton"
                    Grid.Column="4"
                    Command="{Binding PostponeForceUpdateCommand}"
                    AutomationProperties.AutomationId="AppUpdateNoticePostponeButton"
                    Style="{StaticResource NoticeBarButtonStyle}"
                    Visibility="{Binding CanPostponeForceUpdate, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:Loc appUpdate.notice.later}" FontWeight="Bold" />
            </Button>

            <Button x:Name="DismissOptionalButton"
                    Grid.Column="5"
                    Command="{Binding DismissOptionalUpdateCommand}"
                    AutomationProperties.AutomationId="AppUpdateNoticeDismissButton"
                    Style="{StaticResource NoticeBarButtonStyle}"
                    Visibility="{Binding IsOptionalUpdateReady, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:Loc appUpdate.notice.later}" FontWeight="Bold" />
            </Button>

            <Button Grid.Column="6"
                    Command="{Binding DismissForceUpdateForDebugCommand}"
                    Style="{StaticResource TitleBarButtonStyle}"
                    ToolTip="{loc:Loc appUpdate.force.dismissDebug}"
                    Height="30"
                    Margin="8,0,0,0"
                    Visibility="{Binding CanDismissForceUpdateForDebug, Converter={StaticResource BoolToVis}}">
                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
            </Button>
        </Grid>
    </Border>
</UserControl>
