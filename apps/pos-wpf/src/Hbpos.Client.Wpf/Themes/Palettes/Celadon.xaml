<!-- 由色板总表生成，四套主题的键必须完全一致。青瓷：灰绿中间调、石油蓝主色，全天候通用。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="PosPaletteId">Celadon</sys:String>
    <sys:Boolean x:Key="PosPaletteIsDark">False</sys:Boolean>
    <Color x:Key="PosPaletteMaterialPrimaryColor">#FF245A74</Color>

    <!-- 整屏背景 -->
    <SolidColorBrush x:Key="PosScreenBackgroundBrush" Color="#FFE1E8E3" />
    <!-- 卡片/面板 -->
    <SolidColorBrush x:Key="PosSurfaceBrush" Color="#FFF2F5F2" />
    <!-- 次级面板/交替行 -->
    <SolidColorBrush x:Key="PosSurfaceAltBrush" Color="#FFEAEFEB" />
    <!-- 浅灰底（输入区、分组底） -->
    <SolidColorBrush x:Key="PosSurfaceMutedBrush" Color="#FFE4EAE6" />
    <!-- 较深灰底（按下、禁用块） -->
    <SolidColorBrush x:Key="PosSurfaceStrongBrush" Color="#FFD6DED8" />
    <!-- 深色提示底（配白字） -->
    <SolidColorBrush x:Key="PosInverseSurfaceBrush" Color="#FF1D2923" />
    <!-- 分隔线/浅描边 -->
    <SolidColorBrush x:Key="PosDividerBrush" Color="#FFD6DED8" />
    <!-- 描边 -->
    <SolidColorBrush x:Key="PosBorderBrush" Color="#FFC4CFC8" />
    <!-- 深描边/滚动条 -->
    <SolidColorBrush x:Key="PosBorderStrongBrush" Color="#FF93A39A" />
    <!-- 正文 -->
    <SolidColorBrush x:Key="PosTextBrush" Color="#FF1D2923" />
    <!-- 次级正文 -->
    <SolidColorBrush x:Key="PosTextSecondaryBrush" Color="#FF34433B" />
    <!-- 次要文字 -->
    <SolidColorBrush x:Key="PosMutedForegroundBrush" Color="#FF56655D" />
    <!-- 占位/弱提示文字 -->
    <SolidColorBrush x:Key="PosSubtleForegroundBrush" Color="#FF849189" />
    <!-- 功能图标 -->
    <SolidColorBrush x:Key="PosIconBrush" Color="#FF3D5A66" />
    <!-- 侧栏功能图标 -->
    <SolidColorBrush x:Key="PosSidebarIconBrush" Color="#FF3D5A66" />
    <!-- 侧栏退款图标 -->
    <SolidColorBrush x:Key="PosSidebarRefundIconBrush" Color="#FF3D5A66" />
    <!-- 侧栏挂单图标 -->
    <SolidColorBrush x:Key="PosSidebarHoldIconBrush" Color="#FF3D5A66" />
    <!-- 主色填充/描边（配白字） -->
    <SolidColorBrush x:Key="PosPrimaryBrush" Color="#FF245A74" />
    <!-- 主色按下 -->
    <SolidColorBrush x:Key="PosPrimaryStrongBrush" Color="#FF1C4A60" />
    <!-- 主色文字/图标 -->
    <SolidColorBrush x:Key="PosPrimaryTextBrush" Color="#FF245A74" />
    <!-- 选中/主色浅底 -->
    <SolidColorBrush x:Key="PosPrimarySoftBrush" Color="#FFD5E4EB" />
    <!-- 主色浅底（悬停/按下） -->
    <SolidColorBrush x:Key="PosPrimarySoftStrongBrush" Color="#FFC2D7E1" />
    <!-- 主色浅描边 -->
    <SolidColorBrush x:Key="PosPrimarySoftBorderBrush" Color="#FFB5CDD8" />
    <!-- 主色按钮禁用底（配白字） -->
    <SolidColorBrush x:Key="PosPrimaryDisabledBrush" Color="#FF8DA9B8" />
    <!-- 标题文字 -->
    <SolidColorBrush x:Key="PosPrimaryDarkBrush" Color="#FF1D2923" />
    <!-- 重点金额 -->
    <SolidColorBrush x:Key="PosAccentBrush" Color="#FF9A5A00" />
    <!-- 重点金额文字 -->
    <SolidColorBrush x:Key="PosAccentForegroundBrush" Color="#FF9A5A00" />
    <!-- 应付合计底色（荧光笔） -->
    <SolidColorBrush x:Key="PosAmountSoftBrush" Color="#FFF0E2A2" />
    <!-- 成功填充（配白字） -->
    <SolidColorBrush x:Key="PosSuccessBrush" Color="#FF2B7550" />
    <!-- 成功文字 -->
    <SolidColorBrush x:Key="PosSuccessTextBrush" Color="#FF2B7550" />
    <!-- 成功浅底 -->
    <SolidColorBrush x:Key="PosSuccessSoftBrush" Color="#FFD7EBDF" />
    <!-- 成功描边 -->
    <SolidColorBrush x:Key="PosSuccessBorderBrush" Color="#FFA3CDB4" />
    <!-- 警告填充 -->
    <SolidColorBrush x:Key="PosWarningBrush" Color="#FFD4A23E" />
    <!-- 警告文字 -->
    <SolidColorBrush x:Key="PosWarningTextBrush" Color="#FF8A5700" />
    <!-- 警告强调填充（配白字） -->
    <SolidColorBrush x:Key="PosWarningStrongBrush" Color="#FF8A5700" />
    <!-- 警告浅底 -->
    <SolidColorBrush x:Key="PosWarningSoftBrush" Color="#FFF3E3C3" />
    <!-- 警告描边 -->
    <SolidColorBrush x:Key="PosWarningBorderBrush" Color="#FFE0C98E" />
    <!-- 危险填充（配白字） -->
    <SolidColorBrush x:Key="PosDangerBrush" Color="#FFA63A32" />
    <!-- 危险文字 -->
    <SolidColorBrush x:Key="PosDangerTextBrush" Color="#FFA63A32" />
    <!-- 危险浅底 -->
    <SolidColorBrush x:Key="PosDangerSoftBrush" Color="#FFF3DDD9" />
    <!-- 危险描边 -->
    <SolidColorBrush x:Key="PosDangerBorderBrush" Color="#FFE0B3AD" />
    <!-- 标题栏背景 -->
    <SolidColorBrush x:Key="PosHeaderBackgroundBrush" Color="#FFF2F5F2" />
    <!-- 标题栏文字 -->
    <SolidColorBrush x:Key="PosHeaderForegroundBrush" Color="#FF1D2923" />
    <!-- 标题栏次要文字 -->
    <SolidColorBrush x:Key="PosHeaderMutedForegroundBrush" Color="#FF56655D" />
    <!-- 状态栏背景 -->
    <SolidColorBrush x:Key="PosFooterBackgroundBrush" Color="#FFEAEFEB" />

    <!-- ── 长者模式/支付方式/快捷金额新增语义键：旧主题取值＝改动前的等效色，视觉不变 ── -->
    <!-- 首页购物车区底色 -->
    <SolidColorBrush x:Key="PosZoneCartBrush" Color="#FFEAEFEB" />
    <!-- 首页键盘区底色 -->
    <SolidColorBrush x:Key="PosZoneKeypadBrush" Color="#FFEAEFEB" />
    <!-- 首页功能区底色 -->
    <SolidColorBrush x:Key="PosZoneFuncBrush" Color="#FFEAEFEB" />
    <!-- 首页分区竖线 -->
    <SolidColorBrush x:Key="PosZoneDividerBrush" Color="#FFD6DED8" />
    <!-- 键/按钮/卡片描边（原 PosBorderBrush 用法） -->
    <SolidColorBrush x:Key="PosKeyBorderBrush" Color="#FFC4CFC8" />
    <!-- 卡片浅描边（原 PosDividerBrush 用法） -->
    <SolidColorBrush x:Key="PosCardBorderBrush" Color="#FFD6DED8" />
    <!-- 键帽底部投影色 -->
    <SolidColorBrush x:Key="PosKeyShadowBrush" Color="#00000000" />
    <!-- 购物车表头底色 -->
    <SolidColorBrush x:Key="PosCartHeaderBrush" Color="#FFEAEFEB" />
    <!-- 购物车斑马纹 -->
    <SolidColorBrush x:Key="PosCartAltRowBrush" Color="#FFEAEFEB" />
    <!-- 购物车选中行底色 -->
    <SolidColorBrush x:Key="PosCartSelectedRowBrush" Color="#FFD5E4EB" />
    <!-- 购物车应付合计金额色 -->
    <SolidColorBrush x:Key="PosDueAmountBrush" Color="#FF9A5A00" />
    <!-- 首页 Clear 键底色 -->
    <SolidColorBrush x:Key="PosClearKeyBrush" Color="#FFF2F5F2" />
    <!-- 无条码按钮底色 -->
    <SolidColorBrush x:Key="PosNoBarcodeBrush" Color="#FF245A74" />
    <!-- 无条码按钮文字色 -->
    <SolidColorBrush x:Key="PosNoBarcodeForegroundBrush" Color="#FFFFFFFF" />
    <!-- 无条码按钮按下底色 -->
    <SolidColorBrush x:Key="PosNoBarcodePressedBrush" Color="#FF1C4A60" />
    <!-- 无条码按钮禁用底色 -->
    <SolidColorBrush x:Key="PosNoBarcodeDisabledBrush" Color="#FF8DA9B8" />
    <!-- 功能区按钮底色 -->
    <SolidColorBrush x:Key="PosSidebarButtonBrush" Color="#FFF2F5F2" />
    <!-- 功能区按钮文字色 -->
    <SolidColorBrush x:Key="PosSidebarButtonForegroundBrush" Color="#FF1D2923" />
    <!-- 功能区按钮悬停底色 -->
    <SolidColorBrush x:Key="PosSidebarButtonHoverBrush" Color="#FFEAEFEB" />
    <!-- 功能区按钮按下底色 -->
    <SolidColorBrush x:Key="PosSidebarButtonPressedBrush" Color="#FFD5E4EB" />
    <!-- 功能区退出按钮底色 -->
    <SolidColorBrush x:Key="PosSidebarExitButtonBrush" Color="#FFF2F5F2" />
    <!-- 功能区退出按钮文字/图标色 -->
    <SolidColorBrush x:Key="PosSidebarExitForegroundBrush" Color="#FFA63A32" />
    <!-- 功能区退出按钮悬停底色 -->
    <SolidColorBrush x:Key="PosSidebarExitHoverBrush" Color="#FFEAEFEB" />
    <!-- 功能区退出按钮按下底色 -->
    <SolidColorBrush x:Key="PosSidebarExitPressedBrush" Color="#FFD5E4EB" />
    <!-- 确认支付按钮底色 -->
    <SolidColorBrush x:Key="PosConfirmPaymentBrush" Color="#FF245A74" />
    <!-- 确认支付按钮底部厚阴影色 -->
    <SolidColorBrush x:Key="PosConfirmPaymentShadowBrush" Color="#00000000" />
    <!-- 支付页取消按钮底色 -->
    <SolidColorBrush x:Key="PosCancelButtonBrush" Color="#FFF2F5F2" />
    <!-- 支付页取消按钮文字色 -->
    <SolidColorBrush x:Key="PosCancelButtonForegroundBrush" Color="#FF1D2923" />
    <!-- 待付/应付金额强调色 -->
    <SolidColorBrush x:Key="PosAmountEmphasisBrush" Color="#FF245A74" />
    <!-- 找零块底色 -->
    <SolidColorBrush x:Key="PosChangeDueBackgroundBrush" Color="#FFD7EBDF" />
    <!-- 找零文字色 -->
    <SolidColorBrush x:Key="PosChangeDueForegroundBrush" Color="#FF2B7550" />
    <!-- 购物车加量按钮底色 -->
    <SolidColorBrush x:Key="PosQtyPlusBrush" Color="#FFF2F5F2" />
    <!-- 购物车加量按钮文字/图标色 -->
    <SolidColorBrush x:Key="PosQtyPlusForegroundBrush" Color="#FF2B7550" />
    <!-- 10%–50% 折扣键文字色 -->
    <SolidColorBrush x:Key="PosDiscountKeyForegroundBrush" Color="#FF1D2923" />
    <!-- 折扣条分段竖线 -->
    <SolidColorBrush x:Key="PosSegmentSeparatorBrush" Color="#FFC4CFC8" />
    <!-- 屏幕键盘 / 搜索候选弹层的描边（旧主题＝PosDividerBrush；长者主题内容区无描边，但浮层必须有边界） -->
    <SolidColorBrush x:Key="PosPopupBorderBrush" Color="#FFD6DED8" />
    <!-- 支付方式语义色：现金=琥珀棕、刷卡=深蓝、代金券=紫；Fill 选中实心 / On 实心上的字 / Soft 未选浅块 / Ink 浅块上的字与图标 -->
    <SolidColorBrush x:Key="PosMethodCashFillBrush" Color="#FF8A5300" />
    <SolidColorBrush x:Key="PosMethodCashOnBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PosMethodCashSoftBrush" Color="#FFF0E3C9" />
    <SolidColorBrush x:Key="PosMethodCashInkBrush" Color="#FF774700" />
    <SolidColorBrush x:Key="PosMethodCardFillBrush" Color="#FF2B4C8C" />
    <SolidColorBrush x:Key="PosMethodCardOnBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PosMethodCardSoftBrush" Color="#FFDCE3F0" />
    <SolidColorBrush x:Key="PosMethodCardInkBrush" Color="#FF284682" />
    <SolidColorBrush x:Key="PosMethodVoucherFillBrush" Color="#FF6A3D8F" />
    <SolidColorBrush x:Key="PosMethodVoucherOnBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PosMethodVoucherSoftBrush" Color="#FFE6DCEF" />
    <SolidColorBrush x:Key="PosMethodVoucherInkBrush" Color="#FF5D3580" />
    <!-- 快捷现金面额色（澳元面额主色的 UI 自定义色，不取样自纸币）：Fill 底色 / Text 数字色 -->
    <SolidColorBrush x:Key="PosNote100FillBrush" Color="#FF367B5C" />
    <SolidColorBrush x:Key="PosNote100TextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PosNote50FillBrush" Color="#FFDDBB55" />
    <SolidColorBrush x:Key="PosNote50TextBrush" Color="#FF2E1500" />
    <SolidColorBrush x:Key="PosNote20FillBrush" Color="#FFB5492B" />
    <SolidColorBrush x:Key="PosNote20TextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PosNote10FillBrush" Color="#FF2E5E8E" />
    <SolidColorBrush x:Key="PosNote10TextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PosNote5FillBrush" Color="#FF82507C" />
    <SolidColorBrush x:Key="PosNote5TextBrush" Color="#FFFFFFFF" />

    <LinearGradientBrush x:Key="PosPrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2E6C8A" Offset="0" />
        <GradientStop Color="#FF245A74" Offset="0.55" />
        <GradientStop Color="#FF1C4A60" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PosPayButtonGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF2A6682" Offset="0" />
        <GradientStop Color="#FF1F4F66" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
