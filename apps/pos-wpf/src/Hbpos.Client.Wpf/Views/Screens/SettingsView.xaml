                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.loadFromStore}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ReceiptPrinterTitleText}"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   Foreground="{DynamicResource PosTextBrush}" />
