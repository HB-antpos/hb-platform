{
  "manifest_version": 3,
  "name": "HB Supplier Order",
  "version": "1.5.0",
  "description": "Hot Bargain supplier order purchase-cycle assistant for supplier list pages.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://hotbargain.vip/*"],
  "optional_host_permissions": [
    "https://*/*",
    "http://txkorders.inzantsales.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "HB Supplier Order",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://hotbargain.vip/*"],
      "js": ["content/shop-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.4"
    }
  }
}
