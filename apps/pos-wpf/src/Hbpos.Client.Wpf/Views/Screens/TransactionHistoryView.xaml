<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.TransactionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Hbpos.Client.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="688"
             d:DesignWidth="1366"
             Language="{Binding CurrentUiLanguage}"
             Background="{DynamicResource PosSurfaceAltBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringHasValueToVis" />

        <Style x:Key="HistoryPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="HistoryColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource PosFontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   LineHeight="15"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryPrimaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsReturnOrder}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistorySecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HistoryRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="72" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsReturnOrder}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistorySegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosPrimaryBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeldScopeSegmentRadioStyle" TargetType="RadioButton"
               BasedOn="{StaticResource HistorySegmentRadioStyle}">
            <!-- 与来源导航保持一致，避免 Held 模式切换时产生尺寸跳动。 -->
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <Style x:Key="HistoryFilterLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,5" />
        </Style>

        <Style x:Key="HistoryStatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosSuccessBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuspendedOrder}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosWarningSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosWarningBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanContinueInstallmentPayment}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalHold}">
                    <Setter Property="Background" Value="{DynamicResource PosWarningSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosWarningBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalPendingPublish}">
                    <Setter Property="Background" Value="{DynamicResource PosWarningSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosWarningBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.Published}">
                    <Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosSuccessBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.RemotePending}">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalClaimPrepared}">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalClaimActive}">
                    <Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosSuccessBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.ClaimedByOther}">
                    <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.Completed}">
                    <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.Blocked}">
                    <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryStatusBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuspendedOrder}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanContinueInstallmentPayment}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalHold}">
                    <Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalPendingPublish}">
                    <Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.Published}">
                    <Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.RemotePending}">
                    <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalClaimPrepared}">
                    <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.LocalClaimActive}">
                    <Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.ClaimedByOther}">
                    <Setter Property="Foreground" Value="{DynamicResource PosTextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.Completed}">
                    <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HeldBadgeKind}" Value="{x:Static vm:HeldOrderBadgeKind.Blocked}">
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryIconTextButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
        </Style>

        <Style x:Key="HistoryReceiptButtonStyle" TargetType="Button" BasedOn="{StaticResource HistoryIconTextButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="HistoryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
        </Style>

        <Style x:Key="HistoryPrimaryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource HistoryIconButtonStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
        </Style>

        <Style x:Key="HistoryActionCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource HistoryGridCellStyle}">
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <Style x:Key="HistoryMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextSecondaryBrush}" />
        </Style>

        <Style x:Key="HistoryPreviewLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="HistoryPreviewValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="HistoryPageLayout" Background="{DynamicResource PosSurfaceAltBrush}">
        <Grid x:Name="HistoryWorkspace" Margin="20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HistoryHeaderRegion" Grid.Row="0" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding ReturnToPosCommand}"
                            Height="46"
                            Padding="12,0"
                            Margin="0,0,12,0"
                            FontSize="14"
                            Style="{StaticResource PosSecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Loc shell.backToPos}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Border x:Name="HistorySourceNavigation"
                            Grid.Column="1"
                            Height="46"
                            Padding="4"
                            BorderBrush="{DynamicResource PosBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Background="{DynamicResource PosSurfaceMutedBrush}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="HistorySource"
                                         IsChecked="{Binding IsLocalSourceSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{loc:Loc history.source.local}"
                                         Style="{StaticResource HistorySegmentRadioStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Monitor" Width="16" Height="16" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:Loc history.source.local}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="HistorySource"
                                         IsChecked="{Binding IsOnlineSourceSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{loc:Loc history.source.online}"
                                         Style="{StaticResource HistorySegmentRadioStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cloud" Width="16" Height="16" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:Loc history.source.online}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="HistorySource"
                                         IsChecked="{Binding IsInstallmentSourceSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{loc:Loc history.source.installments}"
                                         Style="{StaticResource HistorySegmentRadioStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CalendarClock" Width="16" Height="16" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:Loc history.source.installments}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="HistorySource"
                                         IsChecked="{Binding IsHeldSourceSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="{Binding HeldOrdersSourceLabel}"
                                         Style="{StaticResource HistorySegmentRadioStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardTextClock" Width="16" Height="16" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding HeldOrdersSourceLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"
                            Height="46"
                            Padding="4"
                            BorderBrush="{DynamicResource PosBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Background="{DynamicResource PosSurfaceMutedBrush}"
                            Visibility="{Binding IsHeldScopeSelectorVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{Binding HeldLocalScopeLabel}"
                                         GroupName="HeldScope"
                                         IsChecked="{Binding IsHeldLocalScopeSelected, Mode=TwoWay}"
                                         Style="{StaticResource HeldScopeSegmentRadioStyle}" />
                            <RadioButton Content="{Binding HeldOtherScopeLabel}"
                                         GroupName="HeldScope"
                                         IsChecked="{Binding IsHeldOtherScopeSelected, Mode=TwoWay}"
                                         Style="{StaticResource HeldScopeSegmentRadioStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="HistoryFilterPanel"
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="12,10"
                        Style="{StaticResource HistoryPanelStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="HistoryDateRangeFilter" Grid.Column="0" Width="286">
                            <TextBlock Text="{loc:Loc history.dateRangeLabel}"
                                       Style="{StaticResource HistoryFilterLabelStyle}" />
                            <Border Height="44"
                                    Padding="2,0"
                                    Background="{DynamicResource PosSurfaceBrush}"
                                    BorderBrush="{DynamicResource PosBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedDateFormat="Short"
                                                Height="42"
                                                FontSize="12"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                VerticalContentAlignment="Center"
                                                AutomationProperties.AutomationId="TransactionHistoryDateFrom"
                                                AutomationProperties.Name="{loc:Loc history.dateRangeLabel}"
                                                ToolTip="{loc:Loc history.dateRangeLabel}" />
                                    <TextBlock Grid.Column="1"
                                               Text="-"
                                               Foreground="{DynamicResource PosSubtleForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <DatePicker Grid.Column="2"
                                                SelectedDate="{Binding DateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedDateFormat="Short"
                                                Height="42"
                                                FontSize="12"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                VerticalContentAlignment="Center"
                                                AutomationProperties.AutomationId="TransactionHistoryDateTo"
                                                AutomationProperties.Name="{loc:Loc history.dateRangeLabel}"
                                                ToolTip="{loc:Loc history.dateRangeLabel}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="HistoryTerminalFilter"
                                    Grid.Column="1"
                                    Width="190"
                                    Margin="12,0,0,0"
                                    Visibility="{Binding IsTerminalFilterVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc Terminal}"
                                       Style="{StaticResource HistoryFilterLabelStyle}" />
                            <ComboBox ItemsSource="{Binding TerminalOptions}"
                                      SelectedItem="{Binding SelectedTerminalOption, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      Height="44"
                                      FontSize="12"
                                      ToolTip="{loc:Loc Terminal}" />
                        </StackPanel>

                        <StackPanel x:Name="HistorySearchFilter"
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    MinWidth="220">
                            <TextBlock Text="{loc:Loc history.searchLabel}"
                                       Style="{StaticResource HistoryFilterLabelStyle}" />
                            <Grid>
                                <TextBox x:Name="HistorySearchTextBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="{Binding SearchHintText}"
                                         InputMethod.IsInputMethodEnabled="False"
                                         InputMethod.PreferredImeState="Off"
                                         Height="44"
                                         FontSize="13"
                                         Padding="38,0,48,0"
                                         Style="{StaticResource PosSearchTextBoxStyle}">
                                    <!-- 查询框获得焦点后仍隔离中文输入法，Enter 与扫码统一走当前筛选的 LoadCommand。 -->
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding LoadCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <materialDesign:PackIcon Kind="Magnify"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="{DynamicResource PosSubtleForegroundBrush}"
                                                         Margin="13,0,0,0"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         IsHitTestVisible="False" />
                                <Button x:Name="HistorySearchClearButton"
                                        Click="ClearSearchButtonClick"
                                        ToolTip="{loc:Loc Clear}"
                                        AutomationProperties.AutomationId="TransactionHistorySearchClearButton"
                                        AutomationProperties.Name="{loc:Loc Clear}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PosButtonBaseStyle}">
                                            <Setter Property="Width" Value="40" />
                                            <Setter Property="Height" Value="40" />
                                            <Setter Property="MinWidth" Value="40" />
                                            <Setter Property="MinHeight" Value="40" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=HistorySearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=HistorySearchTextBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <materialDesign:PackIcon Kind="CloseCircle"
                                                             Width="17"
                                                             Height="17"
                                                             IsHitTestVisible="False" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Command="{Binding LoadCommand}"
                                Height="44"
                                MinWidth="104"
                                Padding="16,0"
                                Margin="12,0,0,0"
                                VerticalAlignment="Bottom"
                                FontSize="14"
                                AutomationProperties.Name="{loc:Loc common.load}"
                                Style="{StaticResource PosPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Loc common.load}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource HistoryPanelStyle}"
                    ClipToBounds="True">
                <DataGrid x:Name="HistoryOrdersGrid"
                          ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserResizeColumns="False"
                          RowBackground="{DynamicResource PosSurfaceBrush}"
                          AlternatingRowBackground="{DynamicResource PosSurfaceAltBrush}"
                          RowStyle="{StaticResource HistoryRowStyle}"
                          CellStyle="{StaticResource HistoryGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource HistoryColumnHeaderStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          Style="{StaticResource PosCartDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="ReuploadSelectionColumn"
                                                Header=""
                                                Width="42"
                                                CellStyle="{StaticResource HistoryActionCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selection.IsSelected}"
                                              IsEnabled="{Binding CanReupload}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="OrderSummaryColumn"
                                                Header="{loc:Loc history.orderTime}"
                                                Width="22*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Style="{StaticResource HistoryPrimaryTextStyle}"
                                                   ToolTip="{Binding DisplayOrderId}">
                                            <Run Text="#" />
                                            <Run Text="{Binding DisplayOrderId, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SoldAtDisplay}"
                                                   ToolTip="{Binding SoldAtDisplay}"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource HistorySecondaryTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="StandardCashierSummaryColumn"
                                                Header="{loc:Loc history.cashierTerminal}"
                                                Width="22*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding CashierName}"
                                                   ToolTip="{Binding CashierName}"
                                                   Style="{StaticResource HistoryPrimaryTextStyle}" />
                                        <DockPanel Grid.Row="1" Margin="0,4,0,0" LastChildFill="True">
                                            <materialDesign:PackIcon Kind="Monitor"
                                                                     DockPanel.Dock="Left"
                                                                     Width="14"
                                                                     Height="14"
                                                                     Margin="0,0,6,0"
                                                                     Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                            <TextBlock Text="{Binding DeviceCode}"
                                                       ToolTip="{Binding DeviceCode}"
                                                       Style="{StaticResource HistorySecondaryTextStyle}" />
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="InstallmentCustomerSummaryColumn"
                                                Header="{loc:Loc history.customerPhone}"
                                                Width="24*"
                                                Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding CashierName}"
                                                   ToolTip="{Binding CashierName}"
                                                   Style="{StaticResource HistoryPrimaryTextStyle}" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource HistorySecondaryTextStyle}">
                                            <Run Text="{Binding CustomerPhone}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding DeviceCode}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="StandardAmountSummaryColumn"
                                                Header="{loc:Loc history.amountItems}"
                                                Width="18*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding ActualAmount, StringFormat={}{0:C2}}"
                                                   Style="{StaticResource HistoryPrimaryTextStyle}" />
                                        <DockPanel Grid.Row="1" Margin="0,4,0,0" LastChildFill="True">
                                            <materialDesign:PackIcon Kind="FormatListNumbered"
                                                                     DockPanel.Dock="Left"
                                                                     Width="14"
                                                                     Height="14"
                                                                     Margin="0,0,6,0"
                                                                     Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                            <TextBlock Style="{StaticResource HistorySecondaryTextStyle}">
                                                <Run Text="{Binding LineCount}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding PaymentSummary}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="InstallmentAmountSummaryColumn"
                                                Header="{loc:Loc history.totalOutstanding}"
                                                Width="26*"
                                                Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding TotalAmount, StringFormat={}{0:C2}}"
                                                   Style="{StaticResource HistoryPrimaryTextStyle}" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,4,0,0"
                                                   Style="{StaticResource HistorySecondaryTextStyle}">
                                            <Run Text="{loc:Loc payment.installment.outstanding}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding ActualAmount, StringFormat={}{0:C2}}" />
                                            <Run Text=" · " />
                                            <Run Text="{loc:Loc history.installment.paid}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding PaymentSummary}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="StatusSummaryColumn"
                                                Header="{loc:Loc common.status}"
                                                Width="18*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <Border Style="{StaticResource HistoryStatusBadgeBorderStyle}"
                                                MaxWidth="180"
                                                ToolTip="{Binding StatusLabel}">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       Style="{StaticResource HistoryStatusBadgeTextStyle}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ShareStatusLabel}"
                                                       Style="{StaticResource HistorySecondaryTextStyle}" />
                                            <TextBlock Text="..."
                                                       Visibility="{Binding Share.IsBusy, Converter={StaticResource BoolToVis}}"
                                                       Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn x:Name="HistoryActionsColumn"
                                                Header=""
                                                Width="268"
                                                CellStyle="{StaticResource HistoryActionCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.OpenReceiptPreviewCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0"
                                                ToolTip="{loc:Loc history.viewReceipt}"
                                                AutomationProperties.Name="{loc:Loc history.viewReceipt}"
                                                Style="{StaticResource HistoryReceiptButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Receipt" Width="16" Height="16" Margin="0,0,6,0" />
                                                <TextBlock Text="{loc:Loc history.viewReceipt}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding DataContext.OpenOrderDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanViewOrderDetails}"
                                                Width="44"
                                                Height="44"
                                                Margin="0,0,6,0"
                                                ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.AutomationId="TransactionHistoryOrderDetailsButton"
                                                AutomationProperties.Name="{loc:Loc history.viewOrderDetails}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource HistoryPrimaryIconButtonStyle}">
                                                    <Setter Property="AutomationProperties.HelpText"
                                                            Value="{loc:Loc history.viewOrderDetails}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanViewOrderDetails}" Value="False">
                                                            <Setter Property="AutomationProperties.HelpText"
                                                                    Value="{loc:Loc history.remoteHeldDetailsUnavailable}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <ToolTip.Style>
                                                        <Style TargetType="ToolTip">
                                                            <Setter Property="Content" Value="{loc:Loc history.viewOrderDetails}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.CanViewOrderDetails, RelativeSource={RelativeSource Self}}"
                                                                             Value="False">
                                                                    <Setter Property="Content" Value="{loc:Loc history.remoteHeldDetailsUnavailable}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ToolTip.Style>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="18" Height="18" />
                                        </Button>

                                        <Button Command="{Binding DataContext.RecallOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanRecall}"
                                                Visibility="{Binding CanRecall, Converter={StaticResource BoolToVis}}"
                                                Width="44"
                                                Height="44"
                                                Margin="0,0,6,0"
                                                ToolTip="{loc:Loc suspended.recall}"
                                                AutomationProperties.Name="{loc:Loc suspended.recall}"
                                                Style="{StaticResource HistoryPrimaryIconButtonStyle}">
                                            <materialDesign:PackIcon Kind="ClipboardTextClock" Width="18" Height="18" />
                                        </Button>

                                        <Button Command="{Binding DataContext.ContinueInstallmentPaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanContinueInstallmentPayment}"
                                                Visibility="{Binding CanContinueInstallmentPayment, Converter={StaticResource BoolToVis}}"
                                                Width="44"
                                                Height="44"
                                                Margin="0,0,6,0"
                                                ToolTip="{loc:Loc history.installment.continuePayment}"
                                                AutomationProperties.Name="{loc:Loc history.installment.continuePayment}"
                                                Style="{StaticResource HistoryPrimaryIconButtonStyle}">
                                            <materialDesign:PackIcon Kind="CalendarClock" Width="18" Height="18" />
                                        </Button>

                                        <Button Click="OpenHistoryRowActionsMenu"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Width="44"
                                                Height="44"
                                                ToolTip="{loc:Loc history.moreActions}"
                                                AutomationProperties.Name="{loc:Loc history.moreActions}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource HistoryIconButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanShare}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CanDeleteHeldOrder}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CanForceRelease}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}"
                                                             Placement="Bottom"
                                                             StaysOpen="False"
                                                             MinWidth="168"
                                                             Padding="4">
                                                    <MenuItem Header="{Binding Tag.ShareHeldOrderLabel}"
                                                              Command="{Binding Tag.ShareHeldOrderCommand}"
                                                              CommandParameter="{Binding DataContext}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem" BasedOn="{StaticResource HistoryMenuItemStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.CanShare}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="ShareVariant" Width="17" Height="17" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding Tag.DeleteHeldOrderLabel}"
                                                              Command="{Binding Tag.DeleteHeldOrderCommand}"
                                                              CommandParameter="{Binding DataContext}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem" BasedOn="{StaticResource HistoryMenuItemStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.CanDeleteHeldOrder}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="DeleteOutline"
                                                                                     Width="17"
                                                                                     Height="17"
                                                                                     Foreground="{DynamicResource PosDangerTextBrush}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{Binding Tag.ForceReleaseLabel}"
                                                              Command="{Binding Tag.ForceReleaseHeldOrderCommand}"
                                                              CommandParameter="{Binding DataContext}">
                                                        <MenuItem.Style>
                                                            <Style TargetType="MenuItem" BasedOn="{StaticResource HistoryMenuItemStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.CanForceRelease}"
                                                                                 Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </MenuItem.Style>
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="LockOpen" Width="17" Height="17" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <materialDesign:PackIcon Kind="DotsVertical" Width="20" Height="20" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource HistoryPanelStyle}"
                    Padding="16,12"
                    Margin="0,14,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource PosTextSecondaryBrush}" FontWeight="SemiBold">
                            <Run Text="{loc:Loc history.showingPrefix}" />
                            <Run Text="{Binding Orders.Count, Mode=OneWay}" />
                            <Run Text=" " />
                            <Run Text="{loc:Loc history.transactions}" />
                        </TextBlock>
                        <Separator Width="1" Height="24" Margin="18,0" Background="{DynamicResource PosSurfaceStrongBrush}" />
                        <TextBlock Text="{Binding PreviewOrderId}" Foreground="{DynamicResource PosPrimaryTextBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="  " />
                        <TextBlock Text="{Binding PreviewSoldAt}" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Command="{Binding ConfirmInstallmentPickupCommand}"
                            CommandParameter="{Binding SelectedOrder}"
                            Visibility="{Binding IsConfirmInstallmentPickupVisible, Converter={StaticResource BoolToVis}}"
                            Height="40"
                            MinWidth="140"
                            Padding="14,0"
                            Margin="12,0,0,0"
                            Style="{StaticResource PosPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Loc installment.center.action.confirmPickup}" Foreground="White" FontWeight="Bold" />
                        </StackPanel>
                    </Button>

                    <Button DockPanel.Dock="Right"
                            Command="{Binding ReuploadSelectedCommand}"
                            Content="{loc:Loc history.reuploadSelected}"
                            Visibility="{Binding IsLocalSourceSelected, Converter={StaticResource BoolToVis}}"
                            Height="40"
                            Padding="14,0"
                            Margin="12,0,0,0"
                            Style="{StaticResource PosPrimaryButtonStyle}" />

                    <Button DockPanel.Dock="Right"
                            Command="{Binding ReuploadDateRangeCommand}"
                            ToolTip="{loc:Loc history.reuploadDateRangeTooltip}"
                            Visibility="{Binding IsLocalSourceSelected, Converter={StaticResource BoolToVis}}"
                            Height="40"
                            Padding="14,0"
                            Margin="12,0,0,0"
                            Style="{StaticResource HistoryIconTextButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Upload" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{loc:Loc history.reuploadDateRange}" />
                        </StackPanel>
                    </Button>

                    <Button DockPanel.Dock="Right"
                            Command="{Binding SelectAllReuploadableCommand}"
                            Content="{loc:Loc shell.sync.selectAll}"
                            Visibility="{Binding IsLocalSourceSelected, Converter={StaticResource BoolToVis}}"
                            Height="40"
                            Padding="14,0"
                            Margin="12,0,0,0"
                            Style="{StaticResource HistoryIconTextButtonStyle}" />

                    <Button DockPanel.Dock="Right"
                            Command="{Binding ForceReleaseHeldOrderCommand}"
                            CommandParameter="{Binding SelectedOrder}"
                            Visibility="{Binding IsForceReleaseVisible, Converter={StaticResource BoolToVis}}"
                            Height="40"
                            Padding="14,0"
                            Margin="12,0,0,0"
                            Style="{StaticResource HistoryIconTextButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="LockOpen" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ForceReleaseLabel}" />
                        </StackPanel>
                    </Button>

                    <ProgressBar Width="64"
                                 Height="4"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Margin="12,0,0,0"
                                 Visibility="{Binding IsHeldRemoteRefreshVisible, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding HeldOrdersRemoteStatusMessage}"
                               Foreground="{DynamicResource PosWarningTextBrush}"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               Margin="12,0,0,0"
                               Visibility="{Binding IsHeldRemoteErrorVisible, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource PosDangerTextBrush}"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid x:Name="ReceiptPreviewOverlay"
              Panel.ZIndex="100"
              Background="#660F172A"
              FocusManager.IsFocusScope="True"
              FocusManager.FocusedElement="{Binding ElementName=ReceiptPreviewCloseButton}"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.AutomationId="TransactionHistoryReceiptPreviewOverlay"
              AutomationProperties.Name="{loc:Loc success.receiptPreview}"
              Visibility="{Binding IsReceiptPreviewOpen, Converter={StaticResource BoolToVis}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseReceiptPreviewCommand}" />
            </Grid.InputBindings>

            <Border x:Name="ReceiptPreviewDialog"
                    Width="680"
                    MaxHeight="820"
                    Margin="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    AutomationProperties.AutomationId="TransactionHistoryReceiptPreviewDialog">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.24" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="22,18"
                            BorderBrush="{DynamicResource PosDividerBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Receipt"
                                                         Width="22"
                                                         Height="22"
                                                         Margin="0,0,10,0"
                                                         Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                <TextBlock Text="{loc:Loc success.receiptPreview}"
                                           FontSize="20"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource PosTextBrush}" />
                                <Border Margin="10,0,0,0"
                                        Padding="8,3"
                                        CornerRadius="6"
                                        Background="{DynamicResource PosSuccessSoftBrush}"
                                        BorderBrush="{DynamicResource PosSuccessBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding SelectedOrder.StatusLabel}"
                                               Foreground="{DynamicResource PosSuccessTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding PreviewTotal, StringFormat={}{0:C2}}"
                                       FontSize="26"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource PosTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="20,0" />

                            <Button x:Name="ReceiptPreviewCloseButton"
                                    Grid.Column="2"
                                    Command="{Binding CloseReceiptPreviewCommand}"
                                    Width="40"
                                    Height="40"
                                    MinWidth="40"
                                    Padding="0"
                                    ToolTip="{loc:Loc history.closeReceiptPreview}"
                                    AutomationProperties.AutomationId="TransactionHistoryReceiptPreviewCloseButton"
                                    AutomationProperties.Name="{loc:Loc history.closeReceiptPreview}"
                                    Style="{StaticResource HistoryIconButtonStyle}">
                                <materialDesign:PackIcon Kind="Close" Width="19" Height="19" />
                            </Button>

                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="32,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc OrderNumber}" Style="{StaticResource HistoryPreviewLabelStyle}" />
                                    <TextBlock Text="{Binding PreviewOrderId}" Style="{StaticResource HistoryPreviewValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{loc:Loc Time}" Style="{StaticResource HistoryPreviewLabelStyle}" TextAlignment="Right" />
                                    <TextBlock Text="{Binding PreviewSoldAt}" Style="{StaticResource HistoryPreviewValueStyle}" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Background="{DynamicResource PosSurfaceAltBrush}">
                        <ScrollViewer Margin="24,18"
                                      Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Border Width="430"
                                    Padding="24"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource PosSurfaceBrush}"
                                    BorderBrush="{DynamicResource PosDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.10" />
                                </Border.Effect>
                                <ItemsControl ItemsSource="{Binding ReceiptPreviewRows}"
                                              HorizontalAlignment="Stretch"
                                              ItemTemplate="{StaticResource ReceiptPreviewRowTemplate}">
                                    <!-- 让每一行占满小票宽度，使居中/右对齐相对票面生效。 -->
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="{x:Type ContentPresenter}">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </Border>
                        </ScrollViewer>

                        <Border Background="{DynamicResource PosSurfaceBrush}"
                                Visibility="{Binding IsReceiptPreviewLoading, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Width="180" Height="5" IsIndeterminate="True" />
                                <TextBlock Text="{loc:Loc history.receiptLoading}"
                                           Margin="0,14,0,0"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="18"
                            Background="{DynamicResource PosSurfaceBrush}"
                            BorderBrush="{DynamicResource PosDividerBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CloseReceiptPreviewCommand}"
                                    Content="{loc:Loc history.closeReceiptPreview}"
                                    Height="44"
                                    MinWidth="108"
                                    Margin="0,0,12,0"
                                    AutomationProperties.Name="{loc:Loc history.closeReceiptPreview}"
                                    Style="{StaticResource PosSecondaryButtonStyle}" />
                            <Button Command="{Binding ReprintCommand}"
                                    Height="44"
                                    MinWidth="148"
                                    Visibility="{Binding IsReprintVisible, Converter={StaticResource BoolToVis}}"
                                    AutomationProperties.Name="{loc:Loc history.reprint}"
                                    Style="{StaticResource PosPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="17" Height="17" Foreground="White" Margin="0,0,7,0" />
                                    <TextBlock Text="{loc:Loc history.reprint}" Foreground="White" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 订单明细与小票预览共用同一详情加载结果，仅提供更适合触屏扫读的结构化呈现。 -->
        <UserControl x:Name="OrderDetailsOverlay"
                     Panel.ZIndex="110"
                     Background="#660F172A"
                     FocusManager.IsFocusScope="True"
                     FocusManager.FocusedElement="{Binding ElementName=OrderDetailsCloseButton}"
                     KeyboardNavigation.TabNavigation="Cycle"
                     PreviewKeyDown="OrderDetailsOverlayPreviewKeyDown"
                     AutomationProperties.AutomationId="TransactionHistoryOrderDetailsOverlay"
                     AutomationProperties.Name="{loc:Loc history.viewOrderDetails}"
                     AutomationProperties.IsDialog="True"
                     Visibility="{Binding IsOrderDetailsOpen, Converter={StaticResource BoolToVis}}">
            <UserControl.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseOrderDetailsCommand}" />
            </UserControl.InputBindings>

            <Border x:Name="OrderDetailsDialog"
                    Width="1000"
                    MaxWidth="1000"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    AutomationProperties.AutomationId="TransactionHistoryOrderDetailsDialog">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.24" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="20,14"
                            Background="{DynamicResource PosSurfaceBrush}"
                            BorderBrush="{DynamicResource PosDividerBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FormatListBulleted"
                                                         Width="22"
                                                         Height="22"
                                                         Margin="0,0,10,0"
                                                         Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                <TextBlock Text="{loc:Loc history.viewOrderDetails}"
                                           FontSize="20"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           VerticalAlignment="Center" />
                                <Border Margin="12,0,0,0"
                                        Padding="8,3"
                                        CornerRadius="6"
                                        Background="{DynamicResource PosPrimarySoftBrush}"
                                        BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding OrderDetailsSourceLabel}"
                                               Foreground="{DynamicResource PosPrimaryTextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Border>
                                 <Border Margin="8,0,0,0"
                                         Padding="8,3"
                                         CornerRadius="6"
                                         Background="{DynamicResource PosSurfaceMutedBrush}"
                                         BorderBrush="{DynamicResource PosBorderBrush}"
                                         BorderThickness="1">
                                     <TextBlock Text="{Binding OrderDetailsStatusLabel}"
                                                Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                FontSize="12"
                                                FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PreviewTotal, StringFormat={}{0:C2}}"
                                           Margin="20,0"
                                           FontSize="26"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource PosAccentBrush}"
                                           Visibility="{Binding IsOrderDetailsFinancialContentVisible, Converter={StaticResource BoolToVis}}"
                                           VerticalAlignment="Center" />
                                <Button x:Name="OrderDetailsCloseButton"
                                        Command="{Binding CloseOrderDetailsCommand}"
                                        Width="44"
                                        Height="44"
                                        MinWidth="44"
                                        Padding="0"
                                        ToolTip="{loc:Loc history.closeOrderDetails}"
                                        AutomationProperties.AutomationId="TransactionHistoryOrderDetailsCloseButton"
                                        AutomationProperties.Name="{loc:Loc history.closeOrderDetails}"
                                        Style="{StaticResource HistoryIconButtonStyle}">
                                    <materialDesign:PackIcon Kind="Close" Width="19" Height="19" />
                                </Button>
                            </StackPanel>

                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="32,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Loc OrderNumber}" Style="{StaticResource HistoryPreviewLabelStyle}" />
                                    <TextBlock Text="{Binding OrderDetailsOrderId}" Style="{StaticResource HistoryPreviewValueStyle}" ToolTip="{Binding OrderDetailsOrderId}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Loc Time}" Style="{StaticResource HistoryPreviewLabelStyle}" />
                                    <TextBlock Text="{Binding OrderDetailsSoldAt}" Style="{StaticResource HistoryPreviewValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Loc Store}" Style="{StaticResource HistoryPreviewLabelStyle}" />
                                    <TextBlock Text="{Binding OrderDetailsStoreCode}" Style="{StaticResource HistoryPreviewValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="{loc:Loc Terminal}" Style="{StaticResource HistoryPreviewLabelStyle}" />
                                    <TextBlock Text="{Binding OrderDetailsDeviceCode}" Style="{StaticResource HistoryPreviewValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{loc:Loc Cashier}" Style="{StaticResource HistoryPreviewLabelStyle}" />
                                    <TextBlock Text="{Binding OrderDetailsCashierName}" Style="{StaticResource HistoryPreviewValueStyle}" ToolTip="{Binding OrderDetailsCashierName}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Margin="32,10,0,0"
                                        Orientation="Horizontal"
                                        Visibility="{Binding HasOrderDetailsCustomer, Converter={StaticResource BoolToVis}}">
                                <StackPanel Width="230">
                                    <TextBlock Text="{loc:Loc Customer}" Style="{StaticResource HistoryPreviewLabelStyle}" />
                                    <TextBlock Text="{Binding OrderDetailsCustomerName}" Style="{StaticResource HistoryPreviewValueStyle}" ToolTip="{Binding OrderDetailsCustomerName}" />
                                </StackPanel>
                                <StackPanel Width="230">
                                    <TextBlock Text="{loc:Loc Phone}" Style="{StaticResource HistoryPreviewLabelStyle}" />
                                    <TextBlock Text="{Binding OrderDetailsCustomerPhone}" Style="{StaticResource HistoryPreviewValueStyle}" ToolTip="{Binding OrderDetailsCustomerPhone}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Background="{DynamicResource PosSurfaceAltBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="20,14,20,8">
                            <DataGrid x:Name="OrderDetailsItemsGrid"
                                      ItemsSource="{Binding OrderDetailLines}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeColumns="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      RowHeight="76"
                                      MinRowHeight="76"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource PosDividerBrush}"
                                      VerticalGridLinesBrush="Transparent"
                                      Background="{DynamicResource PosSurfaceBrush}"
                                      BorderBrush="{DynamicResource PosDividerBrush}"
                                      BorderThickness="1"
                                      ColumnHeaderStyle="{StaticResource HistoryColumnHeaderStyle}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                                       EnableRowVirtualization="True"
                                       AutomationProperties.AutomationId="TransactionHistoryOrderDetailsItemsGrid"
                                       Style="{StaticResource PosCartDataGridStyle}">
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource HistoryGridCellStyle}">
                                        <Setter Property="Padding" Value="8,0" />
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Height" Value="76" />
                                        <Setter Property="MinHeight" Value="76" />
                                        <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{loc:Loc Item}" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="OrderDetailProductImage"
                                                            Width="64"
                                                            Height="64"
                                                            Background="{DynamicResource PosPrimarySoftBrush}"
                                                            CornerRadius="7"
                                                            ClipToBounds="True"
                                                            SnapsToDevicePixels="True">
                                                        <Grid>
                                                            <materialDesign:PackIcon Kind="Shopping"
                                                                                     Width="24"
                                                                                     Height="24"
                                                                                     Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center"
                                                                                     Panel.ZIndex="0" />
                                                            <Rectangle Margin="2"
                                                                       RadiusX="6"
                                                                       RadiusY="6"
                                                                       SnapsToDevicePixels="True"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                       Panel.ZIndex="1">
                                                                <Rectangle.Fill>
                                                                    <ImageBrush converters:ProductThumbnailImageSourceConverter.AsyncSourceText="{Binding ProductImage}"
                                                                                converters:ProductThumbnailImageSourceConverter.AsyncDecodePixelWidth="96"
                                                                                Stretch="Uniform" />
                                                                </Rectangle.Fill>
                                                            </Rectangle>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource PosTextBrush}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding DisplayName}" />
                                                        <TextBlock x:Name="OrderDetailItemMetadata"
                                                                   Margin="0,5,0,0"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.ToolTip>
                                                                <ToolTip>
                                                                    <TextBlock TextWrapping="NoWrap">
                                                                        <Run Text="{loc:Loc ItemNumber}" />
                                                                        <Run Text=": " />
                                                                        <Run Text="{Binding ItemNumberDisplay, Mode=OneWay}" />
                                                                        <Run Text="  " />
                                                                        <Run Text="{Binding LookupCodeDisplay, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </ToolTip>
                                                            </TextBlock.ToolTip>
                                                            <Run Text="{loc:Loc ItemNumber}" />
                                                            <Run Text=": " />
                                                            <Run Text="{Binding ItemNumberDisplay, Mode=OneWay}" />
                                                            <Run Text="  " />
                                                            <Run Text="{Binding LookupCodeDisplay, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{loc:Loc Quantity}"
                                                        Width="72"
                                                        Binding="{Binding QuantityDisplay}"
                                                        ElementStyle="{StaticResource HistoryPrimaryTextStyle}" />
                                    <DataGridTextColumn Header="{loc:Loc UnitPrice}"
                                                        Width="98"
                                                        Binding="{Binding UnitPrice, StringFormat={}{0:C2}}"
                                                        ElementStyle="{StaticResource HistoryPrimaryTextStyle}" />
                                    <DataGridTextColumn Header="{loc:Loc Discount}"
                                                        Width="98"
                                                        Binding="{Binding DiscountAmount, StringFormat={}{0:C2}}"
                                                        ElementStyle="{StaticResource HistoryPrimaryTextStyle}" />
                                    <DataGridTextColumn Header="{loc:Loc LineTotal}"
                                                        Width="106"
                                                        Binding="{Binding ActualAmount, StringFormat={}{0:C2}}"
                                                        ElementStyle="{StaticResource HistoryPrimaryTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Panel.ZIndex="10"
                                    Background="{DynamicResource PosSurfaceBrush}"
                                    Visibility="{Binding IsReceiptPreviewLoading, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar Width="180" Height="5" IsIndeterminate="True" />
                                    <TextBlock x:Name="OrderDetailsLoadingStatusText"
                                               Text="{loc:Loc history.orderDetailsLoading}"
                                                Margin="0,14,0,0"
                                                Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>

                            <Border Panel.ZIndex="11"
                                    Background="{DynamicResource PosSurfaceBrush}"
                                    Visibility="{Binding OrderDetailsErrorMessage, Converter={StaticResource StringHasValueToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                             Width="30"
                                                             Height="30"
                                                             Foreground="{DynamicResource PosDangerTextBrush}" />
                                    <TextBlock x:Name="OrderDetailsErrorStatusText"
                                               Text="{Binding OrderDetailsErrorMessage}"
                                                MaxWidth="520"
                                                Margin="0,10,0,14"
                                                Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                FontSize="13"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                AutomationProperties.LiveSetting="Assertive" />
                                    <Button Command="{Binding RetryOrderDetailsCommand}"
                                            Content="{loc:Loc history.retryOrderDetails}"
                                            Height="44"
                                            MinWidth="108"
                                            AutomationProperties.Name="{loc:Loc history.retryOrderDetails}"
                                            Style="{StaticResource PosPrimaryButtonStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Panel.ZIndex="9"
                                    Background="{DynamicResource PosSurfaceBrush}"
                                    Visibility="{Binding IsOrderDetailsEmpty, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="BasketOffOutline"
                                                             Width="30"
                                                             Height="30"
                                                             Foreground="{DynamicResource PosSubtleForegroundBrush}" />
                                    <TextBlock x:Name="OrderDetailsEmptyStatusText"
                                               Text="{loc:Loc history.orderDetailsEmpty}"
                                                Margin="0,10,0,0"
                                                Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="20,0,20,8"
                                Padding="14,10"
                                Background="{DynamicResource PosSurfaceBrush}"
                                BorderBrush="{DynamicResource PosDividerBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding IsOrderDetailsFinancialContentVisible, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Payment}"
                                               Margin="0,0,0,8"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                    <ItemsControl ItemsSource="{Binding Payments}"
                                                  Visibility="{Binding HasOrderDetailsPayments, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border MinWidth="205"
                                                        MaxWidth="285"
                                                        Margin="0,0,12,4"
                                                        Padding="10,7"
                                                        Background="{DynamicResource PosSurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource PosDividerBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding MethodLabel}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PosTextBrush}" />
                                                            <TextBlock Text="{Binding DisplayReference}"
                                                                       Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding DisplayReference}"
                                                                       Visibility="{Binding DisplayReference, Converter={StaticResource StringHasValueToVis}}" />
                                                            <TextBlock Text="{Binding CardSummary}"
                                                                       Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding CardSummary}"
                                                                       Visibility="{Binding CardSummary, Converter={StaticResource StringHasValueToVis}}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Amount, StringFormat={}{0:C2}}"
                                                                   Margin="14,0,0,0"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource PosTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Text="{loc:Loc history.orderDetailsNoPayment}"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Bottom">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOrderDetailsPayments}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Margin="20,0,20,14"
                                Padding="14,10"
                                Background="{DynamicResource PosSurfaceBrush}"
                                BorderBrush="{DynamicResource PosDividerBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding IsOrderDetailsFinancialContentVisible, Converter={StaticResource BoolToVis}}">
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Width="118" Margin="0,0,10,0">
                                    <TextBlock Text="{loc:Loc Subtotal}" Style="{StaticResource HistoryPreviewLabelStyle}" TextAlignment="Right" />
                                    <TextBlock Text="{Binding PreviewSubtotal, StringFormat={}{0:C2}}" Style="{StaticResource HistoryPreviewValueStyle}" TextAlignment="Right" />
                                </StackPanel>
                                <StackPanel Width="118" Margin="0,0,10,0">
                                    <TextBlock Text="{loc:Loc Discount}" Style="{StaticResource HistoryPreviewLabelStyle}" TextAlignment="Right" />
                                    <TextBlock Text="{Binding PreviewDiscount, StringFormat={}{0:C2}}" Style="{StaticResource HistoryPreviewValueStyle}" TextAlignment="Right" />
                                </StackPanel>
                                <StackPanel Width="118"
                                            Margin="0,0,10,0"
                                            Visibility="{Binding HasOrderDetailsTenderedAmount, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Loc Tendered}" Style="{StaticResource HistoryPreviewLabelStyle}" TextAlignment="Right" />
                                    <TextBlock Text="{Binding OrderDetailsTenderedAmount, StringFormat={}{0:C2}}" Style="{StaticResource HistoryPreviewValueStyle}" TextAlignment="Right" />
                                </StackPanel>
                                <StackPanel Width="118"
                                            Margin="0,0,10,0"
                                            Visibility="{Binding HasOrderDetailsChangeAmount, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Loc Change}" Style="{StaticResource HistoryPreviewLabelStyle}" TextAlignment="Right" />
                                    <TextBlock Text="{Binding OrderDetailsChangeAmount, StringFormat={}{0:C2}}" Style="{StaticResource HistoryPreviewValueStyle}" TextAlignment="Right" />
                                </StackPanel>
                                <StackPanel Width="118"
                                            Margin="0,0,10,0"
                                            Visibility="{Binding HasOrderDetailsInstallmentAmounts, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Loc history.paidAmount}" Style="{StaticResource HistoryPreviewLabelStyle}" TextAlignment="Right" />
                                    <TextBlock Text="{Binding OrderDetailsPaidAmount, StringFormat={}{0:C2}}" Style="{StaticResource HistoryPreviewValueStyle}" TextAlignment="Right" />
                                </StackPanel>
                                <StackPanel Width="118"
                                            Margin="0,0,10,0"
                                            Visibility="{Binding HasOrderDetailsInstallmentAmounts, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Loc history.outstandingAmount}" Style="{StaticResource HistoryPreviewLabelStyle}" TextAlignment="Right" />
                                    <TextBlock Text="{Binding OrderDetailsOutstandingAmount, StringFormat={}{0:C2}}" Style="{StaticResource HistoryPreviewValueStyle}" TextAlignment="Right" />
                                </StackPanel>
                                <StackPanel Width="142">
                                    <TextBlock Text="{loc:Loc history.finalTotal}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               TextAlignment="Right" />
                                    <TextBlock Text="{Binding PreviewTotal, StringFormat={}{0:C2}}"
                                               FontSize="22"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource PosAccentBrush}"
                                               TextAlignment="Right" />
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="16"
                            Background="{DynamicResource PosSurfaceBrush}"
                            BorderBrush="{DynamicResource PosDividerBrush}"
                            BorderThickness="0,1,0,0">
                        <Button Command="{Binding CloseOrderDetailsCommand}"
                                Content="{loc:Loc history.closeOrderDetails}"
                                Height="44"
                                MinWidth="108"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="{loc:Loc history.closeOrderDetails}"
                                Style="{StaticResource PosSecondaryButtonStyle}" />
                    </Border>
                </Grid>
            </Border>
        </UserControl>

        <Grid Panel.ZIndex="200"
              Background="#66000000"
              Visibility="{Binding IsForceReleaseReasonPromptOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="440"
                    Padding="24"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.2" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding ForceReleaseLabel}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PosTextBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ForceReleaseReasonLabel}"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               FontSize="12"
                               Margin="0,0,0,6" />
                    <TextBox Text="{Binding ForceReleaseReason, UpdateSourceTrigger=PropertyChanged}"
                             Height="44"
                             FontSize="13"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="{Binding ForceReleaseReasonLabel}"
                             Style="{StaticResource PosSearchTextBoxStyle}" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">
                        <Button Command="{Binding CancelForceReleaseCommand}"
                                Content="{Binding ForceReleaseCancelLabel}"
                                Height="38"
                                MinWidth="92"
                                Margin="0,0,10,0"
                                Style="{StaticResource PosSecondaryButtonStyle}" />
                        <Button Command="{Binding ConfirmForceReleaseCommand}"
                                Content="{Binding ForceReleaseConfirmLabel}"
                                Height="38"
                                MinWidth="92"
                                Style="{StaticResource PosPrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
