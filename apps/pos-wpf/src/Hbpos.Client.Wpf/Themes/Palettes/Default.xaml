<!-- 由色板总表生成，四套主题的键必须完全一致。默认配色：与改造前的界面一致。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="PosPaletteId">Default</sys:String>
    <sys:Boolean x:Key="PosPaletteIsDark">False</sys:Boolean>

    <!-- 整屏背景 -->
    <SolidColorBrush x:Key="PosScreenBackgroundBrush" Color="#FFF3F3F7" />
    <!-- 卡片/面板 -->
    <SolidColorBrush x:Key="PosSurfaceBrush" Color="#FFFFFFFF" />
    <!-- 次级面板/交替行 -->
    <SolidColorBrush x:Key="PosSurfaceAltBrush" Color="#FFF9F9FD" />
    <!-- 浅灰底（输入区、分组底） -->
    <SolidColorBrush x:Key="PosSurfaceMutedBrush" Color="#FFF1F5F9" />
    <!-- 较深灰底（按下、禁用块） -->
    <SolidColorBrush x:Key="PosSurfaceStrongBrush" Color="#FFE2E2E6" />
    <!-- 深色提示底（配白字） -->
    <SolidColorBrush x:Key="PosInverseSurfaceBrush" Color="#FF191C1E" />
    <!-- 分隔线/浅描边 -->
    <SolidColorBrush x:Key="PosDividerBrush" Color="#FFE2E8F0" />
    <!-- 描边 -->
    <SolidColorBrush x:Key="PosBorderBrush" Color="#FFC3C6D6" />
    <!-- 深描边/滚动条 -->
    <SolidColorBrush x:Key="PosBorderStrongBrush" Color="#FF94A3B8" />
    <!-- 正文 -->
    <SolidColorBrush x:Key="PosTextBrush" Color="#FF191C1E" />
    <!-- 次级正文 -->
    <SolidColorBrush x:Key="PosTextSecondaryBrush" Color="#FF424654" />
    <!-- 次要文字 -->
    <SolidColorBrush x:Key="PosMutedForegroundBrush" Color="#FF737785" />
    <!-- 占位/弱提示文字 -->
    <SolidColorBrush x:Key="PosSubtleForegroundBrush" Color="#FF94A3B8" />
    <!-- 功能图标 -->
    <SolidColorBrush x:Key="PosIconBrush" Color="#FF304B73" />
    <!-- 侧栏功能图标 -->
    <SolidColorBrush x:Key="PosSidebarIconBrush" Color="#FF0056D2" />
    <!-- 侧栏退款图标 -->
    <SolidColorBrush x:Key="PosSidebarRefundIconBrush" Color="#FF940010" />
    <!-- 侧栏挂单图标 -->
    <SolidColorBrush x:Key="PosSidebarHoldIconBrush" Color="#FFFF8F00" />
    <!-- 主色填充/描边（配白字） -->
    <SolidColorBrush x:Key="PosPrimaryBrush" Color="#FF0056D2" />
    <!-- 主色按下 -->
    <SolidColorBrush x:Key="PosPrimaryStrongBrush" Color="#FF0049A8" />
    <!-- 主色文字/图标 -->
    <SolidColorBrush x:Key="PosPrimaryTextBrush" Color="#FF0056D2" />
    <!-- 选中/主色浅底 -->
    <SolidColorBrush x:Key="PosPrimarySoftBrush" Color="#FFEAF2FF" />
    <!-- 主色浅底（悬停/按下） -->
    <SolidColorBrush x:Key="PosPrimarySoftStrongBrush" Color="#FFD6E4FA" />
    <!-- 主色浅描边 -->
    <SolidColorBrush x:Key="PosPrimarySoftBorderBrush" Color="#FFBFDBFE" />
    <!-- 主色按钮禁用底（配白字） -->
    <SolidColorBrush x:Key="PosPrimaryDisabledBrush" Color="#FF78A9ED" />
    <!-- 标题文字 -->
    <SolidColorBrush x:Key="PosPrimaryDarkBrush" Color="#FF191C1E" />
    <!-- 重点金额 -->
    <SolidColorBrush x:Key="PosAccentBrush" Color="#FFFF8F00" />
    <!-- 重点金额文字 -->
    <SolidColorBrush x:Key="PosAccentForegroundBrush" Color="#FFFF8F00" />
    <!-- 应付合计底色（荧光笔） -->
    <SolidColorBrush x:Key="PosAmountSoftBrush" Color="#00FFFFFF" />
    <!-- 成功填充（配白字） -->
    <SolidColorBrush x:Key="PosSuccessBrush" Color="#FF0F9D58" />
    <!-- 成功文字 -->
    <SolidColorBrush x:Key="PosSuccessTextBrush" Color="#FF15803D" />
    <!-- 成功浅底 -->
    <SolidColorBrush x:Key="PosSuccessSoftBrush" Color="#FFE8F7F1" />
    <!-- 成功描边 -->
    <SolidColorBrush x:Key="PosSuccessBorderBrush" Color="#FF9AD7AB" />
    <!-- 警告填充 -->
    <SolidColorBrush x:Key="PosWarningBrush" Color="#FFFFB74D" />
    <!-- 警告文字 -->
    <SolidColorBrush x:Key="PosWarningTextBrush" Color="#FF8F4E00" />
    <!-- 警告强调填充（配白字） -->
    <SolidColorBrush x:Key="PosWarningStrongBrush" Color="#FFB45309" />
    <!-- 警告浅底 -->
    <SolidColorBrush x:Key="PosWarningSoftBrush" Color="#FFFFF7E8" />
    <!-- 警告描边 -->
    <SolidColorBrush x:Key="PosWarningBorderBrush" Color="#FFFFD59B" />
    <!-- 危险填充（配白字） -->
    <SolidColorBrush x:Key="PosDangerBrush" Color="#FF940010" />
    <!-- 危险文字 -->
    <SolidColorBrush x:Key="PosDangerTextBrush" Color="#FF940010" />
    <!-- 危险浅底 -->
    <SolidColorBrush x:Key="PosDangerSoftBrush" Color="#FFFFEEF0" />
    <!-- 危险描边 -->
    <SolidColorBrush x:Key="PosDangerBorderBrush" Color="#FFFFB4AB" />
    <!-- 标题栏背景 -->
    <SolidColorBrush x:Key="PosHeaderBackgroundBrush" Color="#FFFFFFFF" />
    <!-- 标题栏文字 -->
    <SolidColorBrush x:Key="PosHeaderForegroundBrush" Color="#FF191C1E" />
    <!-- 标题栏次要文字 -->
    <SolidColorBrush x:Key="PosHeaderMutedForegroundBrush" Color="#FF737785" />
    <!-- 状态栏背景 -->
    <SolidColorBrush x:Key="PosFooterBackgroundBrush" Color="#FFFFFFFF" />

    <!-- ── 长者模式/支付方式/快捷金额新增语义键：旧主题取值＝改动前的等效色，视觉不变 ── -->
    <!-- 首页购物车区底色 -->
    <SolidColorBrush x:Key="PosZoneCartBrush" Color="#FFF9F9FD" />
    <!-- 首页键盘区底色 -->
    <SolidColorBrush x:Key="PosZoneKeypadBrush" Color="#FFF9F9FD" />
    <!-- 首页功能区底色 -->
    <SolidColorBrush x:Key="PosZoneFuncBrush" Color="#FFF9F9FD" />
    <!-- 首页分区竖线 -->
    <SolidColorBrush x:Key="PosZoneDividerBrush" Color="#FFE2E8F0" />
    <!-- 键/按钮/卡片描边（原 PosBorderBrush 用法） -->
    <SolidColorBrush x:Key="PosKeyBorderBrush" Color="#FFC3C6D6" />
    <!-- 卡片浅描边（原 PosDividerBrush 用法） -->
    <SolidColorBrush x:Key="PosCardBorderBrush" Color="#FFE2E8F0" />
    <!-- 键帽底部投影色 -->
    <SolidColorBrush x:Key="PosKeyShadowBrush" Color="#00000000" />
    <!-- 购物车表头底色 -->
    <SolidColorBrush x:Key="PosCartHeaderBrush" Color="#FFF9F9FD" />
    <!-- 购物车斑马纹 -->
    <SolidColorBrush x:Key="PosCartAltRowBrush" Color="#FFF9F9FD" />
    <!-- 购物车选中行底色 -->
    <SolidColorBrush x:Key="PosCartSelectedRowBrush" Color="#FFEAF2FF" />
    <!-- 购物车应付合计金额色 -->
    <SolidColorBrush x:Key="PosDueAmountBrush" Color="#FFFF8F00" />
    <!-- 首页 Clear 键底色 -->
    <SolidColorBrush x:Key="PosClearKeyBrush" Color="#FFFFFFFF" />
    <!-- 无条码按钮底色 -->
    <SolidColorBrush x:Key="PosNoBarcodeBrush" Color="#FF0056D2" />
    <!-- 无条码按钮文字色 -->
    <SolidColorBrush x:Key="PosNoBarcodeForegroundBrush" Color="#FFFFFFFF" />
    <!-- 无条码按钮按下底色 -->
    <SolidColorBrush x:Key="PosNoBarcodePressedBrush" Color="#FF0049A8" />
    <!-- 无条码按钮禁用底色 -->
    <SolidColorBrush x:Key="PosNoBarcodeDisabledBrush" Color="#FFE2E2E6" />
    <!-- 功能区按钮底色 -->
    <SolidColorBrush x:Key="PosSidebarButtonBrush" Color="#FFFFFFFF" />
    <!-- 功能区按钮文字色 -->
    <SolidColorBrush x:Key="PosSidebarButtonForegroundBrush" Color="#FF191C1E" />
    <!-- 功能区按钮悬停底色 -->
    <SolidColorBrush x:Key="PosSidebarButtonHoverBrush" Color="#FFF9F9FD" />
    <!-- 功能区按钮按下底色 -->
    <SolidColorBrush x:Key="PosSidebarButtonPressedBrush" Color="#FFEAF2FF" />
    <!-- 功能区退出按钮底色 -->
    <SolidColorBrush x:Key="PosSidebarExitButtonBrush" Color="#FFFFFFFF" />
    <!-- 功能区退出按钮文字/图标色 -->
    <SolidColorBrush x:Key="PosSidebarExitForegroundBrush" Color="#FF940010" />
    <!-- 功能区退出按钮悬停底色 -->
    <SolidColorBrush x:Key="PosSidebarExitHoverBrush" Color="#FFF9F9FD" />
    <!-- 功能区退出按钮按下底色 -->
    <SolidColorBrush x:Key="PosSidebarExitPressedBrush" Color="#FFEAF2FF" />
    <!-- 确认支付按钮底色 -->
    <SolidColorBrush x:Key="PosConfirmPaymentBrush" Color="#FF0056D2" />
    <!-- 确认支付按钮底部厚阴影色 -->
    <SolidColorBrush x:Key="PosConfirmPaymentShadowBrush" Color="#00000000" />
    <!-- 支付页取消按钮底色 -->
    <SolidColorBrush x:Key="PosCancelButtonBrush" Color="#FFFFFFFF" />
    <!-- 支付页取消按钮文字色 -->
    <SolidColorBrush x:Key="PosCancelButtonForegroundBrush" Color="#FF191C1E" />
    <!-- 待付/应付金额强调色 -->
    <SolidColorBrush x:Key="PosAmountEmphasisBrush" Color="#FF0056D2" />
    <!-- 找零块底色 -->
    <SolidColorBrush x:Key="PosChangeDueBackgroundBrush" Color="#FFE8F7F1" />
    <!-- 找零文字色 -->
    <SolidColorBrush x:Key="PosChangeDueForegroundBrush" Color="#FF15803D" />
    <!-- 购物车加量按钮底色 -->
    <SolidColorBrush x:Key="PosQtyPlusBrush" Color="#FFFFFFFF" />
    <!-- 购物车加量按钮文字/图标色 -->
    <SolidColorBrush x:Key="PosQtyPlusForegroundBrush" Color="#FF15803D" />
    <!-- 10%–50% 折扣键文字色 -->
    <SolidColorBrush x:Key="PosDiscountKeyForegroundBrush" Color="#FF191C1E" />
    <!-- 折扣条分段竖线 -->
    <SolidColorBrush x:Key="PosSegmentSeparatorBrush" Color="#FFC3C6D6" />
    <!-- 屏幕键盘 / 搜索候选弹层的描边（旧主题＝PosDividerBrush；长者主题内容区无描边，但浮层必须有边界） -->
    <SolidColorBrush x:Key="PosPopupBorderBrush" Color="#FFE2E8F0" />
    <!-- 功能区警示键底色（刷卡恢复有待处理卡交易时） -->
    <SolidColorBrush x:Key="PosSidebarWarnButtonBrush" Color="#FFFFF7E8" />
    <!-- 功能区警示键文字/图标色 -->
    <SolidColorBrush x:Key="PosSidebarWarnForegroundBrush" Color="#FF8F4E00" />
    <!-- 功能区警示键描边色 -->
    <SolidColorBrush x:Key="PosSidebarWarnBorderBrush" Color="#FFFFB74D" />
    <!-- 功能区警示键悬停底色 -->
    <SolidColorBrush x:Key="PosSidebarWarnHoverBrush" Color="#FFFFF7E8" />
    <!-- 功能区警示键按下底色 -->
    <SolidColorBrush x:Key="PosSidebarWarnPressedBrush" Color="#FFFFD59B" />
    <!-- 功能区按钮角标底色（挂单数量、二维码秒数） -->
    <SolidColorBrush x:Key="PosSidebarBadgeBrush" Color="#FF0056D2" />
    <!-- 功能区按钮角标文字色 -->
    <SolidColorBrush x:Key="PosSidebarBadgeForegroundBrush" Color="#FFFFFFFF" />
    <!-- 功能区警示角标底色（待处理卡交易数量，白字） -->
    <SolidColorBrush x:Key="PosSidebarBadgeAlertBrush" Color="#FF940010" />
    <!-- Open Item（原 No Barcode）按钮禁用时的文字色：与禁用底色配成「灰块灰字」，明显区别于可用态 -->
    <SolidColorBrush x:Key="PosNoBarcodeDisabledForegroundBrush" Color="#FF737785" />
    <!-- 支付方式语义色：现金=琥珀棕、刷卡=深蓝、代金券=紫；Fill 选中实心 / On 实心上的字 / Soft 未选浅块 / Ink 浅块上的字与图标 -->
    <SolidColorBrush x:Key="PosMethodCashFillBrush" Color="#FFB45309" />
    <SolidColorBrush x:Key="PosMethodCashOnBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PosMethodCashSoftBrush" Color="#FFFFF1E0" />
    <SolidColorBrush x:Key="PosMethodCashInkBrush" Color="#FF8A3F05" />
    <SolidColorBrush x:Key="PosMethodCardFillBrush" Color="#FF1E40AF" />
    <SolidColorBrush x:Key="PosMethodCardOnBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PosMethodCardSoftBrush" Color="#FFE6ECFA" />
    <SolidColorBrush x:Key="PosMethodCardInkBrush" Color="#FF1E3A8A" />
    <SolidColorBrush x:Key="PosMethodVoucherFillBrush" Color="#FF7E22CE" />
    <SolidColorBrush x:Key="PosMethodVoucherOnBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PosMethodVoucherSoftBrush" Color="#FFF3E8FF" />
    <SolidColorBrush x:Key="PosMethodVoucherInkBrush" Color="#FF6B21A8" />
    <!-- 快捷现金面额色（澳元面额主色的 UI 自定义色，不取样自纸币）：Fill 底色 / Text 数字色 -->
    <SolidColorBrush x:Key="PosNote100FillBrush" Color="#FF2F9E6D" />
    <SolidColorBrush x:Key="PosNote100TextBrush" Color="#FF0B1220" />
    <SolidColorBrush x:Key="PosNote50FillBrush" Color="#FFF2C94C" />
    <SolidColorBrush x:Key="PosNote50TextBrush" Color="#FF2E1500" />
    <SolidColorBrush x:Key="PosNote20FillBrush" Color="#FFCF3F1B" />
    <SolidColorBrush x:Key="PosNote20TextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PosNote10FillBrush" Color="#FF2E6BB8" />
    <SolidColorBrush x:Key="PosNote10TextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PosNote5FillBrush" Color="#FFA8408F" />
    <SolidColorBrush x:Key="PosNote5TextBrush" Color="#FFFFFFFF" />

    <LinearGradientBrush x:Key="PosPrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0088FF" Offset="0" />
        <GradientStop Color="#FF0056D2" Offset="0.55" />
        <GradientStop Color="#FF003C9A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PosPayButtonGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0877F9" Offset="0" />
        <GradientStop Color="#FF0046D5" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
