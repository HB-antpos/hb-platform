                                                                   Visibility="{Binding IsOperationBusy, Converter={StaticResource BoolToVis}}" />
                                                                        <StackPanel Visibility="{Binding IsEnteringCode, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock Text="{loc:Loc settings.linkly.lines.enterTitle}" FontSize="15" FontWeight="SemiBold" />
                                                                            <TextBlock Text="{loc:Loc settings.linkly.lines.enterHelp}" TextWrapping="Wrap" Margin="0,6,0,12" />
                                                                            <TextBox Text="{Binding PairCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="6"
                                                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" Height="52" FontSize="28" FontFamily="Consolas"
                                                                                     HorizontalContentAlignment="Center" HorizontalAlignment="Left" Width="230"
                                                                                     InputMethod.IsInputMethodEnabled="False" SpellCheck.IsEnabled="False"
                                                                                     AutomationProperties.Name="{loc:Loc settings.linkly.cloud.pairCode}"
                                                                                     AutomationProperties.AutomationId="LinklyLinePairCode" />
                                                                            <WrapPanel Margin="0,12,0,0">
                                                                                <Button Command="{Binding CancelCommand}" Style="{StaticResource PosSecondaryButtonStyle}" MinHeight="52" Padding="16,8" Margin="0,0,10,6">
                                                                                    <TextBlock Text="{loc:Loc settings.linkly.lines.cancel}" />
                                                                                </Button>
                                                                                <Button Command="{Binding NextCommand}" Style="{StaticResource PosPrimaryButtonStyle}" MinHeight="52" Padding="16,8" Margin="0,0,0,6">
                                                                                    <TextBlock Text="{loc:Loc settings.linkly.lines.next}" Foreground="White" />
                                                                                </Button>
                                                                            </WrapPanel>
                                                                        </StackPanel>
                                                                        <StackPanel Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock Text="{loc:Loc settings.linkly.lines.confirmTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                            <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,4" />
                                                                            <TextBlock Text="{Binding LaneLabel}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                                                            <TextBlock Text="{loc:Loc settings.linkly.cloud.pairCode}" Margin="0,12,0,4" />
                                                                            <TextBlock Text="{Binding PairCode}" FontSize="28" FontFamily="Consolas" FontWeight="Bold" />
                                                                            <TextBlock Text="{loc:Loc settings.linkly.lines.confirmHelp}" TextWrapping="Wrap" Margin="0,10,0,12" />
                                                                            <WrapPanel>
                                                                                <Button Command="{Binding BackCommand}" Style="{StaticResource PosSecondaryButtonStyle}" MinHeight="52" Padding="16,8" Margin="0,0,10,6">
                                                                                    <TextBlock Text="{loc:Loc settings.linkly.lines.back}" />
                                                                                </Button>
                                                                                <Button Command="{Binding ConfirmCommand}" Style="{StaticResource PosPrimaryButtonStyle}" MinHeight="52" Padding="16,8" Margin="0,0,10,6"
                                                                                        AutomationProperties.AutomationId="LinklyLineConfirmPairing">
                                                                                    <TextBlock Text="{loc:Loc settings.linkly.lines.confirm}" Foreground="White" />
                                                                                </Button>
                                                                                <Button Command="{Binding CancelCommand}" Style="{StaticResource PosSecondaryButtonStyle}" MinHeight="52" Padding="16,8" Margin="0,0,0,6">
                                                                                    <TextBlock Text="{loc:Loc settings.linkly.lines.cancel}" />
                                                                                </Button>
                                                                            </WrapPanel>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{loc:Loc settings.linkly.lines.singleExpandedHint}" TextWrapping="Wrap" Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,0,0,14" />
                                            <TextBlock Text="{Binding SelectedLinklyCloudTerminalText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12" />
                                            <Border Background="{DynamicResource PosSurfaceAltBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                                <TextBlock Text="{Binding LinklyTestStatusMessage}" FontSize="12" TextWrapping="Wrap" />
                                            </Border>
                                            <StackPanel>
                                                <Button Command="{Binding TestLinklyTransactionStatusCommand}"
                                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                                        Height="52"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="LanPending" Width="18" Height="18" Margin="0,0,8,0" />
                                                        <TextBlock Text="{loc:Loc settings.linkly.cloudBackend.testStatus}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding SaveLinklyCommand}"
                                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                                        Height="52"
                                                        HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                                        <TextBlock Text="{loc:Loc settings.linkly.enable}" Foreground="White" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <!-- ===== PAGE: PaymentTerminal / Linkly.CloudBackendAsync END ===== -->

                                <!-- ===== PAGE: PaymentTerminal / Linkly.StandardActions (local IP / cloud direct bottom actions + test status) BEGIN ===== -->
                                <WrapPanel Visibility="{Binding IsLinklyStandardActionMode, Converter={StaticResource BoolToVis}}">
                                    <Button Command="{Binding TestLinklyCommand}"
                                            Style="{StaticResource PosSecondaryButtonStyle}"
                                            Height="52"
                                            MinWidth="138"
                                            Margin="0,0,10,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding LinklyTestActionText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding LogonLinklyCommand}"
                                            Visibility="{Binding IsLinklyLocalIpMode, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource PosSecondaryButtonStyle}"
                                            Height="52"
                                            MinWidth="138"
                                            Margin="0,0,10,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Login" Width="18" Height="18" Margin="0,0,8,0" />
                                            <TextBlock Text="{loc:Loc settings.linkly.localIp.logon}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SaveLinklyCommand}"
                                            Style="{StaticResource PosPrimaryButtonStyle}"
                                            Height="52"
                                            MinWidth="138"
                                            Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                            <TextBlock Text="{loc:Loc settings.linkly.enable}" Foreground="White" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <Border Background="{DynamicResource PosSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource PosDividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding IsLinklyStandardActionMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding LinklyTestStatusMessage}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               TextWrapping="Wrap" />
                                </Border>
                                <!-- ===== PAGE: PaymentTerminal / Linkly.StandardActions (local IP / cloud direct bottom actions + test status) END ===== -->
                            </StackPanel>
                            </Grid>
                                </Border>
                            </TabItem>
                            <!-- ===== PAGE: PaymentTerminal / Linkly END ===== -->
                        </TabControl>
                    </Grid>
                </controls:SettingsPageHost>
                <!-- ===== PAGE: PaymentTerminal END ===== -->

                <!-- ===== PAGE: ReceiptPrinter BEGIN ===== -->
                <controls:SettingsPageHost Style="{StaticResource SettingsPageHostStyle}"
                                           Visibility="{Binding IsReceiptPrinterSelected, Converter={StaticResource BoolToVis}}">
                    <!-- SettingsPageHost 槽位：SubTabs（二级页签条）/ Footer（固定底部操作条）；阶段 A 暂不使用，阶段 B 逐页迁移。 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.9*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ===== PAGE: ReceiptPrinter / ReceiptSubTabs BEGIN ===== -->
                        <!-- 分页：打印机与选项 / 门店信息 / 小票条款；右侧小票预览固定不随分页变化。 -->
                        <Border Grid.Row="0" Grid.ColumnSpan="3"
                                Style="{StaticResource SettingsSegmentHostStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="ReceiptSubTabs"
                                             Style="{StaticResource SettingsSubTabRadioStyle}"
                                             IsChecked="{Binding IsReceiptHardwareSubTabSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc settings.subtab.receiptHardware}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource SettingsUnsavedDotStyle}" Visibility="{Binding HasReceiptHardwareUnsaved, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="ReceiptSubTabs"
                                             Style="{StaticResource SettingsSubTabRadioStyle}"
                                             IsChecked="{Binding IsReceiptStoreSubTabSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="StorefrontOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc settings.subtab.receiptStore}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource SettingsUnsavedDotStyle}" Visibility="{Binding HasReceiptStoreUnsaved, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="ReceiptSubTabs"
                                             Style="{StaticResource SettingsSubTabRadioStyle}"
                                             IsChecked="{Binding IsReceiptTermsSubTabSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc settings.subtab.receiptTerms}" VerticalAlignment="Center" />
                                        <Border Style="{StaticResource SettingsUnsavedDotStyle}" Visibility="{Binding HasReceiptTermsUnsaved, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <!-- ===== PAGE: ReceiptPrinter / ReceiptSubTabs END ===== -->

                        <!-- 左栏：连接、打印选项、门店信息、条款、保存，各占一行。 -->
                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- ===== PAGE: ReceiptPrinter / ReceiptHardware BEGIN ===== -->
                            <!-- 打印机连接：默认 USB，端口收进“高级”，测试打印做成主按钮。 -->
                            <Border Grid.Row="0"
                                    Style="{StaticResource SettingsActionCardStyle}"
                                    Visibility="{Binding IsReceiptHardwareSubTabSelected, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding ReceiptHardwareSaveStateText}"
                                                   Tag="{Binding ReceiptHardwareSaveState}"
                                                   Style="{StaticResource SettingsSectionStateTextStyle}" />
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.connection.title}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    </DockPanel>
                                    <TextBlock Text="{loc:Loc settings.receiptPrinter.connection.help}"
                                               Style="{StaticResource SettingsPageDescriptionStyle}" Margin="0,4,0,14" />
                                    <Border Background="{DynamicResource PosSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource PosBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="12"
                                            Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="56" Height="56" CornerRadius="12"
                                                    Background="{DynamicResource PosSurfaceBrush}"
                                                    BorderBrush="{DynamicResource PosBorderBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Printer" Width="28" Height="28"
                                                                         Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock FontSize="16" FontWeight="Bold">
                                                    <Run Text="{loc:Loc settings.receiptPrinter.port}" />
                                                    <Run Text="  " />
                                                    <Run Text="{Binding ReceiptPrinterPortText, Mode=OneWay}" FontFamily="Consolas" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding ReceiptPrinterTestStatusMessage}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Expander Margin="0,10,0,0" Background="Transparent" BorderThickness="0">
                                        <Expander.Header>
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.port.advanced}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                       MinHeight="40"
                                                       Padding="0,10,0,0" />
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.port}" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBox Text="{Binding ReceiptPrinterPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                     FontFamily="Consolas" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- 第 1 行放两张卡片（打印选项、再次扫码确认）上下排列，后面的卡片不用重新编号。 -->
                            <StackPanel Grid.Row="1" Visibility="{Binding IsReceiptHardwareSubTabSelected, Converter={StaticResource BoolToVis}}">
                            <!-- 打印选项：客人小票是否附带银行收据原文；与其他小票字段一样点“保存”后生效。 -->
                            <Border Style="{StaticResource SettingsActionCardStyle}"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc settings.receiptPrinter.options.title}" Style="{StaticResource SettingsSectionTitleStyle}" Margin="0,0,0,8" />
                                    <Grid MinHeight="72">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12"
                                                Background="{DynamicResource PosSurfaceAltBrush}"
                                                Margin="0,0,14,0" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="22" Height="22"
                                                                     Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.printBankReceipt}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PosTextBrush}" />
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.printBankReceipt.help}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="2"
                                                      x:Name="PrintBankReceiptTextToggle"
                                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                      IsChecked="{Binding ReceiptPrintBankReceiptText, Mode=TwoWay}"
                                                      AutomationProperties.Name="{loc:Loc settings.receiptPrinter.printBankReceipt}"
                                                      MinHeight="48"
                                                      MinWidth="56"
                                                      VerticalAlignment="Center">
                                        </ToggleButton>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 再次扫码确认：开启后，对应操作即使当前收银员自己有权限，也要再扫一次授权员工条码；各开关默认关闭，点“保存”后生效。 -->
                            <Border Style="{StaticResource SettingsActionCardStyle}"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc settings.receiptPrinter.rescan.title}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    <TextBlock Text="{loc:Loc settings.receiptPrinter.rescan.help}"
                                               Style="{StaticResource SettingsPageDescriptionStyle}" Margin="0,4,0,8" />
                                    <!-- 无交易开钱箱：只管侧栏「开钱箱」按钮，收现金后的自动开钱箱不受影响。 -->
                                    <Grid MinHeight="72">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12"
                                                Background="{DynamicResource PosSurfaceAltBrush}"
                                                Margin="0,0,14,0" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CashRegister" Width="22" Height="22"
                                                                     Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.noSaleDrawerRescan}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PosTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.noSaleDrawerRescan.help}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="2"
                                                      x:Name="NoSaleCashDrawerRescanToggle"
                                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                      IsChecked="{Binding ReceiptNoSaleCashDrawerRequiresRescan, Mode=TwoWay}"
                                                      AutomationProperties.Name="{loc:Loc settings.receiptPrinter.noSaleDrawerRescan}"
                                                      MinHeight="48"
                                                      MinWidth="56"
                                                      VerticalAlignment="Center">
                                        </ToggleButton>
                                    </Grid>

                                    <!-- 退货操作：只管侧栏「退款」进入退货页那一下；进入后加行、确认退货不再重复扫码。 -->
                                    <Border Height="1"
                                            Background="{DynamicResource PosDividerBrush}"
                                            Margin="0,12,0,12" />
                                    <Grid MinHeight="72">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="44" Height="44" CornerRadius="12"
                                                Background="{DynamicResource PosSurfaceAltBrush}"
                                                Margin="0,0,14,0" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CashRefund" Width="22" Height="22"
                                                                     Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.returnsRescan}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PosTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.returnsRescan.help}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="2"
                                                      x:Name="ReturnsRescanToggle"
                                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                      IsChecked="{Binding ReceiptReturnsRequireRescan, Mode=TwoWay}"
                                                      AutomationProperties.Name="{loc:Loc settings.receiptPrinter.returnsRescan}"
                                                      MinHeight="48"
                                                      MinWidth="56"
                                                      VerticalAlignment="Center">
                                        </ToggleButton>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                            <!-- ===== PAGE: ReceiptPrinter / ReceiptHardware END ===== -->

                            <!-- ===== PAGE: ReceiptPrinter / ReceiptStore BEGIN ===== -->
                            <!-- 门店信息：总部下发后只读，提示去 Web 分店管理修改；可随时“立即同步”。 -->
                            <Border Grid.Row="2"
                                    Style="{StaticResource SettingsActionCardStyle}"
                                    Visibility="{Binding IsReceiptStoreSubTabSelected, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding ReceiptStoreSaveStateText}"
                                                   Tag="{Binding ReceiptStoreSaveState}"
                                                   Style="{StaticResource SettingsSectionStateTextStyle}" />
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.storeInfo.title}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    </DockPanel>
                                    <TextBlock Text="{loc:Loc settings.receiptPrinter.storeInfo.help}"
                                               Style="{StaticResource SettingsPageDescriptionStyle}" Margin="0,4,0,12" />
                                    <Border Background="{DynamicResource PosSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource PosDividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,8"
                                            Margin="0,0,0,14">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Command="{Binding LoadReceiptProfileCommand}"
                                                    Style="{StaticResource SettingsTouchButtonHeight}"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="20" Height="20" Margin="0,0,8,0" />
                                                    <!-- 本机已应用过总部下发（版本 > 0）时显示「立即同步」，否则保持「从分店资料载入」。 -->
                                                    <TextBlock Text="{Binding ReceiptProfileLoadButtonText}" />
                                                </StackPanel>
                                            </Button>
                                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="LockOutline" Width="20" Height="20"
                                                                     Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,10,0"
                                                     Visibility="{Binding IsReceiptProfileManaged, Converter={StaticResource BoolToVis}}" />
                                            <!-- 总部下发后资料字段只读，提示去 Web 分店管理修改。 -->
                                            <TextBlock Text="{Binding ReceiptProfileManagedHintText}"
                                                       Visibility="{Binding IsReceiptProfileManaged, Converter={StaticResource BoolToVis}}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.brandName}" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBox Text="{Binding ReceiptBrandNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.storeName}" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBox Text="{Binding ReceiptStoreNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.address}" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBox Text="{Binding ReceiptStoreAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                     Height="76"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     ScrollViewer.PanningMode="VerticalFirst"
                                                     VerticalScrollBarVisibility="Auto" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.phone}" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBox Text="{Binding ReceiptStorePhoneText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.abn}" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBox Text="{Binding ReceiptAbnText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- ===== PAGE: ReceiptPrinter / ReceiptStore END ===== -->

                            <!-- ===== PAGE: ReceiptPrinter / ReceiptTerms BEGIN ===== -->
                            <!-- 小票条款：保留多行编辑，一行一条；留空＝使用内置默认文案。总部下发后只读（请在 Web 分店管理修改）。 -->
                            <Border Grid.Row="3"
                                    Style="{StaticResource SettingsActionCardStyle}"
                                    Visibility="{Binding IsReceiptTermsSubTabSelected, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding ReceiptTermsSaveStateText}"
                                                   Tag="{Binding ReceiptTermsSaveState}"
                                                   Style="{StaticResource SettingsSectionStateTextStyle}" />
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.terms.title}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                    </DockPanel>
                                    <TextBlock Text="{loc:Loc settings.receiptPrinter.terms.subtitle}"
                                               Style="{StaticResource SettingsPageDescriptionStyle}" Margin="0,4,0,12" />
                                    <TextBlock Text="{loc:Loc settings.receiptPrinter.returnPolicy}" Style="{StaticResource SettingsLabelStyle}" />
                                    <TextBox Text="{Binding ReceiptReturnPolicyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                             Style="{StaticResource SettingsFieldTextBoxStyle}"
                                             Height="110"
                                             MaxLength="500"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             ScrollViewer.PanningMode="VerticalFirst"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,0,0,14" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.voucherTerms}" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBox Text="{Binding ReceiptVoucherTermsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                     Height="130"
                                                     MaxLength="600"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     VerticalContentAlignment="Top"
                                                     ScrollViewer.PanningMode="VerticalFirst"
                                                     VerticalScrollBarVisibility="Auto" />
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.termsHelp}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.installmentTerms}" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBox Text="{Binding ReceiptInstallmentTermsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                     Height="130"
                                                     MaxLength="600"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     VerticalContentAlignment="Top"
                                                     ScrollViewer.PanningMode="VerticalFirst"
                                                     VerticalScrollBarVisibility="Auto" />
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.termsHelp}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- ===== PAGE: ReceiptPrinter / ReceiptTerms END ===== -->

                            <!-- ===== PAGE: ReceiptPrinter / ReceiptLegacySave BEGIN ===== -->
                            <!-- 旧的整页保存按钮：开启自动保存后隐藏。 -->
                            <DockPanel Grid.Row="4" LastChildFill="False" Visibility="{Binding IsExplicitSaveVisible, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding SaveReceiptPrinterCommand}"
                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                        Height="56"
                                        MinWidth="200">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,8,0" Foreground="White" />
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.save}" Foreground="White" FontSize="16" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <!-- ===== PAGE: ReceiptPrinter / ReceiptLegacySave END ===== -->
                        </Grid>

                        <!-- ===== PAGE: ReceiptPrinter / ReceiptPreview BEGIN ===== -->
                        <!-- 右栏：80mm 小票实时预览。 -->
                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource SettingsActionCardStyle}"
                                VerticalAlignment="Top"
                                Padding="16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Border DockPanel.Dock="Right"
                                            Background="{DynamicResource PosSurfaceAltBrush}"
                                            BorderBrush="{DynamicResource PosBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,3"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="80mm" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PosTextSecondaryBrush}" />
                                    </Border>
                                    <materialDesign:PackIcon Kind="ReceiptTextOutline"
                                                             Width="22"
                                                             Height="22"
                                                             Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                             Margin="0,0,9,0" />
                                    <TextBlock Text="{loc:Loc settings.receiptPrinter.preview}"
                                               Style="{StaticResource SettingsSectionTitleStyle}"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <Border Background="{DynamicResource PosSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource PosDividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,18">
                                    <Border MaxWidth="260"
                                            MinHeight="380"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource PosSurfaceBrush}"
                                            Padding="16,20">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18" Color="#FF64748B" />
                                        </Border.Effect>
                                        <!-- 小票纸张用表面色，深色主题下也保持可读。 -->
                                        <StackPanel TextElement.Foreground="{DynamicResource PosTextBrush}">
                                            <TextBlock Text="{Binding ReceiptBrandNameText}"
                                                       FontFamily="Consolas"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ReceiptStoreNameText}"
                                                       FontFamily="Consolas"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding ReceiptStoreAddressText}"
                                                       FontFamily="Consolas"
                                                       FontSize="10.5"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                            <TextBlock FontFamily="Consolas"
                                                       FontSize="10.5"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding ReceiptStorePhoneText, Mode=OneWay}" />
                                                <Run Text=" " />
                                                <Run Text="{Binding ReceiptAbnText, Mode=OneWay}" />
                                            </TextBlock>
                                            <Border BorderBrush="{DynamicResource PosBorderStrongBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Margin="0,14,0,12" />
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.test}"
                                                       FontFamily="Consolas"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       TextAlignment="Center" />
                                            <Border BorderBrush="{DynamicResource PosBorderStrongBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Margin="0,12,0,12" />
                                            <TextBlock Text="{Binding ReceiptReturnPolicyText}"
                                                       FontFamily="Consolas"
                                                       FontSize="10.5"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </Border>
                        <!-- ===== PAGE: ReceiptPrinter / ReceiptPreview END ===== -->
                    </Grid>
                </controls:SettingsPageHost>
                <!-- ===== PAGE: ReceiptPrinter END ===== -->

                <!-- ===== PAGE: DeviceRegistration BEGIN ===== -->
                <controls:SettingsPageHost Style="{StaticResource SettingsPageHostStyle}"
                                           Visibility="{Binding IsDeviceRegistrationSelected, Converter={StaticResource BoolToVis}}">
                    <!-- SettingsPageHost 槽位：SubTabs（二级页签条）/ Footer（固定底部操作条）；阶段 A 暂不使用，阶段 B 逐页迁移。 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Grid.ColumnSpan="3"
                                Style="{StaticResource SettingsActionCardStyle}"
                                Margin="0,0,0,16">
                            <DockPanel>
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource PosSuccessSoftBrush}"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        Margin="18,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                                 Width="19"
                                                                 Height="19"
                                                                 Foreground="{DynamicResource PosSuccessTextBrush}"
                                                                 Margin="0,0,7,0" />
                                        <TextBlock Text="{loc:Loc settings.deviceRegistration.active}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PosSuccessTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border DockPanel.Dock="Left"
                                        Width="58"
                                        Height="58"
                                        Background="{DynamicResource PosPrimarySoftBrush}"
                                        CornerRadius="10"
                                        Margin="0,0,18,0">
                                    <materialDesign:PackIcon Kind="CashRegister"
                                                             Width="34"
                                                             Height="34"
                                                             Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc settings.deviceRegistration.current}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                    <TextBlock FontSize="21"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource PosTextBrush}"
                                               Margin="0,3,0,0">
                                        <Run Text="{Binding Session.StoreName, Mode=OneWay}" />
                                        <Run Text=" (" />
                                        <Run Text="{Binding Session.StoreCode, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               Margin="0,4,0,0">
                                        <Run Text="{loc:Loc settings.deviceRegistration.thisDevice}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding Session.DeviceCode, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <controls:ApiServerSettingsPanel DataContext="{Binding ApiServerSettings}"
                                                         Grid.Row="1"
                                                         Grid.Column="0" />

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource SettingsActionCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="{Binding DeviceRegistrationTitleText}"
                                               FontSize="18"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource PosTextBrush}" />
                                    <TextBlock Text="{loc:Loc settings.deviceRegistration.description}"
                                               Style="{StaticResource SettingsPageDescriptionStyle}" />
                                </StackPanel>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource PosWarningSoftBrush}"
                                        BorderBrush="{DynamicResource PosWarningBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Margin="0,18,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Grid.Column="0"
                                                                 Kind="ShieldAccountOutline"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Foreground="{DynamicResource PosAccentBrush}"
                                                                 VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{loc:Loc settings.deviceRegistration.supervisorRequired}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PosWarningTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="2" Margin="0,0,0,18">
                                    <TextBlock Text="{loc:Loc settings.deviceRegistration.beforeContinue}"
                                               FontSize="13"
                                               FontWeight="Black"
                                               Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="Cart" Width="20" Height="20" Foreground="{DynamicResource PosPrimaryTextBrush}" Margin="0,0,10,0" />
                                        <TextBlock Text="{loc:Loc settings.deviceRegistration.checkCart}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="CreditCard" Width="20" Height="20" Foreground="{DynamicResource PosPrimaryTextBrush}" Margin="0,0,10,0" />
                                        <TextBlock Text="{loc:Loc settings.deviceRegistration.checkPayment}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Sync" Width="20" Height="20" Foreground="{DynamicResource PosPrimaryTextBrush}" Margin="0,0,10,0" />
                                        <TextBlock Text="{loc:Loc settings.deviceRegistration.checkSync}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="3">
                                    <Button Command="{Binding ReregisterDeviceCommand}"
                                            Style="{StaticResource PosPrimaryButtonStyle}"
                                            Height="46"
                                            HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AccountSwitch" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                            <TextBlock Text="{loc:Loc settings.deviceRegistration.action}" Foreground="White" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{loc:Loc settings.deviceRegistration.deviceReuse}"
                                               FontSize="10"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </controls:SettingsPageHost>
                <!-- ===== PAGE: DeviceRegistration END ===== -->

                <!-- ===== PAGE: RemoteMaintenance BEGIN ===== -->
                <controls:SettingsPageHost Style="{StaticResource SettingsPageHostStyle}"
                                           Visibility="{Binding IsRemoteMaintenanceSelected, Converter={StaticResource BoolToVis}}">
                    <!-- SettingsPageHost 槽位：SubTabs（二级页签条）/ Footer（固定底部操作条）；阶段 A 暂不使用，阶段 B 逐页迁移。 -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource SettingsActionCardStyle}" Margin="0,0,0,16">
                            <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="58"
                                        Height="58"
                                        Background="{DynamicResource PosPrimarySoftBrush}"
                                        CornerRadius="10"
                                        Margin="0,0,18,0">
                                    <materialDesign:PackIcon Kind="RemoteDesktop"
                                                             Width="34"
                                                             Height="34"
                                                             Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RemoteMaintenanceTitleText}" FontSize="21" FontWeight="Black" />
                                    <TextBlock Text="{Binding RemoteMaintenanceDescriptionText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource SettingsActionCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{loc:Loc settings.remoteMaintenance.localStatus}" Style="{StaticResource SettingsLabelStyle}" />
                                <Border Grid.Row="1"
                                        Background="{DynamicResource PosSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource PosBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RemoteMaintenanceStatusText}"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   Foreground="{DynamicResource PosTextBrush}" />
                                        <TextBlock Text="{Binding RemoteMaintenanceDetailText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Row="2">
                                    <Button Command="{Binding InstallRemoteMaintenanceCommand}"
                                            Style="{StaticResource PosPrimaryButtonStyle}"
                                            Height="46"
                                            HorizontalAlignment="Left"
                                            MinWidth="190">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Download"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Margin="0,0,8,0"
                                                                     Foreground="White" />
                                            <TextBlock Text="{Binding RemoteMaintenanceActionText}" Foreground="White" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding HasRemoteMaintenanceProgress, Converter={StaticResource BoolToVis}}">
                                        <ProgressBar Height="4"
                                                     IsIndeterminate="{Binding IsRemoteMaintenanceInstalling}"
                                                     Visibility="{Binding IsRemoteMaintenanceInstalling, Converter={StaticResource BoolToVis}}"
                                                     Margin="0,0,0,8" />
                                        <TextBlock Text="{Binding RemoteMaintenanceProgressText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PosTextBrush}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc settings.remoteMaintenance.installHint}"
                                               FontSize="10"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </controls:SettingsPageHost>
                <!-- ===== PAGE: RemoteMaintenance END ===== -->

                <!-- 员工 App 下载：iPhone 与安卓（含 PDA）各一张二维码卡片，所有收银员可见。 -->
                <!-- ===== PAGE: MobileAppDownload BEGIN ===== -->
                <controls:SettingsPageHost Style="{StaticResource SettingsPageHostStyle}"
                                           Visibility="{Binding IsMobileAppDownloadSelected, Converter={StaticResource BoolToVis}}">
                    <!-- SettingsPageHost 槽位：SubTabs（二级页签条）/ Footer（固定底部操作条）；阶段 A 暂不使用，阶段 B 逐页迁移。 -->
                    <Grid>
                        <Grid DataContext="{Binding MobileAppDownload}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- iPhone / iPad -->
                                <Border Grid.Column="0" Style="{StaticResource SettingsActionCardStyle}" Padding="14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Left" Width="40" Height="40" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="9" Margin="0,0,12,0">
                                                <materialDesign:PackIcon Kind="AppleIos" Width="24" Height="24" Foreground="{DynamicResource PosPrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc mobileApp.ios.title}" FontSize="15" FontWeight="Bold" />
                                                <TextBlock Text="{loc:Loc mobileApp.ios.subtitle}" FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Button Command="{Binding EnlargeCommand}"
                                                CommandParameter="ios"
                                                Style="{StaticResource PosSecondaryButtonStyle}"
                                                Width="200"
                                                Height="200"
                                                Padding="0"
                                                Background="{DynamicResource PosSurfaceBrush}"
                                                HorizontalAlignment="Center"
                                                AutomationProperties.Name="{loc:Loc mobileApp.enlarge.open}">
                                            <Grid>
                                                <Image Source="{Binding IosQrPayload, Converter={StaticResource QrCodeImage}, ConverterParameter=190}"
                                                       Stretch="None"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource PosPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6">
                                                    <materialDesign:PackIcon Kind="MagnifyPlus" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <TextBlock Text="{loc:Loc mobileApp.ios.hint}" FontSize="13" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,4" />
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="{loc:Loc mobileApp.version}" FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding IosVersionText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource PosSurfaceAltBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,0" Height="40" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding IosLinkText}" FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Button Grid.Column="1" Command="{Binding CopyLinkCommand}" CommandParameter="ios" Style="{StaticResource PosSecondaryButtonStyle}" Height="40" Padding="12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                                    <TextBlock Text="{loc:Loc mobileApp.copyLink}" FontSize="12" FontWeight="Bold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 安卓手机 / PDA：二维码指向总部匿名下载入口，扫码后直接下载最新安装包。 -->
                                <Border Grid.Column="2" Style="{StaticResource SettingsActionCardStyle}" Padding="14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Left" Width="40" Height="40" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="9" Margin="0,0,12,0">
                                                <materialDesign:PackIcon Kind="Android" Width="24" Height="24" Foreground="{DynamicResource PosSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border DockPanel.Dock="Right" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="11" Padding="9,3" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc mobileApp.android.badge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc mobileApp.android.title}" FontSize="15" FontWeight="Bold" />
                                                <TextBlock Text="{loc:Loc mobileApp.android.subtitle}" FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Button Command="{Binding EnlargeCommand}"
                                                CommandParameter="android"
                                                Style="{StaticResource PosSecondaryButtonStyle}"
                                                Width="200"
                                                Height="200"
                                                Padding="0"
                                                Background="{DynamicResource PosSurfaceBrush}"
                                                HorizontalAlignment="Center"
                                                AutomationProperties.Name="{loc:Loc mobileApp.enlarge.open}"
                                                Visibility="{Binding IsAndroidAvailable, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Image Source="{Binding AndroidQrPayload, Converter={StaticResource QrCodeImage}, ConverterParameter=190}"
                                                       Stretch="None"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource PosPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6">
                                                    <materialDesign:PackIcon Kind="MagnifyPlus" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <!-- 总部确认没有可下载的安卓包时，不显示会扫出 404 的二维码，改为说明与重试。 -->
                                        <Border Width="200"
                                                Height="200"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource PosSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource PosDividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="{Binding IsAndroidNotPublished, Converter={StaticResource BoolToVis}}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="PackageVariantClosed" Width="40" Height="40" Foreground="{DynamicResource PosMutedForegroundBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{loc:Loc mobileApp.android.notPublished}" FontSize="14" FontWeight="Bold" TextAlignment="Center" Margin="0,10,0,2" />
                                                <TextBlock Text="{loc:Loc mobileApp.android.notPublishedHint}" FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}" TextAlignment="Center" />
                                                <Button Command="{Binding RefreshCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Height="40" Padding="16,0" HorizontalAlignment="Center" Margin="0,12,0,0">
                                                    <TextBlock Text="{loc:Loc mobileApp.retry}" FontWeight="Bold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{loc:Loc mobileApp.android.hint}" FontSize="13" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,4" />
                                        <!-- 版本与包大小合成一行，让两张卡片在 1366×688 下一屏放得下。 -->
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="{loc:Loc mobileApp.version}" FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" HorizontalAlignment="Left" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding AndroidVersionText}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding AndroidSizeText}" FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="10,0,0,0" Visibility="{Binding HasAndroidSize, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource PosSurfaceAltBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,0" Height="40" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding AndroidLinkText}" FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Button Grid.Column="1" Command="{Binding CopyLinkCommand}" CommandParameter="android" Style="{StaticResource PosSecondaryButtonStyle}" Height="40" Padding="12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                                    <TextBlock Text="{loc:Loc mobileApp.copyLink}" FontSize="12" FontWeight="Bold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Border Background="{DynamicResource PosWarningSoftBrush}" BorderBrush="{DynamicResource PosWarningBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                            <TextBlock Text="{loc:Loc mobileApp.android.note}" FontSize="11" Foreground="{DynamicResource PosWarningTextBrush}" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 底部状态：联网状态文案、复制反馈、刷新。 -->
                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ProgressBar Width="60" Height="4" IsIndeterminate="True" Margin="0,0,10,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource PosMutedForegroundBrush}" VerticalAlignment="Center" Visibility="{Binding IsOfflineWarning, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Text="{Binding CopyFeedbackText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PosSuccessBrush}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasCopyFeedback, Converter={StaticResource BoolToVis}}" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Height="40" Padding="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        <TextBlock Text="{loc:Loc mobileApp.refresh}" FontWeight="Bold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </controls:SettingsPageHost>
                <!-- ===== PAGE: MobileAppDownload END ===== -->
            </Grid>
        </Grid>

        <!-- 底部状态条（28）：状态文字 + 忙碌进度条。 -->
        <Border Grid.Row="2"
                Background="{DynamicResource PosSurfaceAltBrush}"
                BorderBrush="{DynamicResource PosDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="InformationOutline"
                                         Width="14"
                                         Height="14"
                                         Foreground="{DynamicResource PosMutedForegroundBrush}"
                                         Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Width="90"
                             Height="4"
                             Margin="14,0,0,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- 放大扫码：二维码放大到 360px，方便手机在收银台旁边远距离对准；点任意位置关闭。 -->
        <Border Grid.RowSpan="3"
                Background="#99000000"
                Visibility="{Binding MobileAppDownload.IsEnlarged, Converter={StaticResource BoolToVis}}">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding MobileAppDownload.CloseEnlargedCommand}" />
            </Border.InputBindings>
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,18">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding MobileAppDownload.EnlargedTitleText}" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <Border Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Image Source="{Binding MobileAppDownload.EnlargedQrPayload, Converter={StaticResource QrCodeImage}, ConverterParameter=360}"
                               Stretch="None"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <TextBlock Text="{loc:Loc mobileApp.enlarge.hint}" FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.RowSpan="3"
                Background="#99000000"
                Visibility="{Binding IsLinklySetupInstructionsOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="24">
                <Border Width="720"
                        MaxHeight="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PosSurfaceBrush}"
                        BorderBrush="{DynamicResource PosDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding CloseLinklySetupInstructionsCommand}"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Width="38"
                                    Height="38"
                                    Padding="0">
                                <materialDesign:PackIcon Kind="Close"
                                                         Width="18"
                                                         Height="18"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc settings.linkly.sop.title}"
                                           FontSize="18"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource PosTextBrush}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.note}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,16,0" />
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1"
                                      Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step1}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step2}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step3}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step4}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step5}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step6}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step7}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step8}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.step1}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.step2}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.step3}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.warning}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PosDangerTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step1}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step2}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step3}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step4}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step5}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step6}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step7}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step8}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step9}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step10}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step11}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.manual.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.manual.steps}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.manual.warning}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PosDangerTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.ip.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.ip.steps}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.ip.note}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.mode.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.mode.localIp}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.mode.cloudDirectSync}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.mode.cloudBackendAsync}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2"
                                Command="{Binding CloseLinklySetupInstructionsCommand}"
                                Style="{StaticResource PosPrimaryButtonStyle}"
                                Height="42"
                                MinWidth="110"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                            <TextBlock Text="{loc:Loc settings.linkly.sop.close}" Foreground="White" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 离开设置页时还有保存失败 / 未生效的修改：逐项列出位置与原因，三个选择。 -->
        <Border Grid.RowSpan="3"
                Background="#99000000"
                Visibility="{Binding IsLeaveDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="560"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertOutline" Width="24" Height="24" Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PosDangerTextBrush}" />
                        <TextBlock Text="{Binding LeaveDialogTitleText}"
                                   FontSize="20"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{loc:Loc settings.autosave.leave.message}"
                               FontSize="13"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,14" />
                    <ItemsControl ItemsSource="{Binding LeaveDialogItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PosDangerSoftBrush}"
                                        BorderBrush="{DynamicResource PosDangerBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LocationText}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PosTextBrush}" />
                                        <TextBlock Text="{Binding DetailText}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource PosDangerTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Command="{Binding LeaveStayCommand}"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                MinHeight="52"
                                Padding="18,0"
                                Margin="0,0,10,0">
                            <TextBlock Text="{loc:Loc settings.autosave.leave.stay}" />
                        </Button>
                        <Button Command="{Binding LeaveDiscardCommand}"
                                Visibility="{Binding LeaveDialogCanDiscard, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                MinHeight="52"
                                Padding="18,0"
                                Margin="0,0,10,0">
                            <TextBlock Text="{loc:Loc settings.autosave.leave.discard}" Foreground="{DynamicResource PosDangerTextBrush}" />
                        </Button>
                        <Button Command="{Binding LeaveRetryCommand}"
                                Visibility="{Binding LeaveDialogCanRetry, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource PosPrimaryButtonStyle}"
                                MinHeight="52"
                                Padding="18,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                <TextBlock Text="{loc:Loc settings.autosave.leave.retry}" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
