<!-- 由色板总表生成，四套主题的键必须完全一致。石墨夜：深灰蓝底、浅灰字，适合傍晚、夜班与灯光偏暗的门店。 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="PosPaletteId">Graphite</sys:String>
    <sys:Boolean x:Key="PosPaletteIsDark">True</sys:Boolean>
    <Color x:Key="PosPaletteMaterialPrimaryColor">#FF2F76B8</Color>

    <!-- 整屏背景 -->
    <SolidColorBrush x:Key="PosScreenBackgroundBrush" Color="#FF14171B" />
    <!-- 卡片/面板 -->
    <SolidColorBrush x:Key="PosSurfaceBrush" Color="#FF1C2025" />
    <!-- 次级面板/交替行 -->
    <SolidColorBrush x:Key="PosSurfaceAltBrush" Color="#FF191D22" />
    <!-- 浅灰底（输入区、分组底） -->
    <SolidColorBrush x:Key="PosSurfaceMutedBrush" Color="#FF22272D" />
    <!-- 较深灰底（按下、禁用块） -->
    <SolidColorBrush x:Key="PosSurfaceStrongBrush" Color="#FF2A3038" />
    <!-- 深色提示底（配白字） -->
    <SolidColorBrush x:Key="PosInverseSurfaceBrush" Color="#FF30363E" />
    <!-- 分隔线/浅描边 -->
    <SolidColorBrush x:Key="PosDividerBrush" Color="#FF2A2F36" />
    <!-- 描边 -->
    <SolidColorBrush x:Key="PosBorderBrush" Color="#FF363D46" />
    <!-- 深描边/滚动条 -->
    <SolidColorBrush x:Key="PosBorderStrongBrush" Color="#FF56606B" />
    <!-- 正文 -->
    <SolidColorBrush x:Key="PosTextBrush" Color="#FFE1E4E8" />
    <!-- 次级正文 -->
    <SolidColorBrush x:Key="PosTextSecondaryBrush" Color="#FFC3C8CE" />
    <!-- 次要文字 -->
    <SolidColorBrush x:Key="PosMutedForegroundBrush" Color="#FF98A1AB" />
    <!-- 占位/弱提示文字 -->
    <SolidColorBrush x:Key="PosSubtleForegroundBrush" Color="#FF6E7782" />
    <!-- 功能图标 -->
    <SolidColorBrush x:Key="PosIconBrush" Color="#FF9CB6CF" />
    <!-- 侧栏功能图标 -->
    <SolidColorBrush x:Key="PosSidebarIconBrush" Color="#FF9CB6CF" />
    <!-- 侧栏退款图标 -->
    <SolidColorBrush x:Key="PosSidebarRefundIconBrush" Color="#FF9CB6CF" />
    <!-- 侧栏挂单图标 -->
    <SolidColorBrush x:Key="PosSidebarHoldIconBrush" Color="#FF9CB6CF" />
    <!-- 主色填充/描边（配白字） -->
    <SolidColorBrush x:Key="PosPrimaryBrush" Color="#FF2F76B8" />
    <!-- 主色按下 -->
    <SolidColorBrush x:Key="PosPrimaryStrongBrush" Color="#FF26629B" />
    <!-- 主色文字/图标 -->
    <SolidColorBrush x:Key="PosPrimaryTextBrush" Color="#FF86BDF0" />
    <!-- 选中/主色浅底 -->
    <SolidColorBrush x:Key="PosPrimarySoftBrush" Color="#FF1D3244" />
    <!-- 主色浅底（悬停/按下） -->
    <SolidColorBrush x:Key="PosPrimarySoftStrongBrush" Color="#FF24405A" />
    <!-- 主色浅描边 -->
    <SolidColorBrush x:Key="PosPrimarySoftBorderBrush" Color="#FF2F5374" />
    <!-- 主色按钮禁用底（配白字） -->
    <SolidColorBrush x:Key="PosPrimaryDisabledBrush" Color="#FF34506B" />
    <!-- 标题文字 -->
    <SolidColorBrush x:Key="PosPrimaryDarkBrush" Color="#FFE1E4E8" />
    <!-- 重点金额 -->
    <SolidColorBrush x:Key="PosAccentBrush" Color="#FFEFC05A" />
    <!-- 重点金额文字 -->
    <SolidColorBrush x:Key="PosAccentForegroundBrush" Color="#FFEFC05A" />
    <!-- 应付合计底色（荧光笔） -->
    <SolidColorBrush x:Key="PosAmountSoftBrush" Color="#FF221F16" />
    <!-- 成功填充（配白字） -->
    <SolidColorBrush x:Key="PosSuccessBrush" Color="#FF2F8A5B" />
    <!-- 成功文字 -->
    <SolidColorBrush x:Key="PosSuccessTextBrush" Color="#FF6FD19D" />
    <!-- 成功浅底 -->
    <SolidColorBrush x:Key="PosSuccessSoftBrush" Color="#FF183327" />
    <!-- 成功描边 -->
    <SolidColorBrush x:Key="PosSuccessBorderBrush" Color="#FF2B5A42" />
    <!-- 警告填充 -->
    <SolidColorBrush x:Key="PosWarningBrush" Color="#FFB7862A" />
    <!-- 警告文字 -->
    <SolidColorBrush x:Key="PosWarningTextBrush" Color="#FFE5B04E" />
    <!-- 警告强调填充（配白字） -->
    <SolidColorBrush x:Key="PosWarningStrongBrush" Color="#FFA0701E" />
    <!-- 警告浅底 -->
    <SolidColorBrush x:Key="PosWarningSoftBrush" Color="#FF33290F" />
    <!-- 警告描边 -->
    <SolidColorBrush x:Key="PosWarningBorderBrush" Color="#FF5A4720" />
    <!-- 危险填充（配白字） -->
    <SolidColorBrush x:Key="PosDangerBrush" Color="#FFC4453A" />
    <!-- 危险文字 -->
    <SolidColorBrush x:Key="PosDangerTextBrush" Color="#FFF08A7E" />
    <!-- 危险浅底 -->
    <SolidColorBrush x:Key="PosDangerSoftBrush" Color="#FF3A1F1D" />
    <!-- 危险描边 -->
    <SolidColorBrush x:Key="PosDangerBorderBrush" Color="#FF6A3530" />
    <!-- 标题栏背景 -->
    <SolidColorBrush x:Key="PosHeaderBackgroundBrush" Color="#FF1A1D22" />
    <!-- 标题栏文字 -->
    <SolidColorBrush x:Key="PosHeaderForegroundBrush" Color="#FFE1E4E8" />
    <!-- 标题栏次要文字 -->
    <SolidColorBrush x:Key="PosHeaderMutedForegroundBrush" Color="#FF98A1AB" />
    <!-- 状态栏背景 -->
    <SolidColorBrush x:Key="PosFooterBackgroundBrush" Color="#FF171A1E" />

    <!-- ── 长者模式/支付方式/快捷金额新增语义键：旧主题取值＝改动前的等效色，视觉不变 ── -->
    <!-- 首页购物车区底色 -->
    <SolidColorBrush x:Key="PosZoneCartBrush" Color="#FF191D22" />
    <!-- 首页键盘区底色 -->
    <SolidColorBrush x:Key="PosZoneKeypadBrush" Color="#FF191D22" />
    <!-- 首页功能区底色 -->
    <SolidColorBrush x:Key="PosZoneFuncBrush" Color="#FF191D22" />
    <!-- 首页分区竖线 -->
    <SolidColorBrush x:Key="PosZoneDividerBrush" Color="#FF2A2F36" />
    <!-- 键/按钮/卡片描边（原 PosBorderBrush 用法） -->
    <SolidColorBrush x:Key="PosKeyBorderBrush" Color="#FF363D46" />
    <!-- 卡片浅描边（原 PosDividerBrush 用法） -->
    <SolidColorBrush x:Key="PosCardBorderBrush" Color="#FF2A2F36" />
    <!-- 键帽底部投影色 -->
    <SolidColorBrush x:Key="PosKeyShadowBrush" Color="#00000000" />
    <!-- 购物车表头底色 -->
    <SolidColorBrush x:Key="PosCartHeaderBrush" Color="#FF191D22" />
    <!-- 购物车斑马纹 -->
    <SolidColorBrush x:Key="PosCartAltRowBrush" Color="#FF191D22" />
    <!-- 购物车选中行底色 -->
    <SolidColorBrush x:Key="PosCartSelectedRowBrush" Color="#FF1D3244" />
    <!-- 购物车应付合计金额色 -->
    <SolidColorBrush x:Key="PosDueAmountBrush" Color="#FFEFC05A" />
    <!-- 首页 Clear 键底色 -->
    <SolidColorBrush x:Key="PosClearKeyBrush" Color="#FF1C2025" />
    <!-- 无条码按钮底色 -->
    <SolidColorBrush x:Key="PosNoBarcodeBrush" Color="#FF2F76B8" />
    <!-- 无条码按钮文字色 -->
    <SolidColorBrush x:Key="PosNoBarcodeForegroundBrush" Color="#FFFFFFFF" />
    <!-- 无条码按钮按下底色 -->
    <SolidColorBrush x:Key="PosNoBarcodePressedBrush" Color="#FF26629B" />
    <!-- 无条码按钮禁用底色 -->
    <SolidColorBrush x:Key="PosNoBarcodeDisabledBrush" Color="#FF2A3038" />
    <!-- 功能区按钮底色 -->
    <SolidColorBrush x:Key="PosSidebarButtonBrush" Color="#FF1C2025" />
    <!-- 功能区按钮文字色 -->
    <SolidColorBrush x:Key="PosSidebarButtonForegroundBrush" Color="#FFE1E4E8" />
    <!-- 功能区按钮悬停底色 -->
    <SolidColorBrush x:Key="PosSidebarButtonHoverBrush" Color="#FF191D22" />
    <!-- 功能区按钮按下底色 -->
    <SolidColorBrush x:Key="PosSidebarButtonPressedBrush" Color="#FF1D3244" />
    <!-- 功能区退出按钮底色 -->
    <SolidColorBrush x:Key="PosSidebarExitButtonBrush" Color="#FF1C2025" />
    <!-- 功能区退出按钮文字/图标色 -->
    <SolidColorBrush x:Key="PosSidebarExitForegroundBrush" Color="#FFF08A7E" />
    <!-- 功能区退出按钮悬停底色 -->
    <SolidColorBrush x:Key="PosSidebarExitHoverBrush" Color="#FF191D22" />
    <!-- 功能区退出按钮按下底色 -->
    <SolidColorBrush x:Key="PosSidebarExitPressedBrush" Color="#FF1D3244" />
    <!-- 确认支付按钮底色 -->
    <SolidColorBrush x:Key="PosConfirmPaymentBrush" Color="#FF2F76B8" />
    <!-- 确认支付按钮底部厚阴影色 -->
    <SolidColorBrush x:Key="PosConfirmPaymentShadowBrush" Color="#00000000" />
    <!-- 支付页取消按钮底色 -->
    <SolidColorBrush x:Key="PosCancelButtonBrush" Color="#FF1C2025" />
    <!-- 支付页取消按钮文字色 -->
    <SolidColorBrush x:Key="PosCancelButtonForegroundBrush" Color="#FFE1E4E8" />
    <!-- 待付/应付金额强调色 -->
    <SolidColorBrush x:Key="PosAmountEmphasisBrush" Color="#FF86BDF0" />
    <!-- 找零块底色 -->
    <SolidColorBrush x:Key="PosChangeDueBackgroundBrush" Color="#FF183327" />
    <!-- 找零文字色 -->
    <SolidColorBrush x:Key="PosChangeDueForegroundBrush" Color="#FF6FD19D" />
    <!-- 购物车加量按钮底色 -->
    <SolidColorBrush x:Key="PosQtyPlusBrush" Color="#FF1C2025" />
    <!-- 购物车加量按钮文字/图标色 -->
    <SolidColorBrush x:Key="PosQtyPlusForegroundBrush" Color="#FF6FD19D" />
    <!-- 10%–50% 折扣键文字色 -->
    <SolidColorBrush x:Key="PosDiscountKeyForegroundBrush" Color="#FFE1E4E8" />
    <!-- 折扣条分段竖线 -->
    <SolidColorBrush x:Key="PosSegmentSeparatorBrush" Color="#FF363D46" />
    <!-- 屏幕键盘 / 搜索候选弹层的描边（旧主题＝PosDividerBrush；长者主题内容区无描边，但浮层必须有边界） -->
    <SolidColorBrush x:Key="PosPopupBorderBrush" Color="#FF2A2F36" />
    <!-- 功能区警示键底色（刷卡恢复有待处理卡交易时） -->
    <SolidColorBrush x:Key="PosSidebarWarnButtonBrush" Color="#FF33290F" />
    <!-- 功能区警示键文字/图标色 -->
    <SolidColorBrush x:Key="PosSidebarWarnForegroundBrush" Color="#FFE5B04E" />
    <!-- 功能区警示键描边色 -->
    <SolidColorBrush x:Key="PosSidebarWarnBorderBrush" Color="#FFB7862A" />
    <!-- 功能区警示键悬停底色 -->
    <SolidColorBrush x:Key="PosSidebarWarnHoverBrush" Color="#FF33290F" />
    <!-- 功能区警示键按下底色 -->
    <SolidColorBrush x:Key="PosSidebarWarnPressedBrush" Color="#FF5A4720" />
    <!-- 功能区按钮角标底色（挂单数量、二维码秒数） -->
    <SolidColorBrush x:Key="PosSidebarBadgeBrush" Color="#FF2F76B8" />
    <!-- 功能区按钮角标文字色 -->
    <SolidColorBrush x:Key="PosSidebarBadgeForegroundBrush" Color="#FFFFFFFF" />
    <!-- 功能区警示角标底色（待处理卡交易数量，白字） -->
    <SolidColorBrush x:Key="PosSidebarBadgeAlertBrush" Color="#FFC4453A" />
    <!-- Open Item（原 No Barcode）按钮禁用时的文字色：与禁用底色配成「灰块灰字」，明显区别于可用态 -->
    <SolidColorBrush x:Key="PosNoBarcodeDisabledForegroundBrush" Color="#FF98A1AB" />
    <!-- 支付方式语义色：现金=琥珀棕、刷卡=深蓝、代金券=紫；Fill 选中实心 / On 实心上的字 / Soft 未选浅块 / Ink 浅块上的字与图标 -->
    <SolidColorBrush x:Key="PosMethodCashFillBrush" Color="#FFF0A961" />
    <SolidColorBrush x:Key="PosMethodCashOnBrush" Color="#FF241405" />
    <SolidColorBrush x:Key="PosMethodCashSoftBrush" Color="#FF33261A" />
    <SolidColorBrush x:Key="PosMethodCashTileBrush" Color="#FF33261A" />
    <SolidColorBrush x:Key="PosMethodCashInkBrush" Color="#FFF2B36B" />
    <SolidColorBrush x:Key="PosMethodCardFillBrush" Color="#FF93B3F2" />
    <SolidColorBrush x:Key="PosMethodCardOnBrush" Color="#FF0E1A33" />
    <SolidColorBrush x:Key="PosMethodCardSoftBrush" Color="#FF1E2A44" />
    <SolidColorBrush x:Key="PosMethodCardTileBrush" Color="#FF1E2A44" />
    <SolidColorBrush x:Key="PosMethodCardInkBrush" Color="#FFA9C2F5" />
    <SolidColorBrush x:Key="PosMethodVoucherFillBrush" Color="#FFC6A6F4" />
    <SolidColorBrush x:Key="PosMethodVoucherOnBrush" Color="#FF1F1233" />
    <SolidColorBrush x:Key="PosMethodVoucherSoftBrush" Color="#FF2A2140" />
    <SolidColorBrush x:Key="PosMethodVoucherTileBrush" Color="#FF2A2140" />
    <SolidColorBrush x:Key="PosMethodVoucherInkBrush" Color="#FFCDB0F7" />
    <!-- 快捷现金面额色（澳元面额主色的 UI 自定义色，不取样自纸币）：Fill 底色 / Text 数字色 -->
    <SolidColorBrush x:Key="PosNote100FillBrush" Color="#FF4CC38A" />
    <SolidColorBrush x:Key="PosNote100TextBrush" Color="#FF0B1220" />
    <SolidColorBrush x:Key="PosNote50FillBrush" Color="#FFF2CE5B" />
    <SolidColorBrush x:Key="PosNote50TextBrush" Color="#FF0B1220" />
    <SolidColorBrush x:Key="PosNote20FillBrush" Color="#FFFF7F5E" />
    <SolidColorBrush x:Key="PosNote20TextBrush" Color="#FF0B1220" />
    <SolidColorBrush x:Key="PosNote10FillBrush" Color="#FF74A8F2" />
    <SolidColorBrush x:Key="PosNote10TextBrush" Color="#FF0B1220" />
    <SolidColorBrush x:Key="PosNote5FillBrush" Color="#FFD68BD0" />
    <SolidColorBrush x:Key="PosNote5TextBrush" Color="#FF0B1220" />

    <LinearGradientBrush x:Key="PosPrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3A86CC" Offset="0" />
        <GradientStop Color="#FF2F76B8" Offset="0.55" />
        <GradientStop Color="#FF26629B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PosPayButtonGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF3580C4" Offset="0" />
        <GradientStop Color="#FF2A6BA8" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
