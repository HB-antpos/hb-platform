<?xml version="1.0" encoding="utf-8"?>
<!--
  中文注释：Zeller.* 只从 Zeller 私有源下载，其余包仍只走 nuget.org。
  这个文件管 apps/pos-wpf 下所有工程（WPF 客户端、POS API 与各测试）；只有 WPF 客户端引用 Zeller.PaymentsSdk，
  其它工程的还原不会访问 Zeller 源，也不需要凭据。

  凭据不进仓库。NuGet 从环境变量 NuGetPackageSourceCredentials_zeller 读取，格式：
    Username=<用户名>;Password=<令牌>
  取值是 Zeller 开发者文档「Payments SDK - .NET」快速入门里公开的只读账号（需登录 developer.myzeller.com）。
  - CI：pr-ci.yml 与 wpf-inno-smoke-build.yml 用仓库 Secret ZELLER_NUGET_USERNAME / ZELLER_NUGET_TOKEN 拼出这个变量。
  - 本机：全局包缓存（%USERPROFILE%\.nuget\packages）里已有 zeller.paymentssdk 对应版本时不会访问私有源；
    没有时先在当前终端设好这个变量再还原，例如 PowerShell：
      $env:NuGetPackageSourceCredentials_zeller = 'Username=...;Password=...'
    不要用 dotnet nuget add source 加同名源，那会把令牌明文写进用户级 NuGet 配置。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="zeller" value="https://zeller.jfrog.io/artifactory/api/nuget/v3/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="zeller">
      <package pattern="Zeller.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
