<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.CustomerDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              mc:Ignorable="d"
               d:DesignHeight="688"
               d:DesignWidth="1366"
               UseLayoutRounding="True"
               SnapsToDevicePixels="True"
               Background="{StaticResource PosCustomerDisplayBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="CustomerDisplayHeaderBaseStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PosCustomerDisplaySurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PosCustomerDisplayMutedTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource PosCustomerDisplayDividerBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CustomerDisplayHeaderLeftStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CustomerDisplayHeaderBaseStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="CustomerDisplayHeaderCenterStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CustomerDisplayHeaderBaseStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CustomerDisplayHeaderRightStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CustomerDisplayHeaderBaseStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <Style x:Key="CustomerDisplayCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PosCustomerDisplayTextBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource PosCustomerDisplayDividerBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <!-- 服务徽标：收银时放在汇总栏（不压住竖屏广告），空闲全屏广告时放在广告右下角；两处共用这一个模板。
             有收银员：首字母头像 + 「Served by 名字」+ 小字终端号；未登录或紧急授权：显示器图标 + 终端号。 -->
        <DataTemplate x:Key="CustomerDisplayServedByBadgeTemplate">
            <Border Background="#B309111F"
                    BorderBrush="{StaticResource PosCustomerDisplayDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Padding" Value="16,12" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCashier}" Value="True">
                                <Setter Property="Padding" Value="10,10,16,10" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="18"
                            Margin="0,0,10,0"
                            Background="{StaticResource PosCustomerDisplayAccentBrush}"
                            Visibility="{Binding HasCashier, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CashierInitial}"
                                   Foreground="{StaticResource PosCustomerDisplayBackgroundBrush}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <materialDesign:PackIcon Kind="Monitor" Width="22" Height="22" Foreground="{StaticResource PosCustomerDisplayTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCashier}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PosCustomerDisplayTextBrush}"
                                   Visibility="{Binding HasCashier, Converter={StaticResource BoolToVis}}">
                            <Run Text="{loc:Loc customer.servedBy}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontWeight="SemiBold" />
                            <Run Text="{Binding CashierFirstName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding TerminalName}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource PosCustomerDisplayTextBrush}" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCashier}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource PosCustomerDisplayMutedTextBrush}" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                            <Setter Property="Margin" Value="0,2,0,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 汇总栏里的紧凑版服务徽标（单行，高约 32px）：汇总栏可用高度只有约 98px，原尺寸徽标放不下。
             内容与大徽标一致：有收银员显示首字母头像 +「Served by 名字」+ 小字终端号，否则显示器图标 + 终端号。 -->
        <DataTemplate x:Key="CustomerDisplayServedByCompactBadgeTemplate">
            <Border Background="#B309111F"
                    BorderBrush="{StaticResource PosCustomerDisplayDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Padding" Value="12,3" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCashier}" Value="True">
                                <Setter Property="Padding" Value="3,3,14,3" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24"
                            Height="24"
                            CornerRadius="12"
                            Margin="0,0,8,0"
                            Background="{StaticResource PosCustomerDisplayAccentBrush}"
                            Visibility="{Binding HasCashier, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding CashierInitial}"
                                   Foreground="{StaticResource PosCustomerDisplayBackgroundBrush}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <materialDesign:PackIcon Kind="Monitor" Width="18" Height="18" Foreground="{StaticResource PosCustomerDisplayTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCashier}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <TextBlock FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource PosCustomerDisplayTextBrush}"
                               Visibility="{Binding HasCashier, Converter={StaticResource BoolToVis}}">
                        <Run Text="{loc:Loc customer.servedBy}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontWeight="SemiBold" />
                        <Run Text="{Binding CashierFirstName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding TerminalName}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource PosCustomerDisplayTextBrush}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCashier}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource PosCustomerDisplayMutedTextBrush}" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Setter Property="Margin" Value="8,0,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform"
             StretchDirection="Both"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
        <!-- 画布高度固定 768，宽度在代码中随宿主宽高比调整（4:3 → 1024、16:10 → 1229、16:9 及更宽 1366），常见客显屏都能铺满。 -->
        <Grid x:Name="DesignCanvas"
              Width="1366"
              Height="768"
              Margin="0"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              Background="{StaticResource PosCustomerDisplayBackgroundBrush}">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="SummaryRow" Height="152" />
                </Grid.RowDefinitions>

        <Grid x:Name="ContentGrid" Grid.Row="0" SizeChanged="ContentGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PromotionBannerRow" Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CartColumn" Width="60*" MinWidth="0" />
                <ColumnDefinition x:Name="PromotionColumn" Width="40*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CartPanel"
                    Grid.Row="1"
                    Grid.Column="0"
                    Background="{StaticResource PosCustomerDisplayBackgroundBrush}"
                    BorderBrush="{StaticResource PosCustomerDisplayDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <DataGrid x:Name="LineDataGrid"
                          ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          Background="{StaticResource PosCustomerDisplayBackgroundBrush}"
                          Foreground="{StaticResource PosCustomerDisplayTextBrush}"
                          RowBackground="{StaticResource PosCustomerDisplayBackgroundBrush}"
                          AlternatingRowBackground="{StaticResource PosCustomerDisplaySurfaceBrush}"
                          RowHeight="72"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          CellStyle="{StaticResource CustomerDisplayCellStyle}"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource PosCartDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Loc ItemDescription}" Width="*" HeaderStyle="{StaticResource CustomerDisplayHeaderLeftStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,6,8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="52"
                                                Height="52"
                                                Margin="0,0,12,0"
                                                Background="{StaticResource PosCustomerDisplayAccentSurfaceBrush}"
                                                BorderBrush="{StaticResource PosCustomerDisplayDividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True"
                                                UseLayoutRounding="True"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Rectangle RadiusX="5"
                                                           RadiusY="5"
                                                           Margin="2"
                                                           SnapsToDevicePixels="True"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Panel.ZIndex="1">
                                                    <Rectangle.Fill>
                                                        <ImageBrush converters:ProductThumbnailImageSourceConverter.AsyncSourceText="{Binding ProductImage}"
                                                                    converters:ProductThumbnailImageSourceConverter.AsyncDecodePixelWidth="72"
                                                                    Stretch="Uniform" />
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <materialDesign:PackIcon Kind="Shopping"
                                                                         Width="22"
                                                                         Height="22"
                                                                         Foreground="{StaticResource PosCustomerDisplayAccentBrush}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Panel.ZIndex="0" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource PosCustomerDisplayTextBrush}"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MaxWidth="210">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasItemNumber}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}"
                                                               FontSize="12"
                                                               MaxWidth="185"
                                                               ToolTip="{Binding ItemNumber}"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{loc:Loc ItemNumber}" />
                                                        <Run Text=" " />
                                                        <Run Text="{Binding ItemNumber}" />
                                                    </TextBlock>
                                                    <Border Width="1"
                                                            Height="12"
                                                            Margin="10,0"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource PosCustomerDisplayDividerBrush}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LookupCode}"
                                                           Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Loc Quantity}" Width="96" HeaderStyle="{StaticResource CustomerDisplayHeaderCenterStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Padding="10,4"
                                            Background="{StaticResource PosCustomerDisplayAccentSurfaceBrush}"
                                            BorderBrush="{StaticResource PosCustomerDisplayAccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <TextBlock Text="{Binding QuantityDisplay, Mode=OneWay}" Foreground="{StaticResource PosCustomerDisplayAccentBrush}" FontSize="16" FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Loc Price}" Width="116" HeaderStyle="{StaticResource CustomerDisplayHeaderRightStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:C2}}" Foreground="{StaticResource PosCustomerDisplayTextBrush}" Margin="0,0,12,0" FontSize="17" HorizontalAlignment="Stretch" TextAlignment="Right" />
                                        <TextBlock Text="{Binding DiscountRateText}" Foreground="{StaticResource PosCustomerDisplayAccentBrush}" Margin="0,2,12,0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Stretch" TextAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{loc:Loc Total}" Width="126" HeaderStyle="{StaticResource CustomerDisplayHeaderRightStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GrossAmount, StringFormat={}{0:C2}}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" Margin="0,0,12,1" FontSize="13" HorizontalAlignment="Stretch" TextAlignment="Right" TextDecorations="Strikethrough">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ActualAmount, StringFormat={}{0:C2}}" Margin="0,0,12,0" FontSize="19" HorizontalAlignment="Stretch" TextAlignment="Right" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource PosCustomerDisplayTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource PosCustomerDisplayAccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border x:Name="PromotionPanel"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="18,0,0,0"
                    Background="{StaticResource PosCustomerDisplaySurfaceBrush}"
                    BorderBrush="{StaticResource PosCustomerDisplayDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    ClipToBounds="True">
                <Grid>
                    <Rectangle Fill="{StaticResource PosCustomerDisplaySurfaceBrush}" />
                    <Rectangle x:Name="PromotionFallbackBackground" Fill="{StaticResource PosCustomerDisplayBackgroundBrush}" />
                    <Image x:Name="AdvertisementImage"
                           Stretch="Uniform"
                           Visibility="Collapsed"
                           ImageFailed="AdvertisementImage_ImageFailed" />
                    <!-- 视频播放器由代码按条新建、播完销毁（见 CustomerDisplayView.StartVideoPlayer），这里只占图层位置。 -->
                    <Border x:Name="AdvertisementVideoHost"
                            Visibility="Collapsed" />
                    <Rectangle Opacity="0.18" Fill="#FF000000" />
                    <!-- 空闲全屏广告时徽标仍叠在广告右下角；有商品时徽标挪到汇总栏，不再压住右侧竖屏广告。 -->
                    <ContentControl HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,28,28"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource CustomerDisplayServedByBadgeTemplate}"
                                    Visibility="{Binding IsIdleAdvertisementVisible, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="SummaryPanel"
                Grid.Row="1"
                Margin="0,20,0,0"
                Padding="24,16"
                Background="{StaticResource PosCustomerDisplaySurfaceBrush}"
                BorderBrush="{StaticResource PosCustomerDisplayDividerBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 第一行：左侧件数 / SKU 数，右端服务徽标（紧凑版）。空闲全屏广告时汇总栏整体隐藏，徽标改叠在广告上。 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc customer.itemQuantity}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalItemQuantity, StringFormat={}{0:0.##}}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="15" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="3" Text="{loc:Loc customer.skuCount}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{Binding SkuCount}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="15" Margin="8,0,0,0" />
                        </Grid>

                        <Viewbox Grid.Column="1"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Margin="12,0,0,4"
                                 MaxHeight="34"
                                 Stretch="Uniform"
                                 StretchDirection="DownOnly">
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource CustomerDisplayServedByCompactBadgeTemplate}" />
                        </Viewbox>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc Subtotal}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <Viewbox MaxHeight="38" StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Subtotal, StringFormat={}{0:C2}}" Foreground="{StaticResource PosCustomerDisplayTextBrush}" FontSize="28" FontWeight="Black" />
                            </Viewbox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Loc Tax}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <Viewbox MaxHeight="38" StretchDirection="DownOnly">
                                <TextBlock Text="{Binding TaxAmount, StringFormat={}{0:C2}}" Foreground="{StaticResource PosCustomerDisplayTextBrush}" FontSize="28" FontWeight="Black" />
                            </Viewbox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSavings}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{loc:Loc Savings}" Foreground="{StaticResource PosCustomerDisplayMutedTextBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <Viewbox MaxHeight="38" StretchDirection="DownOnly">
                                <TextBlock Text="{Binding SavingsAmount, StringFormat=-{0:C2}}" Foreground="{StaticResource PosCustomerDisplayTextBrush}" FontSize="28" FontWeight="Black" />
                            </Viewbox>
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc customer.totalToPay}" Foreground="{StaticResource PosCustomerDisplayTextBrush}" FontSize="16" FontWeight="Black" HorizontalAlignment="Right" />
                    <Viewbox MaxWidth="200" MaxHeight="68" HorizontalAlignment="Right" StretchDirection="DownOnly">
                        <TextBlock Text="{Binding TotalToPay, StringFormat={}{0:C2}}" Foreground="{StaticResource PosCustomerDisplayAmountBrush}" FontSize="62" FontWeight="Black" />
                    </Viewbox>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{StaticResource PosCustomerDisplayAccentSurfaceBrush}"
                        BorderBrush="{StaticResource PosCustomerDisplayAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc customer.readyForPayment}" Foreground="{StaticResource PosCustomerDisplayAccentBrush}" FontSize="18" FontWeight="Black" />
                        <TextBlock Text="{loc:Loc customer.insertOrTap}" Foreground="{StaticResource PosCustomerDisplayTextBrush}" FontSize="15" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            </Border>
        </Grid>
        </Grid>
