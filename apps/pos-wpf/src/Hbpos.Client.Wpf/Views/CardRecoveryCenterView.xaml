<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Class="Hbpos.Client.Wpf.Views.CardRecoveryCenterView"
             Background="{DynamicResource PosScreenBackgroundBrush}"
             Loaded="CardRecoveryCenterView_OnLoaded"
             Unloaded="CardRecoveryCenterView_OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ===== 文字 ===== -->
        <Style x:Key="RecoveryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RecoveryCaps" TargetType="TextBlock" BasedOn="{StaticResource RecoveryLabel}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RecoveryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RecoveryMono" TargetType="TextBlock" BasedOn="{StaticResource RecoveryValue}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- ===== 带图标按钮：Content 仍是本地化文字，图标名放在 Tag ===== -->
        <DataTemplate x:Key="RecoveryIconContentTemplate">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                         Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"
                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="RecoveryPrimaryIconButton" TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource RecoveryIconContentTemplate}"/>
            <Setter Property="Padding" Value="24,8"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style x:Key="RecoverySecondaryIconButton" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource RecoveryIconContentTemplate}"/>
            <Setter Property="Padding" Value="22,8"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style x:Key="RecoveryChipButton" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="14.5"/>
        </Style>
        <Style x:Key="RecoveryCopyButton" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== 状态页签与分段筛选（单选按钮） ===== -->
        <Style x:Key="RecoveryTab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="RecoveryCategory"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="MinWidth" Value="168"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PosTextSecondaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="18,0">
                            <Grid>
                                <Border x:Name="Underline" Height="3" VerticalAlignment="Bottom" Margin="-18,0" CornerRadius="0,0,10,10" Background="{DynamicResource PosPrimaryBrush}" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PosPrimaryStrongBrush}"/>
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecoveryCountBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}"/>
        </Style>
        <Style x:Key="RecoverySegment" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PosTextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="9" Margin="2">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PosSurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 列表卡片 ===== -->
        <Style x:Key="RecoveryListItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="96"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="14" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态色调：列表行绑定 Tone，详情绑定 SelectedTone；两套样式颜色一致。 -->
        <Style x:Key="RowPillBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="11,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Background" Value="{DynamicResource PosWarningSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosWarningBorderBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Danger"><Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosDangerBorderBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosSuccessBorderBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowToneText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowToneRail" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosBorderStrongBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="Info"><Setter Property="Background" Value="{DynamicResource PosPrimaryBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Background" Value="{DynamicResource PosWarningBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Danger"><Setter Property="Background" Value="{DynamicResource PosDangerBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Background" Value="{DynamicResource PosSuccessBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowToneIconTile" TargetType="Border" BasedOn="{StaticResource RowPillBorder}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="DetailPillBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource PosSurfaceMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Info"><Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosPrimarySoftBorderBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Warning"><Setter Property="Background" Value="{DynamicResource PosWarningSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosWarningBorderBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Danger"><Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosDangerBorderBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Success"><Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource PosSuccessBorderBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailToneText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Info"><Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedTone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailToneIconTile" TargetType="Border" BasedOn="{StaticResource DetailPillBorder}">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ===== 详情块 ===== -->
        <Style x:Key="RecoveryFieldCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="MinHeight" Value="74"/>
        </Style>
        <Style x:Key="RecoveryExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <DockPanel>
                                <!-- 整行可点：开关铺满标题行，标题内容叠在上面且不拦截点击。 -->
                                <Grid DockPanel.Dock="Top" MinHeight="60">
                                    <ToggleButton Style="{x:Null}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Padding="18,0">
                                                    <materialDesign:PackIcon x:Name="Chevron" Kind="ChevronRight" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource PosTextSecondaryBrush}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="Kind" Value="ChevronDown"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter ContentSource="Header" Margin="18,0,56,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                                <ContentPresenter x:Name="Body" Margin="18,0,18,16" Visibility="Collapsed"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 人工核对结果卡片：Content 是结果名称，Tag 是说明 ===== -->
        <Style x:Key="RecoveryOutcomeTile" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="14" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="16.5" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,6,0,0" FontSize="13.5" FontWeight="Normal" Foreground="{DynamicResource PosTextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecoveryStepNumber" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="{DynamicResource PosInverseSurfaceBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="24,18,24,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 页头 -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc cardRecovery.center.title}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}"/>
                    <TextBlock Text="{loc:Loc cardRecovery.workspace.subtitle}" Margin="0,4,0,0" Style="{StaticResource RecoveryLabel}"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="{loc:Loc cardRecovery.center.action.refresh}" Tag="Refresh" Style="{StaticResource RecoverySecondaryIconButton}" MinHeight="56" MinWidth="140" Margin="12,0"/>
                <Button Grid.Column="2" Command="{Binding BackCommand}" Content="{loc:Loc cardRecovery.workspace.back}" Tag="ChevronLeft" Style="{StaticResource RecoveryPrimaryIconButton}" MinHeight="56" MinWidth="220"/>
            </Grid>

            <!-- 状态页签 -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,14">
                <RadioButton Style="{StaticResource RecoveryTab}" Command="{Binding FilterCommand}" CommandParameter="pending" IsChecked="{Binding IsPendingFilter, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource PosWarningBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc cardRecovery.workspace.pending}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource RecoveryCountBadge}" Background="{DynamicResource PosWarningStrongBrush}">
                            <TextBlock Text="{Binding PendingCount}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource RecoveryTab}" Command="{Binding FilterCommand}" CommandParameter="review" IsChecked="{Binding IsReviewFilter, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource PosDangerBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc cardRecovery.workspace.review}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource RecoveryCountBadge}">
                            <TextBlock Text="{Binding ReviewCount}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource RecoveryTab}" Command="{Binding FilterCommand}" CommandParameter="failed" IsChecked="{Binding IsFailedFilter, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource PosBorderStrongBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc cardRecovery.workspace.failed}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource RecoveryCountBadge}">
                            <TextBlock Text="{Binding FailedCount}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource RecoveryTab}" Command="{Binding FilterCommand}" CommandParameter="resolved" IsChecked="{Binding IsResolvedFilter, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource PosSuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc cardRecovery.workspace.resolved}" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource RecoveryCountBadge}">
                            <TextBlock Text="{Binding ResolvedCount}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
            </WrapPanel>

            <!-- 主从布局 -->
            <Grid Grid.Row="2" x:Name="RecoveryMasterDetailGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*" MinWidth="320"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.5*" MinWidth="480"/>
                </Grid.ColumnDefinitions>

                <!-- 列表 -->
                <Border Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc cardRecovery.workspace.search}" AutomationProperties.Name="{loc:Loc cardRecovery.workspace.search}" MinHeight="56" Padding="44,0,12,0" VerticalContentAlignment="Center" FontSize="16" Style="{StaticResource PosSearchTextBoxStyle}"/>
                            <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{DynamicResource PosMutedForegroundBrush}"/>
                            <TextBlock Text="{loc:Loc cardRecovery.workspace.search}" Margin="46,0,12,0" VerticalAlignment="Center" FontSize="15" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PosSubtleForegroundBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource PosSurfaceMutedBrush}" CornerRadius="12" Padding="2">
                                <UniformGrid Rows="1">
                                    <RadioButton GroupName="RecoveryChannel" Style="{StaticResource RecoverySegment}" Content="{loc:Loc cardRecovery.v2.channelAll}" IsChecked="{Binding IsChannelAll}" AutomationProperties.Name="{loc:Loc cardRecovery.workspace.channel}"/>
                                    <RadioButton GroupName="RecoveryChannel" Style="{StaticResource RecoverySegment}" Content="{loc:Loc cardRecovery.center.channel.square}" IsChecked="{Binding IsChannelSquare}"/>
                                    <RadioButton GroupName="RecoveryChannel" Style="{StaticResource RecoverySegment}" Content="{loc:Loc cardRecovery.center.channel.linkly}" IsChecked="{Binding IsChannelLinkly}"/>
                                </UniformGrid>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource PosSurfaceMutedBrush}" CornerRadius="12" Padding="2">
                                <UniformGrid Rows="1">
                                    <RadioButton GroupName="RecoveryOperation" Style="{StaticResource RecoverySegment}" Content="{loc:Loc cardRecovery.v2.typeAll}" IsChecked="{Binding IsOperationAll}" AutomationProperties.Name="{loc:Loc cardRecovery.workspace.operations}"/>
                                    <RadioButton GroupName="RecoveryOperation" Style="{StaticResource RecoverySegment}" Content="{loc:Loc cardRecovery.v2.typeSale}" IsChecked="{Binding IsOperationSale}"/>
                                    <RadioButton GroupName="RecoveryOperation" Style="{StaticResource RecoverySegment}" Content="{loc:Loc cardRecovery.v2.typeRefund}" IsChecked="{Binding IsOperationRefund}"/>
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding ListCountText}" Style="{StaticResource RecoveryCaps}" Margin="4,14,0,8"/>
                        <Grid Grid.Row="3">
                            <ListBox x:Name="OpenAttemptsList" ItemsSource="{Binding OpenAttemptRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" ItemContainerStyle="{StaticResource RecoveryListItemStyle}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.PanningMode="VerticalOnly">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,14,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource RowToneRail}" CornerRadius="12,0,0,12" Margin="-1.5,-1.5,0,-1.5"/>
                                            <Border Grid.Column="1" Style="{StaticResource RowToneIconTile}" Margin="12,0,12,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="CreditCardOutline"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRefund}" Value="True"><Setter Property="Kind" Value="CashRefund"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Neutral"><Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Border>
                                            <!-- 标题与金额同一行；单号时间、状态各占一行，窄屏也不截断状态。 -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,12">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" Margin="10,0,0,0"/>
                                                    <TextBlock Text="{Binding OperationTypeText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding MetaText}" ToolTip="{Binding OrderText}" Style="{StaticResource RecoveryLabel}" FontSize="13.5" Margin="0,3,0,8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                <Border Style="{StaticResource RowPillBorder}">
                                                    <TextBlock Text="{Binding StatusPillText}" Style="{StaticResource RowToneText}" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{loc:Loc cardRecovery.workspace.empty}" Style="{StaticResource RecoveryLabel}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoOpenAttempts, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <Border Grid.Row="4" Background="{DynamicResource PosSurfaceAltBrush}" Padding="12" Margin="0,10,0,0" CornerRadius="12">
                            <DockPanel>
                                <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Margin="0,1,10,0" Foreground="{DynamicResource PosMutedForegroundBrush}"/>
                                <!-- 收款安全提示已在右侧详情的警示条中显示，这里只保留历史范围说明。 -->
                                <TextBlock Text="{loc:Loc cardRecovery.workspace.historyScope}" Style="{StaticResource RecoveryLabel}" FontSize="13"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 详情 -->
                <Border Grid.Column="2" Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="1" CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.RowSpan="2" Text="{loc:Loc cardRecovery.center.detail.empty}" Style="{StaticResource RecoveryLabel}" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ScrollViewer x:Name="DetailScrollViewer" PanningMode="VerticalOnly" Style="{StaticResource PosVerticalTouchScrollViewerStyle}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="24,22,24,16">
                                <!-- 头部：类型、单号、金额、状态 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource DetailToneIconTile}" VerticalAlignment="Top" Margin="0,0,16,0">
                                        <materialDesign:PackIcon Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="CreditCardOutline"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelectedRefund}" Value="True"><Setter Property="Kind" Value="CashRefund"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedTone}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedTone}" Value="Danger"><Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedTone}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SelectedTitleText}" Style="{StaticResource RecoveryCaps}"/>
                                        <TextBlock Text="{Binding SelectedHeadlineText}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{loc:Loc cardRecovery.v2.copy}" Tag="{Binding SelectedOrderText}" Click="CopyButton_OnClick" Style="{StaticResource RecoveryCopyButton}"/>
                                            <TextBlock Text="{Binding SelectedOrderText}" ToolTip="{Binding SelectedOrderText}" Style="{StaticResource RecoveryMono}" FontWeight="Normal" Foreground="{DynamicResource PosTextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="20,0,0,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SelectedAmountText}" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" HorizontalAlignment="Right"/>
                                        <Border Style="{StaticResource DetailPillBorder}" HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding SelectedStatusPillText}" Style="{StaticResource DetailToneText}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- 安全提示 -->
                                <Border Margin="0,18,0,0" Padding="16,14" CornerRadius="14" BorderThickness="1.5" Background="{DynamicResource PosWarningSoftBrush}" BorderBrush="{DynamicResource PosWarningBorderBrush}" Visibility="{Binding ShowSafetyBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <materialDesign:PackIcon Kind="AlertOutline" Width="26" Height="26" Margin="0,0,14,0" VerticalAlignment="Top" Foreground="{DynamicResource PosWarningStrongBrush}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SafetyBannerTitleText}" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource PosWarningTextBrush}"/>
                                            <TextBlock Text="{Binding SafetyBannerBodyText}" FontSize="14.5" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource PosWarningTextBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- 进度：已提交 → 当前状态 → 完成 -->
                                <Grid Margin="0,22,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.ColumnSpan="3" Margin="0,18,0,0" VerticalAlignment="Top" Height="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="1" Background="{DynamicResource PosSuccessBrush}" CornerRadius="2"/>
                                        <Border Grid.Column="2" CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PosDividerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFinalStepDone}" Value="True"><Setter Property="Background" Value="{DynamicResource PosSuccessBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource PosSuccessBrush}">
                                            <materialDesign:PackIcon Kind="Check" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{loc:Loc cardRecovery.v2.step.submitted}" Style="{StaticResource RecoveryValue}" FontSize="15" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding StepSubmittedTimeText}" Style="{StaticResource RecoveryLabel}" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="20" BorderThickness="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PosSuccessBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PosSuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFinalStepPending}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PosWarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <TextBlock Text="2" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PosWarningTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsFinalStepPending, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <materialDesign:PackIcon Kind="Check" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFinalStepPending}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedStatusPillText}" Style="{StaticResource RecoveryValue}" FontSize="15" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding StepCurrentTimeText}" Style="{StaticResource RecoveryLabel}" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="20" BorderThickness="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFinalStepDone}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PosSuccessBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PosSuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFinalStepFailed}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PosDangerBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <TextBlock Text="3" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PosMutedForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsFinalStepPending, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <materialDesign:PackIcon Kind="Check" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsFinalStepDone, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <materialDesign:PackIcon Kind="Close" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsFinalStepFailed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding StepFinalLabelText}" Style="{StaticResource RecoveryValue}" FontSize="15" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding StepFinalTimeText}" Style="{StaticResource RecoveryLabel}" FontSize="13" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 关键字段 -->
                                <UniformGrid Columns="3" Margin="0,16,-10,0">
                                    <Border Style="{StaticResource RecoveryFieldCard}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc cardRecovery.center.field.channel}" Style="{StaticResource RecoveryCaps}"/>
                                            <TextBlock Text="{Binding SelectedChannelText}" Style="{StaticResource RecoveryValue}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource RecoveryFieldCard}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc cardRecovery.center.field.time}" Style="{StaticResource RecoveryCaps}"/>
                                            <TextBlock Text="{Binding SelectedTimeText}" Style="{StaticResource RecoveryValue}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource RecoveryFieldCard}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc cardRecovery.v2.field.cashier}" Style="{StaticResource RecoveryCaps}"/>
                                            <TextBlock Text="{Binding SelectedCashierNameText}" Style="{StaticResource RecoveryValue}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource RecoveryFieldCard}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc cardRecovery.center.field.txn}" Style="{StaticResource RecoveryCaps}"/>
                                            <DockPanel Margin="0,4,0,0">
                                                <Button DockPanel.Dock="Right" Content="{loc:Loc cardRecovery.v2.copy}" Tag="{Binding SelectedTxnText}" Click="CopyButton_OnClick" Style="{StaticResource RecoveryCopyButton}"/>
                                                <TextBlock Text="{Binding SelectedTxnText}" ToolTip="{Binding SelectedTxnText}" Style="{StaticResource RecoveryMono}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource RecoveryFieldCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc cardRecovery.center.field.responseCode}" Style="{StaticResource RecoveryCaps}"/>
                                            <TextBlock Text="{Binding SelectedResponseCodeText}" Style="{StaticResource RecoveryValue}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 折叠：商品、交易详情、操作记录 -->
                                <Expander Style="{StaticResource RecoveryExpander}" Margin="0,4,0,10">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource PosTextSecondaryBrush}"/>
                                            <TextBlock Text="{loc:Loc cardRecovery.v2.products}" Style="{StaticResource RecoveryValue}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedProductSummaryText}" Style="{StaticResource RecoveryLabel}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding SelectedProductLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,6">
                                                        <TextBlock Text="{Binding Quantity, StringFormat='× {0}'}" DockPanel.Dock="Right" Style="{StaticResource RecoveryValue}" FontSize="15"/>
                                                        <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource PosTextBrush}"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{loc:Loc cardRecovery.v2.noProducts}" Style="{StaticResource RecoveryLabel}" Visibility="{Binding HasNoProductSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Style="{StaticResource RecoveryExpander}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CardSearchOutline" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource PosTextSecondaryBrush}"/>
                                            <TextBlock Text="{loc:Loc cardRecovery.v2.details}" Style="{StaticResource RecoveryValue}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{loc:Loc cardRecovery.center.field.type}" Style="{StaticResource RecoveryCaps}" Margin="0,6"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedTypeText}" Style="{StaticResource RecoveryValue}" FontSize="15" Margin="0,6"/>
                                        <TextBlock Grid.Row="1" Text="{loc:Loc cardRecovery.center.field.responseText}" Style="{StaticResource RecoveryCaps}" Margin="0,6"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedResponseText}" Style="{StaticResource RecoveryValue}" FontSize="15" Margin="0,6"/>
                                        <TextBlock Grid.Row="2" Text="{loc:Loc cardRecovery.center.field.session}" Style="{StaticResource RecoveryCaps}" Margin="0,6"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSessionText}" Style="{StaticResource RecoveryMono}" Margin="0,6"/>
                                        <TextBlock Grid.Row="3" Text="{loc:Loc cardRecovery.center.field.attempt}" Style="{StaticResource RecoveryCaps}" Margin="0,6"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedAttemptText}" Style="{StaticResource RecoveryMono}" Margin="0,6"/>
                                        <TextBlock Grid.Row="4" Text="{loc:Loc cardRecovery.v2.field.cashierId}" Style="{StaticResource RecoveryCaps}" Margin="0,6"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedCashierText}" Style="{StaticResource RecoveryMono}" Margin="0,6"/>
                                        <TextBlock Grid.Row="5" Text="{loc:Loc cardRecovery.center.field.environment}" Style="{StaticResource RecoveryCaps}" Margin="0,6"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedEnvironmentText}" Style="{StaticResource RecoveryValue}" FontSize="15" Margin="0,6"/>
                                    </Grid>
                                </Expander>
                                <Expander Style="{StaticResource RecoveryExpander}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ClockOutline" Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource PosTextSecondaryBrush}"/>
                                            <TextBlock Text="{loc:Loc cardRecovery.workspace.history}" Style="{StaticResource RecoveryValue}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding SelectedHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource RecoveryLabel}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource RecoveryValue}" FontSize="14.5" FontWeight="Normal"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <TextBlock Text="{loc:Loc cardRecovery.workspace.readOnly}" Style="{StaticResource RecoveryLabel}" FontSize="15" Margin="0,8" Visibility="{Binding IsHistorySelection, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding RecoveryOnlyGuidanceMessage}" Style="{StaticResource RecoveryLabel}" FontSize="14.5" Margin="0,8" Visibility="{Binding CanShowRecoveryOnlyGuidance, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 固定操作栏：自动检查倒计时 + 人工核对 + 立即检查 -->
                        <Border Grid.Row="1" Background="{DynamicResource PosSurfaceAltBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="24,14" Visibility="{Binding SelectedAttempt.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DockPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                    <materialDesign:PackIcon Kind="Autorenew" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource PosPrimaryTextBrush}" Visibility="{Binding IsAutoCheckActive, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding AutoCheckText}" Style="{StaticResource RecoveryLabel}" FontSize="14.5" Foreground="{DynamicResource PosTextSecondaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Button Grid.Column="1" Command="{Binding OpenManualCommand}" Content="{loc:Loc cardRecovery.v2.action.manual}" Tag="LockOutline" Style="{StaticResource RecoverySecondaryIconButton}" MinHeight="64" Margin="0,0,12,0"/>
                                <Button Grid.Column="2" Command="{Binding RecoverCommand}" Content="{loc:Loc cardRecovery.v2.action.checkNow}" Tag="Refresh" Style="{StaticResource RecoveryPrimaryIconButton}" MinHeight="64" MinWidth="220"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 底部状态 -->
            <Grid Grid.Row="3" Margin="2,10,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource RecoveryLabel}" FontSize="13.5"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="{loc:Loc cardRecovery.workspace.refreshed}" Style="{StaticResource RecoveryLabel}" FontSize="13.5"/>
                    <TextBlock Text="{Binding LastRefreshText}" Style="{StaticResource RecoveryLabel}" FontSize="13.5" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== 人工核对侧滑面板 ===== -->
        <Grid Visibility="{Binding IsManualExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{DynamicResource PosInverseSurfaceBrush}" Opacity="0.45">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseManualCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border HorizontalAlignment="Right" Width="760" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" Background="{DynamicResource PosSurfaceBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="0,0,0,1" Padding="26,20,20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ResolutionSectionTitleText}" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" TextWrapping="Wrap"/>
                                <Border HorizontalAlignment="Left" Margin="0,8,0,0" CornerRadius="14" Padding="11,3" BorderThickness="1" Background="{DynamicResource PosWarningSoftBrush}" BorderBrush="{DynamicResource PosWarningBorderBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LockOutline" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource PosWarningTextBrush}"/>
                                        <TextBlock Text="{loc:Loc cardRecovery.v2.sheet.supervisorRequired}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PosWarningTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CloseManualCommand}" Content="{loc:Loc cardRecovery.v2.action.close}" Tag="Close" Style="{StaticResource RecoverySecondaryIconButton}" MinHeight="56" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" PanningMode="VerticalOnly" Style="{StaticResource PosVerticalTouchScrollViewerStyle}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="26,18,26,18">
                            <!-- 交易摘要 -->
                            <Border Background="{DynamicResource PosSurfaceAltBrush}" CornerRadius="12" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedTitleText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}"/>
                                        <TextBlock Text="{Binding SelectedOrderText}" Style="{StaticResource RecoveryLabel}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedAmountText}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding ResolutionInstructionsText}" Style="{StaticResource RecoveryLabel}" FontSize="14.5" Margin="0,14,0,0"/>

                            <!-- 第 1 步：证据 -->
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,10">
                                <Border Style="{StaticResource RecoveryStepNumber}">
                                    <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{loc:Loc cardRecovery.v2.sheet.step.evidence}" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <WrapPanel Margin="0,0,0,4">
                                <Button Command="{Binding ApplyEvidencePresetCommand}" CommandParameter="squareDashboard" Content="{loc:Loc cardRecovery.v2.evidence.squareDashboard}" Style="{StaticResource RecoveryChipButton}"/>
                                <Button Command="{Binding ApplyEvidencePresetCommand}" CommandParameter="terminalReceipt" Content="{loc:Loc cardRecovery.v2.evidence.terminalReceipt}" Style="{StaticResource RecoveryChipButton}"/>
                                <Button Command="{Binding ApplyEvidencePresetCommand}" CommandParameter="bankStatement" Content="{loc:Loc cardRecovery.v2.evidence.bankStatement}" Style="{StaticResource RecoveryChipButton}"/>
                            </WrapPanel>
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="{Binding ResolutionReferenceLabelText}" Style="{StaticResource RecoveryLabel}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ResolutionReference, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ResolutionReferenceLabelText}" MinHeight="56" FontSize="16" VerticalContentAlignment="Center" TextWrapping="Wrap" Style="{StaticResource PosSearchTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="{Binding ResolutionEvidenceLabelText}" Style="{StaticResource RecoveryLabel}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ResolutionEvidence, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ResolutionEvidenceLabelText}" MinHeight="56" FontSize="16" VerticalContentAlignment="Center" TextWrapping="Wrap" Style="{StaticResource PosSearchTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="{Binding ResolutionReasonLabelText}" Style="{StaticResource RecoveryLabel}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ResolutionReason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding ResolutionReasonLabelText}" MinHeight="72" FontSize="16" VerticalContentAlignment="Top" Padding="12,10" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource PosSearchTextBoxStyle}"/>
                            </StackPanel>

                            <!-- 第 2 步：选择结果（每个结果都会请求主管扫码授权） -->
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,4">
                                <Border Style="{StaticResource RecoveryStepNumber}">
                                    <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{loc:Loc cardRecovery.v2.sheet.step.outcome}" FontSize="16.5" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc cardRecovery.v2.sheet.outcomeHint}" Style="{StaticResource RecoveryLabel}" Margin="38,0,0,12"/>
                            <UniformGrid Columns="3" Margin="0,0,-10,0">
                                <Button Command="{Binding ConfirmPaidCommand}" Content="{Binding ConfirmProcessedText}" Tag="{Binding ProcessedOutcomeHintText}" Style="{StaticResource RecoveryOutcomeTile}" MinHeight="128" Background="{DynamicResource PosSuccessSoftBrush}" BorderBrush="{DynamicResource PosSuccessBorderBrush}" Foreground="{DynamicResource PosSuccessTextBrush}"/>
                                <Button Command="{Binding ConfirmNotPaidCommand}" Content="{Binding ConfirmNotProcessedText}" Tag="{Binding NotProcessedOutcomeHintText}" Style="{StaticResource RecoveryOutcomeTile}" MinHeight="128"/>
                                <Button Command="{Binding ContinueWaitingCommand}" Content="{loc:Loc cardRecovery.center.action.continueWaiting}" Tag="{Binding WaitingOutcomeHintText}" Style="{StaticResource RecoveryOutcomeTile}" MinHeight="128"/>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{DynamicResource PosSurfaceAltBrush}" BorderBrush="{DynamicResource PosDividerBrush}" BorderThickness="0,1,0,0" Padding="26,14">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource PosMutedForegroundBrush}"/>
                            <TextBlock Text="{loc:Loc cardRecovery.v2.sheet.audit}" Style="{StaticResource RecoveryLabel}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
