<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- 长者模式下支付页的放大尺寸；仅在选中长者主题时追加到应用资源末尾，覆盖标准值。
         只写与标准值不同的键（必须是 Payment.Standard.xaml 键的子集）。 -->
    <sys:String x:Key="PosMetricsElderId">Payment</sys:String>

    <!-- 左列：返回 52/19、件数小标签 16、订单表格字 22/行高 68/表头字 16 高 42 -->
    <sys:Double x:Key="PosPayBackButtonMinHeight">52</sys:Double>
    <sys:Double x:Key="PosPayBackButtonFontSize">19</sys:Double>
    <sys:Double x:Key="PosPayBackIconSize">20</sys:Double>
    <sys:Double x:Key="PosPayItemsLabelFontSize">16</sys:Double>
    <sys:Double x:Key="PosPayCartFontSize">22</sys:Double>
    <sys:Double x:Key="PosPayCartRowHeight">68</sys:Double>
    <sys:Double x:Key="PosPayCartHeaderFontSize">16</sys:Double>
    <sys:Double x:Key="PosPayCartHeaderMinHeight">42</sys:Double>
    <sys:Double x:Key="PosPayCartQtyColumnMinWidth">64</sys:Double>
    <sys:Double x:Key="PosPayCartTotalColumnMinWidth">96</sys:Double>
    <sys:Int32 x:Key="PosPayCartAlternationCount">2</sys:Int32>
    <!-- 汇总：标签 17、值 23、应付标签 20、应付金额 40；灰色衬板与返回按钮浅蓝衬板打开 -->
    <sys:Double x:Key="PosPaySummaryLabelFontSize">17</sys:Double>
    <sys:Double x:Key="PosPaySummaryValueFontSize">23</sys:Double>
    <sys:Double x:Key="PosPayDueLabelFontSize">20</sys:Double>
    <sys:Double x:Key="PosPayDueAmountFontSize">40</sys:Double>
    <sys:Double x:Key="PosPaySummaryPlateOpacity">1</sys:Double>
    <sys:Double x:Key="PosPayBackPlateOpacity">1</sys:Double>
    <sys:Double x:Key="PosPayDueBigLabelFontSize">22</sys:Double>
    <sys:Double x:Key="PosPayDueBigAmountFontSize">52</sys:Double>

    <!-- 中列：待付/找零标签 20、找零金额 46（待付金额 60 不变）、当前支付金额标签 19、输入框字 46/最小高 72、退格 76×72、数字键 42、Clear 26 -->
    <sys:Double x:Key="PosPayAmountLabelFontSize">20</sys:Double>
    <sys:Double x:Key="PosPayChangeAmountFontSize">46</sys:Double>
    <sys:Double x:Key="PosPayChangeIdlePlateOpacity">1</sys:Double>
    <sys:Double x:Key="PosPayTenderLabelFontSize">19</sys:Double>
    <sys:Double x:Key="PosPayTenderInputFontSize">46</sys:Double>
    <sys:Double x:Key="PosPayTenderInputMinHeight">72</sys:Double>
    <!-- 长者：内容区零描边 -->
    <Thickness x:Key="PosPayTenderInputBorderThickness">0</Thickness>
    <sys:Double x:Key="PosPayBackspaceWidth">76</sys:Double>
    <sys:Double x:Key="PosPayBackspaceMinHeight">72</sys:Double>
    <sys:Double x:Key="PosPayBackspaceIconSize">36</sys:Double>
    <sys:Double x:Key="PosPayBackspacePlateOpacity">1</sys:Double>
    <sys:Double x:Key="PosPayKeypadNumberFontSize">42</sys:Double>
    <sys:Double x:Key="PosPayKeypadClearFontSize">26</sys:Double>
    <Thickness x:Key="PosPayClearKeyBorderThickness">0</Thickness>
    <!-- 快捷现金：字号 36、按钮高 84、整行 90（「$」上标随字号略放大） -->
    <sys:Double x:Key="PosPayQuickCashFontSize">36</sys:Double>
    <sys:Double x:Key="PosPayQuickCashDollarFontSize">20</sys:Double>
    <sys:Double x:Key="PosPayQuickCashButtonHeight">84</sys:Double>
    <sys:Double x:Key="PosPayQuickCashRowHeight">90</sys:Double>

    <!-- 右列：支付方式标题 24/方式标签 19；已付款项标题 20/名称 20/金额 24/备注 14；取消 68/20；确认 80/28/图标 26 -->
    <sys:Double x:Key="PosPayMethodTitleFontSize">24</sys:Double>
    <sys:Double x:Key="PosPayMethodLabelFontSize">19</sys:Double>
    <sys:Double x:Key="PosPayTendersTitleFontSize">20</sys:Double>
    <sys:Double x:Key="PosPayTenderNameFontSize">20</sys:Double>
    <sys:Double x:Key="PosPayTenderAmountFontSize">24</sys:Double>
    <sys:Double x:Key="PosPayTenderNoteFontSize">14</sys:Double>
    <sys:Double x:Key="PosPayTenderIconBlockSize">46</sys:Double>
    <sys:Double x:Key="PosPayTenderIconSize">26</sys:Double>
    <sys:Double x:Key="PosPayCancelButtonHeight">68</sys:Double>
    <sys:Double x:Key="PosPayCancelFontSize">20</sys:Double>
    <sys:Double x:Key="PosPayConfirmButtonHeight">80</sys:Double>
    <sys:Double x:Key="PosPayConfirmFontSize">28</sys:Double>
    <sys:Double x:Key="PosPayConfirmIconSize">26</sys:Double>
    <GridLength x:Key="PosPayConfirmIconColumnWidth">34</GridLength>
    <CornerRadius x:Key="PosPayChangePlateCornerRadius">0,7,7,0</CornerRadius>
</ResourceDictionary>
