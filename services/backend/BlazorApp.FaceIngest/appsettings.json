{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "FaceIngest": {
    "CaptureEnabled": false,
    "StorageRootPath": "/app/App_Data/FaceIngest",
    "ConfigDirectory": "/app/config",
    "MaxRequestBodyBytes": 16777216,
    "MaxTotalBytes": 5368709120,
    "MaxFileCount": 100000,
    "MinFreeDiskBytes": 10737418240,
    "RetentionDays": 7,
    "CleanupIntervalMinutes": 10,
    "Cameras": [],
    "ProcessingEnabled": true,
    "ProcessingIntervalSeconds": 5,
    "ProcessingBatchSize": 50,
    "ProcessingMaxAttempts": 10,
    "Database": {
      "ConnectionString": "",
      "CameraRefreshSeconds": 30
    },
    "Cos": {
      "Enabled": false,
      "Bucket": "",
      "Region": "",
      "SecretId": "",
      "SecretKey": "",
      "KeyPrefix": "face-ingest",
      "UploadRawBody": false
    }
  },
  "FaceMatch": {
    "Tencent": {
      "Region": "ap-guangzhou",
      "SecretId": "",
      "SecretKey": ""
    },
    "StaffThreshold": 85,
    "VisitorThreshold": 85,
    "Unwelcome": {
      "Threshold": 95,
      "ImageRetentionDays": 7
    },
    "StaffSuppressSeconds": 30,
    "DuplicateBodyWindowSeconds": 300,
    "Quality": {
      "MinEdgePixels": 80,
      "MinBytes": 4096
    },
    "ProfileRefreshSeconds": 30,
    "Retry": {
      "MaxAttempts": 3,
      "BaseDelayMilliseconds": 500,
      "MaxDelayMilliseconds": 8000
    },
    "FatalCooldownSeconds": 60,
    "MatchMaxAttempts": 3,
    "MatchMaxLocalAgeMinutes": 15
  }
}
