                                                                <WrapPanel Margin="0,0,0,4">
                                                                    <Button Command="{Binding TestConnectionCommand}" Style="{StaticResource PosSecondaryButtonStyle}" MinHeight="44" Padding="12,8" Margin="0,0,10,6">
