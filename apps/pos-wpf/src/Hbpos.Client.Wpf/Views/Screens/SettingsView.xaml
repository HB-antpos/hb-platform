<UserControl x:Class="Hbpos.Client.Wpf.Views.Screens.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Hbpos.Client.Wpf.Converters"
             xmlns:controls="clr-namespace:Hbpos.Client.Wpf.Views.Controls"
             xmlns:loc="clr-namespace:Hbpos.Client.Wpf.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:Hbpos.Client.Wpf.Services"
             mc:Ignorable="d"
             d:DesignHeight="632"
             d:DesignWidth="1366"
             FontFamily="Segoe UI"
             Background="{DynamicResource PosScreenBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:LocalizationKeyConverter x:Key="LocalizationKeyConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <converters:ReceiptQrCodeImageSourceConverter x:Key="QrCodeImage" />

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- 单行输入框不接管触摸平移，让所在页面容器（SettingsPageHost）内的 ScrollViewer 处理纵向拖动。 -->
        <Style x:Key="SettingsFieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PosSearchTextBoxStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="ScrollViewer.PanningMode" Value="None" />
            <!-- 只读（例如总部下发的小票资料）用浅一级底色提示不可编辑，文字仍可选中复制。 -->
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsFieldPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.PanningMode" Value="None" />
        </Style>

        <!-- 系统默认下拉框模板的底色写死为浅灰渐变，深色主题下会变成浅字压浅底；
             改为继承 MaterialDesign 下拉框（与历史、卡交易异常中心一致），底色与弹出层随主题切换。 -->
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 左侧导航项：固定 48 高、间距 6，字号 15 SemiBold（选中 Bold）；英文长标签在项内换行，不截断。 -->
        <Style x:Key="SettingsCategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                    <Setter Property="BorderThickness" Value="4,1,1,1" />
                    <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <!-- 选中态左边线 4px（平时 1px），左内边距相应少 3px，文字不位移。 -->
                    <Setter Property="Padding" Value="9,0,12,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsActionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
        </Style>

        <Style x:Key="SettingsPageDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- 服务商选择做成大卡片：整卡可点，选中时蓝框+浅蓝底，适合触屏。 -->
        <Style x:Key="SettingsProviderTabStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,14,16" />
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="MinWidth" Value="280" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="ProviderTabBorder"
                                Background="{DynamicResource PosSurfaceBrush}"
                                BorderBrush="{DynamicResource PosBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="12"
                                Padding="18,12">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ProviderTabBorder" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                <Setter TargetName="ProviderTabBorder" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ProviderTabBorder" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsModeChoiceBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                             Value="True">
                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 分段控件：一组 RadioButton 放在浅灰底槽里，选中段为白底凸起，整段 52px 高便于触屏。 -->
        <Style x:Key="SettingsSegmentHostStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style x:Key="SettingsSegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 触屏选择列表：每项是一张 64px 高的卡片，左侧单选圆点；不带内部滚动，交给页面容器（SettingsPageHost）的兜底滚动。 -->
        <Style x:Key="SettingsTouchListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.PanningMode" Value="None" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="MinHeight" Value="64" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{DynamicResource PosSurfaceBrush}"
                                            BorderBrush="{DynamicResource PosBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="12"
                                            Padding="16,10">
                                        <DockPanel>
                                            <Border x:Name="RadioOuter"
                                                    DockPanel.Dock="Left"
                                                    Width="26"
                                                    Height="26"
                                                    CornerRadius="13"
                                                    BorderThickness="2"
                                                    BorderBrush="{DynamicResource PosBorderStrongBrush}"
                                                    Background="{DynamicResource PosSurfaceBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,14,0">
                                                <Ellipse x:Name="RadioDot"
                                                         Width="12"
                                                         Height="12"
                                                         Fill="{DynamicResource PosPrimaryBrush}"
                                                         Visibility="Collapsed" />
                                            </Border>
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                            <Setter TargetName="RadioOuter" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                            <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置分区卡片标题与步骤序号。 -->
        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
        </Style>

        <Style x:Key="SettingsStepBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource PosPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsStepBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingsTouchButtonHeight" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="18,0" />
        </Style>
        <!-- 页头保存状态：已保存（绿）/ 正在保存（灰）/ 未保存（红）。 -->
        <Style x:Key="SettingsSaveChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PageSaveStatus}" Value="Saved">
                    <Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PageSaveStatus}" Value="Unsaved">
                    <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsSaveChipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PageSaveStatus}" Value="Saved">
                    <Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding PageSaveStatus}" Value="Unsaved">
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 分区保存状态小字（放在卡片标题右侧）：Tag 绑定该分区的 SaveState；已保存时文字为空、整行折叠。 -->
        <Style x:Key="SettingsSectionStateTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Draft">
                    <Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 分页标签上的红点：该分页有保存失败或未生效的修改。 -->
        <Style x:Key="SettingsUnsavedDotStyle" TargetType="Border">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="CornerRadius" Value="4.5" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PosDangerBrush}" />
        </Style>

        <!-- 左侧导航的未保存数量角标。 -->
        <Style x:Key="SettingsNavBadgeStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource PosDangerBrush}" />
        </Style>

        <!-- 页内分页（支付终端、小票打印机）：沿用分段控件外观，每段至少 150px 宽、48px 高。 -->
        <Style x:Key="SettingsSubTabRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource SettingsSegmentRadioStyle}">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 顶栏（52）：返回收银 | 面包屑「设置 / 页面名」| 页面说明（单行省略）| 保存状态芯片 + 小票页「测试打印」。
             取代旧的顶部条、固定页头和右上角上下文徽标（徽标只是重复标题，不是功能）。 -->
        <Border Grid.Row="0"
                Background="{DynamicResource PosSurfaceBrush}"
                BorderBrush="{DynamicResource PosDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource PosSecondaryButtonStyle}"
                        Height="40"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Loc shell.backToPos}" />
                    </StackPanel>
                </Button>
                <!-- 面包屑：设置 / 当前页面名（二级页签名不放这里）。 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <TextBlock Text="{Binding ScreenTitleText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PosMutedForegroundBrush}" />
                    <TextBlock Text="/"
                               Margin="8,0"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PosSubtleForegroundBrush}" />
                    <TextBlock Text="{Binding PageTitleText}"
                               FontSize="18"
                               FontWeight="Black"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PosTextBrush}" />
                </StackPanel>
                <!-- 页面说明：面包屑右侧单行，放不下时省略。 -->
                <TextBlock Grid.Column="2"
                           Text="{Binding PageDescriptionText}"
                           Margin="16,0"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SettingsSaveChipStyle}"
                            Visibility="{Binding IsPageSaveStatusVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PageSaveStatusText}"
                                       Style="{StaticResource SettingsSaveChipTextStyle}" />
                            <Button Command="{Binding RetryFailedSavesCommand}"
                                    Visibility="{Binding CanRetryPageSaves, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    MinHeight="32"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="10,0,0,0">
                                <TextBlock Text="{loc:Loc settings.autosave.page.retry}" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <!-- 测试打印放在顶栏：小票页三个分页都能直接点；小票设置已自动保存，测试只打印。 -->
                    <Button Command="{Binding TestReceiptPrinterCommand}"
                            Visibility="{Binding IsReceiptPrinterSelected, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource PosPrimaryButtonStyle}"
                            Height="44"
                            MinWidth="150"
                            Padding="18,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" Margin="0,0,8,0" Foreground="White" />
                            <TextBlock Text="{loc:Loc settings.receiptPrinter.test}" Foreground="White" FontSize="16" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区外框：边距 12；导航列 200 宽、与内容间距 12。 -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 导航先于内容声明，使键盘 Tab 顺序与左到右的视觉顺序一致。
                 六项（48 高、间距 6、内边距 10）合计 6×48 + 5×6 + 20 ≈ 340，在 632 高度内完整可见。 -->
            <Border Grid.Column="0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10">
                <StackPanel>
                <Button Command="{Binding SelectDataMaintenanceCommand}"
                        Tag="{Binding IsDataMaintenanceSelected}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <!-- 内容宽度固定 152 = 导航项宽 178 - 左右边线/内边距（选中与未选中都是 152）：Button 模板把内容居中，固定宽度才能让图标、文字左对齐、角标靠右。 -->
                    <Grid Width="152">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="DatabaseSyncOutline"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <!-- 英文长标签允许换行（行高 1.15，按钮固定 48 高可容纳两行）。 -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DataMaintenanceTitleText}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <Border Grid.Column="2"
                                Style="{StaticResource SettingsNavBadgeStyle}"
                                Visibility="{Binding HasDataMaintenanceUnsaved, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding DataMaintenanceUnsavedCount}" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <Button Command="{Binding SelectPaymentTerminalCommand}"
                        Tag="{Binding IsPaymentTerminalSelected}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <!-- 内容宽度固定 152 = 导航项宽 178 - 左右边线/内边距（选中与未选中都是 152）：Button 模板把内容居中，固定宽度才能让图标、文字左对齐、角标靠右。 -->
                    <Grid Width="152">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="ContactlessPayment"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <!-- 英文长标签允许换行（行高 1.15，按钮固定 48 高可容纳两行）。 -->
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc settings.category.paymentTerminal}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <Border Grid.Column="2"
                                Style="{StaticResource SettingsNavBadgeStyle}"
                                Visibility="{Binding HasPaymentTerminalUnsaved, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding PaymentTerminalUnsavedCount}" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <Button Command="{Binding SelectReceiptPrinterCommand}"
                        Tag="{Binding IsReceiptPrinterSelected}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <!-- 内容宽度固定 152 = 导航项宽 178 - 左右边线/内边距（选中与未选中都是 152）：Button 模板把内容居中，固定宽度才能让图标、文字左对齐、角标靠右。 -->
                    <Grid Width="152">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="Printer"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <!-- 英文长标签允许换行（行高 1.15，按钮固定 48 高可容纳两行）。 -->
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc settings.category.receiptPrinter}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <Border Grid.Column="2"
                                Style="{StaticResource SettingsNavBadgeStyle}"
                                Visibility="{Binding HasReceiptPrinterUnsaved, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ReceiptPrinterUnsavedCount}" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <Button Command="{Binding SelectDeviceRegistrationCommand}"
                        Tag="{Binding IsDeviceRegistrationSelected}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <!-- 内容宽度固定 152 = 导航项宽 178 - 左右边线/内边距（选中与未选中都是 152）：Button 模板把内容居中，固定宽度才能让图标、文字左对齐、角标靠右。 -->
                    <Grid Width="152">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="CashRegister"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <!-- 英文长标签允许换行（行高 1.15，按钮固定 48 高可容纳两行）。 -->
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc settings.category.deviceRegistrationNav}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <Border Grid.Column="2"
                                Style="{StaticResource SettingsNavBadgeStyle}"
                                Visibility="{Binding HasDeviceRegistrationUnsaved, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding DeviceRegistrationUnsavedCount}" Foreground="White" FontSize="12" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <Button Command="{Binding SelectRemoteMaintenanceCommand}"
                        Tag="{Binding IsRemoteMaintenanceSelected}"
                        Style="{StaticResource SettingsCategoryButtonStyle}">
                    <!-- 内容宽度固定 152 = 导航项宽 178 - 左右边线/内边距（选中与未选中都是 152）：Button 模板把内容居中，固定宽度才能让图标、文字左对齐、角标靠右。 -->
                    <Grid Width="152">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="RemoteDesktop"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <!-- 英文长标签允许换行（行高 1.15，按钮固定 48 高可容纳两行）。 -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding RemoteMaintenanceTitleText}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Grid>
                </Button>

                <Button Command="{Binding SelectMobileAppDownloadCommand}"
                        Tag="{Binding IsMobileAppDownloadSelected}"
                        Style="{StaticResource SettingsCategoryButtonStyle}"
                        Margin="0">
                    <!-- 内容宽度固定 152 = 导航项宽 178 - 左右边线/内边距（选中与未选中都是 152）：Button 模板把内容居中，固定宽度才能让图标、文字左对齐、角标靠右。 -->
                    <Grid Width="152">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="CellphoneArrowDown"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                        <!-- 英文长标签允许换行（行高 1.15，按钮固定 48 高可容纳两行）。 -->
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc settings.category.mobileAppDownload}"
                                   TextWrapping="Wrap"
                                   LineHeight="17"
                                   LineStackingStrategy="BlockLineHeight"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Grid>
                </Button>
                </StackPanel>
            </Border>

            <!-- 六个分类页面并列放在同一个单元格里，靠各自的 Visibility 绑定互斥显示；
                 不再有外层 ScrollViewer，每页由 SettingsPageHost 自带兜底滚动与固定底栏。 -->
            <Grid Grid.Column="2">
                <!-- ===== PAGE: DataMaintenance BEGIN ===== -->
                <!-- 数据维护（首屏重设计）：本页内容放得下 1366×632（内容区目标 ≤ 502px），不设固定底栏，
                     5 个操作按钮各自留在所属说明卡内：数据下载 / 数据重置在卡标题行右端，检查更新 / 重置销售数据（Debug）/ 重启电脑在卡右端垂直居中。
                     忙碌时按钮禁用沿用各命令自带的 !IsBusy 条件，确认 / 授权流程在命令里，不在这里。
                     页面说明句已在顶栏显示（PageDescriptionText），正文不重复。 -->
                <controls:SettingsPageHost Style="{StaticResource SettingsPageHostStyle}"
                                           Visibility="{Binding IsDataMaintenanceSelected, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <!-- 页面级样式：只在本页使用，不进文件顶部共享资源区。 -->
                        <Grid.Resources>
                            <!-- 紧凑说明卡：浅一级底色，内边距 14,12。 -->
                            <Style x:Key="DataMaintenanceCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsActionCardStyle}">
                                <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                                <Setter Property="Padding" Value="14,12" />
                            </Style>
                            <!-- 更新卡：Debug 时与「重置测试销售数据」各占一半；非 Debug 时通栏（跨三列）。 -->
                            <Style x:Key="DataMaintenanceUpdateCardStyle" TargetType="Border" BasedOn="{StaticResource DataMaintenanceCardStyle}">
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDebugTestSalesDataResetVisible}" Value="True">
                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <!-- 开关卡：没有「重启电脑」卡时通栏。 -->
                            <Style x:Key="DataMaintenanceRestartPromptCardStyle" TargetType="Border" BasedOn="{StaticResource DataMaintenanceCardStyle}">
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRestartComputerTestVisible}" Value="True">
                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <!-- 36px 图标方块。 -->
                            <Style x:Key="DataMaintenanceIconBoxStyle" TargetType="Border">
                                <Setter Property="Width" Value="36" />
                                <Setter Property="Height" Value="36" />
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="DataMaintenanceTitleStyle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="FontWeight" Value="Black" />
                                <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="DataMaintenanceDescriptionStyle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                            <!-- 危险操作按钮：白底红边红字，高 44（触屏最小）。 -->
                            <Style x:Key="DataMaintenanceDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                <Setter Property="Height" Value="44" />
                                <Setter Property="MinWidth" Value="138" />
                                <Setter Property="Padding" Value="16,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Style>
                            <!-- 普通操作按钮（检查更新）：高 44。 -->
                            <Style x:Key="DataMaintenanceNormalButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                <Setter Property="Height" Value="44" />
                                <Setter Property="MinWidth" Value="138" />
                                <Setter Property="Padding" Value="16,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Style>
                            <!-- 数据下载卡里的同步状态胶囊。 -->
                            <Style x:Key="DataMaintenanceChipStyle" TargetType="Border">
                                <Setter Property="Height" Value="24" />
                                <Setter Property="CornerRadius" Value="12" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="Margin" Value="10,0,0,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <!-- 同步块下方 36px 状态区：同步中显示进度条、失败显示红字，正常留空；仅有内容时才画上分隔线。 -->
                            <Style x:Key="DataMaintenanceStateZoneStyle" TargetType="Border">
                                <Setter Property="Height" Value="36" />
                                <Setter Property="BorderThickness" Value="0,1,0,0" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCatalogSyncing}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCatalogSyncFailed}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 第一行左：数据下载。标题行 = 图标 + 标题 + 同步状态胶囊 + （右端）主按钮；下面是说明与同步块。 -->
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource DataMaintenanceCardStyle}">
                            <StackPanel>
                                <Grid MinHeight="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Style="{StaticResource DataMaintenanceIconBoxStyle}"
                                            Background="{DynamicResource PosPrimarySoftBrush}">
                                        <materialDesign:PackIcon Kind="CloudDownloadOutline"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:Loc settings.section.dataDownload.title}"
                                               Style="{StaticResource DataMaintenanceTitleStyle}" />
                                    <!-- 已同步 / 同步中 / 同步失败 三选一的状态胶囊，紧跟标题。 -->
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Border Style="{StaticResource DataMaintenanceChipStyle}"
                                                Background="{DynamicResource PosSuccessSoftBrush}"
                                                Visibility="{Binding IsCatalogSyncSucceeded, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource PosSuccessTextBrush}" />
                                                <TextBlock Text="{loc:Loc settings.section.dataDownload.state.synced}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PosSuccessTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource DataMaintenanceChipStyle}"
                                                Background="{DynamicResource PosPrimarySoftBrush}"
                                                Visibility="{Binding IsCatalogSyncing, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Sync" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                                <TextBlock Text="{loc:Loc settings.section.dataDownload.state.syncing}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource DataMaintenanceChipStyle}"
                                                Background="{DynamicResource PosDangerSoftBrush}"
                                                Visibility="{Binding IsCatalogSyncFailed, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource PosDangerTextBrush}" />
                                                <TextBlock Text="{loc:Loc settings.section.dataDownload.state.failed}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PosDangerTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Button Grid.Column="4"
                                            Command="{Binding DownloadCatalogCommand}"
                                            services:ButtonFeedback.Cue="Download"
                                            Style="{StaticResource PosPrimaryButtonStyle}"
                                            Height="48"
                                            MinWidth="138"
                                            Padding="16,0"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                            <TextBlock Text="{loc:Loc settings.section.dataDownload.action}" Foreground="White" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{loc:Loc settings.section.dataDownload.description}"
                                           Style="{StaticResource DataMaintenanceDescriptionStyle}"
                                           Margin="0,8,0,0" />
                                <!-- 同步时间与同步状态合并展示（上次同步时间 + 36px 固定状态区）；页面级操作提示仍由底部状态栏显示。 -->
                                <Border x:Name="CatalogSyncStatusPanel"
                                        Background="{DynamicResource PosSurfaceBrush}"
                                        BorderBrush="{DynamicResource PosDividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid MinHeight="44" Margin="12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ClockOutline"
                                                                         Width="16"
                                                                         Height="16"
                                                                         Margin="0,0,6,0"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                                <TextBlock Text="{Binding CatalogSyncTimeLabelText}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CatalogSyncTimeText}"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource PosTextBrush}" />
                                        </Grid>
                                        <Border Style="{StaticResource DataMaintenanceStateZoneStyle}">
                                            <Grid Margin="12,0" VerticalAlignment="Center">
                                                <ProgressBar Height="4"
                                                             IsIndeterminate="True"
                                                             Visibility="{Binding IsCatalogSyncing, Converter={StaticResource BoolToVis}}" />
                                                <!-- 失败原因最多两行，放不下的部分省略，完整文字在鼠标悬停提示里。 -->
                                                <TextBlock Text="{Binding CatalogSyncFailureText}"
                                                           ToolTip="{Binding CatalogSyncFailureText}"
                                                           FontSize="11.5"
                                                           LineHeight="14"
                                                           LineStackingStrategy="BlockLineHeight"
                                                           MaxHeight="28"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource PosDangerTextBrush}"
                                                           Visibility="{Binding IsCatalogSyncFailed, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 第一行右：数据重置（授权 / 确认沿用命令内流程）。 -->
                        <Border Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource DataMaintenanceCardStyle}">
                            <StackPanel>
                                <Grid MinHeight="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Style="{StaticResource DataMaintenanceIconBoxStyle}"
                                            Background="{DynamicResource PosWarningSoftBrush}">
                                        <materialDesign:PackIcon Kind="DatabaseRefreshOutline"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Foreground="{DynamicResource PosWarningTextBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{loc:Loc settings.section.dataReset.title}"
                                               Style="{StaticResource DataMaintenanceTitleStyle}" />
                                    <Button Grid.Column="2"
                                            Command="{Binding ResetCatalogCommand}"
                                            Style="{StaticResource DataMaintenanceDangerButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DatabaseRefreshOutline" Width="18" Height="18" Margin="0,0,8,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                            <TextBlock Text="{loc:Loc settings.section.dataReset.action}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{loc:Loc settings.section.dataReset.description}"
                                           Style="{StaticResource DataMaintenanceDescriptionStyle}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 第二行：软件更新（非 Debug 通栏；Debug 与「重置测试销售数据」各占一半）。通道作为第三行小字，按钮在右端垂直居中。 -->
                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource DataMaintenanceUpdateCardStyle}"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Style="{StaticResource DataMaintenanceIconBoxStyle}"
                                        Background="{DynamicResource PosSuccessSoftBrush}">
                                    <materialDesign:PackIcon Kind="Update"
                                                             Width="20"
                                                             Height="20"
                                                             Foreground="{DynamicResource PosSuccessTextBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{loc:Loc settings.section.appUpdate.title}"
                                               Style="{StaticResource DataMaintenanceTitleStyle}" />
                                    <TextBlock Text="{loc:Loc settings.section.appUpdate.description}"
                                               Style="{StaticResource DataMaintenanceDescriptionStyle}"
                                               Margin="0,2,0,0" />
                                    <TextBlock FontSize="11.5"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               Margin="0,4,0,0">
                                        <Run Text="{loc:Loc settings.section.appUpdate.channel}" />
                                        <Run Text=": " />
                                        <Run Text="{Binding AppUpdateChannelText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Command="{Binding CheckForAppUpdateCommand}"
                                        Style="{StaticResource DataMaintenanceNormalButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Update" Width="18" Height="18" Margin="0,0,8,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        <TextBlock Text="{loc:Loc settings.section.appUpdate.action}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 仅 Debug 可见：重置测试销售数据（红底卡，按钮在卡右端；确认框沿用命令内流程）。 -->
                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Style="{StaticResource DataMaintenanceCardStyle}"
                                Background="{DynamicResource PosDangerSoftBrush}"
                                BorderBrush="{DynamicResource PosDangerBorderBrush}"
                                Margin="0,10,0,0"
                                Visibility="{Binding IsDebugTestSalesDataResetVisible, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Style="{StaticResource DataMaintenanceIconBoxStyle}"
                                        Background="{DynamicResource PosSurfaceBrush}">
                                    <materialDesign:PackIcon Kind="DeleteOutline"
                                                             Width="20"
                                                             Height="20"
                                                             Foreground="{DynamicResource PosDangerTextBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{loc:Loc settings.section.testSalesDataReset.title}"
                                               Style="{StaticResource DataMaintenanceTitleStyle}"
                                               Foreground="{DynamicResource PosDangerTextBrush}" />
                                    <TextBlock Text="{loc:Loc settings.section.testSalesDataReset.description}"
                                               Style="{StaticResource DataMaintenanceDescriptionStyle}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Command="{Binding ResetTestSalesDataCommand}"
                                        services:ButtonFeedback.Cue="Delete"
                                        Style="{StaticResource DataMaintenanceDangerButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Margin="0,0,8,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        <TextBlock Text="{loc:Loc settings.section.testSalesDataReset.action}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 第三行：日结后提醒重启（设备级开关，立即保存，默认开启）｜重启电脑（测试）。
                             整行跟随 IsRestartPromptSettingVisible（原来两项在同一张卡里，行为不变）；没有「重启电脑」时开关卡通栏。 -->
                        <Grid Grid.Row="2"
                              Grid.ColumnSpan="3"
                              Margin="0,10,0,0"
                              Visibility="{Binding IsRestartPromptSettingVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource DataMaintenanceRestartPromptCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Style="{StaticResource DataMaintenanceIconBoxStyle}"
                                            Background="{DynamicResource PosSurfaceAltBrush}">
                                        <materialDesign:PackIcon Kind="Restart" Width="20" Height="20"
                                                                 Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc settings.restartPrompt.toggle}" FontSize="15" FontWeight="Bold" />
                                        <TextBlock Text="{loc:Loc settings.restartPrompt.description}"
                                                   Style="{StaticResource DataMaintenanceDescriptionStyle}"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{loc:Loc settings.restartPrompt.toggle.help}"
                                                   Style="{StaticResource DataMaintenanceDescriptionStyle}"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RestartPromptSaveStateText}"
                                                   Tag="{Binding RestartPromptSaveState}"
                                                   Style="{StaticResource SettingsSectionStateTextStyle}"
                                                   Margin="0,0,12,0" />
                                        <ToggleButton x:Name="RestartPromptSettingToggle"
                                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                      IsChecked="{Binding IsRestartPromptEnabled, Mode=TwoWay}"
                                                      AutomationProperties.Name="{loc:Loc settings.restartPrompt.toggle}"
                                                      MinHeight="48" MinWidth="56" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource DataMaintenanceCardStyle}"
                                    Visibility="{Binding IsRestartComputerTestVisible, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Style="{StaticResource DataMaintenanceIconBoxStyle}"
                                            Background="{DynamicResource PosDangerSoftBrush}">
                                        <materialDesign:PackIcon Kind="PowerCycle" Width="20" Height="20"
                                                                 Foreground="{DynamicResource PosDangerTextBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc settings.restartTest.title}" FontSize="15" FontWeight="Bold" />
                                        <TextBlock Text="{loc:Loc settings.restartTest.help}"
                                                   Style="{StaticResource DataMaintenanceDescriptionStyle}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" x:Name="RestartComputerTestButton"
                                            Command="{Binding RestartComputerCommand}"
                                            Style="{StaticResource DataMaintenanceDangerButtonStyle}"
                                            MinHeight="44">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Restart" Width="18" Height="18" Margin="0,0,8,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                            <TextBlock Text="{loc:Loc settings.restartTest.button}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </controls:SettingsPageHost>
                <!-- ===== PAGE: DataMaintenance END ===== -->

                <!-- ===== PAGE: PaymentTerminal BEGIN ===== -->
                <controls:SettingsPageHost Style="{StaticResource SettingsPageHostStyle}"
                                           Visibility="{Binding IsPaymentTerminalSelected, Converter={StaticResource BoolToVis}}">
                    <!-- ===== PAGE: PaymentTerminal / PaymentSubTabs BEGIN ===== -->
                    <controls:SettingsPageHost.SubTabs>
                        <!-- 二级页签条：左边是分页（付款方式 / Square / ANZ Linkly；有未保存修改的分页带红点），
                             右边是随分页切换的「环境」分段（Production / Sandbox）：Square 分页显示 Square 的，Linkly 分页显示 Linkly 的，
                             付款方式分页右侧留空。 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource SettingsSegmentHostStyle}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="PaymentSubTabs"
                                                 Style="{StaticResource SettingsSubTabRadioStyle}"
                                                 IsChecked="{Binding IsPaymentMethodsSubTabSelected, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="TuneVariant" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc settings.subtab.paymentMethods}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource SettingsUnsavedDotStyle}" Visibility="{Binding HasPaymentMethodsUnsaved, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PaymentSubTabs"
                                                 Style="{StaticResource SettingsSubTabRadioStyle}"
                                                 IsChecked="{Binding IsSquareSubTabSelected, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="SquareRoundedOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SquareTitleText}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource SettingsUnsavedDotStyle}" Visibility="{Binding HasSquareUnsaved, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="PaymentSubTabs"
                                                 Style="{StaticResource SettingsSubTabRadioStyle}"
                                                 IsChecked="{Binding IsLinklySubTabSelected, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CreditCardWirelessOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding LinklyTitleText}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource SettingsUnsavedDotStyle}" Visibility="{Binding HasLinklyUnsaved, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <!-- 右侧环境分段容器：两个可见性互斥的占位块（Square / Linkly），按分页切换。 -->
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <!-- Square 环境分段：①环境 + Production / Sandbox 测试，沿用原 IsSquareSandbox 与 CanChangeEnvironment 绑定。 -->
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsSquareSubTabSelected, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource SettingsStepBadgeStyle}" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                        <TextBlock Text="1" Style="{StaticResource SettingsStepBadgeTextStyle}" FontSize="12.5" />
                                    </Border>
                                    <TextBlock Text="{loc:Loc settings.payment.environment}"
                                               Style="{StaticResource SettingsSectionTitleStyle}"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <Border Style="{StaticResource SettingsSegmentHostStyle}" IsEnabled="{Binding CanChangeEnvironment}">
                                        <UniformGrid Rows="1">
                                            <RadioButton GroupName="SquareEnvironmentSegment"
                                                         Style="{StaticResource SettingsSegmentRadioStyle}"
                                                         MinWidth="100"
                                                         IsChecked="{Binding IsSquareSandbox, Mode=TwoWay, Converter={StaticResource InverseBool}}"
                                                         Content="{loc:Loc settings.payment.environment.production}" />
                                            <RadioButton GroupName="SquareEnvironmentSegment"
                                                         Style="{StaticResource SettingsSegmentRadioStyle}"
                                                         MinWidth="100"
                                                         IsChecked="{Binding IsSquareSandbox, Mode=TwoWay}"
                                                         Content="{loc:Loc settings.payment.environment.sandbox}" />
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                                <!-- LINKLY ENV SEGMENT 占位：Linkly 分页选中时显示。由 Linkly 代理填充，Square 一侧不要动。 -->
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsLinklySubTabSelected, Converter={StaticResource BoolToVis}}">
                                    <!-- Linkly 环境分段：与 Square 同款（标题 + Production / Sandbox 测试），沿用 IsLinklySandbox 与 CanChangeEnvironment 绑定；
                                         原来三种模式各有一份分段（本地/直连/后端三个 GroupName），现统一为页签条右侧这一份。 -->
                                    <TextBlock Text="{loc:Loc settings.payment.environment}"
                                               Style="{StaticResource SettingsSectionTitleStyle}"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <Border Style="{StaticResource SettingsSegmentHostStyle}" IsEnabled="{Binding CanChangeEnvironment}">
                                        <UniformGrid Rows="1">
                                            <RadioButton GroupName="LinklyEnvironmentSegment"
                                                         Style="{StaticResource SettingsSegmentRadioStyle}"
                                                         MinWidth="100"
                                                         IsChecked="{Binding IsLinklySandbox, Mode=TwoWay, Converter={StaticResource InverseBool}}"
                                                         Content="{loc:Loc settings.payment.environment.production}" />
                                            <RadioButton GroupName="LinklyEnvironmentSegment"
                                                         Style="{StaticResource SettingsSegmentRadioStyle}"
                                                         MinWidth="100"
                                                         IsChecked="{Binding IsLinklySandbox, Mode=TwoWay}"
                                                         Content="{loc:Loc settings.payment.environment.sandbox}" />
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </controls:SettingsPageHost.SubTabs>
                    <!-- ===== PAGE: PaymentTerminal / PaymentSubTabs END ===== -->
                    <!-- 固定底栏：三个分页各一条，按分页互斥显示。各区块由对应分页的代理填充，互不相扰。 -->
                    <controls:SettingsPageHost.Footer>
                        <Grid>
                            <!-- ===== FOOTER: PaymentMethods BEGIN ===== -->
                            <!-- 付款方式底栏：自动保存时只显示「修改后自动保存」提示；非自动保存（显式保存）时提示折叠，
                                 「保存付款方式」出现在右侧。底栏最小高度固定 65，两种情况都不跳高。 -->
                            <controls:SettingsFooterBar Visibility="{Binding IsPaymentMethodsSubTabSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock controls:SettingsFooterBar.IsFill="True"
                                           Text="{loc:Loc settings.autosave.hint}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                            <Style.Triggers>
                                                <!-- 显式保存模式下「自动保存」提示不成立，折叠。 -->
                                                <DataTrigger Binding="{Binding IsExplicitSaveVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        Command="{Binding SavePaymentMethodsCommand}"
                                        Visibility="{Binding IsExplicitSaveVisible, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                        Height="48" MinWidth="176" Padding="18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,8,0" Foreground="White" />
                                        <TextBlock Text="{loc:Loc settings.payment.methods.save}" Foreground="White" FontSize="16" />
                                    </StackPanel>
                                </Button>
                            </controls:SettingsFooterBar>
                            <!-- ===== FOOTER: PaymentMethods END ===== -->
                            <!-- ===== FOOTER: Square BEGIN ===== -->
                            <!-- Square 底栏：直连 Square 分组（开启/关闭直连 + 刷新直连状态）｜说明文字｜草稿芯片「已修改，尚未生效」｜右侧「保存 Square」。 -->
                            <controls:SettingsFooterBar Visibility="{Binding IsSquareSubTabSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc settings.square.direct.group}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PosTextBrush}" />
                                <Button Command="{Binding ToggleSquareDirectCommand}"
                                        Content="{Binding SquareDirectToggleText}"
                                        Style="{StaticResource PosSecondaryButtonStyle}"
                                        BorderBrush="{DynamicResource PosPrimaryBrush}"
                                        Foreground="{DynamicResource PosPrimaryTextBrush}"
                                        FontWeight="Bold"
                                        Height="44"
                                        MinWidth="120"
                                        Padding="14,0" />
                                <Button Command="{Binding RefreshSquareDirectCommand}"
                                        Style="{StaticResource SettingsTouchButtonHeight}"
                                        Padding="14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:Loc settings.square.direct.refresh}" />
                                    </StackPanel>
                                </Button>
                                <Border Style="{StaticResource SettingsFooterDividerStyle}" />
                                <TextBlock controls:SettingsFooterBar.IsFill="True"
                                           Text="{loc:Loc settings.square.switchHelp}"
                                           ToolTip="{loc:Loc settings.square.switchHelp}"
                                           FontSize="12.5"
                                           LineHeight="16"
                                           LineStackingStrategy="BlockLineHeight"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="32"
                                           Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                <!-- 草稿芯片：Square 有未保存的修改（草稿或保存失败）时出现；文字取 SquareSaveStateText。 -->
                                <Border Visibility="{Binding HasSquareUnsaved, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource PosWarningSoftBrush}"
                                        BorderBrush="{DynamicResource PosWarningBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Height="24"
                                        Padding="10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SquareSaveStateText}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource PosWarningTextBrush}" />
                                </Border>
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        Command="{Binding SaveSquareCommand}"
                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                        Height="48"
                                        MinWidth="176"
                                        Padding="18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,8,0" Foreground="White" />
                                        <TextBlock Text="{loc:Loc settings.square.save}" Foreground="White" FontSize="16" />
                                    </StackPanel>
                                </Button>
                            </controls:SettingsFooterBar>
                            <!-- ===== FOOTER: Square END ===== -->
                            <!-- ===== FOOTER: Linkly BEGIN ===== -->
                            <controls:SettingsFooterBar Spacing="8" Visibility="{Binding IsLinklySubTabSelected, Converter={StaticResource BoolToVis}}">
                                <controls:SettingsFooterBar.Resources>
                                    <!-- 底栏页面级样式：主色描边（使用此线路 / 配对 Cloud）、危险描边（解除绑定）；次按钮统一 44 高、内边距 11（英文按钮放得下）。 -->
                                    <Style x:Key="LinklyFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                        <Setter Property="Height" Value="44" />
                                        <Setter Property="Padding" Value="11,0" />
                                        <Setter Property="FontSize" Value="14" />
                                    </Style>
                                    <Style x:Key="LinklyFooterOutlinePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource LinklyFooterButtonStyle}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                                    </Style>
                                    <Style x:Key="LinklyFooterDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource LinklyFooterButtonStyle}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBorderBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                                    </Style>
                                </controls:SettingsFooterBar.Resources>

                                <!-- Cloud 直连同步：保存测试账号放底栏最左，与其余操作隔开。 -->
                                <Button Click="SaveLinklyCloudCredential_Click"
                                        IsEnabled="{Binding CanSaveLinklyCloudCredentialFromView}"
                                        Visibility="{Binding IsLinklyCloudDirectSyncMode, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource LinklyFooterButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ShieldKeyOutline" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc settings.linkly.cloud.saveCredential}" />
                                    </StackPanel>
                                </Button>

                                <!-- Cloud 后端异步（作用于左侧列表里聚焦的线路 FocusedLinklyCloudLine）：
                                     第一组 线路动作：重新配对/收起、检测连接、使用此线路；
                                     第二组 绑定动作：变更绑定、解除绑定（danger，与其它隔开，沿用 VM 里的确认框）；
                                     第三组 页面动作：测试交易状态（再接公共的「启用 Linkly」）。 -->
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        Command="{Binding FocusedLinklyCloudLine.TogglePairingCommand}"
                                        Visibility="{Binding IsLinklyCloudBackendAsyncMode, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource LinklyFooterButtonStyle}"
                                        AutomationProperties.AutomationId="LinklyLineTogglePairing">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding FocusedLinklyCloudLine.TogglePairingText}" />
                                    </StackPanel>
                                </Button>
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        Command="{Binding FocusedLinklyCloudLine.TestConnectionCommand}"
                                        Visibility="{Binding IsLinklyCloudBackendAsyncMode, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource LinklyFooterButtonStyle}"
                                        AutomationProperties.AutomationId="LinklyLineTestConnection">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LanConnect" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc settings.linkly.lines.testConnection}" />
                                    </StackPanel>
                                </Button>
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        Command="{Binding FocusedLinklyCloudLine.SelectCommand}"
                                        Visibility="{Binding IsLinklyCloudBackendAsyncMode, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource LinklyFooterOutlinePrimaryButtonStyle}"
                                        AutomationProperties.AutomationId="LinklyLineUseForPayments">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc settings.linkly.cloudBackend.useLine}" />
                                    </StackPanel>
                                </Button>
                                <Border Style="{StaticResource SettingsFooterDividerStyle}"
                                        controls:SettingsFooterBar.IsRight="True"
                                        Visibility="{Binding IsLinklyCloudBackendAsyncMode, Converter={StaticResource BoolToVis}}" />
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        CommandParameter="{Binding FocusedLinklyCloudLine.ManagementItem}"
                                        Command="{Binding ChangeLinklyCloudTerminalAssignmentCommand}"
                                        Visibility="{Binding IsLinklyCloudBackendAsyncMode, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource LinklyFooterButtonStyle}"
                                        AutomationProperties.AutomationId="LinklyLineChangeBinding">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LinkVariant" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc settings.linkly.cloudBackend.changeBinding}" />
                                    </StackPanel>
                                </Button>
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        CommandParameter="{Binding FocusedLinklyCloudLine.ManagementItem}"
                                        Command="{Binding UnassignLinklyCloudTerminalCommand}"
                                        Visibility="{Binding IsLinklyCloudBackendAsyncMode, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource LinklyFooterDangerButtonStyle}"
                                        AutomationProperties.AutomationId="LinklyLineUnassign">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc settings.linkly.cloudBackend.unassign}" />
                                    </StackPanel>
                                </Button>
                                <Border Style="{StaticResource SettingsFooterDividerStyle}"
                                        controls:SettingsFooterBar.IsRight="True"
                                        Visibility="{Binding IsLinklyCloudBackendAsyncMode, Converter={StaticResource BoolToVis}}" />
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        Command="{Binding TestLinklyTransactionStatusCommand}"
                                        Visibility="{Binding IsLinklyCloudBackendAsyncMode, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource LinklyFooterButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LanPending" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc settings.linkly.cloudBackend.testStatus}" />
                                    </StackPanel>
                                </Button>

                                <!-- Cloud 直连同步：取消（配对中才可用）+ 配对 Cloud，再用竖线与「测试 / 启用」隔开。 -->
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        Command="{Binding CancelLinklyCloudPairingCommand}"
                                        Click="CancelLinklyCloudPairing_Click"
                                        IsEnabled="{Binding CanCancelLinklyCloudPairingFromView}"
                                        Visibility="{Binding IsLinklyCloudDirectSyncMode, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource LinklyFooterButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc settings.linkly.cloud.cancelPairing}" />
                                    </StackPanel>
                                </Button>
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        Click="PairLinklyCloud_Click"
                                        IsEnabled="{Binding CanPairLinklyCloudFromView}"
                                        Visibility="{Binding IsLinklyCloudDirectSyncMode, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource LinklyFooterOutlinePrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LinkVariant" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc settings.linkly.cloud.pair}" />
                                    </StackPanel>
                                </Button>
                                <Border Style="{StaticResource SettingsFooterDividerStyle}"
                                        controls:SettingsFooterBar.IsRight="True"
                                        Visibility="{Binding IsLinklyCloudDirectSyncMode, Converter={StaticResource BoolToVis}}" />

                                <!-- 本地 IP / Cloud 直连：测试 Linkly（沙盒本地 IP 时文案为「测试虚拟刷卡机」，沿用 LinklyTestActionText）。 -->
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        Command="{Binding TestLinklyCommand}"
                                        Visibility="{Binding IsLinklyStandardActionMode, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource LinklyFooterButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LanConnect" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding LinklyTestActionText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                                <!-- 仅本地 IP：登录银行网络。 -->
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        Command="{Binding LogonLinklyCommand}"
                                        Visibility="{Binding IsLinklyLocalIpMode, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource LinklyFooterButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Login" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{loc:Loc settings.linkly.localIp.logon}" />
                                    </StackPanel>
                                </Button>
                                <!-- 三种模式共用的主按钮：启用 Linkly（唯一实心主色按钮，48 高）。 -->
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        Command="{Binding SaveLinklyCommand}"
                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                        Height="48"
                                        FontSize="15"
                                        Padding="16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,6,0" Foreground="White" />
                                        <TextBlock Text="{loc:Loc settings.linkly.enable}" Foreground="White" />
                                    </StackPanel>
                                </Button>
                            </controls:SettingsFooterBar>
                            <!-- ===== FOOTER: Linkly END ===== -->
                        </Grid>
                    </controls:SettingsPageHost.Footer>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <!-- ===== PAGE: PaymentTerminal / PaymentMethods BEGIN ===== -->
                        <!-- 付款方式（首屏重设计）：左列三个开关行（手动刷卡 / 代金券 / 付款页订单列表，行高 ≥72，开关点击区 ≥48×56），
                             右列「当前付款服务商」摘要卡。保存状态：顶栏芯片 + 本区块标题右侧小字 + 底栏提示；
                             生产装配是自动保存，「保存付款方式」只在非自动保存时出现在底栏右侧（见 FOOTER: PaymentMethods）。 -->
                        <StackPanel Grid.Row="1" Grid.Column="0"
                                    Visibility="{Binding IsPaymentMethodsSubTabSelected, Converter={StaticResource BoolToVis}}">
                            <StackPanel.Resources>
                                <!-- 页面级样式：开关行卡片与图标块。 -->
                                <Style x:Key="PaymentMethodRowStyle" TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="10" />
                                    <Setter Property="Padding" Value="12,6" />
                                    <Setter Property="MinHeight" Value="72" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                                <Style x:Key="PaymentMethodIconBoxStyle" TargetType="Border">
                                    <Setter Property="Width" Value="44" />
                                    <Setter Property="Height" Value="44" />
                                    <Setter Property="CornerRadius" Value="12" />
                                    <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Margin" Value="0,0,14,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </StackPanel.Resources>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc settings.payment.methods.title}" Style="{StaticResource SettingsSectionTitleStyle}" />
                                <TextBlock Text="{Binding PaymentMethodsSaveStateText}"
                                           Tag="{Binding PaymentMethodsSaveState}"
                                           Style="{StaticResource SettingsSectionStateTextStyle}" />
                            </StackPanel>
                            <TextBlock Text="{loc:Loc settings.payment.methods.description}"
                                       Style="{StaticResource SettingsPageDescriptionStyle}" Margin="0,4,0,10" />

                            <!-- 开关行 1：使用手动刷卡（受环境锁 CanChangeEnvironment 控制）。 -->
                            <Border Style="{StaticResource PaymentMethodRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PaymentMethodIconBoxStyle}">
                                        <materialDesign:PackIcon Kind="CreditCardOutline" Width="22" Height="22"
                                                                 Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc settings.payment.methods.manualCard}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc settings.payment.methods.manualCard.help}"
                                                   TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" x:Name="ManualCardSettingToggle"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding UseManualCard, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanChangeEnvironment}"
                                                  AutomationProperties.Name="{loc:Loc settings.payment.methods.manualCard}"
                                                  MinHeight="48" MinWidth="56" VerticalAlignment="Center">
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- 开关行 2：启用代金券（受环境锁控制）。 -->
                            <Border Style="{StaticResource PaymentMethodRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PaymentMethodIconBoxStyle}">
                                        <materialDesign:PackIcon Kind="TicketPercentOutline" Width="22" Height="22"
                                                                 Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc settings.payment.methods.voucher}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc settings.payment.methods.voucher.help}"
                                                   TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" x:Name="VoucherSettingToggle"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding VoucherEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanChangeEnvironment}"
                                                  AutomationProperties.Name="{loc:Loc settings.payment.methods.voucher}"
                                                  MinHeight="48" MinWidth="56" VerticalAlignment="Center">
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- 开关行 3：付款页显示订单列表：默认开启，按本机保存，与上面两项共用同一套保存（自动保存 / 底栏保存按钮）。
                                 它只是付款页的布局偏好，不涉及支付环境，所以不绑定 CanChangeEnvironment，始终可切换。 -->
                            <Border Style="{StaticResource PaymentMethodRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource PaymentMethodIconBoxStyle}">
                                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="22" Height="22"
                                                                 Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc settings.payment.methods.orderList}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{loc:Loc settings.payment.methods.orderList.help}"
                                                   TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" x:Name="OrderListSettingToggle"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding ShowOrderList, Mode=TwoWay}"
                                                  AutomationProperties.Name="{loc:Loc settings.payment.methods.orderList}"
                                                  MinHeight="48" MinWidth="56" VerticalAlignment="Center">
                                    </ToggleButton>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 当前生效的服务商摘要（右列，顶对齐，不随左列拉高）。 -->
                        <Border Grid.Row="1" Grid.Column="2"
                                Style="{StaticResource SettingsActionCardStyle}"
                                Visibility="{Binding IsPaymentMethodsSubTabSelected, Converter={StaticResource BoolToVis}}"
                                VerticalAlignment="Top"
                                Padding="16">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left"
                                            Width="52" Height="52"
                                            Background="{DynamicResource PosPrimarySoftBrush}"
                                            CornerRadius="12"
                                            Margin="0,0,14,0">
                                        <materialDesign:PackIcon Kind="ContactlessPayment" Width="28" Height="28"
                                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc settings.payment.activeProvider.title}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                        <TextBlock Text="{Binding ActivePaymentProviderText}"
                                                   FontSize="20" FontWeight="Black"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding ActivePaymentProviderDetailText}"
                                           FontSize="13"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="20"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- ===== PAGE: PaymentTerminal / PaymentMethods END ===== -->

                        <TabControl Grid.Row="2"
                                    Grid.ColumnSpan="3"
                                    AutomationProperties.AutomationId="PaymentProviderTabs"
                                    SelectedIndex="{Binding SelectedProviderTabIndex, Mode=TwoWay}"
                                    Visibility="{Binding IsProviderSubTabSelected, Converter={StaticResource BoolToVis}}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0">
                            <TabControl.Resources>
                                <!-- 标签头由上方分页条代替；TabControl 只负责按 SelectedProviderTabIndex 显示 Square / Linkly 内容。 -->
                                <Style TargetType="TabItem" BasedOn="{StaticResource SettingsProviderTabStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                            </TabControl.Resources>
                            <!-- ===== PAGE: PaymentTerminal / Square BEGIN ===== -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource PosPrimarySoftBrush}" Margin="0,0,14,0">
                                            <materialDesign:PackIcon Kind="TabletCellphone" Width="24" Height="24" Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SquareTitleText}" FontSize="17" />
                                            <TextBlock Text="{loc:Loc settings.payment.provider.square.subtitle}"
                                                       FontSize="12" FontWeight="Normal"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem.Header>
                                <!-- Square 首屏版式（1366×632 内正文不滚动）：
                                     顶部连接条（环境①在二级页签条右侧；本条放②终端超时秒数 + 令牌来源）
                                     + 三栏（左：说明与直连 Square 说明｜中：③门店位置 + ④设备｜右：⑤设备码管理）。
                                     操作按钮（直连开关 / 刷新直连状态 / 保存 Square）全部在固定底栏 FOOTER: Square。
                                     高度预算：正文可用 368 = 顶部条 48 + 间距 12 + 三栏 302（门店/设备列表各固定 98 高内部滚动，列表行内不放按钮）。 -->
                                <Grid>
                                    <Grid.Resources>
                                        <!-- 页面级样式：紧凑单选列表（固定高度内部滚动，行高 ≥48，选中行浅蓝底 + 左侧 3px 蓝条）。 -->
                                        <Style x:Key="SquareCompactListBoxStyle" TargetType="ListBox">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBox">
                                                        <Border Background="{DynamicResource PosSurfaceBrush}"
                                                                BorderBrush="{DynamicResource PosDividerBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                ClipToBounds="True">
                                                            <ScrollViewer Focusable="False"
                                                                          Padding="0"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          HorizontalScrollBarVisibility="Disabled"
                                                                          CanContentScroll="False"
                                                                          PanningMode="VerticalOnly">
                                                                <ItemsPresenter />
                                                            </ScrollViewer>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="ItemContainerStyle">
                                                <Setter.Value>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                                                        <Setter Property="MinHeight" Value="48" />
                                                        <Setter Property="Padding" Value="12,6" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="ItemBorder"
                                                                            Background="Transparent"
                                                                            BorderBrush="{DynamicResource PosDividerBrush}"
                                                                            BorderThickness="0,0,0,1"
                                                                            MinHeight="{TemplateBinding MinHeight}"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <Grid>
                                                                            <Border x:Name="SelectedBar"
                                                                                    Width="3"
                                                                                    Margin="-12,-6,0,-6"
                                                                                    HorizontalAlignment="Left"
                                                                                    Background="{DynamicResource PosPrimaryBrush}"
                                                                                    Visibility="Collapsed" />
                                                                            <DockPanel>
                                                                                <Border x:Name="RadioOuter"
                                                                                        DockPanel.Dock="Left"
                                                                                        Width="18"
                                                                                        Height="18"
                                                                                        CornerRadius="9"
                                                                                        BorderThickness="2"
                                                                                        BorderBrush="{DynamicResource PosBorderStrongBrush}"
                                                                                        Background="{DynamicResource PosSurfaceBrush}"
                                                                                        VerticalAlignment="Center"
                                                                                        Margin="0,0,10,0">
                                                                                    <Ellipse x:Name="RadioDot"
                                                                                             Width="8"
                                                                                             Height="8"
                                                                                             Fill="{DynamicResource PosPrimaryBrush}"
                                                                                             Visibility="Collapsed" />
                                                                                </Border>
                                                                                <ContentPresenter VerticalAlignment="Center" />
                                                                            </DockPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                                                            <Setter TargetName="RadioOuter" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                                                            <Setter TargetName="RadioDot" Property="Visibility" Value="Visible" />
                                                                            <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <!-- 列表为空时居中显示的提示文字（叠在列表上，列表有项时折叠）。 -->
                                        <Style x:Key="SquareListEmptyTextStyle" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="TextAlignment" Value="Center" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="16,0" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="48" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="302" />
                                    </Grid.RowDefinitions>

                                    <!-- ===== 顶部连接条（48）：②终端超时秒数 + 令牌来源（只读状态块）。①环境分段在二级页签条右侧。 ===== -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Style="{StaticResource SettingsStepBadgeStyle}" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                                <TextBlock Text="2" Style="{StaticResource SettingsStepBadgeTextStyle}" FontSize="12.5" />
                                            </Border>
                                            <TextBlock Text="{loc:Loc settings.square.timeoutSeconds}"
                                                       Style="{StaticResource SettingsSectionTitleStyle}"
                                                       FontSize="15"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="150"
                                                       TextWrapping="Wrap"
                                                       LineHeight="17"
                                                       LineStackingStrategy="BlockLineHeight" />
                                        </StackPanel>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding TimeoutSecondsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                 Width="96"
                                                 Height="44"
                                                 VerticalAlignment="Center"
                                                 Margin="12,0,20,0" />
                                        <!-- 令牌由后台统一管理，收银机只显示状态。 -->
                                        <Border Grid.Column="2"
                                                Height="48"
                                                Background="{DynamicResource PosSurfaceAltBrush}"
                                                BorderBrush="{DynamicResource PosDividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12,3">
                                            <DockPanel>
                                                <materialDesign:PackIcon DockPanel.Dock="Left" Kind="ShieldKeyOutline" Width="22" Height="22"
                                                                         Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                         VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="13"
                                                           LineHeight="16"
                                                           LineStackingStrategy="BlockLineHeight"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource PosTextSecondaryBrush}">
                                                    <Run Text="{loc:Loc settings.square.tokenSource}" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" /><Run Text="  " /><Run Text="{Binding SquareTokenStatusText, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                    </Grid>

                                    <!-- ===== 三栏（302）：左 340 : 中 300 : 右 390（按星号比例缩放），栏间 1px 竖线 ===== -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="340*" />
                                            <ColumnDefinition Width="33" />
                                            <ColumnDefinition Width="300*" />
                                            <ColumnDefinition Width="33" />
                                            <ColumnDefinition Width="390*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 左栏：Square 说明 + 令牌说明 + 直连 Square 说明卡（按钮在底栏）。内容异常变长时栏内可滚动，不撑高整页。 -->
                                        <ScrollViewer Grid.Column="0"
                                                      Style="{DynamicResource PosVerticalTouchScrollViewerStyle}"
                                                      Focusable="False"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      PanningMode="VerticalOnly">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Loc settings.square.description}"
                                                           FontSize="12"
                                                           LineHeight="16"
                                                           LineStackingStrategy="BlockLineHeight"
                                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{loc:Loc settings.square.tokenHelp}"
                                                           FontSize="12"
                                                           LineHeight="16"
                                                           LineStackingStrategy="BlockLineHeight"
                                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                           TextWrapping="Wrap" />
                                                <!-- 直连 Square（默认关闭）：本地开关 + 服务端门店开关 + 令牌剩余有效期；开关与刷新按钮在底栏。 -->
                                                <Border Margin="0,8,0,0"
                                                        Background="{DynamicResource PosSurfaceAltBrush}"
                                                        BorderBrush="{DynamicResource PosDividerBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="12,10">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Loc settings.square.direct.title}" FontSize="13" FontWeight="Bold" />
                                                        <TextBlock Text="{loc:Loc settings.square.direct.description}"
                                                                   FontSize="12"
                                                                   LineHeight="16"
                                                                   LineStackingStrategy="BlockLineHeight"
                                                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                                   TextWrapping="Wrap" Margin="0,6,0,6" />
                                                        <TextBlock Text="{Binding SquareDirectStatusText}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource PosDividerBrush}" />

                                        <!-- 中栏：③门店位置 + ④设备。标题行右端各带「加载…」按钮（放在列表头部、不进滚动区），
                                             下面是固定 98 高的内部滚动列表（约 2 行 + 滚动条），列表行内没有功能按钮。 -->
                                        <StackPanel Grid.Column="2">
                                            <!-- ③ 门店位置 -->
                                            <Grid Height="44">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource SettingsStepBadgeStyle}" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                                        <TextBlock Text="3" Style="{StaticResource SettingsStepBadgeTextStyle}" FontSize="12.5" />
                                                    </Border>
                                                    <TextBlock Text="{loc:Loc settings.square.location}"
                                                               Style="{StaticResource SettingsSectionTitleStyle}"
                                                               FontSize="15"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Command="{Binding LoadLocationsCommand}"
                                                        services:ButtonFeedback.Cue="Download"
                                                        Style="{StaticResource SettingsTouchButtonHeight}"
                                                        Padding="14,0"
                                                        ToolTip="{loc:Loc settings.square.loadLocations.tooltip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="20" Height="20" Margin="0,0,8,0" />
                                                        <TextBlock Text="{loc:Loc settings.square.loadLocations}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid Height="98" Margin="0,4,0,0">
                                                <ListBox x:Name="SquareLocationList"
                                                         ItemsSource="{Binding SquareLocations}"
                                                         SelectedItem="{Binding SelectedSquareLocation, Mode=TwoWay}"
                                                         Style="{StaticResource SquareCompactListBoxStyle}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Id}" FontSize="12" FontFamily="Consolas"
                                                                           Foreground="{DynamicResource PosMutedForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="{loc:Loc settings.square.location.empty}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SquareListEmptyTextStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasItems, ElementName=SquareLocationList}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- ④ 刷卡设备 -->
                                            <Grid Height="44" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource SettingsStepBadgeStyle}" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                                        <TextBlock Text="4" Style="{StaticResource SettingsStepBadgeTextStyle}" FontSize="12.5" />
                                                    </Border>
                                                    <TextBlock Text="{loc:Loc settings.square.device}"
                                                               Style="{StaticResource SettingsSectionTitleStyle}"
                                                               FontSize="15"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Command="{Binding LoadDevicesCommand}"
                                                        Style="{StaticResource SettingsTouchButtonHeight}"
                                                        Padding="14,0"
                                                        ToolTip="{loc:Loc settings.square.loadDevices.tooltip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Margin="0,0,8,0" />
                                                        <TextBlock Text="{loc:Loc settings.square.loadDevices}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Grid Height="98" Margin="0,4,0,0">
                                                <ListBox x:Name="SquareDeviceList"
                                                         ItemsSource="{Binding SquareDevices}"
                                                         SelectedItem="{Binding SelectedSquareDevice, Mode=TwoWay}"
                                                         Style="{StaticResource SquareCompactListBoxStyle}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Right"
                                                                        Background="{DynamicResource PosSurfaceAltBrush}"
                                                                        BorderBrush="{DynamicResource PosBorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="13"
                                                                        Padding="10,2"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StatusDisplayName}" FontSize="12.5" FontWeight="Bold"
                                                                               Foreground="{DynamicResource PosTextSecondaryBrush}" />
                                                                </Border>
                                                                <StackPanel Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontFamily="Consolas"
                                                                               Foreground="{DynamicResource PosMutedForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="{loc:Loc settings.square.device.empty}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SquareListEmptyTextStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasItems, ElementName=SquareDeviceList}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="3" Width="1" HorizontalAlignment="Center" Background="{DynamicResource PosDividerBrush}" />

                                        <!-- 右栏：⑤设备码管理。沙盒环境下输入与按钮整体禁用，底部提示槽由帮助说明换成「不支持」警告（二选一，高度不变）。 -->
                                        <ScrollViewer Grid.Column="4"
                                                      Style="{DynamicResource PosVerticalTouchScrollViewerStyle}"
                                                      Focusable="False"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      PanningMode="VerticalOnly">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Height="24" Margin="0,0,0,8">
                                                    <Border Style="{StaticResource SettingsStepBadgeStyle}" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
                                                        <TextBlock Text="5" Style="{StaticResource SettingsStepBadgeTextStyle}" FontSize="12.5" />
                                                    </Border>
                                                    <TextBlock Text="{loc:Loc settings.square.deviceCodes}"
                                                               Style="{StaticResource SettingsSectionTitleStyle}"
                                                               FontSize="15"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel IsEnabled="{Binding IsSquareDeviceCodesSupported}">
                                                    <!-- 第一行：新设备码名称 + 创建设备码 -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{loc:Loc settings.square.deviceCodeName}" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,2" />
                                                            <TextBox Text="{Binding SquareDeviceCodeNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding CreateDeviceCodeCommand}"
                                                                Style="{StaticResource PosPrimaryButtonStyle}"
                                                                Height="48"
                                                                Padding="16,0"
                                                                VerticalAlignment="Bottom"
                                                                Margin="8,0,0,-2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="PlusCircleOutline" Width="20" Height="20" Margin="0,0,8,0" Foreground="White" />
                                                                <TextBlock Text="{loc:Loc settings.square.createDeviceCode}" Foreground="White" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <!-- 第二行：设备码列表下拉 + 加载设备码 + 刷新状态（设备码的刷新，与直连的「刷新直连状态」不同） -->
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{loc:Loc settings.square.deviceCodeList}" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,2" />
                                                            <ComboBox ItemsSource="{Binding SquareDeviceCodes}"
                                                                      SelectedItem="{Binding SelectedSquareDeviceCode, Mode=TwoWay}"
                                                                      Style="{StaticResource SettingsComboBoxStyle}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                                            <TextBlock FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}">
                                                                                <Run Text="{Binding Code}" />
                                                                                <Run Text="  " />
                                                                                <Run Text="{Binding Status}" />
                                                                                <Run Text="  " />
                                                                                <Run Text="{Binding DeviceId}" />
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding LoadDeviceCodesCommand}"
                                                                Style="{StaticResource SettingsTouchButtonHeight}"
                                                                Padding="14,0"
                                                                VerticalAlignment="Bottom"
                                                                Margin="8,0,0,0">
                                                            <TextBlock Text="{loc:Loc settings.square.loadDeviceCodes}" />
                                                        </Button>
                                                        <Button Grid.Column="2"
                                                                Command="{Binding RefreshDeviceCodeStatusCommand}"
                                                                Style="{StaticResource SettingsTouchButtonHeight}"
                                                                Padding="14,0"
                                                                VerticalAlignment="Bottom"
                                                                Margin="8,0,0,0">
                                                            <TextBlock Text="{loc:Loc settings.square.refreshDeviceCode}" />
                                                        </Button>
                                                    </Grid>

                                                    <!-- 选中设备码时放大显示（固定 60 高），方便在终端上照着输入。 -->
                                                    <Border Height="60"
                                                            Background="{DynamicResource PosSurfaceBrush}"
                                                            BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}"
                                                            BorderThickness="2"
                                                            CornerRadius="12">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedSquareDeviceCode}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SelectedSquareDeviceCode.Code}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="34"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock FontSize="12.5" Margin="16,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource PosMutedForegroundBrush}">
                                                                <Run Text="{Binding SelectedSquareDeviceCode.Name, Mode=OneWay}" />
                                                                <Run Text=" · " />
                                                                <Run Text="{Binding SelectedSquareDeviceCode.Status, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- 提示槽（最小高 50）：生产环境显示帮助说明，沙盒环境换成「仅支持 Production」警告，二选一。 -->
                                                <Grid MinHeight="50" Margin="0,6,0,0">
                                                    <TextBlock Text="{loc:Loc settings.square.deviceCodesHelp}"
                                                               FontSize="12"
                                                               LineHeight="16"
                                                               LineStackingStrategy="BlockLineHeight"
                                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsSquareDeviceCodesSupported, Converter={StaticResource BoolToVis}}" />
                                                    <Border Background="{DynamicResource PosWarningSoftBrush}"
                                                            BorderBrush="{DynamicResource PosWarningBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10,6"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsSquareDeviceCodesUnsupported, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding SquareDeviceCodesUnavailableText}"
                                                                   FontSize="12.5"
                                                                   Foreground="{DynamicResource PosWarningTextBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <!-- ===== PAGE: PaymentTerminal / Square END ===== -->

                            <!-- ===== PAGE: PaymentTerminal / Linkly BEGIN ===== -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource PosPrimarySoftBrush}" Margin="0,0,14,0">
                                            <materialDesign:PackIcon Kind="LanConnect" Width="24" Height="24" Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LinklyTitleText}" FontSize="17" />
                                            <TextBlock Text="{loc:Loc settings.payment.provider.linkly.subtitle}"
                                                       FontSize="12" FontWeight="Normal"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem.Header>
                                <!-- 首屏重设计：整页是左右两列 + 底部 34 高状态条（高度预算：正文内容 ≤ 366 = 322 + 8 + 36）。
                                     左列（400）= 「连接模式 / 连接优先级」合并列表 + 模式说明；右列 = 当前查看模式自己的字段/状态。
                                     所有操作按钮在页面固定底栏（Linkly 底栏区块），页内只有输入与状态。 -->
                                <Grid>
                                    <Grid.Resources>
                                        <!-- 页面级样式（只在 Linkly 页内使用，不动文件顶部的共享资源）。 -->

                                        <!-- 模式行里「整行可点」的透明按钮：无边框无底色，只负责接收点击。 -->
                                        <Style x:Key="LinklyFlatRowButtonStyle" TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <!-- 模式行右侧 ⚙ ▲ ▼：44×44 方形图标按钮。 -->
                                        <Style x:Key="LinklyIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                            <Setter Property="Width" Value="44" />
                                            <Setter Property="Height" Value="44" />
                                            <Setter Property="MinHeight" Value="44" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>

                                        <!-- 线路列表（固定高度内部滚动，区内不放功能按钮）：圆角外框 + 触屏纵向滚动，选中行浅蓝底 + 左侧蓝条。 -->
                                        <Style x:Key="LinklyLineListBoxStyle" TargetType="ListBox">
                                            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBox">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8"
                                                                ClipToBounds="True">
                                                            <ScrollViewer Style="{DynamicResource PosVerticalTouchScrollViewerStyle}"
                                                                          Focusable="False"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          HorizontalScrollBarVisibility="Disabled"
                                                                          CanContentScroll="False"
                                                                          PanningMode="VerticalOnly">
                                                                <ItemsPresenter />
                                                            </ScrollViewer>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="ItemContainerStyle">
                                                <Setter.Value>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="ItemBorder"
                                                                            MinHeight="52"
                                                                            Background="Transparent"
                                                                            BorderBrush="{DynamicResource PosDividerBrush}"
                                                                            BorderThickness="0,0,0,1"
                                                                            Padding="12,5,10,5">
                                                                        <Grid>
                                                                            <Rectangle x:Name="SelectedBar"
                                                                                       Width="3"
                                                                                       Margin="-12,-5,0,-5"
                                                                                       HorizontalAlignment="Left"
                                                                                       Fill="{DynamicResource PosPrimaryBrush}"
                                                                                       Visibility="Collapsed" />
                                                                            <ContentPresenter VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                                                            <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>

                                        <!-- 线路状态胶囊：底色与文字色成对。 -->
                                        <Style x:Key="LinklyChipBorderStyle" TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10" />
                                            <Setter Property="Padding" Value="8,1" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                            <Setter Property="Background" Value="{DynamicResource PosDividerBrush}" />
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" MinHeight="316" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="400" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                <!-- ===== PAGE: PaymentTerminal / Linkly.Common (header / priority list / mode picker / SOP) BEGIN ===== -->
                                <!-- 左列：标题行（连接模式 / 连接优先级 + 查看设置说明）→ 3 行模式列表 → 当前模式说明。
                                     原三选一单选（LinklySettingsMode）与连接优先级列表合并：点行 = 切换查看（与原单选同一语义，
                                     即 SelectedLinklyMode 赋值，VM 里会同时提升为首选）；⚙ = 设为首选并查看（原命令）；▲▼ = 调序（原命令）。
                                     顶部标题块、SOP 折叠面板、优先级行的 HelpKey 原本就是 Collapsed，不再保留；SOP 覆盖层沿用。 -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <Grid Height="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                   Margin="0,0,8,0"><Run Text="{loc:Loc settings.linkly.mode.title}" /><Run Text=" / " FontWeight="SemiBold" /><Run Text="{loc:Loc settings.linkly.priority.title}" FontWeight="SemiBold" /></TextBlock>
                                        <Button Grid.Column="1"
                                                Command="{Binding OpenLinklySetupInstructionsCommand}"
                                                Style="{StaticResource PosSecondaryButtonStyle}"
                                                Height="44"
                                                Padding="10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="BookOpenPageVariantOutline" Width="18" Height="18" Margin="0,0,6,0" />
                                                <TextBlock Text="{loc:Loc settings.linkly.sop.open}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- 3 行模式列表：行高固定 62，行间距 6（共 204 含末行下边距）。 -->
                                    <ItemsControl ItemsSource="{Binding LinklyModePriorityItems}" Margin="0,6,0,0"
                                                  AutomationProperties.AutomationId="LinklyModePriorityList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="62" Margin="0,0,0,6" CornerRadius="10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Style.Triggers>
                                                                <!-- 「正在查看」高亮：当前查看模式 == 本行模式（按三个模式各一条触发器）。 -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Mode}" Value="LocalIp" />
                                                                        <Condition Binding="{Binding DataContext.IsLinklyLocalIpMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Mode}" Value="CloudDirectSync" />
                                                                        <Condition Binding="{Binding DataContext.IsLinklyCloudDirectSyncMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Mode}" Value="CloudBackendAsync" />
                                                                        <Condition Binding="{Binding DataContext.IsLinklyCloudBackendAsyncMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid Margin="6,0,8,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- 点行（排名 + 名称 + 短说明）= 切换查看该模式；命令即原 ⚙ 命令（原单选与它一样会提升为首选）。 -->
                                                        <Button Grid.Column="0" Grid.ColumnSpan="2"
                                                                Style="{StaticResource LinklyFlatRowButtonStyle}"
                                                                Command="{Binding DataContext.SelectLinklyPriorityModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="50" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding Rank}"
                                                                               FontSize="20"
                                                                               FontWeight="Black"
                                                                               HorizontalAlignment="Center"
                                                                               Foreground="{DynamicResource PosAccentBrush}" />
                                                                    <Border CornerRadius="9" Padding="7,0" Margin="0,2,0,0" HorizontalAlignment="Center">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{DynamicResource PosDividerBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Rank}" Value="1">
                                                                                        <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{Binding RoleKey, Converter={StaticResource LocalizationKeyConverter}}"
                                                                                   FontSize="11"
                                                                                   FontWeight="Bold">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Rank}" Value="1">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource PosPrimaryTextBrush}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                                                    <TextBlock Text="{Binding ModeKey, Converter={StaticResource LocalizationKeyConverter}}"
                                                                               FontSize="15"
                                                                               FontWeight="Bold"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource PosTextBrush}" />
                                                                    <!-- 新增短说明（三种模式各一句，中英各 3 键 settings.linkly.mode.*.short）；完整说明在左列底部与「查看设置说明」。 -->
                                                                    <TextBlock FontSize="11.5"
                                                                               LineHeight="14"
                                                                               LineStackingStrategy="BlockLineHeight"
                                                                               TextWrapping="Wrap"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               MaxHeight="28"
                                                                               Margin="0,2,0,0"
                                                                               Foreground="{DynamicResource PosMutedForegroundBrush}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="{loc:Loc settings.linkly.mode.localIp.short}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Mode}" Value="CloudDirectSync">
                                                                                        <Setter Property="Text" Value="{loc:Loc settings.linkly.mode.cloudDirectSync.short}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Mode}" Value="CloudBackendAsync">
                                                                                        <Setter Property="Text" Value="{loc:Loc settings.linkly.mode.cloudBackendAsync.short}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <Button Style="{StaticResource LinklyIconButtonStyle}"
                                                                    Command="{Binding DataContext.SelectLinklyPriorityModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{loc:Loc settings.linkly.priority.configure}"
                                                                    AutomationProperties.Name="{loc:Loc settings.linkly.priority.configure}">
                                                                <materialDesign:PackIcon Kind="Cog" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Button>
                                                            <Button Style="{StaticResource LinklyIconButtonStyle}"
                                                                    Margin="8,0,0,0"
                                                                    Command="{Binding DataContext.MoveLinklyPriorityUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{loc:Loc settings.linkly.priority.moveUp}"
                                                                    AutomationProperties.Name="{loc:Loc settings.linkly.priority.moveUp}">
                                                                <materialDesign:PackIcon Kind="ChevronUp" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Button>
                                                            <Button Style="{StaticResource LinklyIconButtonStyle}"
                                                                    Margin="8,0,0,0"
                                                                    Command="{Binding DataContext.MoveLinklyPriorityDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="{loc:Loc settings.linkly.priority.moveDown}"
                                                                    AutomationProperties.Name="{loc:Loc settings.linkly.priority.moveDown}">
                                                                <materialDesign:PackIcon Kind="ChevronDown" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 当前查看模式的说明（真实文案：标题 + 描述），最多 4 行，超出省略。 -->
                                    <TextBlock Visibility="{Binding IsLinklyLocalIpMode, Converter={StaticResource BoolToVis}}"
                                               FontSize="11" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60" Margin="2,0,0,0"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"><Run Text="{loc:Loc settings.linkly.localIp.title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" /> <Run Text="{loc:Loc settings.linkly.localIp.description}" /></TextBlock>
                                    <TextBlock Visibility="{Binding IsLinklyCloudDirectSyncMode, Converter={StaticResource BoolToVis}}"
                                               FontSize="11" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60" Margin="2,0,0,0"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"><Run Text="{loc:Loc settings.linkly.cloudDirect.title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" /> <Run Text="{loc:Loc settings.linkly.cloudDirect.description}" /></TextBlock>
                                    <TextBlock Visibility="{Binding IsLinklyCloudBackendAsyncMode, Converter={StaticResource BoolToVis}}"
                                               FontSize="11" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60" Margin="2,0,0,0"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"><Run Text="{loc:Loc settings.linkly.cloudBackend.title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" /> <Run Text="{loc:Loc settings.linkly.cloudBackend.description}" /></TextBlock>
                                </StackPanel>
                                <!-- ===== PAGE: PaymentTerminal / Linkly.Common (header / priority list / mode picker / SOP) END ===== -->

                                <!-- ===== PAGE: PaymentTerminal / Linkly.LocalIp BEGIN ===== -->
                                <!-- 本地 IP：地址卡（默认官方推荐地址大字；「自定义地址（高级）」就地切换为 IP / 端口输入框，高度不变）
                                     + 终端超时秒数 + 提示。环境分段在二级页签条右侧；测试 / 登录银行网络 / 启用在底栏。 -->
                                <StackPanel Grid.Row="0" Grid.Column="2"
                                            Visibility="{Binding IsLinklyLocalIpMode, Converter={StaticResource BoolToVis}}">
                                    <Border Padding="14,10" CornerRadius="12" BorderThickness="1.5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource PosBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLinklyRecommendedAddress}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PosPrimarySoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" MinHeight="66" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0" Kind="Monitor" Width="26" Height="26"
                                                                         Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                         VerticalAlignment="Center" Margin="0,0,14,0" />
                                                <!-- 展示态：推荐地址等宽大字（自定义编辑展开时隐藏）。 -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=LinklyCustomAddressToggle}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock FontFamily="Consolas" FontSize="24" FontWeight="Bold">
                                                        <Run Text="{Binding LinklyHostText, Mode=OneWay}" />
                                                        <Run Text=" : " Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                                        <Run Text="{Binding LinklyPortText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <!-- 编辑态：IP 地址 + 端口输入（原「自定义地址（高级）」展开区）。 -->
                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=LinklyCustomAddressToggle}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="120" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{loc:Loc settings.linkly.localIp.ipAddress}" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,2" />
                                                        <TextBox Text="{Binding LinklyHostText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource SettingsFieldTextBoxStyle}" FontFamily="Consolas" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{loc:Loc settings.linkly.port}" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,2" />
                                                        <TextBox Text="{Binding LinklyPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource SettingsFieldTextBoxStyle}" FontFamily="Consolas" />
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <!-- 官方推荐徽标（推荐地址时显示）。 -->
                                                    <Border Background="{DynamicResource PosSurfaceBrush}"
                                                            BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="14"
                                                            Padding="12,4"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsLinklyRecommendedAddress, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{loc:Loc settings.linkly.localIp.recommendedBadge}"
                                                                   FontSize="12.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                                    </Border>
                                                    <!-- 使用推荐地址（非推荐地址时显示）。 -->
                                                    <Button Command="{Binding UseRecommendedLinklyAddressCommand}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SettingsTouchButtonHeight}">
                                                                <!-- 展示态居中；编辑态输入框上方有标签，按钮对齐输入框底部。 -->
                                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=LinklyCustomAddressToggle}" Value="True">
                                                                        <Setter Property="VerticalAlignment" Value="Bottom" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLinklyRecommendedAddress}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Restore" Width="20" Height="20" Margin="0,0,8,0" />
                                                            <TextBlock Text="{loc:Loc settings.linkly.localIp.useRecommended}" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{loc:Loc settings.linkly.localIp.recommended.help}"
                                                           FontSize="12"
                                                           LineHeight="16"
                                                           LineStackingStrategy="BlockLineHeight"
                                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="48"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0" />
                                                <!-- 「自定义地址（高级）」开关：勾选后上面的大字就地换成 IP / 端口输入框（原 Expander）。 -->
                                                <ToggleButton Grid.Column="1"
                                                              x:Name="LinklyCustomAddressToggle"
                                                              Height="44"
                                                              Padding="12,0"
                                                              Cursor="Hand"
                                                              VerticalAlignment="Center"
                                                              FocusVisualStyle="{x:Null}"
                                                              AutomationProperties.AutomationId="LinklyCustomAddressToggle">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="Bd"
                                                                    Background="{DynamicResource PosSurfaceBrush}"
                                                                    BorderBrush="{DynamicResource PosBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{loc:Loc settings.linkly.localIp.customTitle}"
                                                                               FontSize="14" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                               VerticalAlignment="Center" />
                                                                    <materialDesign:PackIcon x:Name="Caret" Kind="ChevronDown" Width="18" Height="18"
                                                                                             Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                             Foreground="{DynamicResource PosTextSecondaryBrush}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Caret" Property="Kind" Value="ChevronUp" />
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc settings.square.timeoutSeconds}" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBox Text="{Binding TimeoutSecondsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,22,0,0">
                                            <Border Background="{DynamicResource PosWarningSoftBrush}"
                                                    BorderBrush="{DynamicResource PosWarningBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,6">
                                                <DockPanel>
                                                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="AlertOutline" Width="18" Height="18"
                                                                             Foreground="{DynamicResource PosAccentBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{loc:Loc settings.linkly.localIp.testSafetyShort}"
                                                               FontSize="12" Foreground="{DynamicResource PosWarningTextBrush}" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </Border>
                                            <!-- 沙盒本地 IP 才显示的安全提示。 -->
                                            <Border Background="{DynamicResource PosPrimarySoftBrush}"
                                                    BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,6"
                                                    Margin="0,8,0,0"
                                                    Visibility="{Binding IsLinklySandboxLocalIpMode, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{loc:Loc settings.linkly.localIp.sandboxSafety}"
                                                           FontSize="11.5"
                                                           LineHeight="15"
                                                           LineStackingStrategy="BlockLineHeight"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PosTextBrush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="75" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <!-- ===== PAGE: PaymentTerminal / Linkly.LocalIp END ===== -->

                                <!-- ===== PAGE: PaymentTerminal / Linkly.CloudDirectSync BEGIN ===== -->
                                <!-- Cloud 直连同步：密钥/凭据状态 → 刷卡机配对（账号 / 密码 / 配对码）。
                                     保存测试账号、配对 Cloud / 取消、测试、启用都在底栏；环境分段在二级页签条右侧。 -->
                                <StackPanel Grid.Row="0" Grid.Column="2"
                                            Visibility="{Binding IsLinklyCloudDirectSyncMode, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc settings.linkly.cloud.secret}" Style="{StaticResource SettingsLabelStyle}" />
                                            <Border Height="44" Background="{DynamicResource PosSurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource PosBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,0">
                                                <DockPanel VerticalAlignment="Center">
                                                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="ShieldKeyOutline" Width="18" Height="18"
                                                                             Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding LinklyCloudSecretStatusText}" FontSize="12" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                                               Foreground="{DynamicResource PosMutedForegroundBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                               MaxHeight="30" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc settings.linkly.cloud.credential}" Style="{StaticResource SettingsLabelStyle}" />
                                            <Border Height="44" Background="{DynamicResource PosSurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource PosBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,0">
                                                <DockPanel VerticalAlignment="Center">
                                                    <materialDesign:PackIcon DockPanel.Dock="Left" Kind="ShieldKeyOutline" Width="18" Height="18"
                                                                             Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding LinklyCloudCredentialStatusText}" FontSize="12" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                                               Foreground="{DynamicResource PosMutedForegroundBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                               MaxHeight="30" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                                        <TextBlock Text="{loc:Loc settings.linkly.cloud.terminalPairingTitle}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource PosTextBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc settings.linkly.cloud.terminalPairingSubtitle}" FontSize="12"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc settings.linkly.cloud.username}" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBox Text="{Binding LinklyCloudUsernameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc settings.linkly.cloud.password}" Style="{StaticResource SettingsLabelStyle}" />
                                            <PasswordBox x:Name="LinklyCloudPasswordBox"
                                                         PasswordChanged="LinklyCloudPasswordBox_PasswordChanged"
                                                         Style="{StaticResource SettingsFieldPasswordBoxStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc settings.linkly.cloud.pairCode}" Style="{StaticResource SettingsLabelStyle}" />
                                            <TextBox Text="{Binding LinklyPairCodeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" FontFamily="Consolas" FontSize="20" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <!-- ===== PAGE: PaymentTerminal / Linkly.CloudDirectSync END ===== -->

                                <!-- ===== PAGE: PaymentTerminal / Linkly.CloudBackendAsync BEGIN ===== -->
                                <!-- Cloud 后端异步：master-detail。
                                     第一行 刷卡机下拉 + 刷新（两个原「刷新」合并为一个）→ Web 管理凭据提示 → 线路列表（固定高度内部滚动）+ 聚焦线路详情。
                                     线路动作（重新配对 / 检测连接 / 使用此线路 / 变更绑定 / 解除绑定）都在底栏，作用于「当前聚焦线路」FocusedLinklyCloudLine。
                                     md 区固定 214 高，保证最大内容（配对确认步）也放得进 1366×632。 -->
                                <Grid Grid.Row="0" Grid.Column="2"
                                      Visibility="{Binding IsLinklyCloudBackendAsyncMode, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="214" />
                                    </Grid.RowDefinitions>

                                    <!-- 刷卡机下拉（旧下拉保留：选中即触发切换付款线路）+ 刷新。 -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Loc settings.linkly.cloudBackend.terminal}"
                                                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ComboBox Grid.Column="1"
                                                  Style="{StaticResource SettingsComboBoxStyle}"
                                                  ItemsSource="{Binding LinklyCloudTerminals}"
                                                  SelectedItem="{Binding SelectedLinklyCloudTerminal, Mode=TwoWay}"
                                                  SelectionChanged="LinklyCloudTerminal_SelectionChanged"
                                                  AutomationProperties.AutomationId="LinklyCloudTerminalSelector">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid MinWidth="260">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="4" Padding="7,3" Margin="0,0,9,0">
                                                            <TextBlock Text="{Binding LaneNo, StringFormat=Lane {0}}" FontSize="11" FontWeight="Bold" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="2" Text="{Binding PairingState}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="10,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="3"
                                                Click="RefreshLinklyCloudTerminals_Click"
                                                IsEnabled="{Binding CanRefreshLinklyCloudTerminals}"
                                                Style="{StaticResource PosSecondaryButtonStyle}"
                                                Height="44"
                                                MinWidth="96"
                                                Padding="14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,7,0" />
                                                <TextBlock Text="{loc:Loc settings.linkly.cloudBackend.refresh}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Cloud 用户名和密码由 Web 管理后台统一维护（整句保留，最多 2 行）。 -->
                                    <Border Grid.Row="1" Margin="0,8,0,8"
                                            Background="{DynamicResource PosPrimarySoftBrush}"
                                            BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="ShieldLockOutline" Width="18" Height="18"
                                                                     Foreground="{DynamicResource PosPrimaryTextBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{loc:Loc settings.linkly.cloudBackend.credentialsManagedByWeb}"
                                                       FontSize="11.5" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                                       Foreground="{DynamicResource PosTextBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       MaxHeight="30" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- master-detail：左 252 线路列表，右聚焦线路详情。 -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="252" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 线路列表：行数不定 → 固定高度内部滚动，区内不放功能按钮；点选 = 聚焦（不切换付款线路）。 -->
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="22" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{loc:Loc settings.linkly.lines.description}">
                                                <Run Text="{loc:Loc settings.linkly.lines.title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" /><Run Text="  " /><Run Text="{loc:Loc settings.linkly.lines.description}" FontSize="11" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                            </TextBlock>
                                            <!-- 单一列表同时呈现权威绑定状态和逐线路配对状态，避免同一线路出现两套互相矛盾的操作。 -->
                                            <ListBox Grid.Row="1"
                                                     Style="{StaticResource LinklyLineListBoxStyle}"
                                                     ItemsSource="{Binding LinklyCloudLines}"
                                                     SelectedItem="{Binding FocusedLinklyCloudLine, Mode=TwoWay}"
                                                     SelectionMode="Single"
                                                     AutomationProperties.AutomationId="LinklyCloudLineCards">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <DockPanel LastChildFill="True">
                                                                <Border DockPanel.Dock="Right" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding LaneLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <WrapPanel Margin="0,3,0,0">
                                                                <!-- 配对状态：已就绪=绿，其它=黄。 -->
                                                                <Border Margin="0,0,6,2">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource LinklyChipBorderStyle}">
                                                                            <Setter Property="Background" Value="{DynamicResource PosWarningSoftBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Terminal.IsReady}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding PairingStatusText}" FontSize="11" FontWeight="Bold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PosWarningTextBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Terminal.IsReady}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                                <!-- 连接状态：已连接=绿，失败=红，其它（未检测）=灰。 -->
                                                                <Border Margin="0,0,6,2">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border" BasedOn="{StaticResource LinklyChipBorderStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource PosSuccessSoftBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding HasConnectionFailure}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource PosDangerSoftBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding ConnectionStatusText}" FontSize="11" FontWeight="Bold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" /></DataTrigger>
                                                                                    <DataTrigger Binding="{Binding HasConnectionFailure}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                                <TextBlock Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource PosSuccessTextBrush}">
                                                                    <Run Text="●" /> <Run Text="{loc:Loc settings.linkly.lines.selected}" />
                                                                </TextBlock>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>

                                        <!-- 没有任何线路：空状态（替代详情区）。管理接口过旧的提示在这里也要能看到。 -->
                                        <StackPanel Grid.Column="2">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLinklyCloudTerminals}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{loc:Loc settings.linkly.lines.empty}" TextWrapping="Wrap" FontSize="12.5"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,2,0,8" />
                                            <Border Background="{DynamicResource PosWarningSoftBrush}" BorderBrush="{DynamicResource PosWarningBorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,6"
                                                    Visibility="{Binding IsLinklyCloudLineManagementUnavailable, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding LinklyCloudLineManagementMessage}" FontSize="11.5" Foreground="{DynamicResource PosWarningTextBrush}" TextWrapping="Wrap" />
                                            </Border>
                                        </StackPanel>

                                        <!-- 聚焦线路详情：DataContext = FocusedLinklyCloudLine（没有线路时整块折叠）。
                                             VM 级属性（管理接口可用性、命令）一律通过祖先 UserControl 的 DataContext 访问。 -->
                                        <Grid Grid.Column="2" DataContext="{Binding FocusedLinklyCloudLine}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 常态：线路名 + 三项状态 + 连接帮助 + 变更绑定（管理接口过旧时换成黄色提示）。 -->
                                            <StackPanel Grid.Row="0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <DockPanel Height="28" LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" FontSize="17" FontWeight="Black"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" />
                                                    <Border DockPanel.Dock="Left" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="4" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LaneLabel}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                                    </Border>
                                                    <Border DockPanel.Dock="Left" Background="{DynamicResource PosSuccessSoftBrush}" CornerRadius="10" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{loc:Loc settings.linkly.lines.selected}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PosSuccessTextBrush}" />
                                                    </Border>
                                                </DockPanel>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{loc:Loc settings.linkly.lines.pairingStatus}" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,1" />
                                                        <TextBlock Text="{Binding PairingStatusText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Terminal.IsReady}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{loc:Loc settings.linkly.lines.connectionStatus}" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,1" />
                                                        <TextBlock Text="{Binding ConnectionStatusText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PosSuccessTextBrush}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasConnectionFailure}" Value="True"><Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{loc:Loc settings.linkly.cloudBackend.boundDevice}" Style="{StaticResource SettingsLabelStyle}" Margin="0,0,0,1" />
                                                        <TextBlock Text="{Binding ManagementItem.AssignedDeviceCode, TargetNullValue=—}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                                <!-- 连接帮助（有才显示，最多 2 行）。 -->
                                                <Border Background="{DynamicResource PosWarningSoftBrush}" BorderBrush="{DynamicResource PosWarningBorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,6,0,0"
                                                        Visibility="{Binding HasConnectionHelp, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding ConnectionHelpText}" FontSize="11.5" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30"
                                                               Foreground="{DynamicResource PosWarningTextBrush}" />
                                                </Border>
                                                <!-- 变更绑定：目标 POS 下拉（动作按钮在底栏）。 -->
                                                <DockPanel Margin="0,8,0,0" Visibility="{Binding SupportsManagement, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock DockPanel.Dock="Left" Text="{loc:Loc settings.linkly.cloudBackend.changeBinding}"
                                                               FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                                                              ItemsSource="{Binding ManagementItem.AssignableDevices}"
                                                              SelectedItem="{Binding ManagementItem.SelectedTargetDevice, Mode=TwoWay}"
                                                              AutomationProperties.AutomationId="LinklyLineAssignmentTarget">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock>
                                                                    <Run Text="{Binding DeviceCode}" /><Run Text=" · " /><Run Text="{Binding DeviceSystem}" />
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </DockPanel>
                                                <!-- 管理接口过旧（SupportsManagement=false）：黄色提示取代变更绑定槽位。 -->
                                                <Border Margin="0,8,0,0" Background="{DynamicResource PosWarningSoftBrush}" BorderBrush="{DynamicResource PosWarningBorderBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="10,6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SupportsManagement}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding DataContext.LinklyCloudLineManagementMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               FontSize="11.5" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="45"
                                                               Foreground="{DynamicResource PosWarningTextBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- 配对面板（展开时取代常态内容）：输入码 → 确认两步，按钮留在面板内（有输入框的二步表单），底栏的「重新配对 / 收起」只负责开关。 -->
                                            <Border Grid.Row="0" Background="{DynamicResource PosPrimarySoftBrush}" BorderBrush="{DynamicResource PosPrimarySoftBorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Top"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <!-- 步骤 1：输入新配对码。 -->
                                                    <StackPanel Visibility="{Binding IsEnteringCode, Converter={StaticResource BoolToVis}}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{loc:Loc settings.linkly.lines.working}" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PosPrimaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="170"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                                       Visibility="{Binding IsOperationBusy, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{loc:Loc settings.linkly.lines.enterTitle}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                        <TextBlock Text="{loc:Loc settings.linkly.lines.enterHelp}" FontSize="11.5" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" Margin="0,4,0,6" />
                                                        <DockPanel LastChildFill="False">
                                                            <TextBox DockPanel.Dock="Left"
                                                                     Text="{Binding PairCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="6"
                                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" Height="52" FontSize="26" FontFamily="Consolas"
                                                                     HorizontalContentAlignment="Center" Width="190"
                                                                     InputMethod.IsInputMethodEnabled="False" SpellCheck.IsEnabled="False"
                                                                     AutomationProperties.Name="{loc:Loc settings.linkly.cloud.pairCode}"
                                                                     AutomationProperties.AutomationId="LinklyLinePairCode" />
                                                            <Button DockPanel.Dock="Right" Command="{Binding NextCommand}" Style="{StaticResource PosPrimaryButtonStyle}" Height="44" Padding="16,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{loc:Loc settings.linkly.lines.next}" Foreground="White" />
                                                            </Button>
                                                            <Button DockPanel.Dock="Right" Command="{Binding CancelCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Height="44" Padding="16,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{loc:Loc settings.linkly.lines.cancel}" />
                                                            </Button>
                                                        </DockPanel>
                                                    </StackPanel>
                                                    <!-- 步骤 2：确认线路与配对码（最高内容）。 -->
                                                    <StackPanel Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{loc:Loc settings.linkly.lines.working}" FontSize="11.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PosPrimaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="170"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                                       Visibility="{Binding IsOperationBusy, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{loc:Loc settings.linkly.lines.confirmTitle}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" MaxWidth="170" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding LaneLabel}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{loc:Loc settings.linkly.lines.confirmHelp}" FontSize="11.5" LineHeight="15" LineStackingStrategy="BlockLineHeight"
                                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="45" VerticalAlignment="Top" />
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{loc:Loc settings.linkly.cloud.pairCode}" FontSize="12" FontWeight="Bold"
                                                                       Foreground="{DynamicResource PosMutedForegroundBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <TextBlock Text="{Binding PairCode}" FontSize="26" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Button Command="{Binding BackCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Height="44" Padding="14,0" Margin="0,0,8,0">
                                                                <TextBlock Text="{loc:Loc settings.linkly.lines.back}" />
                                                            </Button>
                                                            <Button Command="{Binding ConfirmCommand}" Style="{StaticResource PosPrimaryButtonStyle}" Height="44" Padding="14,0" Margin="0,0,8,0"
                                                                    AutomationProperties.AutomationId="LinklyLineConfirmPairing">
                                                                <TextBlock Text="{loc:Loc settings.linkly.lines.confirm}" Foreground="White" />
                                                            </Button>
                                                            <Button Command="{Binding CancelCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Height="44" Padding="14,0">
                                                                <TextBlock Text="{loc:Loc settings.linkly.lines.cancel}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- 说明（常态与配对时都显示，最多 3 行）：Ready 含义 + 一次只展开一条线路。 -->
                                            <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="11" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}"><Run Text="{loc:Loc settings.linkly.cloudBackend.readyHint}" /> <Run Text="{loc:Loc settings.linkly.lines.singleExpandedHint}" /></TextBlock>
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <!-- ===== PAGE: PaymentTerminal / Linkly.CloudBackendAsync END ===== -->

                                <!-- ===== PAGE: PaymentTerminal / Linkly.StandardActions (local IP / cloud direct bottom actions + test status) BEGIN ===== -->
                                <!-- 底部 34 高状态条（三种模式共用，固定高度不挤布局）：显示 LinklyTestStatusMessage，最多 2 行省略；
                                     后端异步模式且还没有测试结果时，显示「已为当前 POS 选择 …」（原来在卡片外重复出现两次的 SelectedLinklyCloudTerminalText）。
                                     原来的底部按钮（测试 Linkly / 登录银行网络 / 启用 Linkly）已移到页面固定底栏（Linkly 底栏区块）。 -->
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                        Height="34" Margin="0,6,0,0" Padding="12,0" CornerRadius="8" BorderThickness="1"
                                        Background="{DynamicResource PosSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource PosDividerBrush}">
                                    <DockPanel VerticalAlignment="Center">
                                        <materialDesign:PackIcon DockPanel.Dock="Left" Kind="InformationOutline" Width="16" Height="16"
                                                                 Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock FontSize="12" FontWeight="SemiBold" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="28" VerticalAlignment="Center"
                                                   AutomationProperties.AutomationId="LinklyTestStatusMessage">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding LinklyTestStatusMessage}" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsLinklyCloudBackendAsyncMode}" Value="True" />
                                                                <Condition Binding="{Binding LinklyTestStatusMessage}" Value="" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="{Binding SelectedLinklyCloudTerminalText}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                                <!-- ===== PAGE: PaymentTerminal / Linkly.StandardActions (local IP / cloud direct bottom actions + test status) END ===== -->
                                </Grid>
                            </TabItem>
                            <!-- ===== PAGE: PaymentTerminal / Linkly END ===== -->
                        </TabControl>
                    </Grid>
                </controls:SettingsPageHost>
                <!-- ===== PAGE: PaymentTerminal END ===== -->

                <!-- ===== PAGE: ReceiptPrinter BEGIN ===== -->
                <!-- 小票页根：左 = SettingsPageHost（二级页签条 / 正文 / 固定底栏），右 = 296 宽的独立小票预览栏（占满整页高度）。
                     预览放在 SettingsPageHost 之外（页面级右列），这样三个分页共用同一份预览，且预览不会挤占页签条与底栏的宽度。
                     外层 Grid 与 SettingsPageHost 绑定同一个可见性，保证框架里「六个页面容器按分类互斥显示」的约定不变。 -->
                <Grid Visibility="{Binding IsReceiptPrinterSelected, Converter={StaticResource BoolToVis}}">
                    <Grid.Resources>
                        <!-- 页面级样式（只在小票页内使用，不进共享资源区）。尺寸按 1366×632 首屏预算：分页内容区可用高度约 366。 -->
                        <Style x:Key="ReceiptCardStyle" TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Padding" Value="12,9" />
                        </Style>
                        <Style x:Key="ReceiptCardTitleStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="15" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                        <Style x:Key="ReceiptHintTextStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                        <!-- 开关行：白底圆角框，最小 56 高。 -->
                        <Style x:Key="ReceiptSwitchRowStyle" TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Padding" Value="12,6" />
                            <Setter Property="MinHeight" Value="56" />
                        </Style>
                        <Style x:Key="ReceiptSwitchTitleStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="15" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                        <!-- 「打印机端口（高级）」展开开关：无边框的平面按钮，只显示箭头 + 文字；展开时输入框出现在同一行，不增加高度。 -->
                        <Style x:Key="ReceiptAdvancedToggleStyle" TargetType="ToggleButton">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Focusable" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" MinHeight="44">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="ReceiptAdvancedChevronStyle" TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="ChevronRight" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                    <Setter Property="Kind" Value="ChevronDown" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <!-- 顶部分页条右侧的「总部下发」锁提示：只在本机已应用过总部下发、且不在「打印机与选项」分页时显示。 -->
                        <Style x:Key="ReceiptManagedHintBorderStyle" TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsReceiptProfileManaged}" Value="True" />
                                        <Condition Binding="{Binding IsReceiptHardwareSubTabSelected}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                        <!-- 底栏「立即同步 / 从分店资料载入」：只在门店信息、小票条款两个分页显示（命令相同）。 -->
                        <Style x:Key="ReceiptSyncButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsTouchButtonHeight}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReceiptHardwareSubTabSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                        <!-- 底栏左侧「修改后自动保存」空闲提示：有测试 / 同步状态消息时让位给消息。 -->
                        <Style x:Key="ReceiptIdleHintStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReceiptPrinterTestStatusMessage}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="296" />
                    </Grid.ColumnDefinitions>

                    <controls:SettingsPageHost Grid.Column="0"
                                               Style="{StaticResource SettingsPageHostStyle}"
                                               Visibility="{Binding IsReceiptPrinterSelected, Converter={StaticResource BoolToVis}}">
                        <!-- ===== PAGE: ReceiptPrinter / ReceiptSubTabs BEGIN ===== -->
                        <controls:SettingsPageHost.SubTabs>
                            <!-- 分页条：打印机与选项 / 门店信息 / 小票条款；右侧放「总部下发」锁提示和当前分页的区块保存状态。 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SettingsSegmentHostStyle}"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="ReceiptSubTabs"
                                                     Style="{StaticResource SettingsSubTabRadioStyle}"
                                                     IsChecked="{Binding IsReceiptHardwareSubTabSelected, Mode=TwoWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{loc:Loc settings.subtab.receiptHardware}" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource SettingsUnsavedDotStyle}" Visibility="{Binding HasReceiptHardwareUnsaved, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="ReceiptSubTabs"
                                                     Style="{StaticResource SettingsSubTabRadioStyle}"
                                                     IsChecked="{Binding IsReceiptStoreSubTabSelected, Mode=TwoWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="StorefrontOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{loc:Loc settings.subtab.receiptStore}" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource SettingsUnsavedDotStyle}" Visibility="{Binding HasReceiptStoreUnsaved, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="ReceiptSubTabs"
                                                     Style="{StaticResource SettingsSubTabRadioStyle}"
                                                     IsChecked="{Binding IsReceiptTermsSubTabSelected, Mode=TwoWay}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{loc:Loc settings.subtab.receiptTerms}" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource SettingsUnsavedDotStyle}" Visibility="{Binding HasReceiptTermsUnsaved, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>

                                <DockPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <!-- 区块保存状态：只显示当前分页自己的（已保存时文字为空、自动折叠；失败红色、草稿橙色）。 -->
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding ReceiptHardwareSaveStateText}"
                                               Tag="{Binding ReceiptHardwareSaveState}"
                                               Visibility="{Binding IsReceiptHardwareSubTabSelected, Converter={StaticResource BoolToVis}}"
                                               Style="{StaticResource SettingsSectionStateTextStyle}" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding ReceiptStoreSaveStateText}"
                                               Tag="{Binding ReceiptStoreSaveState}"
                                               Visibility="{Binding IsReceiptStoreSubTabSelected, Converter={StaticResource BoolToVis}}"
                                               Style="{StaticResource SettingsSectionStateTextStyle}" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding ReceiptTermsSaveStateText}"
                                               Tag="{Binding ReceiptTermsSaveState}"
                                               Visibility="{Binding IsReceiptTermsSubTabSelected, Converter={StaticResource BoolToVis}}"
                                               Style="{StaticResource SettingsSectionStateTextStyle}" />
                                    <!-- 总部下发提示：门店信息、小票条款两个分页共用（资料字段只读，请到 Web 分店管理修改）。 -->
                                    <Border Style="{StaticResource ReceiptManagedHintBorderStyle}">
                                        <DockPanel>
                                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="LockOutline" Width="18" Height="18"
                                                                     Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                                                     Visibility="{Binding IsReceiptProfileManaged, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding ReceiptProfileManagedHintText}"
                                                       Visibility="{Binding IsReceiptProfileManaged, Converter={StaticResource BoolToVis}}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DockPanel>
                            </Grid>
                        </controls:SettingsPageHost.SubTabs>
                        <!-- ===== PAGE: ReceiptPrinter / ReceiptSubTabs END ===== -->

                        <!-- 固定底栏：左侧状态文字（测试打印 / 立即同步的结果，三个分页通用；没有消息时显示「修改后自动保存」），
                             右侧「立即同步」（门店信息、小票条款分页）和「保存小票打印机」（仅关闭自动保存时）。 -->
                        <controls:SettingsPageHost.Footer>
                            <controls:SettingsFooterBar>
                                <Grid controls:SettingsFooterBar.IsFill="True" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc settings.autosave.hint}" Style="{StaticResource ReceiptIdleHintStyle}" />
                                    <TextBlock Text="{Binding ReceiptPrinterTestStatusMessage}"
                                               ToolTip="{Binding ReceiptPrinterTestStatusMessage}"
                                               FontSize="13"
                                               Foreground="{DynamicResource PosTextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.LiveSetting="Polite" />
                                </Grid>
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        Command="{Binding LoadReceiptProfileCommand}"
                                        Style="{StaticResource ReceiptSyncButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="20" Height="20" Margin="0,0,8,0" />
                                        <!-- 本机已应用过总部下发（版本 > 0）时显示「立即同步」，否则保持「从分店资料载入」。 -->
                                        <TextBlock Text="{Binding ReceiptProfileLoadButtonText}" />
                                    </StackPanel>
                                </Button>
                                <!-- ===== PAGE: ReceiptPrinter / ReceiptLegacySave BEGIN ===== -->
                                <!-- 旧的整页保存按钮（显式保存路径）：开启自动保存后隐藏；命令与原来完全相同。 -->
                                <Button controls:SettingsFooterBar.IsRight="True"
                                        Command="{Binding SaveReceiptPrinterCommand}"
                                        Visibility="{Binding IsExplicitSaveVisible, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                        Height="48"
                                        MinWidth="170"
                                        Padding="18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,8,0" Foreground="White" />
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.save}" Foreground="White" FontSize="16" />
                                    </StackPanel>
                                </Button>
                                <!-- ===== PAGE: ReceiptPrinter / ReceiptLegacySave END ===== -->
                            </controls:SettingsFooterBar>
                        </controls:SettingsPageHost.Footer>

                        <!-- 正文：三个分页叠在同一个单元格里，按所选分页互斥显示。 -->
                        <Grid>
                            <!-- ===== PAGE: ReceiptPrinter / ReceiptHardware BEGIN ===== -->
                            <!-- 打印机与选项：双栏。左 = 打印机连接 + 打印选项；右 = 再次扫码确认。 -->
                            <Grid Visibility="{Binding IsReceiptHardwareSubTabSelected, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <!-- 打印机连接：默认 USB，端口收进“高级”一行（固定 56 高，展开只在同一行出现输入框）。 -->
                                    <Border Style="{StaticResource ReceiptCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.connection.title}" Style="{StaticResource ReceiptCardTitleStyle}" />
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.connection.help}" Style="{StaticResource ReceiptHintTextStyle}" />
                                            <Border Background="{DynamicResource PosSurfaceBrush}"
                                                    BorderBrush="{DynamicResource PosDividerBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,8"
                                                    Margin="0,8,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="44" Height="44" CornerRadius="10"
                                                            Background="{DynamicResource PosSurfaceAltBrush}"
                                                            BorderBrush="{DynamicResource PosDividerBrush}"
                                                            BorderThickness="1"
                                                            Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Printer" Width="26" Height="26"
                                                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.port}" Style="{StaticResource ReceiptHintTextStyle}" FontWeight="Bold" />
                                                        <TextBlock FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PosTextBrush}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding ReceiptPrinterPortText, Mode=OneWay}" FontFamily="Consolas" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <!-- 「打印机端口（高级）」：固定 56 高。折叠时只有箭头 + 标题；展开时端口输入框出现在同一行右侧，整块高度不变。 -->
                                            <Border Height="56"
                                                    Margin="0,8,0,0"
                                                    Background="{DynamicResource PosSurfaceBrush}"
                                                    BorderBrush="{DynamicResource PosDividerBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="ReceiptPrinterPortAdvancedToggle"
                                                                  Grid.Column="0"
                                                                  Style="{StaticResource ReceiptAdvancedToggleStyle}"
                                                                  AutomationProperties.Name="{loc:Loc settings.receiptPrinter.port.advanced}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Style="{StaticResource ReceiptAdvancedChevronStyle}"
                                                                                     Width="18" Height="18" Margin="0,0,6,0"
                                                                                     Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.port.advanced}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PosTextSecondaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <TextBox Grid.Column="1"
                                                             Margin="10,0,0,0"
                                                             VerticalAlignment="Center"
                                                             Visibility="{Binding IsChecked, ElementName=ReceiptPrinterPortAdvancedToggle, Converter={StaticResource BoolToVis}}"
                                                             Text="{Binding ReceiptPrinterPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="{loc:Loc settings.receiptPrinter.port}"
                                                             Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                             FontFamily="Consolas" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- 打印选项：客人小票是否附带银行收据原文。 -->
                                    <Border Style="{StaticResource ReceiptCardStyle}" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.options.title}" Style="{StaticResource ReceiptCardTitleStyle}" />
                                            <Border Style="{StaticResource ReceiptSwitchRowStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="10"
                                                            Background="{DynamicResource PosPrimarySoftBrush}"
                                                            Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="20" Height="20"
                                                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.printBankReceipt}" Style="{StaticResource ReceiptSwitchTitleStyle}" />
                                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.printBankReceipt.help}" Style="{StaticResource ReceiptHintTextStyle}" />
                                                    </StackPanel>
                                                    <ToggleButton Grid.Column="2"
                                                                  x:Name="PrintBankReceiptTextToggle"
                                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                                  IsChecked="{Binding ReceiptPrintBankReceiptText, Mode=TwoWay}"
                                                                  AutomationProperties.Name="{loc:Loc settings.receiptPrinter.printBankReceipt}"
                                                                  MinHeight="48"
                                                                  MinWidth="56"
                                                                  VerticalAlignment="Center">
                                                    </ToggleButton>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 再次扫码确认：开启后，对应操作即使当前收银员自己有权限，也要再扫一次授权员工条码。 -->
                                <Border Grid.Column="2"
                                        Style="{StaticResource ReceiptCardStyle}"
                                        VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.rescan.title}" Style="{StaticResource ReceiptCardTitleStyle}" />
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.rescan.help}" Style="{StaticResource ReceiptHintTextStyle}" Margin="0,0,0,6" />
                                        <!-- 无交易开钱箱：只管侧栏「开钱箱」按钮，收现金后的自动开钱箱不受影响。 -->
                                        <Border Style="{StaticResource ReceiptSwitchRowStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="10"
                                                        Background="{DynamicResource PosPrimarySoftBrush}"
                                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20"
                                                                             Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Loc settings.receiptPrinter.noSaleDrawerRescan}" Style="{StaticResource ReceiptSwitchTitleStyle}" />
                                                    <TextBlock Text="{loc:Loc settings.receiptPrinter.noSaleDrawerRescan.help}" Style="{StaticResource ReceiptHintTextStyle}" />
                                                </StackPanel>
                                                <ToggleButton Grid.Column="2"
                                                              x:Name="NoSaleCashDrawerRescanToggle"
                                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                              IsChecked="{Binding ReceiptNoSaleCashDrawerRequiresRescan, Mode=TwoWay}"
                                                              AutomationProperties.Name="{loc:Loc settings.receiptPrinter.noSaleDrawerRescan}"
                                                              MinHeight="48"
                                                              MinWidth="56"
                                                              VerticalAlignment="Center">
                                                </ToggleButton>
                                            </Grid>
                                        </Border>

                                        <!-- 退货操作：只管侧栏「退款」进入退货页那一下；进入后加行、确认退货不再重复扫码。 -->
                                        <Border Style="{StaticResource ReceiptSwitchRowStyle}" Margin="0,6,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="10"
                                                        Background="{DynamicResource PosPrimarySoftBrush}"
                                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="CashRefund" Width="20" Height="20"
                                                                             Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Loc settings.receiptPrinter.returnsRescan}" Style="{StaticResource ReceiptSwitchTitleStyle}" />
                                                    <TextBlock Text="{loc:Loc settings.receiptPrinter.returnsRescan.help}" Style="{StaticResource ReceiptHintTextStyle}" />
                                                </StackPanel>
                                                <ToggleButton Grid.Column="2"
                                                              x:Name="ReturnsRescanToggle"
                                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                              IsChecked="{Binding ReceiptReturnsRequireRescan, Mode=TwoWay}"
                                                              AutomationProperties.Name="{loc:Loc settings.receiptPrinter.returnsRescan}"
                                                              MinHeight="48"
                                                              MinWidth="56"
                                                              VerticalAlignment="Center">
                                                </ToggleButton>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- ===== PAGE: ReceiptPrinter / ReceiptHardware END ===== -->

                            <!-- ===== PAGE: ReceiptPrinter / ReceiptStore BEGIN ===== -->
                            <!-- 门店信息：品牌 | 门店名称、电话 | ABN 两列，地址整行。总部下发后全部只读（灰底 + 锁图标），提示在分页条右侧；「立即同步」在底栏。 -->
                            <StackPanel Visibility="{Binding IsReceiptStoreSubTabSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc settings.receiptPrinter.storeInfo.title}"
                                           FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{DynamicResource PosTextBrush}" />
                                <TextBlock Text="{loc:Loc settings.receiptPrinter.storeInfo.help}"
                                           Style="{StaticResource SettingsPageDescriptionStyle}" Margin="0,2,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.brandName}" Style="{StaticResource SettingsLabelStyle}" />
                                        <Grid>
                                            <TextBox Text="{Binding ReceiptBrandNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                     Padding="12,0,36,0"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                            <materialDesign:PackIcon Kind="LockOutline" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                     IsHitTestVisible="False" Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                                     Visibility="{Binding IsReceiptProfileManaged, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.storeName}" Style="{StaticResource SettingsLabelStyle}" />
                                        <Grid>
                                            <TextBox Text="{Binding ReceiptStoreNameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                     Padding="12,0,36,0"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                            <materialDesign:PackIcon Kind="LockOutline" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                     IsHitTestVisible="False" Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                                     Visibility="{Binding IsReceiptProfileManaged, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.phone}" Style="{StaticResource SettingsLabelStyle}" />
                                        <Grid>
                                            <TextBox Text="{Binding ReceiptStorePhoneText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                     Padding="12,0,36,0"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                            <materialDesign:PackIcon Kind="LockOutline" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                     IsHitTestVisible="False" Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                                     Visibility="{Binding IsReceiptProfileManaged, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.abn}" Style="{StaticResource SettingsLabelStyle}" />
                                        <Grid>
                                            <TextBox Text="{Binding ReceiptAbnText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                     Padding="12,0,36,0"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}" />
                                            <materialDesign:PackIcon Kind="LockOutline" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                     IsHitTestVisible="False" Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                                     Visibility="{Binding IsReceiptProfileManaged, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.address}" Style="{StaticResource SettingsLabelStyle}" />
                                        <Grid>
                                            <TextBox Text="{Binding ReceiptStoreAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                     Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                     Padding="12,8,36,8"
                                                     VerticalContentAlignment="Top"
                                                     Height="76"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     ScrollViewer.PanningMode="VerticalFirst"
                                                     VerticalScrollBarVisibility="Auto" />
                                            <materialDesign:PackIcon Kind="LockOutline" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,12,0"
                                                                     IsHitTestVisible="False" Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                                     Visibility="{Binding IsReceiptProfileManaged, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <!-- ===== PAGE: ReceiptPrinter / ReceiptStore END ===== -->

                            <!-- ===== PAGE: ReceiptPrinter / ReceiptTerms BEGIN ===== -->
                            <!-- 小票条款：三栏等宽文本框（退换货政策 / 代金券使用说明 / 分期条款），一行一条；留空＝使用内置默认文案。
                                 总部下发后只读（提示与「立即同步」同门店信息页，在分页条右侧和底栏）。
                                 正文外层是兜底 ScrollViewer（给子元素无限高度），所以文本框用固定高度，不能靠 * 行拉伸。 -->
                            <StackPanel Visibility="{Binding IsReceiptTermsSubTabSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc settings.receiptPrinter.terms.title}"
                                           FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{DynamicResource PosTextBrush}" />
                                <TextBlock Text="{loc:Loc settings.receiptPrinter.terms.subtitle}"
                                           Style="{StaticResource SettingsPageDescriptionStyle}" Margin="0,2,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.returnPolicy}" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBox Text="{Binding ReceiptReturnPolicyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                 Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                 Height="232"
                                                 MaxLength="500"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalContentAlignment="Top"
                                                 Padding="12,8"
                                                 ScrollViewer.PanningMode="VerticalFirst"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.voucherTerms}" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBox Text="{Binding ReceiptVoucherTermsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                 Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                 Height="232"
                                                 MaxLength="600"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalContentAlignment="Top"
                                                 Padding="12,8"
                                                 ScrollViewer.PanningMode="VerticalFirst"
                                                 VerticalScrollBarVisibility="Auto" />
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.termsHelp}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.installmentTerms}" Style="{StaticResource SettingsLabelStyle}" />
                                        <TextBox Text="{Binding ReceiptInstallmentTermsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsReceiptProfileManaged, Mode=OneWay}"
                                                 Style="{StaticResource SettingsFieldTextBoxStyle}"
                                                 Height="232"
                                                 MaxLength="600"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalContentAlignment="Top"
                                                 Padding="12,8"
                                                 ScrollViewer.PanningMode="VerticalFirst"
                                                 VerticalScrollBarVisibility="Auto" />
                                        <TextBlock Text="{loc:Loc settings.receiptPrinter.termsHelp}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <!-- ===== PAGE: ReceiptPrinter / ReceiptTerms END ===== -->
                        </Grid>
                    </controls:SettingsPageHost>

                    <!-- ===== PAGE: ReceiptPrinter / ReceiptPreview BEGIN ===== -->
                    <!-- 右栏：80mm 小票实时预览。296 宽、占满整页高度，三个分页共用；内部 ScrollViewer 可滚动（只含预览，不含功能按钮）。 -->
                    <Border Grid.Column="2"
                            Style="{StaticResource SettingsActionCardStyle}"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <Border DockPanel.Dock="Right"
                                        Background="{DynamicResource PosSurfaceAltBrush}"
                                        BorderBrush="{DynamicResource PosBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="80mm" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PosTextSecondaryBrush}" />
                                </Border>
                                <materialDesign:PackIcon Kind="ReceiptTextOutline"
                                                         Width="22"
                                                         Height="22"
                                                         Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                         Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Loc settings.receiptPrinter.preview}"
                                           FontSize="15"
                                           FontWeight="ExtraBold"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           VerticalAlignment="Center" />
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Background="{DynamicResource PosSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PosDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ScrollViewer Style="{DynamicResource PosVerticalTouchScrollViewerStyle}"
                                              Focusable="False"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="False"
                                              PanningMode="VerticalOnly"
                                              PanningDeceleration="0.0008"
                                              PanningRatio="1.0">
                                    <Border Width="240"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,14"
                                            Background="{DynamicResource PosSurfaceBrush}"
                                            Padding="14,16,14,20">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.18" Color="#FF64748B" />
                                        </Border.Effect>
                                        <!-- 小票纸张用表面色，深色主题下也保持可读。 -->
                                        <StackPanel TextElement.Foreground="{DynamicResource PosTextBrush}">
                                            <TextBlock Text="{Binding ReceiptBrandNameText}"
                                                       FontFamily="Consolas"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ReceiptStoreNameText}"
                                                       FontFamily="Consolas"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding ReceiptStoreAddressText}"
                                                       FontFamily="Consolas"
                                                       FontSize="10.5"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                            <TextBlock FontFamily="Consolas"
                                                       FontSize="10.5"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding ReceiptStorePhoneText, Mode=OneWay}" />
                                                <Run Text=" " />
                                                <Run Text="{Binding ReceiptAbnText, Mode=OneWay}" />
                                            </TextBlock>
                                            <Border BorderBrush="{DynamicResource PosBorderStrongBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Margin="0,12" />
                                            <TextBlock Text="{loc:Loc settings.receiptPrinter.test}"
                                                       FontFamily="Consolas"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       TextAlignment="Center" />
                                            <Border BorderBrush="{DynamicResource PosBorderStrongBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    Margin="0,12" />
                                            <TextBlock Text="{Binding ReceiptReturnPolicyText}"
                                                       FontFamily="Consolas"
                                                       FontSize="10.5"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- ===== PAGE: ReceiptPrinter / ReceiptPreview END ===== -->
                </Grid>
                <!-- ===== PAGE: ReceiptPrinter END ===== -->

                <!-- ===== PAGE: DeviceRegistration BEGIN ===== -->
                <!-- 设备注册：三栏（API 服务器 360 ｜ 网络检测 400 ｜ 更换分店注册 余宽），主体高度固定 436（可用 437，留 1px 余量；无页签条：528 - 底栏 65 - 边线 2 - 内边距 24）。
                     底栏三区与三栏对齐（同一组列宽）：测试连接、保存地址 ｜ 检测网络、复制报告 ｜ 更换分店重新注册（danger，与其它隔开）。
                     诊断的「一键修复 / 确认修改 / 还原修改」文案动态且很长，是底栏例外，留在网络检测卡内的固定状态区。 -->
                <controls:SettingsPageHost Style="{StaticResource SettingsPageHostStyle}"
                                           Visibility="{Binding IsDeviceRegistrationSelected, Converter={StaticResource BoolToVis}}">
                    <controls:SettingsPageHost.Resources>
                        <!-- 页面级样式：danger 描边按钮（白底、红描边红字），用于「更换分店重新注册」。 -->
                        <Style x:Key="DeviceDangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                            <Setter Property="BorderBrush" Value="{DynamicResource PosDangerBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PosDangerTextBrush}" />
                        </Style>
                        <Style x:Key="DeviceCardTitleStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="15" />
                            <Setter Property="FontWeight" Value="ExtraBold" />
                            <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                        </Style>
                        <Style x:Key="DeviceHintTextStyle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </controls:SettingsPageHost.Resources>

                    <Grid Height="436">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="400" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 第 1 栏：API 服务器（地址、填入本地 / 远程、状态消息、入口状态）；测试连接 / 保存地址在底栏。 -->
                        <controls:ApiServerSettingsPanel DataContext="{Binding ApiServerSettings}"
                                                         IsSettingsLayout="True"
                                                         Grid.Column="0" />

                        <!-- 第 2 栏：网络检测（步骤区固定高度内部滚动，结论 / 修复 / 确认 / 还原在卡内固定状态区）；服务缺失时整栏隐藏。 -->
                        <Grid Grid.Column="2"
                              Visibility="{Binding ApiServerSettings.HasNetworkDiagnostics, Converter={StaticResource BoolToVis}}">
                            <controls:NetworkDiagnosticsPanel DataContext="{Binding ApiServerSettings.Network}" />
                        </Grid>

                        <!-- 第 3 栏：更换分店注册。 -->
                        <Border Grid.Column="4"
                                Background="{DynamicResource PosSurfaceAltBrush}"
                                BorderBrush="{DynamicResource PosDividerBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding DeviceRegistrationTitleText}"
                                           FontSize="17"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource PosTextBrush}" />

                                <!-- 当前注册：门店名 (门店码)、当前收银设备、已启用。 -->
                                <Border Background="{DynamicResource PosSurfaceBrush}"
                                        BorderBrush="{DynamicResource PosDividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8"
                                        Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="44"
                                                Height="44"
                                                Background="{DynamicResource PosPrimarySoftBrush}"
                                                CornerRadius="10"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CashRegister"
                                                                     Width="28"
                                                                     Height="28"
                                                                     Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc settings.deviceRegistration.current}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                            <TextBlock FontSize="14.5"
                                                       FontWeight="ExtraBold"
                                                       Foreground="{DynamicResource PosTextBrush}"
                                                       TextWrapping="Wrap">
                                                <Run Text="{Binding Session.StoreName, Mode=OneWay}" />
                                                <Run Text=" (" />
                                                <Run Text="{Binding Session.StoreCode, Mode=OneWay}" />
                                                <Run Text=")" />
                                            </TextBlock>
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                       TextWrapping="Wrap">
                                                <Run Text="{loc:Loc settings.deviceRegistration.thisDevice}" />
                                                <Run Text=": " />
                                                <Run Text="{Binding Session.DeviceCode, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource PosSuccessSoftBrush}"
                                                CornerRadius="12"
                                                Padding="10,3"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc settings.deviceRegistration.active}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PosSuccessTextBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 需要主管授权。 -->
                                <Border Background="{DynamicResource PosWarningSoftBrush}"
                                        BorderBrush="{DynamicResource PosWarningBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ShieldAccountOutline"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Foreground="{DynamicResource PosAccentBrush}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:Loc settings.deviceRegistration.supervisorRequired}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PosWarningTextBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 继续前请确认（三条）。 -->
                                <TextBlock Text="{loc:Loc settings.deviceRegistration.beforeContinue}"
                                           FontSize="13"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           Margin="0,10,0,2" />
                                <StackPanel Orientation="Horizontal" MinHeight="24">
                                    <materialDesign:PackIcon Kind="Cart" Width="18" Height="18" Foreground="{DynamicResource PosPrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:Loc settings.deviceRegistration.checkCart}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" MinHeight="24" Margin="0,2,0,0">
                                    <materialDesign:PackIcon Kind="CreditCard" Width="18" Height="18" Foreground="{DynamicResource PosPrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:Loc settings.deviceRegistration.checkPayment}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" MinHeight="24" Margin="0,2,0,0">
                                    <materialDesign:PackIcon Kind="Sync" Width="18" Height="18" Foreground="{DynamicResource PosPrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:Loc settings.deviceRegistration.checkSync}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Text="{loc:Loc settings.deviceRegistration.description}"
                                           Style="{StaticResource DeviceHintTextStyle}"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="{loc:Loc settings.deviceRegistration.deviceReuse}"
                                           Style="{StaticResource DeviceHintTextStyle}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 固定底栏（声明在正文之后，保持文件内「地址面板先于更换分店命令」的顺序）。
                         三个区与上面三栏用同一组列宽，按钮落在各自栏的正下方：
                         区 1 测试连接（44）+ 保存地址（主按钮 48）｜区 2 检测网络 + 复制报告（有检测结果才出现）｜区 3 更换分店重新注册（danger，与前两区用分隔线隔开）。
                         命令都是原面板里那一批（ApiServerSettings.*），只是把按钮从面板内搬到了底栏。 -->
                    <controls:SettingsPageHost.Footer>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="400" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Command="{Binding ApiServerSettings.TestConnectionCommand}"
                                        AutomationProperties.Name="{loc:Loc settings.serverAddress.test}"
                                        Style="{StaticResource SettingsTouchButtonHeight}"
                                        Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="LanConnect" Width="20" Height="20" Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:Loc settings.serverAddress.test}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{Binding ApiServerSettings.SaveCommand}"
                                        AutomationProperties.Name="{loc:Loc settings.serverAddress.save}"
                                        Style="{StaticResource PosPrimaryButtonStyle}"
                                        Height="48"
                                        Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,8,0" Foreground="White" />
                                        <TextBlock Text="{loc:Loc settings.serverAddress.save}" Foreground="White" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Grid.Column="1" Style="{StaticResource SettingsFooterDividerStyle}" HorizontalAlignment="Center" />

                            <!-- 区 2：检测网络 + 复制报告；网络检测服务缺失时整区隐藏。 -->
                            <DockPanel Grid.Column="2"
                                       VerticalAlignment="Center"
                                       LastChildFill="True"
                                       Visibility="{Binding ApiServerSettings.HasNetworkDiagnostics, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding ApiServerSettings.Network.CopyReportCommand}"
                                        Visibility="{Binding ApiServerSettings.Network.HasResult, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.AutomationId="NetworkCopyReportButton"
                                        Style="{StaticResource SettingsTouchButtonHeight}"
                                        MinWidth="140"
                                        Margin="8,0,0,0">
                                    <TextBlock Text="{loc:Loc settings.network.copy}" />
                                </Button>
                                <Button Command="{Binding ApiServerSettings.Network.DiagnoseCommand}"
                                        AutomationProperties.AutomationId="NetworkDiagnoseButton"
                                        AutomationProperties.Name="{loc:Loc settings.network.diagnose}"
                                        Style="{StaticResource SettingsTouchButtonHeight}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Stethoscope" Width="20" Height="20" Margin="0,0,8,0" />
                                        <TextBlock Text="{loc:Loc settings.network.diagnose}" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>

                            <Border Grid.Column="3"
                                    Style="{StaticResource SettingsFooterDividerStyle}"
                                    Background="{DynamicResource PosDangerBorderBrush}"
                                    HorizontalAlignment="Center" />

                            <!-- 区 3：更换分店重新注册（danger 描边）；确认流程（主管授权、检查购物车 / 待同步订单）沿用，不变。 -->
                            <Button Grid.Column="4"
                                    Command="{Binding ReregisterDeviceCommand}"
                                    Style="{StaticResource DeviceDangerOutlineButtonStyle}"
                                    Height="48"
                                    VerticalAlignment="Center"
                                    Padding="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountSwitch" Width="20" Height="20" Margin="0,0,8,0" Foreground="{DynamicResource PosDangerTextBrush}" />
                                    <TextBlock Text="{loc:Loc settings.deviceRegistration.action}" Foreground="{DynamicResource PosDangerTextBrush}" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </controls:SettingsPageHost.Footer>
                </controls:SettingsPageHost>
                <!-- ===== PAGE: DeviceRegistration END ===== -->

                <!-- ===== PAGE: RemoteMaintenance BEGIN ===== -->
                <!-- 远程维护（首屏重设计）：上排左「标题卡 + 本机服务状态卡」、右「安装步骤卡（① ② ③）」，
                     下方通栏固定 76px 状态区（进度条 + 阶段 / 结果文案都落在这里，长错误文案最多两行放得下），
                     固定底栏只放一个主按钮（InstallRemoteMaintenanceCommand，文案随 RemoteMaintenanceActionText 切换，安装中由命令禁用）。 -->
                <controls:SettingsPageHost Style="{StaticResource SettingsPageHostStyle}"
                                           Visibility="{Binding IsRemoteMaintenanceSelected, Converter={StaticResource BoolToVis}}">
                    <controls:SettingsPageHost.Footer>
                        <controls:SettingsFooterBar>
                            <Button controls:SettingsFooterBar.IsRight="True"
                                    Command="{Binding InstallRemoteMaintenanceCommand}"
                                    Style="{StaticResource PosPrimaryButtonStyle}"
                                    Height="48"
                                    MinWidth="210"
                                    Padding="20,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Download"
                                                             Width="18"
                                                             Height="18"
                                                             Margin="0,0,8,0"
                                                             Foreground="White" />
                                    <TextBlock Text="{Binding RemoteMaintenanceActionText}" Foreground="White" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </controls:SettingsFooterBar>
                    </controls:SettingsPageHost.Footer>
                    <Grid>
                        <!-- 页面级样式：只在本页使用。 -->
                        <Grid.Resources>
                            <Style x:Key="RemoteMaintenanceCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsActionCardStyle}">
                                <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                                <Setter Property="Padding" Value="16,14" />
                            </Style>
                            <!-- 安装步骤行：白底圆角，最小高 44，左边是蓝色圆形序号。 -->
                            <Style x:Key="RemoteMaintenanceStepStyle" TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="MinHeight" Value="44" />
                                <Setter Property="Padding" Value="12,6" />
                                <Setter Property="Margin" Value="0,6,0,0" />
                            </Style>
                            <Style x:Key="RemoteMaintenanceStepNumberStyle" TargetType="Border">
                                <Setter Property="Width" Value="26" />
                                <Setter Property="Height" Value="26" />
                                <Setter Property="CornerRadius" Value="13" />
                                <Setter Property="Background" Value="{DynamicResource PosPrimaryBrush}" />
                                <Setter Property="Margin" Value="0,0,10,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="RemoteMaintenanceStepNumberTextStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="RemoteMaintenanceStepTextStyle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13.5" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{DynamicResource PosTextBrush}" />
                            </Style>
                            <!-- 空闲时状态区里的「—」占位：有进度 / 结果文案时折叠。 -->
                            <Style x:Key="RemoteMaintenanceIdlePlaceholderStyle" TargetType="TextBlock">
                                <Setter Property="Text" Value="—" />
                                <Setter Property="FontSize" Value="13.5" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{DynamicResource PosMutedForegroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRemoteMaintenanceProgress}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左列：标题卡 + 本机服务状态卡。 -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <Border Style="{StaticResource RemoteMaintenanceCardStyle}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left"
                                            Width="56"
                                            Height="56"
                                            Background="{DynamicResource PosPrimarySoftBrush}"
                                            CornerRadius="12"
                                            Margin="0,0,14,0">
                                        <materialDesign:PackIcon Kind="RemoteDesktop"
                                                                 Width="32"
                                                                 Height="32"
                                                                 Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RemoteMaintenanceTitleText}" FontSize="21" FontWeight="Black" />
                                        <TextBlock Text="{Binding RemoteMaintenanceDescriptionText}"
                                                   FontSize="12.5"
                                                   Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource RemoteMaintenanceCardStyle}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc settings.remoteMaintenance.localStatus}"
                                               Style="{StaticResource SettingsLabelStyle}"
                                               Margin="0,0,0,10" />
                                    <Border Background="{DynamicResource PosSurfaceBrush}"
                                            BorderBrush="{DynamicResource PosBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RemoteMaintenanceStatusText}"
                                                       FontSize="18"
                                                       FontWeight="Black"
                                                       Foreground="{DynamicResource PosTextBrush}" />
                                            <TextBlock Text="{Binding RemoteMaintenanceDetailText}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource PosMutedForegroundBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 右列：安装步骤卡（原 installHint 整段文字拆成「说明 + ① ② ③ + 保持 POS 打开」）。 -->
                        <Border Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource RemoteMaintenanceCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc settings.remoteMaintenance.installHint.intro}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <Border Style="{StaticResource RemoteMaintenanceStepStyle}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource RemoteMaintenanceStepNumberStyle}">
                                            <TextBlock Text="1" Style="{StaticResource RemoteMaintenanceStepNumberTextStyle}" />
                                        </Border>
                                        <TextBlock Text="{loc:Loc settings.remoteMaintenance.installHint.step1}" Style="{StaticResource RemoteMaintenanceStepTextStyle}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RemoteMaintenanceStepStyle}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource RemoteMaintenanceStepNumberStyle}">
                                            <TextBlock Text="2" Style="{StaticResource RemoteMaintenanceStepNumberTextStyle}" />
                                        </Border>
                                        <TextBlock Text="{loc:Loc settings.remoteMaintenance.installHint.step2}" Style="{StaticResource RemoteMaintenanceStepTextStyle}" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource RemoteMaintenanceStepStyle}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Style="{StaticResource RemoteMaintenanceStepNumberStyle}">
                                            <TextBlock Text="3" Style="{StaticResource RemoteMaintenanceStepNumberTextStyle}" />
                                        </Border>
                                        <TextBlock Text="{loc:Loc settings.remoteMaintenance.installHint.step3}" Style="{StaticResource RemoteMaintenanceStepTextStyle}" />
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="{loc:Loc settings.remoteMaintenance.installHint.keepOpen}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- 通栏固定 76px 状态区：空闲显示「—」；安装中 = 进度条 + 阶段文案；结束后同一位置显示最终结果（进度文案本身就是结果文案）。
                             固定高度，进度条 / 长文案出现与消失都不会让页面跳动；按钮不在这里，永远在底栏。 -->
                        <Border x:Name="RemoteMaintenanceStatusZone"
                                Grid.Row="1"
                                Grid.ColumnSpan="3"
                                Height="76"
                                Margin="0,12,0,0"
                                Padding="16,10"
                                ClipToBounds="True"
                                Background="{DynamicResource PosSurfaceAltBrush}"
                                BorderBrush="{DynamicResource PosDividerBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RemoteMaintenanceIdlePlaceholderStyle}" />
                                <StackPanel Visibility="{Binding HasRemoteMaintenanceProgress, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Height="4"
                                                 IsIndeterminate="{Binding IsRemoteMaintenanceInstalling}"
                                                 Visibility="{Binding IsRemoteMaintenanceInstalling, Converter={StaticResource BoolToVis}}"
                                                 Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding RemoteMaintenanceProgressText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               LineHeight="18"
                                               LineStackingStrategy="BlockLineHeight"
                                               Foreground="{DynamicResource PosTextBrush}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </controls:SettingsPageHost>
                <!-- ===== PAGE: RemoteMaintenance END ===== -->

                <!-- 员工 App 下载：iPhone 与安卓（含 PDA）各一张二维码卡片，所有收银员可见。 -->
                <!-- ===== PAGE: MobileAppDownload BEGIN ===== -->
                <!-- 员工 App 下载（首屏重设计）：两张横排卡（左 = 240px 白底二维码框 + 提示，右 = 图标标题 / 版本 / 链接框 + 复制链接 / 安卓首次安装提示），
                     二维码本体 222px 画在 240px 白底外框（内边距 8 + 1px 边线）内，留足白边保证可扫；整张二维码仍是点击放大入口（放大层在页面之外，沿用现有）。
                     「复制链接」是和链接框配对的行内操作，留在卡内；固定底栏只放页面级的「刷新」+ 状态文字（联网状态 / 复制反馈）。
                     两张卡合计约 312px，1366×632 下无需滚动。页面说明句已在顶栏显示（PageDescriptionText），正文不重复。 -->
                <controls:SettingsPageHost Style="{StaticResource SettingsPageHostStyle}"
                                           Visibility="{Binding IsMobileAppDownloadSelected, Converter={StaticResource BoolToVis}}">
                    <controls:SettingsPageHost.Footer>
                        <!-- 底栏跟随页面一样绑定到 MobileAppDownload 子 ViewModel。 -->
                        <controls:SettingsFooterBar DataContext="{Binding MobileAppDownload}">
                            <!-- 状态区（占满中间）：加载进度条 / 离线警告图标 / StatusText / 复制反馈。 -->
                            <Grid controls:SettingsFooterBar.IsFill="True" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" Width="60" Height="4" IsIndeterminate="True" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                                <materialDesign:PackIcon Grid.Column="1" Kind="AlertCircleOutline" Width="16" Height="16" Margin="0,0,6,0" Foreground="{DynamicResource PosMutedForegroundBrush}" VerticalAlignment="Center" Visibility="{Binding IsOfflineWarning, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12.5" Foreground="{DynamicResource PosMutedForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Grid.Column="3" Text="{Binding CopyFeedbackText}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PosSuccessBrush}" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasCopyFeedback, Converter={StaticResource BoolToVis}}" AutomationProperties.LiveSetting="Polite" />
                            </Grid>
                            <Button controls:SettingsFooterBar.IsRight="True"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Height="44"
                                    MinWidth="110"
                                    Padding="18,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                    <TextBlock Text="{loc:Loc mobileApp.refresh}" FontWeight="Bold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                </StackPanel>
                            </Button>
                        </controls:SettingsFooterBar>
                    </controls:SettingsPageHost.Footer>
                    <Grid>
                        <!-- 页面级样式：只在本页使用。 -->
                        <Grid.Resources>
                            <Style x:Key="MobileAppCardStyle" TargetType="Border" BasedOn="{StaticResource SettingsActionCardStyle}">
                                <Setter Property="Background" Value="{DynamicResource PosSurfaceAltBrush}" />
                                <Setter Property="Padding" Value="14" />
                            </Style>
                            <!-- 二维码背板固定纯白，不随主题：深色主题下白底留边才保证手机相机扫得到（主题测试只禁止直接写颜色名，这里走资源）。 -->
                            <SolidColorBrush x:Key="MobileAppQrBackdropBrush" Color="#FFFFFFFF" />
                            <!-- 二维码按钮：240×240 白底外框，二维码本体 222px 居中，四周白边 8px（含 1px 边线）。 -->
                            <Style x:Key="MobileAppQrButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                <Setter Property="Width" Value="240" />
                                <Setter Property="Height" Value="240" />
                                <Setter Property="Padding" Value="8" />
                                <Setter Property="Background" Value="{StaticResource MobileAppQrBackdropBrush}" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                            </Style>
                            <!-- 链接框：44 高，与「复制链接」按钮同高。 -->
                            <Style x:Key="MobileAppLinkBoxStyle" TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="Height" Value="44" />
                            </Style>
                            <Style x:Key="MobileAppCopyButtonStyle" TargetType="Button" BasedOn="{StaticResource PosSecondaryButtonStyle}">
                                <Setter Property="Height" Value="44" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="Margin" Value="0,8,0,0" />
                            </Style>
                            <Style x:Key="MobileAppIconBoxStyle" TargetType="Border">
                                <Setter Property="Width" Value="36" />
                                <Setter Property="Height" Value="36" />
                                <Setter Property="CornerRadius" Value="10" />
                                <Setter Property="Margin" Value="0,0,10,0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="MobileAppQrHintStyle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </Grid.Resources>
                        <Grid DataContext="{Binding MobileAppDownload}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- iPhone / iPad -->
                            <Border Grid.Column="0" Style="{StaticResource MobileAppCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 左：二维码（240 框 + 放大镜徽标）+ 其下一句提示（固定 34 高，英文两行也放得下）。 -->
                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="240" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="34" />
                                        </Grid.RowDefinitions>
                                        <Button Command="{Binding EnlargeCommand}"
                                                CommandParameter="ios"
                                                Style="{StaticResource MobileAppQrButtonStyle}"
                                                AutomationProperties.Name="{loc:Loc mobileApp.enlarge.open}">
                                            <!-- 内层固定 222×222：放大镜徽标贴在二维码画布右下角，图片小于画布时落在白边里。 -->
                                            <Grid Width="222" Height="222">
                                                <Image Source="{Binding IosQrPayload, Converter={StaticResource QrCodeImage}, ConverterParameter=222}"
                                                       Stretch="None"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource PosPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                                                    <materialDesign:PackIcon Kind="MagnifyPlus" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <TextBlock Grid.Row="2" Text="{loc:Loc mobileApp.ios.hint}" Style="{StaticResource MobileAppQrHintStyle}" />
                                    </Grid>
                                    <!-- 右：图标标题 / 最新版本 / 链接框 + 整宽复制按钮。 -->
                                    <StackPanel Grid.Column="2">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Style="{StaticResource MobileAppIconBoxStyle}" Background="{DynamicResource PosPrimarySoftBrush}">
                                                <materialDesign:PackIcon Kind="AppleIos" Width="22" Height="22" Foreground="{DynamicResource PosPrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc mobileApp.ios.title}" FontSize="15" FontWeight="Bold" />
                                                <TextBlock Text="{loc:Loc mobileApp.ios.subtitle}" FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock Text="{loc:Loc mobileApp.version}" FontSize="12.5" Foreground="{DynamicResource PosMutedForegroundBrush}" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding IosVersionText}" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border Style="{StaticResource MobileAppLinkBoxStyle}" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding IosLinkText}" FontSize="11.5" Foreground="{DynamicResource PosMutedForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Button Command="{Binding CopyLinkCommand}" CommandParameter="ios" Style="{StaticResource MobileAppCopyButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                                <TextBlock Text="{loc:Loc mobileApp.copyLink}" FontSize="13.5" FontWeight="Bold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 安卓手机 / PDA：二维码指向总部匿名下载入口，扫码后直接下载最新安装包。 -->
                            <Border Grid.Column="2" Style="{StaticResource MobileAppCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 左：二维码（同样 240 框）或「暂无安装包」占位（同尺寸同位置）+ 提示。 -->
                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="240" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="34" />
                                        </Grid.RowDefinitions>
                                        <Button Command="{Binding EnlargeCommand}"
                                                CommandParameter="android"
                                                Style="{StaticResource MobileAppQrButtonStyle}"
                                                AutomationProperties.Name="{loc:Loc mobileApp.enlarge.open}"
                                                Visibility="{Binding IsAndroidAvailable, Converter={StaticResource BoolToVis}}">
                                            <!-- 内层固定 222×222：放大镜徽标贴在二维码画布右下角，图片小于画布时落在白边里。 -->
                                            <Grid Width="222" Height="222">
                                                <Image Source="{Binding AndroidQrPayload, Converter={StaticResource QrCodeImage}, ConverterParameter=222}"
                                                       Stretch="None"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource PosPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                                                    <materialDesign:PackIcon Kind="MagnifyPlus" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <!-- 总部确认没有可下载的安卓包时，不显示会扫出 404 的二维码，改为说明与重试。 -->
                                        <Border Width="240"
                                                Height="240"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource PosSurfaceBrush}"
                                                BorderBrush="{DynamicResource PosDividerBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Visibility="{Binding IsAndroidNotPublished, Converter={StaticResource BoolToVis}}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
                                                <materialDesign:PackIcon Kind="PackageVariantClosed" Width="40" Height="40" Foreground="{DynamicResource PosMutedForegroundBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{loc:Loc mobileApp.android.notPublished}" FontSize="14" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,2" />
                                                <TextBlock Text="{loc:Loc mobileApp.android.notPublishedHint}" FontSize="11.5" Foreground="{DynamicResource PosMutedForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                                <Button Command="{Binding RefreshCommand}" Style="{StaticResource PosSecondaryButtonStyle}" Height="44" Padding="20,0" HorizontalAlignment="Center" Margin="0,10,0,0">
                                                    <TextBlock Text="{loc:Loc mobileApp.retry}" FontWeight="Bold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Row="2" Text="{loc:Loc mobileApp.android.hint}" Style="{StaticResource MobileAppQrHintStyle}" />
                                    </Grid>
                                    <!-- 右：图标标题 + 「PDA 扫这张」徽章 / 最新版本（含构建号、包大小，放不下自动折行）/ 链接框 + 复制 / 底部首次安装提示。 -->
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Style="{StaticResource MobileAppIconBoxStyle}" Background="{DynamicResource PosSuccessSoftBrush}">
                                                    <materialDesign:PackIcon Kind="Android" Width="22" Height="22" Foreground="{DynamicResource PosSuccessTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Loc mobileApp.android.title}" FontSize="15" FontWeight="Bold" />
                                                    <TextBlock Text="{loc:Loc mobileApp.android.subtitle}" FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <!-- 徽章独立一行，英文长文案不挤标题。 -->
                                            <Border Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" Margin="0,8,0,0">
                                                <TextBlock Text="{loc:Loc mobileApp.android.badge}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PosPrimaryTextBrush}" />
                                            </Border>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{loc:Loc mobileApp.version}" FontSize="12.5" Foreground="{DynamicResource PosMutedForegroundBrush}" VerticalAlignment="Top" Margin="0,0,8,0" />
                                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding AndroidVersionText}" FontSize="12.5" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding AndroidSizeText}" FontSize="12.5" Foreground="{DynamicResource PosMutedForegroundBrush}" Margin="8,0,0,0" Visibility="{Binding HasAndroidSize, Converter={StaticResource BoolToVis}}" />
                                                </WrapPanel>
                                            </Grid>
                                            <Border Style="{StaticResource MobileAppLinkBoxStyle}" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding AndroidLinkText}" FontSize="11.5" Foreground="{DynamicResource PosMutedForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Button Command="{Binding CopyLinkCommand}" CommandParameter="android" Style="{StaticResource MobileAppCopyButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16" Margin="0,0,6,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                                    <TextBlock Text="{loc:Loc mobileApp.copyLink}" FontSize="13.5" FontWeight="Bold" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Border Grid.Row="1" VerticalAlignment="Bottom" Background="{DynamicResource PosWarningSoftBrush}" BorderBrush="{DynamicResource PosWarningBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                                            <TextBlock Text="{loc:Loc mobileApp.android.note}" FontSize="12.5" Foreground="{DynamicResource PosWarningTextBrush}" TextWrapping="Wrap" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </controls:SettingsPageHost>
                <!-- ===== PAGE: MobileAppDownload END ===== -->
            </Grid>
        </Grid>

        <!-- 底部状态条（28）：状态文字 + 忙碌进度条。 -->
        <Border Grid.Row="2"
                Background="{DynamicResource PosSurfaceAltBrush}"
                BorderBrush="{DynamicResource PosDividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="InformationOutline"
                                         Width="14"
                                         Height="14"
                                         Foreground="{DynamicResource PosMutedForegroundBrush}"
                                         Margin="0,0,8,0" />
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Width="90"
                             Height="4"
                             Margin="14,0,0,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- 放大扫码：二维码放大到 360px，方便手机在收银台旁边远距离对准；点任意位置关闭。 -->
        <Border Grid.RowSpan="3"
                Background="#99000000"
                Visibility="{Binding MobileAppDownload.IsEnlarged, Converter={StaticResource BoolToVis}}">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding MobileAppDownload.CloseEnlargedCommand}" />
            </Border.InputBindings>
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,18">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding MobileAppDownload.EnlargedTitleText}" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <Border Background="{DynamicResource PosSurfaceBrush}" BorderBrush="{DynamicResource PosBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Image Source="{Binding MobileAppDownload.EnlargedQrPayload, Converter={StaticResource QrCodeImage}, ConverterParameter=360}"
                               Stretch="None"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <TextBlock Text="{loc:Loc mobileApp.enlarge.hint}" FontSize="12" Foreground="{DynamicResource PosMutedForegroundBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.RowSpan="3"
                Background="#99000000"
                Visibility="{Binding IsLinklySetupInstructionsOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="24">
                <Border Width="720"
                        MaxHeight="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PosSurfaceBrush}"
                        BorderBrush="{DynamicResource PosDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding CloseLinklySetupInstructionsCommand}"
                                    Style="{StaticResource PosSecondaryButtonStyle}"
                                    Width="38"
                                    Height="38"
                                    Padding="0">
                                <materialDesign:PackIcon Kind="Close"
                                                         Width="18"
                                                         Height="18"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc settings.linkly.sop.title}"
                                           FontSize="18"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource PosTextBrush}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.note}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,16,0" />
                            </StackPanel>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1"
                                      Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step1}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step2}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step3}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step4}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step5}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step6}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step7}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.cloud.step8}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.step1}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.step2}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.step3}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.repair.warning}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PosDangerTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step1}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step2}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step3}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step4}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step5}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step6}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step7}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step8}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step9}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step10}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.local.step11}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.manual.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.manual.steps}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.manual.warning}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PosDangerTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.ip.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.ip.steps}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.ip.note}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="{loc:Loc settings.linkly.sop.mode.title}"
                                           Style="{StaticResource SettingsLabelStyle}" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.mode.localIp}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.mode.cloudDirectSync}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="{loc:Loc settings.linkly.sop.mode.cloudBackendAsync}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PosMutedForegroundBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2"
                                Command="{Binding CloseLinklySetupInstructionsCommand}"
                                Style="{StaticResource PosPrimaryButtonStyle}"
                                Height="42"
                                MinWidth="110"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                            <TextBlock Text="{loc:Loc settings.linkly.sop.close}" Foreground="White" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 离开设置页时还有保存失败 / 未生效的修改：逐项列出位置与原因，三个选择。 -->
        <Border Grid.RowSpan="3"
                Background="#99000000"
                Visibility="{Binding IsLeaveDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="560"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertOutline" Width="24" Height="24" Margin="0,0,10,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PosDangerTextBrush}" />
                        <TextBlock Text="{Binding LeaveDialogTitleText}"
                                   FontSize="20"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{loc:Loc settings.autosave.leave.message}"
                               FontSize="13"
                               Foreground="{DynamicResource PosMutedForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,14" />
                    <ItemsControl ItemsSource="{Binding LeaveDialogItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PosDangerSoftBrush}"
                                        BorderBrush="{DynamicResource PosDangerBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LocationText}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource PosTextBrush}" />
                                        <TextBlock Text="{Binding DetailText}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource PosDangerTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Command="{Binding LeaveStayCommand}"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                MinHeight="52"
                                Padding="18,0"
                                Margin="0,0,10,0">
                            <TextBlock Text="{loc:Loc settings.autosave.leave.stay}" />
                        </Button>
                        <Button Command="{Binding LeaveDiscardCommand}"
                                Visibility="{Binding LeaveDialogCanDiscard, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource PosSecondaryButtonStyle}"
                                MinHeight="52"
                                Padding="18,0"
                                Margin="0,0,10,0">
                            <TextBlock Text="{loc:Loc settings.autosave.leave.discard}" Foreground="{DynamicResource PosDangerTextBrush}" />
                        </Button>
                        <Button Command="{Binding LeaveRetryCommand}"
                                Visibility="{Binding LeaveDialogCanRetry, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource PosPrimaryButtonStyle}"
                                MinHeight="52"
                                Padding="18,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" Foreground="White" />
                                <TextBlock Text="{loc:Loc settings.autosave.leave.retry}" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
