<Window x:Class="Hbpos.Updater.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hbpos.Updater"
        Title="{Binding WindowTitle}"
        Width="540"
        Height="380"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Topmost="True"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        AutomationProperties.AutomationId="UpdaterWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="InkBrush" Color="#FF1E293B" />
        <SolidColorBrush x:Key="BodyBrush" Color="#FF475569" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF64748B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="AccentDeepBrush" Color="#FF1D4ED8" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFEFF6FF" />
        <SolidColorBrush x:Key="TrackBrush" Color="#FFE2E8F0" />
        <SolidColorBrush x:Key="DividerBrush" Color="#FFEEF1F5" />
        <SolidColorBrush x:Key="PendingRingBrush" Color="#FFCBD5E1" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF15803D" />
        <SolidColorBrush x:Key="SuccessDeepBrush" Color="#FF166534" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#FFDCFCE7" />

        <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{StaticResource TrackBrush}" CornerRadius="5" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Foreground" Value="#FF16A34A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PercentTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPercentNumeric}" Value="True">
                    <Setter Property="FontSize" Value="40" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FromVersionPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF1F5F9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style x:Key="FromVersionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BodyBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToVersionPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToVersionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessDeepBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="12" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonBaseStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ActionButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Background" Value="{StaticResource AccentDeepBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentDeepBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1E40AF" />
                    <Setter Property="BorderBrush" Value="#FF1E40AF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource PendingRingBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF8FAFC" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonBaseStyle}">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextDecorations="Underline" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="StepTemplate" DataType="{x:Type local:UpdaterStepViewModel}">
            <StackPanel Orientation="Horizontal">
                <Grid Width="24" Height="24">
                    <Ellipse x:Name="Circle" Fill="White" Stroke="{StaticResource PendingRingBrush}" StrokeThickness="2" />
                    <TextBlock x:Name="Number"
                               Text="{Binding Number}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Path x:Name="Check"
                          Visibility="Collapsed"
                          Data="M7,12.5 L10.5,16 L17,8.5"
                          Stroke="White"
                          StrokeThickness="2.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Grid>
                <TextBlock x:Name="Label"
                           Margin="8,0,0,0"
                           Text="{Binding Label}"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:UpdaterStepState.Active}">
                    <Setter TargetName="Circle" Property="Fill" Value="{StaticResource AccentSoftBrush}" />
                    <Setter TargetName="Circle" Property="Stroke" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Number" Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource InkBrush}" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:UpdaterStepState.Done}">
                    <Setter TargetName="Circle" Property="Fill" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Circle" Property="Stroke" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource BodyBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- 外层留 10px 透明边距，与启动页一致，避免裁掉卡片圆角。 -->
    <Grid Margin="10" Background="Transparent">
        <Border Background="White"
                BorderBrush="#FFE3E7EF"
                BorderThickness="1"
                CornerRadius="18"
                Padding="32,28,32,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Image Width="48"
                           Height="48"
                           Source="pack://application:,,,/Resources/AppBrandIcon.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           IsHitTestVisible="False"
                           AutomationProperties.Name="HB POS" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"
                                   AutomationProperties.AutomationId="UpdaterTitle" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding Subtitle}"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="390"
                                   AutomationProperties.AutomationId="UpdaterSubtitle" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,22,0,0"
                            Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasVersions, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="UpdaterVersionRow">
                        <TextBlock Text="{Binding VersionLabel}"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <Border Margin="10,0,0,0" Style="{StaticResource FromVersionPillStyle}">
                            <TextBlock Text="{Binding FromVersion}" Style="{StaticResource FromVersionTextStyle}" />
                        </Border>
                        <Path Margin="10,0"
                              Width="16"
                              Height="16"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Data="M5,12 L19,12 M13,6 L19,12 L13,18"
                              Stroke="{StaticResource MutedBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <Border Style="{StaticResource ToVersionPillStyle}">
                            <TextBlock Text="{Binding ToVersion}" Style="{StaticResource ToVersionTextStyle}" />
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <Path Margin="0,0,6,0"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Data="M5,12.5 L9.5,17 L19,7.5"
                                      Stroke="{StaticResource SuccessBrush}"
                                      StrokeThickness="2.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding StageTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}"
                                           AutomationProperties.AutomationId="UpdaterStageTitle" />
                            </StackPanel>
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding StageDetail}"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"
                                       AutomationProperties.AutomationId="UpdaterStageDetail" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Bottom"
                                   Text="{Binding PercentText}"
                                   Style="{StaticResource PercentTextStyle}"
                                   AutomationProperties.AutomationId="UpdaterPercent" />
                    </Grid>

                    <Grid Height="10" Margin="0,10,0,0">
                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}"
                                     Style="{StaticResource ProgressBarStyle}"
                                     Visibility="{Binding IsDeterminate, Converter={StaticResource BoolToVis}}"
                                     AutomationProperties.AutomationId="UpdaterProgressBar" />
                        <Border Background="{StaticResource TrackBrush}"
                                CornerRadius="5"
                                ClipToBounds="True"
                                Visibility="{Binding IsIndeterminate, Converter={StaticResource BoolToVis}}">
                            <Border Width="120"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="IndeterminateTransform" X="-120" />
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="IndeterminateTransform"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="-120"
                                                                 To="456"
                                                                 Duration="0:0:1.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Border>
                    </Grid>

                    <DockPanel Margin="0,8,0,0" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding ElapsedText}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Typography.NumeralAlignment="Tabular"
                                   AutomationProperties.AutomationId="UpdaterElapsed" />
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding HintText}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Typography.NumeralAlignment="Tabular"
                                   AutomationProperties.AutomationId="UpdaterHint" />
                    </DockPanel>
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,20,0,0"
                        VerticalAlignment="Top"
                        Padding="16,14"
                        Background="#FFFEF2F2"
                        BorderBrush="#FFFECACA"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.AutomationId="UpdaterFailurePanel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="20" Height="20" Margin="0,1,0,0" VerticalAlignment="Top">
                            <Ellipse Margin="1.5" Stroke="#FFB91C1C" StrokeThickness="2" />
                            <Path Data="M10,5.8 L10,11.2 M10,14.2 L10,14.3"
                                  Stroke="#FFB91C1C"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{Binding FailureTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#FF991B1B"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="UpdaterFailureTitle" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding FailureMessage}"
                                       FontSize="13"
                                       LineHeight="19"
                                       Foreground="#FF7F1D1D"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="UpdaterFailureMessage" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,18,0,0"
                        Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.AutomationId="UpdaterSteps">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Grid.Column="0"
                                        Focusable="False"
                                        Content="{Binding DownloadStep}"
                                        ContentTemplate="{StaticResource StepTemplate}" />
                        <!-- 下载必然已完成，第一段连线始终是完成色。 -->
                        <Border Grid.Column="1" Height="2" Margin="10,0" Background="{StaticResource AccentBrush}" />
                        <ContentControl Grid.Column="2"
                                        Focusable="False"
                                        Content="{Binding InstallStep}"
                                        ContentTemplate="{StaticResource StepTemplate}" />
                        <Border Grid.Column="3" Height="2" Margin="10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LaunchStep.State}" Value="{x:Static local:UpdaterStepState.Pending}">
                                            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <ContentControl Grid.Column="4"
                                        Focusable="False"
                                        Content="{Binding LaunchStep}"
                                        ContentTemplate="{StaticResource StepTemplate}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,18,0,0"
                        Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left"
                                Content="{Binding ViewLogText}"
                                Command="{Binding ViewLogCommand}"
                                Style="{StaticResource LinkButtonStyle}"
                                Visibility="{Binding CanViewLog, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="UpdaterViewLogButton" />
                        <Button DockPanel.Dock="Right"
                                Margin="10,0,0,0"
                                Content="{Binding RetryText}"
                                Command="{Binding RetryCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.AutomationId="UpdaterRetryButton" />
                        <Button DockPanel.Dock="Right"
                                Content="{Binding OpenCurrentVersionText}"
                                Command="{Binding OpenCurrentVersionCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="UpdaterOpenCurrentButton" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
