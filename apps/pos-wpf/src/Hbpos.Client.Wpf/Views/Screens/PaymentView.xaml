                               TextWrapping="Wrap"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PosTextBrush}" />
                    <Button Command="{Binding CloseInstallmentMinimumNoticeCommand}"
                            AutomationProperties.AutomationId="InstallmentMinimumNoticeOkButton"
                            Style="{StaticResource PosPrimaryButtonStyle}"
                            MinWidth="160"
                            Height="48"
                            HorizontalAlignment="Right">
                        <TextBlock Text="{loc:Loc payment.installment.minimumNotice.ok}"
                                   Foreground="White"
                                   FontWeight="Black" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="3"
              Panel.ZIndex="21"
              Background="#99000000"
              Visibility="{Binding IsInstallmentCustomerDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="720"
                    MaxWidth="720"
                    Padding="22"
                    Background="{DynamicResource PosSurfaceBrush}"
                    BorderBrush="{DynamicResource PosDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="{DynamicResource PosPrimarySoftBrush}" CornerRadius="10">
                            <materialDesign:PackIcon Kind="AccountEdit"
                                                     Width="26"
                                                     Height="26"
                                                     Foreground="{DynamicResource PosPrimaryTextBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc payment.installment.customerDialogTitle}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="22"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource PosPrimaryTextBrush}" />
                        <Button Grid.Column="2"
                                Command="{Binding CancelInstallmentCustomerDialogCommand}"
                                Width="34"
                                Height="34"
                                Padding="0"
                                Style="{StaticResource TitleBarButtonStyle}">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{loc:Loc payment.installment.customerDialogHelp}"
                               Margin="0,14,0,12"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PosMutedForegroundBrush}" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc payment.installment.customerName}" Margin="0,0,0,6" FontSize="13" FontWeight="Black" Foreground="{DynamicResource PosTextBrush}" />
                            <Border CornerRadius="8" BorderThickness="2" Background="{DynamicResource PosSurfaceBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PosBorderStrongBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInstallmentCustomerNameDraftActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource PosPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBox x:Name="InstallmentCustomerDraftNameTextBox"
                                         Text="{Binding InstallmentCustomerDraftName, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="{loc:Loc payment.installment.customerNamePlaceholder}"
                                         GotKeyboardFocus="InstallmentCustomerDraftNameTextBoxGotKeyboardFocus"
                                         Style="{StaticResource InstallmentCustomerDialogTextBoxStyle}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
