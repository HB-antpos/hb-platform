                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <StackPanel Margin="0,0,28,10" MinWidth="125">
                                                                        <TextBlock Text="{loc:Loc settings.linkly.lines.connectionStatus}" Style="{StaticResource SettingsLabelStyle}" />
