<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Hbpos.Client.Wpf.Views.Controls">
    <!--
        设置页分类页面容器 SettingsPageHost 的样式与模板，由 PosTheme.xaml 合并（因此应用级资源里一定有）。
        本字典单独合并时无法用 StaticResource 看到 PosTheme 里的键，所以滚动区样式一律用 DynamicResource；
        颜色全部来自色板的 DynamicResource，随主题切换。

        结构（卡片：PosSurfaceBrush 底、1px PosDividerBrush 边、圆角 10）：
          Row 0  SubTabs  二级页签条（可选，约 69 高：上下 8 + 分段条 52 + 下边线 1）
          Row 1  Content  正文，外包 ScrollViewer（内容超出时的兜底；设计目标是不出现滚动条）
          Row 2  Footer   固定底部操作条（可选，上边线 1px，不随正文滚动）
    -->
    <Style x:Key="SettingsPageHostStyle" TargetType="{x:Type controls:SettingsPageHost}">
        <Setter Property="Background" Value="{DynamicResource PosSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PosDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- 正文内边距：纵 12 / 横 16。 -->
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsPageHost}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 二级页签条：圆角比外框小 1px（外框 10 - 边线 1），贴合卡片上沿。 -->
                            <Border x:Name="PART_SubTabsHost"
                                    Grid.Row="0"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource PosSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PosDividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="9,9,0,0"
                                    Padding="16,8">
                                <ContentPresenter Content="{TemplateBinding SubTabs}" />
                            </Border>

                            <!-- 正文：作为内容超出时的兜底滚动区，触屏纵向平移 + 惯性，与旧设置页外层滚动一致。 -->
                            <ScrollViewer x:Name="PART_BodyScrollViewer"
                                          Grid.Row="1"
                                          Style="{StaticResource PosVerticalTouchScrollViewerStyle}"
                                          Focusable="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          PanningMode="VerticalOnly"
                                          PanningDeceleration="0.0008"
                                          PanningRatio="1.0">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>

                            <!-- 固定底部操作条：最小高度 65（内边距 8 + 48 高主按钮 + 上边线 1），有无保存按钮都不跳高。 -->
                            <Border x:Name="PART_FooterHost"
                                    Grid.Row="2"
                                    Visibility="Collapsed"
                                    MinHeight="65"
                                    Background="{DynamicResource PosSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PosDividerBrush}"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,9,9"
                                    Padding="16,8">
                                <ContentPresenter Content="{TemplateBinding Footer}"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasSubTabs" Value="True">
                            <Setter TargetName="PART_SubTabsHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasFooter" Value="True">
                            <Setter TargetName="PART_FooterHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 隐式样式：直接 new 出来的 SettingsPageHost（例如测试里）和未写 Style 的用法也能拿到同一套模板。 -->
    <Style TargetType="{x:Type controls:SettingsPageHost}"
           BasedOn="{StaticResource SettingsPageHostStyle}" />

    <!-- 底栏里的 1px 竖分隔线（危险操作与其它操作之间），放在 SettingsFooterBar 内作为一个子元素。 -->
    <Style x:Key="SettingsFooterDividerStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{DynamicResource PosDividerBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
