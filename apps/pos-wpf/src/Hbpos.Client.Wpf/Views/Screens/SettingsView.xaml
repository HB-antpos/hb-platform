                                                                    </StackPanel>
                                                                </WrapPanel>
                                                                <Border Background="{DynamicResource PosWarningSoftBrush}" BorderBrush="{DynamicResource PosWarningBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10"
